#!/bin/sh
# Runs the conformance fixtures' programs on the VAX/VMS development system
# and compares what each prints with the same program built by the LLVM
# backend and run here (PLAN.md Phase 16 step 5;
# doc/developer/vax-macro32-backend.md, section 16). make test-vax runs it.
#
#   tools/vax-suite [<list>]
#
# The list (default test/vax-suite.list) has a line for each program:
#
#   <fixture> <main module's file> <-O2 or -OC> [<poc option>...]
#       [: <arguments> [; <arguments>]...]
#
# A main module in a subdirectory of the fixture (src/M.Mod) is built and
# run from there, so its own modules are found beside it and a relative
# directory among the options is relative to it.
# '#' starts a comment line. The program is built once with the options,
# and run once with each list of arguments after ":" (quoted as in the
# shell: "two words", ""), or once with none. For each line, the
# fixture's directory is copied twice under build/vax-suite: in one, poc
# builds the program for the host and runs it, keeping each run's standard
# output, standard error and exit status; in the other, poc builds it for
# vax-dec-vms with rtl/vax on the import path, and its .mar files and
# build procedure are renamed after the line's place in the list
# (P001_<MODULE>.MAR, P001.COM), so that every program goes to the guest
# at once. There one procedure, SUITE.COM, assembles poc's runtime, then
# builds each program and runs it as a foreign command with each run's
# arguments quoted (so DCL keeps their case), its SYS$OUTPUT and SYS$ERROR
# in two files, and types both into its log with its status, which comes
# back through tools/vax-do.
#
# Each program is built for the VAX both ways (Phase 18 step 6d;
# doc/developer/vax-object-language.md, section 17.2, item 9): from
# MACRO-32 as P001, and from poc's objects (-vax-objects) as O001, whose
# objects go as O001_<module>.obj, which tools/vax-do converts, with
# every <MODULE>.OBJ in its procedure renamed to match. VAX_WAYS=macro32
# or VAX_WAYS=objects builds one way only, as in test/vaxfixture.sh.
#
# The guest's output must be the host's, and its status the host's exit
# status: SS$_NORMAL is 0, %X10000000 + 8 * n + 2 is n (section 14, item
# 10). A record has no "no line end", so a host output whose last line has
# none is compared as if it had. Where the VAX must differ, the fixture's
# expected-vax-<module>-<build>[-<run>].out, .err or .status is what the
# guest's must be instead: <module> the main module's file without .mod,
# <build> the options without their "-", joined by "-" (O2, or
# O2-trap-heap-exhausted), and <run> the run's number from 1 on a line
# with ":"; without -<build>, expected-vax-<module>[-<run>] is for every
# build that has none of its own. Its lines starting ";;", which say why,
# are not compared. Built from objects, whose tracebacks name each
# routine as its DST record does, with its line (section 16), the
# fixture's expected-vax-objects-<module>... files, named the same way,
# come first. In the guest's standard output and standard error
# (VMS writes its own messages to both, $PUTMSG) the code addresses in
# its fault messages and tracebacks (PC=, PSL=, a traceback line's last
# two columns) are masked as xxxxxxxx first, since any change moves them.
#
# Prints PASSED or FAILED for each run, with the differences, then the
# counts. Exits 0 if all passed, 1 if not, 2 if the guest could not be used
# (VAX_DO_TIMEOUT, default here 3600 seconds, bounds the guest's run).
set -u

ROOT=$(cd "$(dirname "$0")/.." && pwd)
list=${1:-$ROOT/test/vax-suite.list}
POC_BIN_DIR=${POC_BIN_DIR:-$ROOT/build/bin}
PATH="$POC_BIN_DIR:$PATH"
export PATH
VAX_DO_TIMEOUT=${VAX_DO_TIMEOUT:-3600}
export VAX_DO_TIMEOUT
unset POC_IMPORT_PATH

[ -f "$list" ] || { echo "vax-suite: no list $list" >&2; exit 2; }
"$ROOT/tools/vax-assemble" -available || { echo "vax-suite: the VAX guest is not available" >&2; exit 2; }

# the ways each program is built (VAX_WAYS, as test/vaxfixture.sh's)
ways=${VAX_WAYS:-macro32 objects}
for way in $ways; do
  case $way in macro32|objects) ;; *) echo "vax-suite: VAX_WAYS: no way $way" >&2; exit 2 ;; esac
done
# a build's name: the line's P<n> from MACRO-32, O<n> from poc's objects
way_id() {
  case $2 in macro32) echo "$1" ;; objects) echo "O${1#P}" ;; esac
}

work=$ROOT/build/vax-suite
rm -rf "$work"
mkdir -p "$work/host" "$work/vax" "$work/guest" "$work/back"
suite=$work/guest/SUITE.COM
cat >"$suite" <<'EOF'
$ ! Written by tools/vax-suite: builds and runs each program of the list
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ DEF = F$ENVIRONMENT("DEFAULT")
EOF

# the list's lines, numbered: <id> <line>
entries=$work/entries
grep -v '^[[:space:]]*\(#\|$\)' "$list" | awk '{ printf "P%03d %s\n", NR, $0 }' >"$entries"

# a line's parts: build (fixture, main, options), runs (one per line of
# $work/<id>.runs, each its arguments as the list has them), tag
parse() {
  line=$1
  case $line in
    *" : "*) build=${line%% : *}; runs=${line#* : }; numbered=yes ;;
    *) build=$line; runs=; numbered=no ;;
  esac
  # shellcheck disable=SC2086
  set -- $build
  fixture=$1; main=$2; shift 2; options=$*
  case $main in
    */*) subdir=/${main%/*}; main=${main##*/} ;;
    *) subdir= ;;
  esac
  base=${main%.[Mm]od}
  tag=$(echo "$options" | sed 's/^-//; s/ -/-/g; s/ /-/g')
  if [ "$numbered" = yes ]; then
    printf '%s\n' "$runs" | tr ';' '\n' | sed 's/^ *//; s/ *$//' >"$work/$id.runs"
  else
    echo >"$work/$id.runs"
  fi
}

while read -r id line; do
  parse "$line"
  # the host's runs
  cp -R "$ROOT/test/conformance/$fixture" "$work/host/$id"
  h=$work/host/$id$subdir
  # shellcheck disable=SC2086
  if (cd "$h" && poc $options -o prog -build "$main") >"$work/host/$id.build" 2>&1; then hostbuilt=yes; else hostbuilt=no; fi
  k=0
  while IFS= read -r args; do
    k=$((k + 1))
    if [ "$hostbuilt" = yes ]; then
      (cd "$h" && eval "set -- $args" && timeout 120 ./prog "$@" </dev/null >"$work/$id.$k.host.out" 2>"$work/$id.$k.host.err"
       echo "$?" >"$work/$id.$k.host.status")
    else
      echo "host build failed" >"$work/$id.$k.host.status"
    fi
  done <"$work/$id.runs"
  # the VAX's builds, one for each way, renamed for the guest
  for way in $ways; do
    vid=$(way_id "$id" "$way")
    cp -R "$ROOT/test/conformance/$fixture" "$work/vax/$vid"
    v=$work/vax/$vid$subdir
    top=$(sed -n 's/^[[:space:]]*MODULE[[:space:]]*\([A-Za-z0-9_]*\).*/\1/p' "$v/$main" | head -1)
    # shellcheck disable=SC2086
    if ! (cd "$v" && poc $options -target vax-dec-vms -vax-$way -import-path "$ROOT/rtl/vax" -build "$main") >"$work/vax/$vid.build" 2>&1 \
       || [ ! -f "$v/$top.com" ]; then
      echo "VAX build failed" >"$work/$vid.vax.failed"
      continue
    fi
    objects=
    upper=$(echo "$top" | tr a-z A-Z)
    if [ "$way" = macro32 ]; then
      for m in $(sed -n 's/^\$ MACRO\/OBJECT \(.*\)\.MAR$/\1/p' "$v/$top.com"); do
        file=$(cd "$v" && ls | awk -v m="$m" 'toupper($0) == m ".MAR"')
        cp "$v/$file" "$work/guest/${vid}_$m.MAR"
        objects="$objects ${vid}_$m.OBJ"
      done
      sed -e "s/^\\\$ MACRO\\/OBJECT \\(.*\\)\\.MAR\$/\$ MACRO\\/OBJECT ${vid}_\\1.MAR/" \
          -e "s/^\\([A-Z0-9_\$]*\\)\\.OBJ\$/${vid}_\\1.OBJ/" \
          -e "s/^\\\$ CREATE $upper\\.OPT\$/\$ CREATE $vid.OPT/" \
          -e "s/^\\\$ LINK\\/EXECUTABLE=$upper\\.EXE $upper\\.OPT/\$ LINK\\/EXECUTABLE=$vid.EXE $vid.OPT/" \
          "$v/$top.com" >"$work/guest/$vid.COM"
    else
      # the objects, each sent as <vid>_<M>.obj, which tools/vax-do
      # converts, and every <M>.OBJ in the procedure, its conversion's
      # lines and its options file's, renamed; POCRTL.OBJ is the suite's
      modules=$(sed -n 's/^\([A-Z0-9_$]*\)\.OBJ$/\1/p' "$v/$top.com")
      for m in $modules; do
        file=$(cd "$v" && ls | awk -v m="$m" 'toupper($0) == m ".OBJ"')
        cp "$v/$file" "$work/guest/${vid}_$m.obj"
        objects="$objects ${vid}_$m.OBJ"
      done
      awk -v id="$vid" -v modules="$modules" '
        BEGIN { n = split(modules, name, " ") }
        {
          for (i = 1; i <= n; i++) {
            t = name[i] ".OBJ"; done = ""; rest = $0
            while ((p = index(rest, t)) > 0) {
              before = p > 1 ? substr(rest, p - 1, 1) : ""
              if (before ~ /[A-Z0-9_$]/) done = done substr(rest, 1, p + length(t) - 1)
              else done = done substr(rest, 1, p - 1) id "_" t
              rest = substr(rest, p + length(t))
            }
            $0 = done rest
          }
          print
        }' "$v/$top.com" \
      | sed -e "s/^\\\$ CREATE $upper\\.OPT\$/\$ CREATE $vid.OPT/" \
            -e "s/^\\\$ LINK\\/EXECUTABLE=$upper\\.EXE $upper\\.OPT/\$ LINK\\/EXECUTABLE=$vid.EXE $vid.OPT/" \
            >"$work/guest/$vid.COM"
    fi
    {
      echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite build $vid\""
      echo "\$ @$vid"
      echo "\$ S = \$STATUS"
      echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite build-status $vid \", S"
      echo "\$ IF .NOT. S THEN GOTO END_$vid"
      echo "\$ $vid :== \$'DEF'$vid.EXE"
    } >>"$suite"
    k=0
    outputs=
    while IFS= read -r args; do
      k=$((k + 1)); r=${vid}R$k
      quoted=$(eval "set -- $args"; for a; do printf ' "%s"' "$(printf '%s' "$a" | sed 's/"/""/g')"; done)
      {
        echo "\$ DEFINE/USER_MODE SYS\$OUTPUT $r.OUT"
        echo "\$ DEFINE/USER_MODE SYS\$ERROR $r.ERR"
        echo "\$ $vid$quoted"
        echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite status $vid.$k \", \$STATUS"
        echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite out $vid.$k\""
        echo "\$ IF F\$SEARCH(\"$r.OUT\") .NES. \"\" THEN TYPE $r.OUT"
        echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite err $vid.$k\""
        echo "\$ IF F\$SEARCH(\"$r.ERR\") .NES. \"\" THEN TYPE $r.ERR"
        echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite end $vid.$k\""
      } >>"$suite"
      outputs="$outputs $r.OUT $r.ERR"
    done <"$work/$id.runs"
    {
      echo "\$ DELETE/SYMBOL/GLOBAL $vid"
      echo "\$ END_$vid:"
      echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite end $vid\""
      for f in $objects $vid.OPT $vid.EXE $outputs; do
        echo "\$ IF F\$SEARCH(\"$f\") .NES. \"\" THEN DELETE/NOLOG $f;*"
      done
    } >>"$suite"
  done
done <"$entries"
{
  echo "\$ DELETE/NOLOG POCRTL.OBJ;*"
  echo "\$ EXIT 1"
} >>"$suite"

cp "$ROOT/rtl/vax/PocRtl.mar" "$work/guest/POCRTL.MAR"
(cd "$work/guest" && "$ROOT/tools/vax-do" -o "$work/back" SUITE.COM $(ls | grep -v '^SUITE\.COM$')) \
  >"$work/guest.log" 2>&1
status=$?
if [ "$status" -eq 2 ]; then
  echo "vax-suite: the VAX guest could not be used:" >&2; cat "$work/guest.log" >&2; exit 2
fi

# each build's and each run's part of the guest's log
awk -v dir="$work" '
  /^%%vax-suite (build|out|err|end) / { part = $2; id = $3; next }
  /^%%vax-suite build-status / { print $4 >(dir "/" $3 ".vax.build-status"); next }
  /^%%vax-suite status / { print $4 >(dir "/" $3 ".vax.status"); next }
  part == "build" { print >>(dir "/" id ".vax.build-log") }
  part == "out" { print >>(dir "/" id ".vax.out") }
  part == "err" { print >>(dir "/" id ".vax.err") }
' "$work/guest.log"

# a VMS status as an exit status
exit_status() {
  case $1 in
    %X00000001) echo 0 ;;
    %X1*) n=$(( (0x${1#%X} - 0x10000002) )); if [ $((n % 8)) -eq 0 ] && [ "$n" -ge 0 ]; then echo $((n / 8)); else echo "$1"; fi ;;
    *) echo "$1" ;;
  esac
}

# what the guest's <kind> must be for run k: built from objects, the
# fixture's expected-vax-objects file for this build, else its file for
# every build; then its expected-vax file for this build, else its file
# for every build; else the host's, ending with a line end
want() {
  run=; [ "$numbered" = yes ] && run=-$k
  objects=$ROOT/test/conformance/$fixture/expected-vax-objects-$base
  over=$ROOT/test/conformance/$fixture/expected-vax-$base
  if [ "$way" = objects ] && [ -f "$objects-$tag$run.$1" ]; then grep -v '^;;' "$objects-$tag$run.$1"
  elif [ "$way" = objects ] && [ -f "$objects$run.$1" ]; then grep -v '^;;' "$objects$run.$1"
  elif [ -f "$over-$tag$run.$1" ]; then grep -v '^;;' "$over-$tag$run.$1"
  elif [ -f "$over$run.$1" ]; then grep -v '^;;' "$over$run.$1"
  elif [ -s "$work/$id.$k.host.$1" ]; then sed '$a\' "$work/$id.$k.host.$1"
  fi
}

# VMS's own message for a fault, and its traceback, name code addresses,
# which any change to the code moves: they are masked, in place
masked() {
  sed -e 's/PC=[0-9A-F]\{8\}/PC=xxxxxxxx/g' -e 's/PSL=[0-9A-F]\{8\}/PSL=xxxxxxxx/g' \
      -e 's/ [0-9A-F]\{8\}  [0-9A-F]\{8\}$/ xxxxxxxx  xxxxxxxx/' "$1" >"$1.masked" && mv "$1.masked" "$1"
}

passed=0; failed=0
while read -r id line; do
  parse "$line"
  k=0
  while IFS= read -r args; do
    k=$((k + 1))
    for way in $ways; do
      vid=$(way_id "$id" "$way"); r=$vid.$k
      name="$build${args:+ : $args}"
      : >"$work/$r.diff"
      if [ -f "$work/$vid.vax.failed" ]; then
        echo "the VAX build failed:" >>"$work/$r.diff"; cat "$work/vax/$vid.build" >>"$work/$r.diff"
      elif [ ! -f "$work/$vid.vax.build-status" ] || [ "$(cat "$work/$vid.vax.build-status")" != %X10000001 ]; then
        echo "the guest's build failed:" >>"$work/$r.diff"; cat "$work/$vid.vax.build-log" 2>/dev/null >>"$work/$r.diff"
      else
        for kind in out err; do
          want "$kind" >"$work/$r.want.$kind"
          [ -f "$work/$r.vax.$kind" ] || : >"$work/$r.vax.$kind"
          masked "$work/$r.vax.$kind"
          if ! diff "$work/$r.want.$kind" "$work/$r.vax.$kind" >"$work/$r.d" 2>&1; then
            case $kind in out) echo "standard output differs (< wanted, > the VAX's):" ;;
                          err) echo "standard error differs (< wanted, > the VAX's):" ;; esac >>"$work/$r.diff"
            cat "$work/$r.d" >>"$work/$r.diff"
          fi
        done
        got=$(exit_status "$(cat "$work/$r.vax.status" 2>/dev/null)")
        wanted=$(want status)
        [ "$got" = "$wanted" ] || echo "exit status: wanted $wanted, the VAX's $got" >>"$work/$r.diff"
      fi
      if [ -s "$work/$r.diff" ]; then
        failed=$((failed + 1)); echo "FAILED: $r ($way) $name"; sed 's/^/  /' "$work/$r.diff"
      else
        passed=$((passed + 1)); echo "PASSED: $r ($way) $name"
      fi
    done
  done <"$work/$id.runs"
done <"$entries"
echo
echo "$passed passed, $failed failed"
[ "$failed" -eq 0 ]
