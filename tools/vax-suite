#!/bin/sh
# Runs the conformance fixtures' programs on the VAX/VMS development system
# and compares what each prints with the same program built by the LLVM
# backend and run here (PLAN.md Phase 16 step 5;
# doc/developer/vax-macro32-backend.md, section 16). make test-vax runs it.
#
#   tools/vax-suite [<list>]
#
# The list (default test/vax-suite.list) has a line for each program:
#
#   <fixture> <main module's file> <-O2 or -OC> [<argument>...]
#
# '#' starts a comment line. For each, the fixture's directory is copied
# twice under build/vax-suite: in one, poc builds the program for the host
# and runs it with the arguments, keeping its standard output, standard
# error and exit status; in the other, poc builds it for vax-dec-vms with
# rtl/vax on the import path, and its .mar files and build procedure are
# renamed after the program's place in the list (P001_<MODULE>.MAR,
# P001.COM), so that every program goes to the guest at once. There one
# procedure, SUITE.COM, assembles poc's runtime, then builds and runs each
# program as a foreign command with its arguments quoted (so DCL keeps
# their case), its SYS$OUTPUT and SYS$ERROR in two files, and types both
# into its log with its status, which comes back through tools/vax-do.
#
# The guest's output must be the host's, and its status the host's exit
# status: SS$_NORMAL is 0, %X10000000 + 8 * n + 2 is n (section 14, item
# 10). A record has no "no line end", so a host output whose last line has
# none is compared as if it had. Where the VAX must differ, the fixture's
# expected-vax-<module>-<model>.out, .err or .status (<module> its main
# module's file without .mod, <model> O2 or OC) is what the guest's must
# be instead; its lines starting ";;", which say why, are not compared.
# On the guest's standard error the code addresses in VMS's own fault
# messages and tracebacks (PC=, PSL=, a traceback line's last two
# columns) are masked as xxxxxxxx first, since any change moves them.
#
# Prints PASSED or FAILED for each program, with the differences, then the
# counts. Exits 0 if all passed, 1 if not, 2 if the guest could not be used
# (VAX_DO_TIMEOUT, default here 3600 seconds, bounds the guest's run).
set -u

ROOT=$(cd "$(dirname "$0")/.." && pwd)
list=${1:-$ROOT/test/vax-suite.list}
POC_BIN_DIR=${POC_BIN_DIR:-$ROOT/build/bin}
PATH="$POC_BIN_DIR:$PATH"
export PATH
VAX_DO_TIMEOUT=${VAX_DO_TIMEOUT:-3600}
export VAX_DO_TIMEOUT
unset POC_IMPORT_PATH

[ -f "$list" ] || { echo "vax-suite: no list $list" >&2; exit 2; }
"$ROOT/tools/vax-assemble" -available || { echo "vax-suite: the VAX guest is not available" >&2; exit 2; }

work=$ROOT/build/vax-suite
rm -rf "$work"
mkdir -p "$work/host" "$work/vax" "$work/guest" "$work/back"
suite=$work/guest/SUITE.COM
cat >"$suite" <<'EOF'
$ ! Written by tools/vax-suite: builds and runs each program of the list
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ DEF = F$ENVIRONMENT("DEFAULT")
EOF

# the list's lines, numbered: <id> <fixture> <main> <model> [<argument>...]
entries=$work/entries
grep -v '^[[:space:]]*\(#\|$\)' "$list" | awk '{ printf "P%03d %s\n", NR, $0 }' >"$entries"

while read -r id fixture main model args; do
  base=${main%.mod}; tag=${model#-}
  echo "$fixture $main $model${args:+ $args}" >"$work/$id.name"
  # the host's run
  h=$work/host/$id
  cp -R "$ROOT/test/conformance/$fixture" "$h"
  if (cd "$h" && poc "$model" -o prog -build "$main") >"$h.build" 2>&1; then
    # shellcheck disable=SC2086
    (cd "$h" && timeout 120 ./prog $args >"$work/$id.host.out" 2>"$work/$id.host.err"
     echo "$?" >"$work/$id.host.status")
  else
    echo "host build failed" >"$work/$id.host.status"
  fi
  # the VAX's build, renamed for the guest
  v=$work/vax/$id
  cp -R "$ROOT/test/conformance/$fixture" "$v"
  top=$(sed -n 's/^[[:space:]]*MODULE[[:space:]]*\([A-Za-z0-9_]*\).*/\1/p' "$v/$main" | head -1)
  if ! (cd "$v" && poc "$model" -target vax-dec-vms -import-path "$ROOT/rtl/vax" -build "$main") >"$v.build" 2>&1 \
     || [ ! -f "$v/$top.com" ]; then
    echo "VAX build failed" >"$work/$id.vax.failed"
    continue
  fi
  objects=
  for m in $(sed -n 's/^\$ MACRO\/OBJECT \(.*\)\.MAR$/\1/p' "$v/$top.com"); do
    file=$(cd "$v" && ls | awk -v m="$m" 'toupper($0) == m ".MAR"')
    cp "$v/$file" "$work/guest/${id}_$m.MAR"
    objects="$objects ${id}_$m.OBJ"
  done
  upper=$(echo "$top" | tr a-z A-Z)
  sed -e "s/^\\\$ MACRO\\/OBJECT \\(.*\\)\\.MAR\$/\$ MACRO\\/OBJECT ${id}_\\1.MAR/" \
      -e "s/^\\([A-Z0-9_\$]*\\)\\.OBJ\$/${id}_\\1.OBJ/" \
      -e "s/^\\\$ CREATE $upper\\.OPT\$/\$ CREATE $id.OPT/" \
      -e "s/^\\\$ LINK\\/EXECUTABLE=$upper\\.EXE $upper\\.OPT/\$ LINK\\/EXECUTABLE=$id.EXE $id.OPT/" \
      "$v/$top.com" >"$work/guest/$id.COM"
  quoted=
  for a in $args; do quoted="$quoted \"$(printf '%s' "$a" | sed 's/"/""/g')\""; done
  {
    echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite build $id\""
    echo "\$ @$id"
    echo "\$ S = \$STATUS"
    echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite build-status $id \", S"
    echo "\$ IF .NOT. S THEN GOTO END_$id"
    echo "\$ $id :== \$'DEF'$id.EXE"
    echo "\$ DEFINE/USER_MODE SYS\$OUTPUT $id.OUT"
    echo "\$ DEFINE/USER_MODE SYS\$ERROR $id.ERR"
    echo "\$ $id$quoted"
    echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite status $id \", \$STATUS"
    echo "\$ DELETE/SYMBOL/GLOBAL $id"
    echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite out $id\""
    echo "\$ IF F\$SEARCH(\"$id.OUT\") .NES. \"\" THEN TYPE $id.OUT"
    echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite err $id\""
    echo "\$ IF F\$SEARCH(\"$id.ERR\") .NES. \"\" THEN TYPE $id.ERR"
    echo "\$ END_$id:"
    echo "\$ WRITE SYS\$OUTPUT \"%%vax-suite end $id\""
    for f in $objects $id.OPT $id.EXE $id.OUT $id.ERR; do
      echo "\$ IF F\$SEARCH(\"$f\") .NES. \"\" THEN DELETE/NOLOG $f;*"
    done
  } >>"$suite"
done <"$entries"
{
  echo "\$ DELETE/NOLOG POCRTL.OBJ;*"
  echo "\$ EXIT 1"
} >>"$suite"

cp "$ROOT/rtl/vax/PocRtl.mar" "$work/guest/POCRTL.MAR"
(cd "$work/guest" && "$ROOT/tools/vax-do" -o "$work/back" SUITE.COM $(ls | grep -v '^SUITE\.COM$')) \
  >"$work/guest.log" 2>&1
status=$?
if [ "$status" -eq 2 ]; then
  echo "vax-suite: the VAX guest could not be used:" >&2; cat "$work/guest.log" >&2; exit 2
fi

# each program's part of the guest's log
awk -v dir="$work" '
  /^%%vax-suite (build|out|err|end) / { part = $2; id = $3; next }
  /^%%vax-suite build-status / { print $4 >(dir "/" $3 ".vax.build-status"); next }
  /^%%vax-suite status / { print $4 >(dir "/" $3 ".vax.status"); next }
  part == "build" { print >>(dir "/" id ".vax.build-log") }
  part == "out" { print >>(dir "/" id ".vax.out") }
  part == "err" { print >>(dir "/" id ".vax.err") }
' "$work/guest.log"

# a VMS status as an exit status
exit_status() {
  case $1 in
    %X00000001) echo 0 ;;
    %X1*) n=$(( (0x${1#%X} - 0x10000002) )); if [ $((n % 8)) -eq 0 ] && [ "$n" -ge 0 ]; then echo $((n / 8)); else echo "$1"; fi ;;
    *) echo "$1" ;;
  esac
}

# what the guest's <kind> must be: the fixture's expected-vax file, else
# the host's, ending with a line end
want() {
  over=$ROOT/test/conformance/$fixture/expected-vax-$base-$tag.$1
  if [ -f "$over" ]; then grep -v '^;;' "$over"
  elif [ -s "$work/$id.host.$1" ]; then sed '$a\' "$work/$id.host.$1"
  fi
}

# VMS's own message for a fault, and its traceback, name code addresses,
# which any change to the code moves: they are masked, in place
masked() {
  sed -e 's/PC=[0-9A-F]\{8\}/PC=xxxxxxxx/g' -e 's/PSL=[0-9A-F]\{8\}/PSL=xxxxxxxx/g' \
      -e 's/ [0-9A-F]\{8\}  [0-9A-F]\{8\}$/ xxxxxxxx  xxxxxxxx/' "$1" >"$1.masked" && mv "$1.masked" "$1"
}

passed=0; failed=0
while read -r id fixture main model args; do
  base=${main%.mod}; tag=${model#-}
  name=$(cat "$work/$id.name")
  : >"$work/$id.diff"
  if [ -f "$work/$id.vax.failed" ]; then
    echo "the VAX build failed:" >>"$work/$id.diff"; cat "$work/vax/$id.build" >>"$work/$id.diff"
  elif [ ! -f "$work/$id.vax.build-status" ] || [ "$(cat "$work/$id.vax.build-status")" != %X10000001 ]; then
    echo "the guest's build failed:" >>"$work/$id.diff"; cat "$work/$id.vax.build-log" 2>/dev/null >>"$work/$id.diff"
  else
    for kind in out err; do
      want "$kind" >"$work/$id.want.$kind"
      [ -f "$work/$id.vax.$kind" ] || : >"$work/$id.vax.$kind"
      [ "$kind" = err ] && masked "$work/$id.vax.err"
      diff "$work/$id.want.$kind" "$work/$id.vax.$kind" >"$work/$id.d" 2>&1 ||
        { echo "standard $kind differs (< wanted, > the VAX's):" | sed 's/standard out /standard output /; s/standard err /standard error /' >>"$work/$id.diff"; cat "$work/$id.d" >>"$work/$id.diff"; }
    done
    got=$(exit_status "$(cat "$work/$id.vax.status" 2>/dev/null)")
    wanted=$(want status)
    [ "$got" = "$wanted" ] || echo "exit status: wanted $wanted, the VAX's $got" >>"$work/$id.diff"
  fi
  if [ -s "$work/$id.diff" ]; then
    failed=$((failed + 1)); echo "FAILED: $id $name"; sed 's/^/  /' "$work/$id.diff"
  else
    passed=$((passed + 1)); echo "PASSED: $id $name"
  fi
done <"$entries"
echo
echo "$passed passed, $failed failed"
[ "$failed" -eq 0 ]
