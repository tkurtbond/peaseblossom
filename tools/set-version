#!/bin/sh
# Sets poc's version, the first step of a release (doc/developer/DEVELOPER.md,
# section 7): Version.number in src/driver/Version.Mod, and the same version
# in each package - Version in the Fedora spec, with Release back to 1 and a
# %changelog entry for it, DISTVERSION in the FreeBSD ports, V in the OpenBSD
# port and DISTNAME in pkgsrc's packages - lang/peaseblossom's and
# lang/peaseblossom-vax's for FreeBSD and pkgsrc, whose peaseblossom-vax is
# a port of its own (OpenBSD's is a subpackage, and Fedora's) - removing any
# PORTREVISION, REVISION (REVISION-main, REVISION-vax) or PKGREVISION; and where the documents name it, INSTALL.md's examples of
# unpacking the tarball and installing a release's packages (their file
# names and download URLs), the Reference Guide's "describes poc
# <major.minor>" and the VAX/VMS Guide's example of unpacking the kits
# (their names, POC-<x-y-z>, and what POC -VERSION prints). The
# %changelog entry says only "Update to <version>.", for the person
# releasing to fill in; one already there for the version is kept. Each package's distinfo is of the published tarball, so it is made
# later, on its system (section 6). Run as tools/set-version <x.y.z>, or
# make set-version VERSION=<x.y.z>, from anywhere.
set -e

ROOT=$(cd "$(dirname "$0")/.." && pwd)
version=$1
if ! printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "usage: tools/set-version <major.minor.patch>" >&2
  exit 1
fi

# edit FILE SED-SCRIPT: rewrites FILE through sed, checking that it changed
# what it was meant to (sed -i differs between GNU and BSD sed)
edit() {
  file=$ROOT/$1
  sed "$2" "$file" >"$file.tmp.$$"
  if cmp -s "$file" "$file.tmp.$$"; then
    rm -f "$file.tmp.$$"
  else
    cat "$file.tmp.$$" >"$file"; rm -f "$file.tmp.$$"
    echo "set-version: $1"
  fi
}

# must FILE PATTERN: FILE has a line matching PATTERN, or the edit above
# would have done nothing unnoticed
must() {
  grep -Eq "$2" "$ROOT/$1" || { echo "set-version: $1 has no line matching $2" >&2; exit 1; }
}

must src/driver/Version.Mod '^ *number\* *= *"[^"]*";'
must packaging/fedora/peaseblossom.spec '^Version: '
must packaging/fedora/peaseblossom.spec '^Release: '
must packaging/fedora/peaseblossom.spec '^%changelog$'
must packaging/freebsd/lang/peaseblossom/Makefile '^DISTVERSION='
must packaging/freebsd/lang/peaseblossom-vax/Makefile '^DISTVERSION='
must packaging/openbsd/lang/peaseblossom/Makefile '^V ='
must packaging/pkgsrc/lang/peaseblossom/Makefile '^DISTNAME='
must packaging/pkgsrc/lang/peaseblossom-vax/Makefile '^DISTNAME='
must INSTALL.md 'peaseblossom-[0-9]+\.[0-9]+\.[0-9]+'
must doc/reference-guide.md 'describes poc [0-9]+\.[0-9]+ '
must doc/vax-vms-guide.md '@\[-\]POC-[0-9]+-[0-9]+-[0-9]+$'
must doc/vax-vms-guide.md '^    poc [0-9]+\.[0-9]+\.[0-9]+$'

edit src/driver/Version.Mod "s/^\( *number\* *= *\)\"[^\"]*\";/\1\"$version\";/"

spec=packaging/fedora/peaseblossom.spec
note=
edit $spec "s/^\(Version: *\).*/\1$version/; s/^\(Release: *\)[0-9]*%/\11%/"
if ! grep -q "^\* .* - $version-1\$" "$ROOT/$spec"; then
  who="$(git -C "$ROOT" config user.name) <$(git -C "$ROOT" config user.email)>"
  day=$(LC_ALL=C date '+%a %b %d %Y')
  edit $spec "/^%changelog\$/a\\
* $day $who - $version-1\\
- Update to $version.\\

"
  note="; fill in the %changelog entry in $spec"
fi

for port in peaseblossom peaseblossom-vax; do
  edit packaging/freebsd/lang/$port/Makefile \
    "s/^\(DISTVERSION=[[:space:]]*\).*/\1$version/; /^PORTREVISION=/d"
  edit packaging/pkgsrc/lang/$port/Makefile \
    "s/^\(DISTNAME=[[:space:]]*peaseblossom-\).*/\1$version/; /^PKGREVISION=/d"
done
edit packaging/openbsd/lang/peaseblossom/Makefile \
  "s/^\(V =[[:space:]]*\).*/\1$version/; /^REVISION\(-[a-z]*\)\{0,1\}[[:space:]]*=/d"

edit INSTALL.md "s/peaseblossom-[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*/peaseblossom-$version/g; s|/download/v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*/|/download/v$version/|g"
edit doc/reference-guide.md \
  "s/describes poc [0-9][0-9]*\.[0-9][0-9]* /describes poc ${version%.*} /"
hyphens=$(printf '%s\n' "$version" | tr . -)
edit doc/vax-vms-guide.md \
  "s/POC-\(VMS-\)\{0,1\}[0-9][0-9]*-[0-9][0-9]*-[0-9][0-9]*/POC-\1$hyphens/g; s/\(\.COM\` for \)[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*)/\1$version)/; s/^    poc [0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\$/    poc $version/"

echo "set-version: $version$note"
