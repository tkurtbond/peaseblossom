# Assembles, links and runs a program under the debugger on the VAX/VMS
# development system for tools/vax-run, which runs this: in one FTP
# session (tools/vax-ftp.tcl), copies each <file> to POC's home directory
# as <NAME.EXT>; then, by telnet, keeping the FTP session alive, assembles
# each <MODULE>.MAR and POCSTUB.MAR /DEBUG (a <file> that is poc's object,
# <NAME.EXT> <MODULE>.OBJ, copied in binary mode as <MODULE>.CNT and
# converted to <MODULE>.OBJ instead: tools/vax-objconvert.tcl) and links
# them /DEBUG as
# POCRUN.EXE, the main module, the first, first, so that its start is the
# image's, and runs it once for each R<n>.DBG, the debugger reading its
# commands from it (DBG$INPUT) and writing to R<n>.OUT (DBG$OUTPUT); then
# brings each R<n>.OUT back into <dir>, and deletes every version of every
# file of the run there, whatever happened. Prints what MACRO and LINK say
# and a line "VAXRUN-STATUS <step> <hex $STATUS>" after each step. Exits 0,
# 1 if an R<n>.OUT did not come back (its error on the standard error), 2
# if the guest could not be used.
#
#   expect -f tools/vax-run.exp <host> <number of runs> <dir> {<file> <NAME.EXT>}... -- <MODULE>...

set host [lindex $argv 0]
set runs [lindex $argv 1]
set outdir [lindex $argv 2]
set rest [lrange $argv 3 end]
set split [lsearch -exact $rest --]
set puts [lrange $rest 0 [expr {$split - 1}]]
set modules [lrange $rest [expr {$split + 1}] end]
set timeout 120
log_user 0

source [file join [file dirname [info script]] vax-login.tcl]
source [file join [file dirname [info script]] vax-ftp.tcl]
source [file join [file dirname [info script]] vax-objconvert.tcl]

if {[catch {ftp_open $host} message]} {
  puts stderr "vax-run: the VAX guest $host is not available ($message)"
  exit 2
}
# from here on, whatever happens, every file of this run is deleted there
set made POCRUN.EXE
foreach name [concat $modules POCSTUB] { lappend made $name.MAR $name.OBJ $name.CNT }
for {set i 1} {$i <= $runs} {incr i} { lappend made R$i.DBG R$i.OUT }
exit -onexit {
  foreach remote $::made { catch {ftp_delete $remote} }
  ftp_close
}

set objects {}
foreach {file remote} $puts {
  if {[string match *.OBJ $remote]} {
    set name [file rootname $remote]
    if {[catch {objconvert_put $file $name} message]} { fail "cannot copy $file there: $message" }
    lappend objects $name
  } elseif {[catch {ftp_put $file $remote} message]} {
    fail "cannot copy $file there: $message"
  }
}

vax_login $host
objconvert_each $objects

# command, then its output and "VAXRUN-STATUS <step> <$STATUS>"
proc step {name command} {
  global prompt expect_out
  send "$command\r"
  expect {
    -re $prompt {}
    timeout { fail "no prompt after $command" }
  }
  set out $expect_out(buffer)
  regsub {^[^\n]*\n} $out "" out
  regsub {\r?\n?VAXASM> $} $out "" out
  regsub -all {\r} $out "" out
  if {[string trim $out] ne ""} { puts [string trimright $out] }
  send "WRITE SYS\$OUTPUT \"VAXRUN-STATUS \", \$STATUS\r"
  expect {
    -re {VAXRUN-STATUS %X([0-9A-F]{8})\r?\n} { puts "VAXRUN-STATUS $name $expect_out(1,string)" }
    timeout { fail "no status after $command" }
  }
  expect {
    -re $prompt {}
    timeout { fail "no prompt after the status of $command" }
  }
  catch ftp_noop
}

foreach name [concat $modules POCSTUB] {
  if {$name ni $objects} { step $name "MACRO/DEBUG/OBJECT/NOLIST $name" }
}
step LINK "LINK/DEBUG/NOMAP/EXECUTABLE=POCRUN [join [concat $modules POCSTUB] ,]"
for {set i 1} {$i <= $runs} {incr i} {
  step D$i "DEFINE DBG\$INPUT R$i.DBG"
  step O$i "DEFINE DBG\$OUTPUT R$i.OUT"
  step R$i "RUN POCRUN"
  step A$i "DEASSIGN DBG\$INPUT"
  step B$i "DEASSIGN DBG\$OUTPUT"
}

send "LOGOUT\r"
expect eof

set status 0
for {set i 1} {$i <= $runs} {incr i} {
  if {[catch {ftp_get R$i.OUT [file join $outdir R$i.OUT]} message]} {
    puts stderr "vax-run: cannot copy R$i.OUT back: $message"
    file delete [file join $outdir R$i.OUT]
    set status 1
  }
}
exit $status
