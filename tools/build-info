#!/bin/sh
# Writes BuildInfo.Mod into the directory given (Phase 13 step 1): the git
# commit poc is built from, with "-dirty" when tracked files differ from it,
# or, when the tree is not a git checkout, what the file COMMIT at its top
# says (make dist writes it into a release tarball), or else "" (a copy
# made with git archive). `poc -version` prints it after Version.number. The file
# is rewritten only when its content changes, so a build is not redone for
# nothing. Run with the directory as its argument, from anywhere.
#
# A second argument, vax-dec-vms, is for a poc that will run on VAX/VMS
# (Phase 16 step 4; doc/developer/vax-macro32-backend.md, section 15,
# proposal 7): BuildInfo.defaultTarget is then that triple, the target poc
# compiles for when no -target is given, and the only one it has. Without
# it, defaultTarget is "", and poc compiles for the host.
set -e

dir=$1
target=${2:-}
case $target in
  ""|vax-dec-vms) ;;
  *) echo "build-info: no such target for poc to run on: $target" >&2; exit 1 ;;
esac
ROOT=$(cd "$(dirname "$0")/.." && pwd)
commit=
# the tree's own repository, not one it was unpacked inside
if command -v git >/dev/null 2>&1 \
   && [ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$ROOT" && pwd -P)" ]; then
  commit=$(git -C "$ROOT" rev-parse --short HEAD)
  git -C "$ROOT" diff --quiet HEAD -- || commit="$commit-dirty"
elif [ -f "$ROOT/COMMIT" ]; then
  commit=$(sed -n 1p "$ROOT/COMMIT")
fi

mkdir -p "$dir"
tmp="$dir/BuildInfo.Mod.tmp.$$"
cat >"$tmp" <<MOD
MODULE BuildInfo;

  (* Written by tools/build-info; do not edit. *)

  CONST
    commit* = "$commit";
    (* the target when no -target is given: "" for the host's *)
    defaultTarget* = "$target";

END BuildInfo.
MOD
if cmp -s "$tmp" "$dir/BuildInfo.Mod"; then rm -f "$tmp"; else mv "$tmp" "$dir/BuildInfo.Mod"; fi
