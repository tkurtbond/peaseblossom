#!/bin/sh
# Runs a DCL command procedure on the VAX/VMS development system, with the
# files it needs, and brings back the files it makes (PLAN.md Phase 16 step
# 1: the one host-side command every later step's fixtures depend on;
# doc/developer/DEVELOPER.md, section 4). The procedure and the input files
# are copied to POC's home directory by FTP, in active and ASCII mode, each
# as its file name uppercased; the procedure is run by telnet as
# @NAME/OUTPUT=VAXDO.LOG, so that what it writes comes back by FTP whole,
# not read from a terminal; then VAXDO.LOG and each -get file are copied
# back into the output directory, as named, and every copy on the guest is
# deleted. tools/vax-do.exp does all of that in one FTP session and one
# telnet session (tools/vax-ftp.tcl says why). Prints the procedure's
# output and a last line "<proc>: <hex $STATUS> <severity>".
#
#   tools/vax-do [-o <dir>] [-get <NAME.EXT>]... [-p <word>] <proc.com> [<file>...]
#
# -o is the directory the files come back to (default .); -get names a file
# the procedure leaves in POC's directory, repeated for each; -p gives the
# procedure its P1, letters, digits and underscores only. Files cross in
# ASCII mode, as RMS variable-length records on the guest, all but poc's
# objects, <name>.obj (PLAN.md Phase 18 step 4c; doc/developer/
# vax-object-language.md, section 15.9, proposal 7): each is copied in
# binary mode as <NAME>.CNT and converted there to <NAME>.OBJ by
# OBJCONVERT, before the procedure runs (tools/vax-objconvert.tcl).
# VAX_DO_CONVERT=no sends each in binary mode as <NAME>.OBJ instead, as a
# user would, and leaves it to the procedure, which poc writes to convert
# it (doc/developer/vax-object-language.md, section 17, proposal 3) with
# an OBJCONVERT of its own, as the kit's SETUP.COM defines.
# VAX_DO_TIMEOUT is how long the procedure may run, in seconds (default
# 600). Exits 0 if the procedure's $STATUS is a success or informational
# one and every file came back, 1 if not, 2 if the guest could not be used.
#
# The login and password are $VAX_NETRC's (default ~/.netrc-poc-vax), read by
# the expect script itself, never on a command line or printed. VAX_HOST names the guest (default 192.168.2.20). Runs share POC's
# home directory, so each holds this host's lock while it uses the guest
# (tools/vax-lock.sh).
set -e

host=${VAX_HOST:-192.168.2.20}
here=$(cd "$(dirname "$0")" && pwd)
VAX_NETRC=${VAX_NETRC:-$HOME/.netrc-poc-vax}
export VAX_NETRC
. "$here/vax-lock.sh"

usage() { echo "usage: tools/vax-do [-o <dir>] [-get <NAME.EXT>]... [-p <word>] <proc.com> [<file>...]" >&2; exit 2; }

# a file's name on the guest: its own, uppercased, which must be a plain VMS
# name and type
guest_name() {
  n=$(basename "$1" | tr a-z A-Z)
  case $n in
    *[!A-Z0-9_\$.-]*|*.*.*|.*|"") echo "vax-do: $(basename "$1") is not a VMS file name" >&2; exit 2 ;;
  esac
  echo "$n"
}

outdir=.
gets=
VAX_DO_PARAMETER=; export VAX_DO_PARAMETER
while [ $# -gt 0 ]; do
  case $1 in
    -o) [ $# -ge 2 ] || usage; outdir=$2; shift 2 ;;
    -get) [ $# -ge 2 ] || usage; g=$(guest_name "$2"); gets="$gets $g"; shift 2 ;;
    -p)
      [ $# -ge 2 ] || usage
      case $2 in *[!A-Za-z0-9_]*|"") echo "vax-do: -p $2 is not a word" >&2; exit 2 ;; esac
      VAX_DO_PARAMETER=$2; export VAX_DO_PARAMETER; shift 2 ;;
    -*) usage ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || usage
case $1 in *.com|*.COM) ;; *) echo "vax-do: $1 is not a .com file" >&2; exit 2 ;; esac
for f; do [ -r "$f" ] || { echo "vax-do: cannot read $f" >&2; exit 2; }; done
[ -d "$outdir" ] || { echo "vax-do: $outdir is not a directory" >&2; exit 2; }
procfile=$1
proc=$(guest_name "$1")
for f; do guest_name "$f" >/dev/null || exit 2; done
# poc's objects: the converter's MACRO and its key (tools/vax-objconvert)
for f; do
  case ${VAX_DO_CONVERT:-}:$f in
    no:*) break ;;
    *.obj)
      VAX_OBJCONVERT_DIR=${VAX_OBJCONVERT_DIR:-$(dirname "$here")/build/objconvert}
      VAX_OBJCONVERT_KEY=$("$here/vax-objconvert" "$VAX_OBJCONVERT_DIR") || exit 2
      export VAX_OBJCONVERT_DIR VAX_OBJCONVERT_KEY
      break ;;
  esac
done

out=$(mktemp "${TMPDIR:-/tmp}/vax-do.XXXXXX")
# only once this run has the lock may it touch the guest
vax_lock
trap 'rm -f "$out"; vax_unlock' EXIT

# each file and its name there, then the files to bring back
set -- "$@" --
while [ "$1" != -- ]; do
  set -- "$@" "$1" "$(guest_name "$1")"
  shift
done
shift
# shellcheck disable=SC2086
set -- "$@" -- $gets

status=0
expect -f "$here/vax-do.exp" "$host" "${proc%.COM}" "$outdir" "$@" >"$out" || status=$?
[ "$status" -ne 2 ] || { cat "$out" >&2; exit 2; }
[ -f "$outdir/VAXDO.LOG" ] && cat "$outdir/VAXDO.LOG"
hex=$(sed -n 's/^VAXDO-STATUS \([0-9A-F]*\)$/\1/p' "$out")
if [ -z "$hex" ]; then
  echo "$procfile: no status"; exit 1
fi
# the low three bits of a VMS status are its severity
case $(( 0x$hex & 7 )) in
  0) sev=warning ;; 1) sev=success ;; 2) sev=error ;;
  3) sev=informational ;; 4) sev=fatal ;; *) sev=unknown ;;
esac
echo "$procfile: %X$hex $sev"
case $sev in success|informational) ;; *) status=1 ;; esac
exit $status
