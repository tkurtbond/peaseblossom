#!/bin/sh
# make seed (Phase 13 step 4): the bootstrap seed, poc's own LLVM IR, from
# which clang alone builds a Stage 0 poc (tools/bootstrap/stage0-seed) on a
# host without voc. poc's IR depends only on the word size (checked
# 2026-10-02: every 64-bit target's, x86_64 and aarch64 alike, differs
# only in the triple and its datalayout, and so does every 32-bit x86
# BSD's), so there are
# two: 64, for x86_64-unknown-linux-gnu, and 32, for i386-unknown-openbsd,
# each with its triple in TRIPLE, which stage0-seed replaces with the
# host's. Written by the Stage 2 poc (POC, default build/stage2/bin/poc)
# under -OC, as poc's own build is, into SEED_DIR, default build/seed. The
# seed is not kept in git (decided with the user): make dist puts it in the
# release tarball as seed/, the only place a top-level seed/ is.
set -e

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
BUILD=${BOOTSTRAP_BUILD_DIR:-$ROOT/build}
POC=${POC:-$BUILD/stage2/bin/poc}
SEED=${SEED_DIR:-$BUILD/seed}

"$ROOT/tools/build-info" "$BUILD/gen"
rm -rf "$SEED"
for spec in 64:x86_64-unknown-linux-gnu 32:i386-unknown-openbsd; do
  bits=${spec%%:*}; triple=${spec#*:}
  mkdir -p "$SEED/$bits"
  (cd "$SEED/$bits" &&
   "$POC" -OC -clear-library-path -target "$triple" \
     -import-path "$ROOT/src/front" -import-path "$ROOT/src/back/llvm" -import-path "$ROOT/src/back/vax" \
     -import-path "$ROOT/rtl/llvm" -import-path "$ROOT/src/driver" -import-path "$BUILD/gen" \
     -emit-llvm-ir "$ROOT/src/driver/Poc.Mod" >/dev/null &&
   rm -f ./*.sym && echo "$triple" > TRIPLE)
  # stage0-seed replaces the triple everywhere: it must be only in each
  # module's target line and its -target symbol, never in poc's own text
  for f in "$SEED/$bits"/*.ll; do
    if [ "$(grep -c -- "$triple" "$f")" != 2 ]; then
      echo "make-seed: $f has $triple other than in its target triple and -target symbol" >&2
      exit 1
    fi
  done
done
"$POC" -version | sed -n 1p > "$SEED/VERSION"
echo "seed: wrote $SEED ($(cat "$SEED/VERSION"))"
