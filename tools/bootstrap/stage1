#!/bin/sh
# Stage 1: the Stage-0-built poc (build/bin/poc, made by tools/bootstrap/
# stage0) compiles poc's own source, giving build/stage1/bin/poc - poc built by
# poc, linked against rtl/llvm instead of voc's runtime. See PLAN.md,
# "Bootstrap terminology". Run with no arguments from anywhere.
#
# -OC matches Stage 0's own voc -OC (see stage0's comment): poc's LONGINT
# must be 8 bytes wide for Types.Value.intVal. The build leaves its
# intermediate Poc.ll and the .sym files it generated in build/stage1/obj,
# which stage2 compares against its own. The binary sits in bin/ so that
# POC_BIN_DIR=build/stage1/bin runs the conformance suite under it
# (make test-stage1).
#
# make check-opt2 (Phase 11 D13) sets BOOTSTRAP_BUILD_DIR, to build in a
# directory of its own instead of build, and BOOTSTRAP_OPT, a level for
# poc's -opt, to build with clang optimizing.
set -e

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
BUILD=${BOOTSTRAP_BUILD_DIR:-$ROOT/build}
STAGE0_POC=${STAGE0_POC:-$BUILD/bin/poc}

# The Stage 0 poc is a voc program, linked against voc's shared runtime
# (libvoc-OC.so), which Linux finds by itself and NetBSD/OpenBSD do not - and a
# non-interactive shell (ssh host cmd) has no login profile to set
# LD_LIBRARY_PATH. Same as test/testenv.sh.
VOC_BIN_DIR=${VOC_BIN_DIR:-/usr/local/sw/versions/voc/git/bin}
VOC_LIB_DIR=${VOC_LIB_DIR:-$VOC_BIN_DIR/../lib}
LD_LIBRARY_PATH="$VOC_LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH

rm -rf "$BUILD/stage1"
mkdir -p "$BUILD/stage1/obj" "$BUILD/stage1/bin"
# BuildInfo.Mod, the commit `poc -version` names (Phase 13 step 1)
"$ROOT/tools/build-info" "$BUILD/gen"
cd "$BUILD/stage1/obj"
# rtl/llvm from source, not a poc-rtl library (Phase 12 step 2d): the
# stages must not depend on one, and the fixed point compares the output
# for every module
"$STAGE0_POC" -OC -clear-library-path ${BOOTSTRAP_OPT:+-opt "$BOOTSTRAP_OPT"} \
  -import-path "$ROOT/src/front" -import-path "$ROOT/src/back/llvm" \
  -import-path "$ROOT/rtl/llvm" -import-path "$ROOT/src/driver" -import-path "$BUILD/gen" \
  -o "$BUILD/stage1/bin/poc" -build "$ROOT/src/driver/Poc.Mod"
echo "Stage 1: built $BUILD/stage1/bin/poc"
