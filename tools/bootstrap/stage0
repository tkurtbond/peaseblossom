#!/bin/sh
# Stage 0: compile poc's own source with voc, the bootstrap compiler.
# See PLAN.md, "Bootstrap terminology". Run with no arguments from anywhere;
# output lands in build/bin/poc.
#
# Built with voc's -OC (Component Pascal size model) rather than the -O2
# default: this gives poc's own LONGINT variables 8 bytes of real host
# storage instead of 4, needed so Types.Value.intVal (a LONGINT field) can
# hold a full-range HUGEINT constant without silently wrapping. This is a
# codegen flag only - it changes nothing about poc's own source text, so
# it does not conflict with the strict-Oberon2.pdf-syntax constraint on
# poc's bootstrap-era source (see "Constraint" under "Bootstrap
# terminology" in PLAN.md).
#
# Phase 13 steps 4-5: there are two other ways, chosen here first:
# BOOTSTRAP_POC, a poc already built, compiles poc (tools/bootstrap/
# stage0-poc); or clang builds poc from the bootstrap seed, seed/, which a
# release tarball has (stage0-seed): a tarball always builds from its own
# seed, voc or not. In a git checkout the seed is used only without voc,
# so that a seed/ left there (make seed writes build/seed, but an older one
# wrote seed/) cannot build a Stage 0 older than the source unnoticed.
# Otherwise voc.
set -e

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
BUILD="$ROOT/build"
VOC_BIN_DIR=${VOC_BIN_DIR:-/usr/local/sw/versions/voc/git/bin}

if [ -n "$BOOTSTRAP_POC" ]; then
  exec "$ROOT/tools/bootstrap/stage0-poc"
elif [ -d "$ROOT/seed" ] && { [ ! -e "$ROOT/.git" ] || [ ! -x "$VOC_BIN_DIR/voc" ]; }; then
  exec "$ROOT/tools/bootstrap/stage0-seed"
elif [ ! -x "$VOC_BIN_DIR/voc" ]; then
  echo "stage0: no voc in $VOC_BIN_DIR (VOC_BIN_DIR), no seed/ (a release tarball has one)," >&2
  echo "and no BOOTSTRAP_POC (an installed poc): nothing to build poc with" >&2
  exit 1
fi

mkdir -p "$BUILD/bin" "$BUILD/obj"
# Every module is compiled again below, so no symbol file is kept from the
# last build: voc writes a module's .sym only when its interface changes,
# but the .sym also lists the modules it imports, which voc links by - so
# a new import (FormattedOutput's of FormattedText, 2026-10-05) behind an
# unchanged interface left the module out of the link.
rm -f "$BUILD/obj/"*.sym
# BuildInfo.Mod, the commit `poc -version` names (Phase 13 step 1)
"$ROOT/tools/build-info" "$BUILD/gen"
export PATH="$VOC_BIN_DIR:$PATH"

cd "$BUILD/obj"
# Err (Phase 11 D11), which Diagnostics and Poc write their errors through:
# rtl/llvm's own source, over voc's version of the one module that calls the
# operating system
voc -OC -s "$ROOT/rtl/voc/FileDescriptorOutput.Mod"
voc -OC -s "$ROOT/rtl/llvm/RealDigits.Mod"
voc -OC -s "$ROOT/rtl/llvm/FormattedText.Mod"
voc -OC -s "$ROOT/rtl/llvm/FormattedOutput.Mod"
voc -OC -s "$ROOT/rtl/llvm/Err.Mod"
voc -OC -s "$ROOT/src/front/Diagnostics.Mod"
voc -OC -s "$ROOT/src/front/Lexer.Mod"
voc -OC -s "$ROOT/src/front/SyntaxTree.Mod"
voc -OC -s "$ROOT/src/front/Types.Mod"
voc -OC -s "$ROOT/src/front/MemoryLayout.Mod"
voc -OC -s "$ROOT/src/front/SymbolTable.Mod"
voc -OC -s "$ROOT/src/front/DecimalToDouble.Mod"
voc -OC -s "$ROOT/src/front/ConstantEvaluator.Mod"
voc -OC -s "$ROOT/src/front/PredeclaredProcedures.Mod"
voc -OC -s "$ROOT/src/front/ModuleInterface.Mod"
voc -OC -s "$ROOT/src/front/SemanticActions.Mod"
voc -OC -s "$ROOT/src/front/NestedProcedures.Mod"
voc -OC -s "$ROOT/src/front/Parser.Mod"
voc -OC -s "$ROOT/src/back/llvm/LLVMTypes.Mod"
voc -OC -s "$ROOT/src/back/llvm/LLVMCodeGenerator.Mod"
voc -OC -s "$ROOT/src/back/llvm/LLVMToolchainDriver.Mod"
voc -OC -s "$ROOT/src/back/vax/VaxTypes.Mod"
voc -OC -s "$ROOT/src/driver/Version.Mod"
voc -OC -s "$BUILD/gen/BuildInfo.Mod"
voc -OC -s "$ROOT/src/driver/Libraries.Mod"
# voc's collector misses a pointer held only in a callee-saved register
# (doc/developer/bootstrapping-with-voc.md): poc is linked with a Heap_GC
# that stores them on the stack first, then calls libvoc's. voc adds
# LDFLAGS to its link command, ahead of libvoc; dlsym is in libdl on Linux.
${CC:-cc} -fPIC -c "$ROOT/tools/bootstrap/voc-heap-gc-spill.c" -o voc-heap-gc-spill.o
case $(uname -s) in Linux) spill_libs=-ldl ;; *) spill_libs= ;; esac
LDFLAGS="$BUILD/obj/voc-heap-gc-spill.o $spill_libs${LDFLAGS:+ $LDFLAGS}" \
  voc -OC -m "$ROOT/src/driver/Poc.Mod"
if ! nm Poc | grep -q ' T Heap_GC$'; then
  echo "stage0: poc was linked without voc-heap-gc-spill.o's Heap_GC" >&2
  exit 1
fi

cp Poc "$BUILD/bin/poc"
echo "Stage 0: built $BUILD/bin/poc"
