#!/bin/sh
# Regenerates the tables of doc/research/voc-module-inventory.md (PLAN.md Phase 12
# step 3): reads voc's module sources and install, checks each library and
# runtime module with poc, and replaces everything after the document's
# marker line. Its prose (sources and method, what voc ships, the findings)
# is written by hand and left alone: reread it against the new tables.
#
# Run from anywhere, after `make build` (it uses build/bin/poc and the
# poc-rtl interfaces make built for this host). Needs python3. Environment:
# VOC_SOURCE (voc's source clone) and VOC_INSTALL (its install) override the
# paths AGENTS.md gives.
#
# The check: each module through `poc -O2 -emit-interface`, in import order
# (import_order.py), in a scratch directory holding poc-rtl's .sym files, so
# that voc's Files, Platform, ... are poc's, as a program would get them
# (-emit-interface does not consult the library path). voc's host variants
# (Platformunix as Platform, oocCLP64 as oocC) are linked under their module
# names, since poc finds a module by its file name.
set -e
export PYTHONDONTWRITEBYTECODE=1

HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/../.." && pwd)
VOC_SOURCE=${VOC_SOURCE:-/usr/local/sw/src/lang/Oberon/vishap/compiler}
VOC_INSTALL=${VOC_INSTALL:-/usr/local/sw/versions/voc/git}
POC="$ROOT/build/bin/poc"
RTL_SYMBOLS="$ROOT/build/lib/poc/$(clang -dumpmachine)/O2"
DOCUMENT="$ROOT/doc/research/voc-module-inventory.md"
MARKER='<!-- Generated by tools/voc-inventory/inventory: everything below this line is replaced. -->'

grep -qxF "$MARKER" "$DOCUMENT" || { echo "inventory: no marker line in $DOCUMENT" >&2; exit 1; }
[ -x "$POC" ] && [ -d "$RTL_SYMBOLS" ] || { echo "inventory: run make build first" >&2; exit 1; }

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
cd "$HERE"
python3 extract_modules.py "$VOC_SOURCE" "$VOC_INSTALL" >"$WORK/modules.json"
python3 import_order.py "$WORK/modules.json" >"$WORK/order.txt"

mkdir "$WORK/source" "$WORK/check"
for f in "$VOC_SOURCE"/src/runtime/*.Mod "$VOC_SOURCE"/src/library/*/*.Mod
do
  ln -sf "$f" "$WORK/source/$(basename "$f")"
done
ln -sf "$VOC_SOURCE/src/runtime/Platformunix.Mod" "$WORK/source/Platform.Mod"
ln -sf "$VOC_SOURCE/src/library/ooc/oocCLP64.Mod" "$WORK/source/oocC.Mod"
ln -sf "$VOC_SOURCE/src/library/ooc/oocwrapperlibc.Mod" "$WORK/source/oocwrapperlibc.Mod"
cp "$RTL_SYMBOLS"/*.sym "$WORK/check/"

cd "$WORK/check"
: >status.txt
while read -r name
do
  if [ -f "$RTL_SYMBOLS/$name.sym" ]
  then echo "$name poc" >>status.txt
  elif "$POC" -O2 -import-path . -emit-interface "../source/$name.Mod" >"$name.out" 2>&1
  then echo "$name 0" >>status.txt
  else echo "$name 1" >>status.txt
  fi
done <"$WORK/order.txt"

cd "$HERE"
python3 write_tables.py "$VOC_SOURCE" "$WORK/modules.json" "$WORK/check" >"$WORK/tables.md"
sed -n "1,/^$(printf '%s' "$MARKER" | sed 's/[][\/.*^$]/\\&/g')\$/p" "$DOCUMENT" >"$WORK/document.md"
cat "$WORK/tables.md" >>"$WORK/document.md"
cp "$WORK/document.md" "$DOCUMENT"
echo "inventory: $(grep -c ' 0$' "$WORK/check/status.txt") of $(grep -vc ' poc$' "$WORK/check/status.txt") modules accepted; wrote $DOCUMENT"
