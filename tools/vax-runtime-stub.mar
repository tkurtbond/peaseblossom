; Stand-ins for poc's VAX runtime routines (Phase 16 writes the real ones),
; so that tools/vax-run can link and run a module's MACRO-32 under the
; debugger. doc/developer/vax-macro32-backend.md, sections 7, 8 and 9.
	.TITLE	POCSTUB
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; What the last trap was given, for the debugger to examine after the
; program ends: its code, line and column, and the module's name
	.PSECT	POC_DATA
POC_TRAP_CODE::
	.BLKL	1
POC_TRAP_LINE::
	.BLKL	1
POC_TRAP_COLUMN::
	.BLKL	1
POC_TRAP_MODULE::
	.BLKB	32

; What HALT was given, for the debugger to examine after the program ends
POC_HALT_CODE::
	.BLKL	1

; Room for the debugger's CALLs to pass by reference: a VAR parameter's
; variable or a HUGEINT's copy
POC_SCRATCH::
	.BLKQ	8

	.PSECT	POC_CODE
; POC_TRAP(code, module, line, column), module a counted string: the
; code's low word and the rest kept in POC_TRAP_*; ends with SS$_ABORT
	.ENTRY	POC_TRAP, ^M<R2,R3,R4,R5>
	MOVZWL	4(AP), POC_TRAP_CODE
	MOVL	12(AP), POC_TRAP_LINE
	MOVL	16(AP), POC_TRAP_COLUMN
	MOVL	8(AP), R1
	MOVZBL	(R1)+, R0
	MOVC5	R0, (R1), #0, #32, POC_TRAP_MODULE
	$EXIT_S	#44
	RET

; POC_HALT(code): kept in POC_HALT_CODE, then the program ends with
; SS$_NORMAL (rtl/vax/PocRtl.mar's exits with HALT(n)'s status)
	.ENTRY	POC_HALT, ^M<>
	MOVL	4(AP), POC_HALT_CODE
	$EXIT_S	#1
	RET

; POC_STRCMP(a, alen, b, blen): the strings at a and b, alen and blen
; bytes, compared up to the first 0X or the end of either, a byte past
; the end being 0X; R0 is the difference of the first two bytes that
; differ, unsigned, so less than, equal to or greater than zero as a is
; less than, equal to or greater than b
	.ENTRY	POC_STRCMP, ^M<R2,R3,R4,R5>
	MOVL	4(AP), R1
	MOVL	8(AP), R3
	MOVL	12(AP), R2
	MOVL	16(AP), R4
10$:	CLRL	R0
	TSTL	R3
	BEQL	20$
	MOVZBL	(R1)+, R0
	DECL	R3
20$:	CLRL	R5
	TSTL	R4
	BEQL	30$
	MOVZBL	(R2)+, R5
	DECL	R4
30$:	SUBL2	R5, R0
	BNEQ	40$
	TSTL	R5
	BNEQ	10$
40$:	RET

; POC_HMUL(a, b), a and b the addresses of HUGEINTs: R0 and R1 the
; product's low 64 bits. EMUL multiplies the low longwords as signed; a
; negative one's other operand, added to the high longword, makes that
; unsigned; the cross products go into the high longword too
	.ENTRY	POC_HMUL, ^M<R2,R3,R4>
	MOVL	4(AP), R3
	MOVL	8(AP), R4
	EMUL	(R3), (R4), #0, R0
	TSTL	(R3)
	BGEQ	10$
	ADDL2	(R4), R1
10$:	TSTL	(R4)
	BGEQ	20$
	ADDL2	(R3), R1
20$:	MULL3	(R3), 4(R4), R2
	ADDL2	R2, R1
	MULL3	4(R3), (R4), R2
	ADDL2	R2, R1
	RET

; POC_HDIV(a, b) and POC_HMOD(a, b), a and b the addresses of HUGEINTs:
; R0 and R1 the floored quotient or the remainder (with b's sign); a zero
; b gets the VAX's integer divide-by-zero trap
	.ENTRY	POC_HDIV, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	JSB	HDIVMOD
	RET

	.ENTRY	POC_HMOD, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	JSB	HDIVMOD
	MOVQ	R2, R0
	RET

; a, b as above: R0 and R1 the quotient, R2 and R3 the remainder. The
; magnitudes are divided bit by bit, the quotient's bits shifted in where
; the dividend's leave (R2 and R3), the remainder in R8 and R9; then the
; signs (R10: 1 a negative, 2 b negative) and the floor
HDIVMOD:
	MOVL	4(AP), R0
	MOVQ	(R0), R2
	MOVL	8(AP), R0
	MOVQ	(R0), R4
	BISL3	R4, R5, R0
	BNEQ	5$
	DIVL2	R0, R1
5$:	CLRL	R10
	MOVQ	R4, R6
	TSTL	R3
	BGEQ	10$
	MNEGL	R3, R3
	MNEGL	R2, R2
	SBWC	#0, R3
	BISL2	#1, R10
10$:	TSTL	R7
	BGEQ	20$
	MNEGL	R7, R7
	MNEGL	R6, R6
	SBWC	#0, R7
	BISL2	#2, R10
20$:	CLRQ	R8
	MOVL	#64, R11
30$:	ADDL2	R2, R2
	ADWC	R3, R3
	ADWC	R8, R8
	ADWC	R9, R9
	CMPL	R9, R7
	BGTRU	40$
	BLSSU	50$
	CMPL	R8, R6
	BLSSU	50$
40$:	SUBL2	R6, R8
	SBWC	R7, R9
	BISL2	#1, R2
50$:	SOBGTR	R11, 30$
	BLBC	R10, 60$
	MNEGL	R9, R9
	MNEGL	R8, R8
	SBWC	#0, R9
60$:	CMPL	R10, #1
	BEQL	70$
	CMPL	R10, #2
	BNEQ	90$
70$:	MNEGL	R3, R3
	MNEGL	R2, R2
	SBWC	#0, R3
	BISL3	R8, R9, R0
	BEQL	90$
	SUBL2	#1, R2
	SBWC	#0, R3
	ADDL2	R4, R8
	ADWC	R5, R9
90$:	MOVQ	R2, R0
	MOVQ	R8, R2
	RSB

; POC_QTOG(q), q the address of a quadword: R0 and R1 its value as a
; G_floating (design section 14, item 9), which no VAX instruction
; converts a quadword to. The high longword, signed, times 2^32, and the
; low one, unsigned, are each exact; their sum is rounded once, as the
; VAX rounds
	.ENTRY	POC_QTOG, ^M<R2,R3,R4>
	MOVL	4(AP), R4
	CVTLG	4(R4), R0
	MULG2	#4294967296.0, R0
	CVTLG	(R4), R2
	BGEQ	10$
	ADDG2	#4294967296.0, R2
10$:	ADDG2	R2, R0
	RET

; POC_ENTIERQ(x), x the address of a G_floating in [-2^63, 2^63), which
; the caller has checked: R0 and R1 ENTIER(x), the largest quadword not
; greater than x (design section 14, item 9). An x within a longword's
; range is floored by CVTGL, which truncates, then 1 less when converting
; that back gives more than x, then sign-extended. A larger x has no bit
; below 2^-21, so that hi = floor(x / 2^32), floored as above, and
; f = x - hi * 2^32, in [0, 2^32), are exact; the low longword is f's
; floor, its truncation: CVTGL of f - 2^31 (exact, f being at least
; 2^31) with bit 31 set, or of f
	.ENTRY	POC_ENTIERQ, ^M<R2,R3,R4,R5>
	MOVG	@4(AP), R2
	CMPG	R2, #-2147483648.0
	BLSS	20$
	CMPG	R2, #2147483648.0
	BGEQ	20$
	CVTGL	R2, R0
	CVTLG	R0, R4
	CMPG	R4, R2
	BLEQ	10$
	DECL	R0
10$:	ASHL	#-31, R0, R1
	RET
20$:	DIVG2	#4294967296.0, R2
	CVTGL	R2, R1
	CVTLG	R1, R4
	CMPG	R4, R2
	BLEQ	30$
	DECL	R1
30$:	CVTLG	R1, R2
	MULG2	#4294967296.0, R2
	SUBG3	R2, @4(AP), R2
	CMPG	R2, #2147483648.0
	BLSS	40$
	SUBG2	#2147483648.0, R2
	CVTGL	R2, R0
	BISL2	#^X80000000, R0
	RET
40$:	CVTGL	R2, R0
	RET

; NEW's allocator, rtl/vax's GarbageCollectedHeap.Allocate(size, tag)
; by its symbol (design section 15, proposal 9), a stand-in that never
; collects: a block of a tag longword and size bytes from LIB$GET_VM, tag
; stored and the bytes cleared, since LIB$GET_VM does not clear them and
; every variable starts at zero (MOVC5 in pieces of at most 65535); R0
; the address past the tag, or 0, NIL, when there is no memory. The
; collector's initializer and SetStackBase, which a program that
; allocates calls from its start, do nothing here, nor does POC_ROOTS,
; which a module whose variables hold pointers calls
	.ENTRY	GARBAGECOLLECTEDHEAP_A_A8NV38EI, ^M<R2,R3,R4,R5,R6,R7>
	SUBL2	#8, SP
	ADDL3	#4, 4(AP), -8(FP)
	PUSHAL	-4(FP)
	PUSHAL	-8(FP)
	CALLS	#2, G^LIB$GET_VM
	BLBS	R0, 10$
	CLRL	R0
	RET
10$:	MOVL	-4(FP), R1
	MOVL	8(AP), (R1)
	MOVL	4(AP), R6
	ADDL3	#4, R1, R3
20$:	TSTL	R6
	BEQL	30$
	MOVL	R6, R7
	CMPL	R7, #65535
	BLEQU	25$
	MOVL	#65535, R7
25$:	SUBL2	R7, R6
	MOVC5	#0, (R3), #0, R7, (R3)
	BRB	20$
30$:	ADDL3	#4, -4(FP), R0
	RET

	.ENTRY	GARBAGECOLLECTEDHEAP_INIT, ^M<>
	RET

	.ENTRY	GARBAGECOLLECTEDHEAP_S_EA118OLO, ^M<>
	RET

	.ENTRY	POC_ROOTS, ^M<>
	RET

; Out's and Err's lines, and Platform's and Modules' services, as
; rtl/vax/PocRtl.mar has them (design section 15), so that a program
; using rtl/vax runs under the debugger as it does without it
	$DSCDEF
	$JPIDEF
	$LNMDEF

; a fixed-length string descriptor of the length bytes at text, made on
; the stack, its address in R1
	.MACRO	POC_DESCRIBE	TEXT, LENGTH
	SUBL2	#8, SP
	MOVW	LENGTH, DSC$W_LENGTH(SP)
	MOVB	#DSC$K_DTYPE_T, DSC$B_DTYPE(SP)
	MOVB	#DSC$K_CLASS_S, DSC$B_CLASS(SP)
	MOVL	TEXT, DSC$A_POINTER(SP)
	MOVL	SP, R1
	.ENDM	POC_DESCRIBE

	.PSECT	POC_DATA
; SYS$ERROR, written one record at a time; POC_ERR_IS_OPEN is 1 once
; POC_ERR_OPEN has opened it
POC_ERR_IS_OPEN:
	.BLKL	1
POC_ERR_FAB:
	$FAB	FNM=<SYS$ERROR>, FAC=<PUT>, RFM=VAR, RAT=<CR>
POC_ERR_RAB:
	$RAB	FAB=POC_ERR_FAB

	.PSECT	POC_CODE
; POC_ERR_OPEN: SYS$ERROR opened, the first time; R0 the status. It
; stays open, and RMS closes it when the image exits
	.ENTRY	POC_ERR_OPEN, ^M<>
	MOVL	#1, R0
	TSTL	POC_ERR_IS_OPEN
	BNEQ	10$
	$CREATE	FAB=POC_ERR_FAB
	BLBC	R0, 10$
	$CONNECT	RAB=POC_ERR_RAB
	BLBS	R0, 5$
	PUSHL	R0
	$CLOSE	FAB=POC_ERR_FAB
	POPL	R0
	RET
5$:	MOVL	#1, POC_ERR_IS_OPEN
10$:	RET

; Out's and Err's lines (rtl/vax/LineOutput.Mod; design section 14, item
; 2, and section 15, proposal 8). Each is kept until Ln, since a record
; is written whole.

	.PSECT	POC_DATA
; the two lines and their lengths, Out's then Err's, for the exit handler
POC_LINES:
	.BLKL	4
; the exit handler's control block: forward link, handler, one argument,
; the address of the exit status
POC_LINES_EXIT_BLOCK:
	.LONG	0
	.ADDRESS	POC_LINES_EXIT
	.LONG	1
	.ADDRESS	POC_LINES_EXIT_STATUS
POC_LINES_EXIT_STATUS:
	.BLKL	1

	.PSECT	POC_CODE
; POC_PUT_LINE(text, length): the length bytes at text written to
; SYS$OUTPUT as one record by LIB$PUT_OUTPUT, through a fixed-length string
; descriptor made on the stack; R0 LIB$PUT_OUTPUT's status
	.ENTRY	POC_PUT_LINE, ^M<>
	SUBL2	#8, SP
	MOVW	8(AP), (SP)
	MOVB	#DSC$K_DTYPE_T, DSC$B_DTYPE(SP)
	MOVB	#DSC$K_CLASS_S, DSC$B_CLASS(SP)
	MOVL	4(AP), DSC$A_POINTER(SP)
	MOVL	SP, R0
	PUSHL	R0
	CALLS	#1, G^LIB$PUT_OUTPUT
	RET

; POC_PUT_ERROR_LINE(text, length): the same written to SYS$ERROR, by
; RMS as POC_TRAP writes; R0 the status
	.ENTRY	POC_PUT_ERROR_LINE, ^M<>
	CALLS	#0, POC_ERR_OPEN
	BLBC	R0, 10$
	MOVW	8(AP), POC_ERR_RAB+RAB$W_RSZ
	MOVL	4(AP), POC_ERR_RAB+RAB$L_RBF
	$PUT	RAB=POC_ERR_RAB
10$:	RET

; POC_LINES_REGISTER(outText, outLength, errText, errLength): Out's and
; Err's lines and their lengths, LONGINTs whose low longwords are the
; counts, under -O2 or -OC; kept for POC_LINES_EXIT, which is declared an
; exit handler, so that a line the program has not ended with Ln when it
; ends is written still, as a record of its own: Out's, then Err's
	.ENTRY	POC_LINES_REGISTER, ^M<>
	MOVQ	4(AP), POC_LINES
	MOVQ	12(AP), POC_LINES+8
	$DCLEXH_S	DESBLK=POC_LINES_EXIT_BLOCK
	RET

	.ENTRY	POC_LINES_EXIT, ^M<R2>
	MOVL	POC_LINES+4, R2
	TSTL	(R2)
	BEQL	10$
	PUSHL	(R2)
	PUSHL	POC_LINES
	CALLS	#2, POC_PUT_LINE
	CLRL	(R2)
10$:	MOVL	POC_LINES+12, R2
	TSTL	(R2)
	BEQL	20$
	PUSHL	(R2)
	PUSHL	POC_LINES+8
	CALLS	#2, POC_PUT_ERROR_LINE
	CLRL	(R2)
20$:	RET

; Platform's and Modules' services (rtl/vax/Platform.Mod and Modules.Mod;
; design section 15, proposals 3 to 8). A name is passed as its address
; and its length, a buffer to fill as its address and its size; a routine
; that fills one returns the length it wrote in R0.

	.PSECT	POC_CONST
; the tables a file name's logical names are looked up in: the process's,
; the job's, the group's and the system's
POC_FILE_DEV:
	.ASCID	/LNM$FILE_DEV/
POC_CASE_BLIND:
	.LONG	LNM$M_CASE_BLIND

	.PSECT	POC_DATA
; $TRNLNM's item list: the index of the equivalence string wanted, the
; string and its length, and the largest index there is
POC_LNM_INDEX:
	.BLKL	1
POC_LNM_LENGTH:
	.BLKW	1
POC_LNM_MAX:
	.BLKL	1
POC_LNM_ITEMS:
	.WORD	4, LNM$_INDEX
	.ADDRESS	POC_LNM_INDEX
	.LONG	0
POC_LNM_STRING:
	.WORD	0, LNM$_STRING
	.LONG	0
	.ADDRESS	POC_LNM_LENGTH
	.WORD	4, LNM$_MAX_INDEX
	.ADDRESS	POC_LNM_MAX
	.LONG	0
	.LONG	0
; $GETJPI's item lists: the process's identification, and the image's
; file specification and its length
POC_JPI_PID:
	.BLKL	1
POC_JPI_PID_ITEMS:
	.WORD	4, JPI$_PID
	.ADDRESS	POC_JPI_PID
	.LONG	0
	.LONG	0
POC_JPI_LENGTH:
	.BLKW	1
POC_JPI_IMAGE_ITEMS:
	.WORD	0, JPI$_IMAGNAME
	.LONG	0
	.ADDRESS	POC_JPI_LENGTH
	.LONG	0
; the file a name is erased, or parsed, as: one FAB and NAM serve every
; $PARSE, so that each releases what the last one kept (RMS, $PARSE)
POC_NAME_FAB:
	$FAB	NAM=POC_NAME_NAM
POC_NAME_NAM:
	$NAM	ESA=POC_NAME_EXPANDED, ESS=NAM$C_MAXRSS
POC_NAME_EXPANDED:
	.BLKB	NAM$C_MAXRSS

	.PSECT	POC_CODE
; POC_TRNLNM(name, length, index, value, size): the equivalence string
; at index of the logical name in LNM$FILE_DEV, ignoring case, in value;
; R0 its length, or -1 when there is no such name or no string at index
	.ENTRY	POC_TRNLNM, ^M<>
	MOVL	12(AP), POC_LNM_INDEX
	MOVW	20(AP), POC_LNM_STRING
	MOVL	16(AP), POC_LNM_STRING+4
	CLRW	POC_LNM_LENGTH
	MNEGL	#1, POC_LNM_MAX
	POC_DESCRIBE	4(AP), 8(AP)
	PUSHAL	POC_LNM_ITEMS
	CLRL	-(SP)
	PUSHL	R1
	PUSHAQ	POC_FILE_DEV
	PUSHAL	POC_CASE_BLIND
	CALLS	#5, G^SYS$TRNLNM
	BLBC	R0, 10$
	CMPL	12(AP), POC_LNM_MAX
	BGTR	10$
	MOVZWL	POC_LNM_LENGTH, R0
	RET
10$:	MNEGL	#1, R0
	RET

; POC_ERASE(name, length): the file deleted, the highest version when
; the name gives none; R0 RMS's status
	.ENTRY	POC_ERASE, ^M<>
	MOVL	4(AP), POC_NAME_FAB+FAB$L_FNA
	MOVB	8(AP), POC_NAME_FAB+FAB$B_FNS
	$ERASE	FAB=POC_NAME_FAB
	RET

; POC_PARSE(name, length): the name parsed, which looks its directory up;
; R0 RMS's status, RMS$_DNF if there is no such directory
	.ENTRY	POC_PARSE, ^M<>
	MOVL	4(AP), POC_NAME_FAB+FAB$L_FNA
	MOVB	8(AP), POC_NAME_FAB+FAB$B_FNS
	$PARSE	FAB=POC_NAME_FAB
	RET

; POC_CREATE_DIRECTORY(name, length): the directory made, and those it is
; in that are missing, by LIB$CREATE_DIR; R0 its status, SS$_CREATED or
; SS$_NORMAL (all of them there already) when it succeeds
	.ENTRY	POC_CREATE_DIRECTORY, ^M<>
	POC_DESCRIBE	4(AP), 8(AP)
	PUSHL	R1
	CALLS	#1, G^LIB$CREATE_DIR
	RET

; POC_DEFAULT_DIRECTORY(value, size): the process's default directory, as
; $SETDDIR reads it, in value; R0 its length, 0 if it cannot be read
	.ENTRY	POC_DEFAULT_DIRECTORY, ^M<>
	CLRL	-(SP)
	POC_DESCRIBE	4(AP), 8(AP)
	PUSHL	R1
	PUSHAW	-4(FP)
	CLRL	-(SP)
	CALLS	#3, G^SYS$SETDDIR
	BLBC	R0, 10$
	MOVZWL	-4(FP), R0
	RET
10$:	CLRL	R0
	RET

; POC_PROCESS_ID(): R0 the process's identification, 0 if $GETJPI fails
	.ENTRY	POC_PROCESS_ID, ^M<>
	CLRL	POC_JPI_PID
	$GETJPIW_S	ITMLST=POC_JPI_PID_ITEMS
	MOVL	POC_JPI_PID, R0
	RET

; POC_IMAGE_NAME(value, size): the file specification of the image
; running in value; R0 its length, 0 if $GETJPI fails
	.ENTRY	POC_IMAGE_NAME, ^M<>
	MOVW	8(AP), POC_JPI_IMAGE_ITEMS
	MOVL	4(AP), POC_JPI_IMAGE_ITEMS+4
	CLRW	POC_JPI_LENGTH
	$GETJPIW_S	ITMLST=POC_JPI_IMAGE_ITEMS
	BLBC	R0, 10$
	MOVZWL	POC_JPI_LENGTH, R0
	RET
10$:	CLRL	R0
	RET

; POC_FOREIGN(value, size): the command line after a foreign command, as
; LIB$GET_FOREIGN gives it, without prompting, in value; R0 its length,
; 0 when there is none
	.ENTRY	POC_FOREIGN, ^M<>
	CLRL	-(SP)
	POC_DESCRIBE	4(AP), 8(AP)
	PUSHAW	-4(FP)
	CLRL	-(SP)
	PUSHL	R1
	CALLS	#3, G^LIB$GET_FOREIGN
	BLBC	R0, 10$
	MOVZWL	-4(FP), R0
	RET
10$:	CLRL	R0
	RET

	.END
