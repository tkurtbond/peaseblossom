#!/bin/sh
# Runs a program's MACRO-32 on the VAX/VMS development system under the
# debugger, to check what it does, not only that it assembles (the design,
# doc/developer/vax-macro32-backend.md, section 10). The main module, the
# first .mar, and its imports, any others, are linked with
# tools/vax-runtime-stub.mar, stand-ins for poc's runtime routines, the
# main module first, so that the image starts at its <MODULE>_MAIN, the
# program's start (section 6). Each <run>.dbg is one run: debugger
# commands, after SET RADIX DECIMAL and SET MODULE/ALL, which typically
# DEPOSIT the inputs, GO, and EXAMINE what the program left (the stub's
# POC_TRAP_* say what a trap was given). The debugger's output comes back
# as <run>.out beside it, from its first line after "%DEBUG-I-INITIAL".
# Copying is by FTP (active, ASCII), the session by telnet
# (tools/vax-run.exp), as tools/vax-assemble does; the copies on the guest
# are deleted. The copies there, the copies back and the deletions are
# one FTP session each, a login on the guest. Exits 0 if everything
# assembled, linked and ran, 1 if a step failed (its messages are
# printed), 2 if the guest could not be used.
#
#   tools/vax-run <main.mar> [<import.mar>...] <run.dbg>...
#
# Each module's .TITLE names its file on the guest, so a .mar may be a
# fixture's expected-vax.mar.
#
# Runs share POC's home directory with each other and with
# tools/vax-assemble, so each holds this host's lock while it uses the
# guest (tools/vax-lock.sh). VAX_HOST names the guest (default
# 192.168.2.20).
set -e

host=${VAX_HOST:-192.168.2.20}
here=$(cd "$(dirname "$0")" && pwd)
# the guest's login and password, in netrc form: VAX_NETRC, or else
# ~/.netrc-poc-vax, kept apart from ~/.netrc, which other machines use
VAX_NETRC=${VAX_NETRC:-$HOME/.netrc-poc-vax}
export VAX_NETRC
. "$here/vax-lock.sh"

usage() { echo "usage: tools/vax-run <main.mar> [<import.mar>...] <run.dbg>..." >&2; exit 2; }

# the modules, each as "<file> <MODULE>", the main one first; then the runs
mars=; modules=
while [ $# -gt 0 ]; do
  case $1 in *.mar|*.MAR) ;; *) break ;; esac
  [ -r "$1" ] || { echo "vax-run: cannot read $1" >&2; exit 2; }
  # a module's name, its .TITLE, is its file's name on the guest
  module=$(sed -n 's/^	\.TITLE	\([A-Z0-9_$]*\)$/\1/p' "$1")
  case $module in
    *[!A-Z0-9_\$]*|""|POCSTUB) echo "vax-run: no .TITLE it can use in $1" >&2; exit 2 ;;
  esac
  mars="$mars $1"; modules="$modules $module"
  shift
done
[ -n "$modules" ] && [ $# -gt 0 ] || usage
main=${mars# }; main=${main%% *}
grep -q '^	\.END	[A-Z0-9_$]*_MAIN$' "$main" || { echo "vax-run: no program's start (.END <MODULE>_MAIN) in $main" >&2; exit 2; }

ftp="ftp://$host/"
curl_ftp() { curl -s -S --netrc-file "$VAX_NETRC" -P - --retry 3 --retry-delay 2 "$@"; }
work=$(mktemp -d "${TMPDIR:-/tmp}/vax-run.XXXXXX")
# every version of each of this run's files deleted, in one session ("*": a
# file that is not there is no failure)
cleanup() {
  rm -rf "$work"
  set --
  for m in $modules POCSTUB; do
    set -- "$@" -Q "*DELE $m.MAR;*" -Q "*DELE $m.OBJ;*"
  done
  set -- "$@" -Q "*DELE POCRUN.EXE;*"
  i=1
  while [ $i -le "$runs" ]; do
    set -- "$@" -Q "*DELE R$i.DBG;*" -Q "*DELE R$i.OUT;*"
    i=$((i + 1))
  done
  curl -s --netrc-file "$VAX_NETRC" -P - --retry 3 --retry-delay 2 "$@" "$ftp" -o /dev/null 2>/dev/null || true
}
runs=$#
# only once this run has the lock may it, or its cleanup, touch the guest
# (a guest busy with another run can be slow to answer)
vax_lock
trap 'rm -rf "$work"; vax_unlock' EXIT
"$here/vax-assemble" -available || { echo "vax-run: the VAX guest $host is not available" >&2; exit 2; }
trap 'cleanup; vax_unlock' EXIT

i=1
for dbg in "$@"; do
  [ -r "$dbg" ] || { echo "vax-run: cannot read $dbg" >&2; exit 2; }
  { echo "SET RADIX DECIMAL"; echo "SET MODULE/ALL"; cat "$dbg"; } >"$work/R$i.DBG"
  i=$((i + 1))
done
# everything copied to the guest in one session
upload() {
  set -- -T "$here/vax-runtime-stub.mar" "${ftp}POCSTUB.MAR"
  ms=$modules
  for f in $mars; do
    m=${ms# }; m=${m%% *}; ms=${ms# }; ms=${ms#"$m"}
    set -- "$@" -T "$f" "$ftp$m.MAR"
  done
  i=1
  while [ $i -le "$runs" ]; do
    set -- "$@" -T "$work/R$i.DBG" "${ftp}R$i.DBG"
    i=$((i + 1))
  done
  curl_ftp --use-ascii "$@"
}
upload

session=0
# shellcheck disable=SC2086
expect -f "$here/vax-run.exp" "$host" "$runs" $modules >"$work/session" || session=$?
[ "$session" -eq 0 ] || exit 2

# every step's $STATUS a success, or what the steps said; not a run's,
# which is the program's own (a trap's SS$_ABORT), in its debugger output
if grep '^VAXRUN-STATUS ' "$work/session" | awk '$2 !~ /^R[0-9]+$/ { s = substr($3, 8, 1); if (s != "1" && s != "3" && s != "9" && s != "B") bad = 1 } END { exit bad }'; then
  :
else
  cat "$work/session"
  exit 1
fi

# every run's debugger output brought back in one session
download() {
  set --
  i=1
  while [ $i -le "$runs" ]; do
    set -- "$@" -o "$work/R$i.OUT" "${ftp}R$i.OUT"
    i=$((i + 1))
  done
  curl_ftp --use-ascii "$@"
}
download
i=1
for dbg in "$@"; do
  sed '1,/^%DEBUG-I-INITIAL/d' "$work/R$i.OUT" >"${dbg%.dbg}.out"
  i=$((i + 1))
done
exit 0
