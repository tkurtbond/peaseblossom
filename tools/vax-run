#!/bin/sh
# Runs a module's MACRO-32 on the VAX/VMS development system under the
# debugger, to check what it does, not only that it assembles (the design,
# doc/developer/vax-macro32-backend.md, section 10). The module is linked
# with tools/vax-runtime-stub.mar, stand-ins for poc's runtime routines,
# and a driver, written here, that calls its <MODULE>_INIT and returns
# SS$_NORMAL. Each <run>.dbg is one run: debugger commands, after SET RADIX
# DECIMAL and SET MODULE/ALL, which typically DEPOSIT the inputs, GO, and
# EXAMINE what the module left (the stub's POC_TRAP_* say what a trap was
# given). The debugger's output comes back as <run>.out beside it, from its
# first line after "%DEBUG-I-INITIAL". Copying is by FTP (active, ASCII),
# the session by telnet (tools/vax-run.exp), as tools/vax-assemble does; the
# copies on the guest are deleted. Exits 0 if everything assembled, linked
# and ran, 1 if a step failed (its messages are printed), 2 if the guest
# could not be used.
#
#   tools/vax-run <file.mar> <run.dbg>...
#
# The module's .TITLE names its file on the guest, so <file.mar> may be a
# fixture's expected-vax.mar.
#
# Runs share POC's home directory with each other and with
# tools/vax-assemble, so each holds this host's lock while it uses the
# guest (tools/vax-lock.sh). VAX_HOST names the guest (default
# 192.168.2.20).
set -e

host=${VAX_HOST:-192.168.2.20}
here=$(cd "$(dirname "$0")" && pwd)
# the guest's login and password, in netrc form: VAX_NETRC, or else
# ~/.netrc-poc-vax, kept apart from ~/.netrc, which other machines use
VAX_NETRC=${VAX_NETRC:-$HOME/.netrc-poc-vax}
export VAX_NETRC
. "$here/vax-lock.sh"

[ $# -ge 2 ] || { echo "usage: tools/vax-run <file.mar> <run.dbg>..." >&2; exit 2; }
"$here/vax-assemble" -available || { echo "vax-run: the VAX guest $host is not available" >&2; exit 2; }

mar=$1; shift
[ -r "$mar" ] || { echo "vax-run: cannot read $mar" >&2; exit 2; }
# the module's name, its .TITLE, is its file's name on the guest
module=$(sed -n 's/^	\.TITLE	\([A-Z0-9_$]*\)$/\1/p' "$mar")
case $module in
  *[!A-Z0-9_\$]*|""|POCSTUB|POCDRIVER) echo "vax-run: no .TITLE it can use in $mar" >&2; exit 2 ;;
esac
init=$(sed -n 's/^	\.ENTRY	\([A-Z0-9_$]*_INIT\),.*/\1/p' "$mar")
[ -n "$init" ] || { echo "vax-run: no <MODULE>_INIT in $mar" >&2; exit 2; }

ftp="ftp://$host/"
curl_ftp() { curl -s -S --netrc-file "$VAX_NETRC" -P - --retry 3 --retry-delay 2 "$@"; }
work=$(mktemp -d "${TMPDIR:-/tmp}/vax-run.XXXXXX")
cleanup() {
  rm -rf "$work"
  for f in "$module.MAR" "$module.OBJ" POCSTUB.MAR POCSTUB.OBJ POCDRIVER.MAR POCDRIVER.OBJ POCRUN.EXE; do
    curl -s --netrc-file "$VAX_NETRC" -P - -Q "DELE $f;*" "$ftp" -o /dev/null 2>/dev/null || true
  done
  i=1
  while [ $i -le "$runs" ]; do
    for ext in DBG OUT; do
      curl -s --netrc-file "$VAX_NETRC" -P - -Q "DELE R$i.$ext;*" "$ftp" -o /dev/null 2>/dev/null || true
    done
    i=$((i + 1))
  done
}
runs=$#
# only once this run has the lock may its cleanup touch the guest
vax_lock
trap 'cleanup; vax_unlock' EXIT

cat >"$work/POCDRIVER.MAR" <<EOF
; Runs one module's initializer, for tools/vax-run
	.TITLE	POCDRIVER
	.EXTERNAL	$init
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.ENTRY	POC_DRIVER, ^M<>
	CALLS	#0, $init
	MOVL	#1, R0
	RET
	.END	POC_DRIVER
EOF
curl_ftp --use-ascii -T "$mar" "$ftp$module.MAR"
curl_ftp --use-ascii -T "$here/vax-runtime-stub.mar" "${ftp}POCSTUB.MAR"
curl_ftp --use-ascii -T "$work/POCDRIVER.MAR" "${ftp}POCDRIVER.MAR"
i=1
for dbg in "$@"; do
  [ -r "$dbg" ] || { echo "vax-run: cannot read $dbg" >&2; exit 2; }
  { echo "SET RADIX DECIMAL"; echo "SET MODULE/ALL"; cat "$dbg"; } >"$work/R$i.DBG"
  curl_ftp --use-ascii -T "$work/R$i.DBG" "${ftp}R$i.DBG"
  i=$((i + 1))
done

session=0
expect -f "$here/vax-run.exp" "$host" "$module" "$runs" >"$work/session" || session=$?
[ "$session" -eq 0 ] || exit 2

# every step's $STATUS a success, or what the steps said; not a run's,
# which is the program's own (a trap's SS$_ABORT), in its debugger output
if grep '^VAXRUN-STATUS ' "$work/session" | awk '$2 !~ /^R[0-9]+$/ { s = substr($3, 8, 1); if (s != "1" && s != "3" && s != "9" && s != "B") bad = 1 } END { exit bad }'; then
  :
else
  cat "$work/session"
  exit 1
fi

i=1
for dbg in "$@"; do
  out="${dbg%.dbg}.out"
  curl_ftp --use-ascii -o "$work/R$i.OUT" "${ftp}R$i.OUT"
  sed '1,/^%DEBUG-I-INITIAL/d' "$work/R$i.OUT" >"$out"
  i=$((i + 1))
done
exit 0
