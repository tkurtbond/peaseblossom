*~
.DS_Store
.\#*
.\#*
.~
.~*\#
\#*\#

# Python's bytecode cache, from running tools/voc-inventory
__pycache__/

# Generated by conformance tests (voc/poc build output; see test/testenv.sh)
test/conformance/**/*.c
# a fixture's own C source (Phase 12 step 5a: a module's part in C)
!test/conformance/llvm-c-part/part/Twice.c
!test/conformance/poc-c-flag/part/Hash.c
!test/conformance/llvm-cxx-part/native/native.c
!test/conformance/llvm-cxx-part/both/Both.c
!test/conformance/llvm-object-reuse/src/A.c
!test/conformance/llvm-system-val-external/part/Compare.c
test/conformance/**/*.h
# a fixture's own C header (Phase 13 step 2: -c-flag)
!test/conformance/poc-c-flag/include/fnv.h
!test/conformance/llvm-object-reuse/src/a.h
test/conformance/**/*.sym
test/conformance/**/*.o
# a C or C++ part's dependencies and stamp (poc's clang -MD)
test/conformance/**/*.o.d
test/conformance/**/*.ll
# a Files.New file that was never registered (poc's or voc's runtime)
test/conformance/**/.tmp.*
test/conformance/**/*.s
test/conformance/**/*.mar
# a VAX fixture's expected MACRO-32, reviewed (doc/developer/vax-macro32-backend.md, section 10),
# and its imports'
!test/conformance/**/expected-vax.mar
!test/conformance/**/expected-vax-*.mar
# a hand-written MACRO-32 source (PLAN.md Phase 16 step 2)
!test/conformance/**/hand-*.mar
# an object's image (poc -emit-vax-image, tools/vax-image), but not a VAX
# fixture's expected ones, made by MACRO (doc/developer/vax-object-language.md,
# section 14.5)
test/conformance/**/*.image
!test/conformance/**/expected-vax.image
!test/conformance/**/expected-vax-*.image
# an object poc writes (-emit-vax-object), but not vax-image-reader's, which
# is MACRO's records in the counted form
test/conformance/**/*.obj
!test/conformance/vax-image-reader/objset2.obj
# vax-object-records's printed records, but not the expected ones
test/conformance/vax-object-records/Vax*.records
test/conformance/vax-traceback/VaxTrace.records
test/conformance/vax-traceback/VaxTrace-g.records
test/conformance/vax-debug-records/VaxDebug.records
test/conformance/vax-debug-records/VaxDebug-g.records
test/conformance/vax-debug-records/VaxDebugTypes-g.records
# a build procedure poc writes for the VAX, but not the expected ones or a
# fixture's own procedures for the guest (Phase 16 step 2)
test/conformance/**/*.com
!test/conformance/**/expected-*.com
!test/conformance/**/guest-*.com
# vax-vmsdef's procedure for the guest, which assembles its listings
!test/conformance/vax-vmsdef/mlb-listings.com
test/conformance/**/result
# vax-files-riders' copies of llvm-files-riders' sources, and what it expects
test/conformance/vax-files-riders/*.mod
test/conformance/vax-files-riders/guest.expected
# vax-texts' and vax-oberon's renamed copies of llvm-texts' and
# llvm-oberon's programs, the host build vax-texts compares with, and what
# they expect
test/conformance/vax-texts/TextsUse.mod
test/conformance/vax-texts/host/
test/conformance/doc-vax-guide/work/
test/conformance/vax-texts/texts.expected
test/conformance/vax-oberon/OberonUse.mod
test/conformance/vax-oberon/beyond.mod
test/conformance/vax-oberon/oberon.expected
