;; Reviewed 2026-10-10 by the user (written by Claude, from
;; design section 15, rtl/llvm/GarbageCollectedHeap.Mod, the LIB$
;; and System Services manuals and the guest runs). Why this is
;; right:
;; - rtl/llvm's collector, its procedures and their order unchanged,
;;   compiled with SYSTEM.ADDRESS a longword: word, which the body sets
;;   to 4, and every address and size a longword.
;; - What it takes from the system comes from rtl/vax/PocRtl.mar, by
;;   ["VMS"] externals called with CALLG, each argument a longword:
;;   POC_GET_MEMORY(bytes) for calloc, CAllocate multiplying count by
;;   size (MULL3); POC_FREE_MEMORY(address, bytes) for free, CFree given
;;   a table's old size, its capacity read before it is replaced, or a
;;   chunk's bytes + 16; POC_ROOT_TABLES for ModuleTable,
;;   MarkFromModuleTables reading each table's link at 0, its count at 4
;;   and the address of each pointer at 8 + 4i, then the pointer there
;;   (GetWord twice); POC_PAGE_FILE_LEFT for the ceiling.
;; - SYSTEM.GET and SYSTEM.PUT move the address to R0, then MOVL or, for
;;   a CHAR, MOVB between (R0) and the variable; GetByte's result is
;;   zero-extended (MOVZBL). SYSTEM.ADR(marker) is MOVAB -4(FP),
;;   MarkFromStack's and FinalizeAtExit's local. SYSTEM.VAL between
;;   SYSTEM.PTR and SYSTEM.ADDRESS is a longword moved as it is.
;; - Collect passes MarkFromStack, its local label's address (MOVAB), to
;;   POC_SAVE_REGISTERS, whose entry mask saves R2-R11 in a frame
;;   between the scan's start and the base before it calls
;;   MarkFromStack. RegisterFinalizer passes FinalizeAtExit to
;;   POC_AT_EXIT once, as $DCLEXH's handler. A finalizer is called
;;   through its procedure value (FinalizeLast: CALLG list, (R2)),
;;   checked for NIL first (trap 4).
;; - DIV and MOD floor, as everywhere: DIVL3, then the correction when
;;   the remainder's sign differs from the divisor's.
;; - The body sets word to 4, orderBias to ^X80000000 by doubling 1
;;   until it is not positive (MULL2 wraps, the IV bit clear in the
;;   mask), heapLimit to three quarters of POC_PAGE_FILE_LEFT's bytes
;;   (DIVL3 #4, then MULL3 #3), or 1 GB when that is 0, chunkBytes to
;;   256 KB and the mark stack to 16384 entries.
;; - Under -O2 an INTEGER is a word (ChunkField's field, CVTWL 8(AP))
;;   and collections a longword; under -OC, not written here, they are a
;;   longword and a quadword.
;; - On the guest (test.sh), CollectOut, built with -O2 and -OC, prints
;;   output.expected, as the LLVM backend's does: 40 MB allocated with a
;;   heap under 2 MB; lists held by a module variable, a local and an
;;   array of pointers whole, after a mark stack of four entries
;;   overflows; ten finalizers run; NEW giving NIL under a ceiling, and
;;   allocating again once the list is dropped. HeapCeiling's heap stops
;;   between half and three quarters of the paging file quota left.
; GarbageCollectedHeap, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	GARBAGECOLLECTEDHEAP
	.IDENT	/6a025ae7dc390cf3/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
