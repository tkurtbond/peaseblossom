$ ! vax-tasks-collector (doc/developer/tasks.md, Phase 9): poc's runtime
$ ! and Coroutines' switch, COROUTINESWITCH.MAR, are assembled; then
$ ! TASKCOLLECTOR.COM, which poc -build wrote, links the program with the
$ ! switch by its -link line, and the image runs, its SYS$ERROR, where a
$ ! trap's message goes, a file shown after the run. Everything made is
$ ! deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN MACRO/OBJECT COROUTINESWITCH.MAR
$ IF S THEN S = $STATUS
$ IF S THEN @TASKCOLLECTOR
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ DEFINE/USER_MODE SYS$ERROR TASKCOLLECTOR.ERR
$ RUN TASKCOLLECTOR
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ IF F$SEARCH("TASKCOLLECTOR.ERR") .NES. "" THEN TYPE TASKCOLLECTOR.ERR
$ IF F$SEARCH("TASKCOLLECTOR.ERR") .NES. "" THEN DELETE/NOLOG TASKCOLLECTOR.ERR;*
$CLEAN:
$ DELETE/NOLOG POCRTL.OBJ;*,COROUTINESWITCH.OBJ;*,TASKCOLLECTOR.OBJ;*,TASKS.OBJ;*,TASKWAITING.OBJ;*
$ DELETE/NOLOG COROUTINES.OBJ;*,GARBAGECOLLECTEDHEAP.OBJ;*,OUT.OBJ;*,LINEOUTPUT.OBJ;*
$ DELETE/NOLOG FORMATTEDOUTPUT.OBJ;*,FORMATTEDTEXT.OBJ;*,REALDIGITS.OBJ;*
$ IF F$SEARCH("TASKCOLLECTOR.OPT") .NES. "" THEN DELETE/NOLOG TASKCOLLECTOR.OPT;*
$ IF F$SEARCH("TASKCOLLECTOR.EXE") .NES. "" THEN DELETE/NOLOG TASKCOLLECTOR.EXE;*
$ EXIT 1
