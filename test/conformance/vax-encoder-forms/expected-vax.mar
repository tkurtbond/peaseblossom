;; Phase 18 step 3e: the coverage module of the VAX encoder, as
;; EncoderForms.Mod writes it: every instruction of VaxOpcodes' table, each
;; with an operand of each of its operand types chosen in turn from the
;; forms that type allows, then the displacements and literals at the edges
;; of each size, reals and integers in real operands, references to
;; symbols near, far, forward, in another section and external, branches
;; and a CASE table, a private procedure, and every directive and kind of
;; item. Not a program to run. expected-vax.image is the image of the
;; object MACRO made from this file (tools/vax-macro-image), 2026-10-18,
;; and is made again from MACRO, never from poc, whenever this changes.
; EncoderForms, written by test/conformance/vax-encoder-forms/EncoderForms.Mod
	.TITLE	ENCODERFORMS
	.IDENT	/0123456789abcdef/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD
	.EXTERNAL	EXTSYM
	.EXTERNAL	EXTDATA

; data, with every directive and kind of item
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1
	.ALIGN	LONG
DATA1::
	.BLKL	4
	.BLKB	3
	.ALIGN	WORD
	.BLKW	2
	.ALIGN	QUAD
	.BLKQ	1
	.BLKF	1
	.BLKG	2
DATA2:
	.BYTE	1, -1, 255
	.BYTE	0[5]
	.WORD	-2, 65535
	.WORD	^M<R2,R3,R11>
	.ALIGN	LONG
	.LONG	-1, ^XF000000F, 2147483647
	.LONG	DATA1, DATA2+4
	.LONG	NEAR, EXTDATA+8
	.ADDRESS	DATA1, PRIVATE, EXTSYM
	.ADDRESS	STRING1+2
	.LONG	DATA2-DATA1
	.PSECT	POC_CONST
STRING1:
	.ASCII	/Text/
	.ASCII	"a/b"
	.ASCIZ	/zero/
	.ASCIC	/counted/
	.ASCID	/described/
	.ALIGN	QUAD
	.F_FLOATING	1.5E0, -0.1
	.G_FLOATING	-2.25, 1.0E300
FORMS_SIZE == 5
FORMS_KEY == 0

; the code
	.PSECT	POC_CODE
	.ENTRY	ENCODERFORMS_MAIN, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
FAR:
	.BLKB	32800
BACK:

; each instruction of the table
L_I001:
	SUBG2	#0.5, -8(FP)
L_I002:
	PUSHL	#1002
L_I003:
	BLSSU	L_I003
L_I004:
	ASHL	#-5, 300(R2), @-70000(FP)
L_I005:
	BISW2	70000(R4), -(SP)
L_I006:
	SUBG3	@12(AP), #1000, FAR
L_I007:
	BISW3	#-13, @-70000(FP), DATA1[R9]
L_I008:
	CVTGB	(R2), G^EXTDATA
L_I009:
	BVC	L_I009
L_I010:
	CVTWL	#1018, L^DATA1
L_I011:
	MULL2	#-21, @-12(FP)[R8]
L_I012:
	DECB	-300(FP)[R9]
L_I013:
	TSTW	FAR
L_I014:
	ASHQ	#24, FWD, -8(FP)
L_I015:
	SBWC	DATA1+8, 70000(R5)
L_I016:
	MULL3	DATA1[R8], #^X8000001F, @-70000(FP)
L_I017:
	CVTGF	#0.5, -(SP)
L_I018:
	DIVW2	#1034, BACK
L_I019:
	DIVW3	#-37, G^EXTDATA[R8], DATA1+8
L_I020:
	CVTGL	L^DATA1, DATA1+4[R7]
L_I021:
	DECL	G^EXTDATA
L_I022:
	BLEQU	L_I023
L_I023:
	DIVG2	@-12(FP)[R10], L^DATA1
L_I024:
	DIVG3	-300(FP)[R8], #120.0, -300(FP)[R10]
L_I025:
	CMPB	#48, L_I025+4
L_I026:
	MULF2	#0.1, -8(FP)
L_I027:
	MULF3	#-2.5, -8(FP), @12(AP)
L_I028:
	MOVAB	@-400(FP), @-70000(FP)
L_I029:
	RET
L_I030:
	CVTGW	70000(R4), -(SP)
L_I031:
	CMPF	@12(AP), #1.0E30
L_I032:
	XORW2	@-400(FP), FWD
L_I033:
	CMPG	@-70000(FP), #0.5
L_I034:
	XORW3	(R2), #1066, G^EXTDATA+12
L_I035:
	DECW	G^EXTDATA[R7]
L_I036:
	MOVAF	L^DATA1, (R2)[R9]
L_I037:
	ADDB2	BACK, -300(FP)[R7]
L_I038:
	MOVAG	@70000(R5)[R8], L_I038+4
L_I039:
	ADDB3	FWD, #-77, 300(R4)
L_I040:
	PUSHAB	70000(R5)
L_I041:
	CMPL	DATA1[R10], #16
L_I042:
	CLRB	@-70000(FP)
L_I043:
	PUSHAF	(R4)
L_I044:
	MOVAL	-(SP), L_I044
L_I045:
	CALLG	BACK, FAR
L_I046:
	BICB2	G^EXTDATA[R10], DATA1+8
L_I047:
	PUSHAG	DATA1[R8]
L_I048:
	BICB3	#90, (R3)[R10], G^EXTDATA+12
L_I049:
	ADDL2	@-12(FP)[R8], L^DATA1
L_I050:
	CLRF	(R2)[R10]
L_I051:
	ADDL3	#32, @70000(R4)[R8], @70000(R5)[R9]
L_I052:
	MNEGB	L_I052+4, R0
L_I053:
	CLRG	-8(FP)
L_I054:
	MOVAQ	300(R4), 70000(R5)
L_I055:
	MOVZBL	#40, @-400(FP)
L_I056:
	PUSHAL	@-70000(FP)
L_I057:
	BGEQU	L_I057
L_I058:
	MNEGF	#1.0E30, L_I058
L_I059:
	BICL2	#^X8000001F, FAR
L_I060:
	MNEGG	#0.5, DATA1+8
L_I061:
	CLRL	DATA1[R9]
L_I062:
	BICL3	(R2), #-17, G^EXTDATA+12
L_I063:
	BITB	#^X9F, L_I063
L_I064:
	CMPW	#56, BACK
L_I065:
	BGTRU	L_I066
L_I066:
	MULW2	FAR, L_I066+4
L_I067:
	PUSHAQ	(R5)
L_I068:
	MOVAW	-8(FP), 300(R4)
L_I069:
	BLBC	#0, L_I069
L_I070:
	MULW3	#1130, DATA1+4[R10], (R4)
L_I071:
	CALLS	G^EXTDATA, L_I071
L_I072:
	MNEGL	G^EXTDATA+12, FAR
L_I073:
	CLRQ	FWD
L_I074:
	SUBB2	#74, DATA1[R10]
L_I075:
	SUBB3	#-41, (R3)[R8], G^EXTDATA+12
L_I076:
	MOVZBW	@-12(FP)[R10], L^DATA1
L_I077:
	INCB	(R2)[R8]
L_I078:
	PUSHAW	@-12(FP)[R9]
L_I079:
	BLEQ	L_I079
L_I080:
	ADDF2	#-2.5, L_I080+4
L_I081:
	ADDF3	#0.0, R1, 300(R4)
L_I082:
	BITL	-8(FP), #1154
L_I083:
	CLRW	@-400(FP)
L_I084:
	MULG2	#1.0E30, (R4)
L_I085:
	BEQL	L_I086
L_I086:
	BNEQ	L_I086
L_I087:
	JMP	BACK
L_I088:
	MULG3	@-400(FP), #0.1, DATA1+8
L_I089:
	BGTR	L_I090
L_I090:
	CVTBF	(R2), G^EXTDATA
L_I091:
	SUBL2	-(SP), G^EXTDATA[R7]
L_I092:
	CVTBG	L_I092, (R2)[R9]
L_I093:
	SUBL3	BACK, #-73, @70000(R5)[R8]
L_I094:
	MNEGW	#^X801F, R5
L_I095:
	CVTLB	#48, 300(R4)
L_I096:
	BISB2	#114, @12(AP)
L_I097:
	BISB3	#-81, DATA1+4[R8], (R4)
L_I098:
	INCL	-(SP)
L_I099:
	BLBS	#56, L_I099
L_I100:
	CVTBL	#122, FWD
L_I101:
	CVTLF	#-89, DATA1[R8]
L_I102:
	CVTLG	#^X8000001F, G^EXTDATA
L_I103:
	BITW	#0, @-12(FP)[R8]
L_I104:
	BISL2	#1194, (R2)[R10]
L_I105:
	BISL3	#-97, @70000(R4)[R8], @70000(R5)[R9]
L_I106:
	DIVB2	L_I106+4, R0
L_I107:
	DIVB3	R1, #74, 70000(R5)
L_I108:
	MOVB	#-5, @-400(FP)
L_I109:
	MOVC3	#^X801F, (R4), -(SP)
L_I110:
	SUBF2	@12(AP), BACK
L_I111:
	INCW	FAR
L_I112:
	MOVC5	#-13, DATA1+8, #^X9F, (R2), G^EXTDATA
L_I113:
	CVTBW	-(SP), G^EXTDATA[R9]
L_I114:
	SUBF3	L_I114, #1.0E30, @-12(FP)[R8]
L_I115:
	ADDW2	#^X801F, @70000(R5)[R10]
L_I116:
	MOVF	#0.5, R5
L_I117:
	CVTFB	#0.1, 300(R4)
L_I118:
	DIVL2	#-29, @12(AP)
L_I119:
	ADDW3	#^X801F, DATA1+4[R10], (R4)
L_I120:
	MOVG	G^EXTDATA, L_I120
L_I121:
	CASEB	G^EXTDATA+12, #-37, G^EXTDATA[R8]
L_I122:
	DIVL3	#^X8000001F, L^DATA1, DATA1+4[R7]
L_I123:
	EMUL	(R3)[R8], #1242, @-12(FP)[R10], L^DATA1
L_I124:
	CVTFG	-300(FP)[R8], @-12(FP)[R9]
L_I125:
	CVTLW	@70000(R4)[R10], @70000(R5)[R7]
L_I126:
	BICW2	L_I126+4, R0
L_I127:
	MCOMB	R1, 300(R4)
L_I128:
	MOVL	-8(FP), @12(AP)
L_I129:
	BICW3	300(R2), #0, (R4)
L_I130:
	BRB	L_I131
L_I131:
	ADWC	@12(AP), BACK
L_I132:
	XORB2	@-400(FP), FWD
L_I133:
	ADDG2	@-70000(FP), DATA1[R7]
L_I134:
	BLSS	L_I134
L_I135:
	XORB3	#74, -(SP), G^EXTDATA[R7]
L_I136:
	ADDG3	L_I136, #120.0, @-12(FP)[R10]
L_I137:
	MOVZWL	#16, @70000(R5)[R8]
L_I138:
	CVTFL	#0.1, R5
L_I139:
	MOVQ	#-77, 300(R4)
L_I140:
	CASEL	#^X8000001F, DATA1[R10], #24
L_I141:
	TSTB	DATA1+4[R8]
L_I142:
	XORL2	#1282, -(SP)
L_I143:
	MCOML	#-85, BACK
L_I144:
	XORL3	#^X8000001F, G^EXTDATA[R10], DATA1+8
L_I145:
	DIVF2	L^DATA1, DATA1+4[R9]
L_I146:
	TSTF	(R3)[R10]
L_I147:
	MOVW	#-93, G^EXTDATA[R8]
L_I148:
	LOCC	#^X9F, -300(FP)[R10], @-12(FP)[R7]
L_I149:
	DIVF3	@70000(R4)[R8], #1000, L_I149+4
L_I150:
	TSTG	#1.0E30
L_I151:
	BBC	R1, 300(R4), L_I151
L_I152:
	SUBW2	#48, @-400(FP)
L_I153:
	BGEQ	L_I154
L_I154:
	SUBW3	70000(R4), #-9, L_I154
L_I155:
	CVTFW	#0.0, FAR
L_I156:
	CASEW	#56, @-70000(FP), #1314
L_I157:
	CVTWB	(R2), G^EXTDATA
L_I158:
	TSTL	-(SP)
L_I159:
	ROTL	#^X9F, L_I159, (R2)[R7]
L_I160:
	CVTWF	BACK, -300(FP)[R9]
L_I161:
	MULB2	FAR, L_I161+4
L_I162:
	MCOMW	FWD, -8(FP)
L_I163:
	CVTWG	DATA1+8, 70000(R5)
L_I164:
	MULB3	DATA1[R8], #74, @-70000(FP)
L_I165:

; displacements at the edges of each size
	MOVL	0(R3), R0
	MOVL	@0(R3), R0
	MOVL	0(R3)[R7], R0
	MOVL	@0(FP)[R8], R0
	MOVL	127(R3), R0
	MOVL	@127(R3), R0
	MOVL	127(R3)[R7], R0
	MOVL	@127(FP)[R8], R0
	MOVL	128(R3), R0
	MOVL	@128(R3), R0
	MOVL	128(R3)[R7], R0
	MOVL	@128(FP)[R8], R0
	MOVL	-128(R3), R0
	MOVL	@-128(R3), R0
	MOVL	-128(R3)[R7], R0
	MOVL	@-128(FP)[R8], R0
	MOVL	-129(R3), R0
	MOVL	@-129(R3), R0
	MOVL	-129(R3)[R7], R0
	MOVL	@-129(FP)[R8], R0
	MOVL	32767(R3), R0
	MOVL	@32767(R3), R0
	MOVL	32767(R3)[R7], R0
	MOVL	@32767(FP)[R8], R0
	MOVL	32768(R3), R0
	MOVL	@32768(R3), R0
	MOVL	32768(R3)[R7], R0
	MOVL	@32768(FP)[R8], R0
	MOVL	-32768(R3), R0
	MOVL	@-32768(R3), R0
	MOVL	-32768(R3)[R7], R0
	MOVL	@-32768(FP)[R8], R0
	MOVL	-32769(R3), R0
	MOVL	@-32769(R3), R0
	MOVL	-32769(R3)[R7], R0
	MOVL	@-32769(FP)[R8], R0
	MOVL	4(AP), R1
	MOVL	-4(SP), R1
	MOVL	(SP), R1
	PUSHL	FP
	MOVQ	R10, R8

; literals at the edges of short literals and of each size
	MOVB	#63, R0
	MOVB	#64, R0
	MOVB	#127, R0
	MOVB	#-128, R0
	MOVB	#-1, R0
	MOVW	#32767, R0
	MOVW	#-32768, R0
	MOVW	#^XFFFF, R0
	MOVL	#0, R0
	MOVL	#64, R0
	MOVL	#2147483647, R0
	MOVL	#-2147483648, R0
	MOVL	#^XFFFFFFFF, R0
	MOVL	#^XF0, R0
	MOVQ	#63, R0
	MOVQ	#64, R0
	MOVQ	#-1, R0
	MOVQ	#2147483647, R0
	MOVQ	#^X80000000, R0

; reals, F and G, and integers in real operands
	MOVF	#0.0, R0
	MOVF	#0.5, R0
	MOVF	#1.0, R0
	MOVF	#1.5E0, R0
	MOVF	#120.0, R0
	MOVF	#128.0, R0
	MOVF	#0.25, R0
	MOVF	#-0.5, R0
	MOVF	#0.1, R0
	MOVF	#3.14159265358979323846, R0
