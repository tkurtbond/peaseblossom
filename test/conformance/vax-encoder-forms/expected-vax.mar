	MOVF	#1.0E30, R0
	MOVF	#0, R0
	MOVF	#10, R0
	MOVF	#63, R0
	MOVF	#64, R0
	MOVF	#1000, R0
	MOVF	#-3, R0
	MOVG	#0.0, R0
	MOVG	#0.5, R0
	MOVG	#1.0, R0
	MOVG	#1.5E0, R0
	MOVG	#120.0, R0
	MOVG	#128.0, R0
	MOVG	#0.25, R0
	MOVG	#-0.5, R0
	MOVG	#0.1, R0
	MOVG	#3.14159265358979323846, R0
	MOVG	#1.0E-30, R0
	MOVG	#1.0E30, R0
	MOVG	#0, R0
	MOVG	#10, R0
	MOVG	#63, R0
	MOVG	#64, R0
	MOVG	#1000, R0
	MOVG	#-3, R0
	MOVG	#1.0E300, R0
	MOVG	#1.0E-300, R0
	CVTFG	#2.5, R0
	CVTGF	#2.5, R0

; references to symbols
NEAR:
	MOVL	NEAR, R0
	MOVL	BACK, R0
	MOVL	FAR, R0
	MOVL	FWD, R0
	MOVL	FWD+8, R0
	MOVL	DATA1, R0
	MOVL	DATA1+12, R0
	MOVL	NEAR[R7], R0
	MOVL	FWD+4[R7], R0
	MOVL	DATA1+8[R7], R0
	MOVL	L^NEAR, R0
	MOVL	L^FWD, R0
	MOVL	L^DATA1+4, R0
	MOVL	G^EXTDATA, R0
	MOVL	G^EXTDATA+4, R0
	MOVL	G^EXTDATA[R8], R0
	MOVAB	G^EXTDATA, R0
	PUSHAB	STRING1
	CALLS	#0, G^EXTSYM
	CALLS	#1, PRIVATE
	CALLG	DATA1, G^EXTSYM
	JMP	G^EXTSYM
	JMP	FWD

; branches and a CASE
L_B1:
	BRB	L_B1
	BNEQ	L_B2
	BEQL	L_B1
	BBC	#3, R0, L_B1
L_B2:
	CASEL	R0, #0, #2
L_TABLE:
	.WORD	L_C0-L_TABLE
	.WORD	L_C1-L_TABLE
	.WORD	L_C2-L_TABLE
L_C0:
	BRB	L_C2
L_C1:
	CLRL	R0
L_C2:
	RET

; a private procedure
PRIVATE:
	.WORD	^M<>
	RET
FWD::
	RET

	.END	ENCODERFORMS_MAIN
