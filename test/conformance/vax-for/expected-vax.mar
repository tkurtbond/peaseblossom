;; Written by Claude, 2026-10-14, for Phase 17 (design section 20,
;; proposal 8, approved by the user); reviewed by the user, 2026-10-14. It
;; replaces the file the user reviewed on 2026-10-08. Why this is right:
;; - Each of the 4 FOR loops ends before a step that would pass its
;;   final value (proposal 8), as on LLVM and as language-extensions.md,
;;   "FOR final value", says since 0.6.0, no longer by the report's
;;   equivalence, which steps past the limit: after the body, SUBx3 at
;;   the variable's width computes the distance left, CMPx compares it
;;   with the step's size, and BGEQU goes on to the step, else JMP L^
;;   leaves the loop, so the variable keeps the last value the body had.
;;   - FOR i := 0 TO n: SUBW3 i, -4(FP) (n's slot), n - i, against #1.
;;   - FOR i := 10 TO 1 BY -2, counting down: SUBW3 #1, i, i - 1,
;;     against #2, the step's size.
;;   - FOR l := n TO 100000 BY 3: SUBL3 l, #100000, against #3.
;;   - FOR i := s TO s + 5: SUBW3 i, -4(FP), against #1.
;;   - Each adds one label, so the labels after each are numbered one
;;     more. The head's test (the next bullet but one) is unchanged:
;;     signed, as these variables are.
;;   - The comment of VaxFor.mod is reworded within its 5 lines, so no
;;     line number changes.
;; The rest is as the user reviewed it on 2026-10-08:
;; - FOR as Oberon2.pdf 9.8 says: the start assigned first (CLRW i for
;;   0), then the limit evaluated once, before the loop. A variable limit
;;   is copied to a slot of the frame, -4(FP), as the body may change it
;;   (SUBL2 #4, SP makes the slot; the step-3 spill's frame, section 7);
;;   a constant one stays an immediate (#1, #100000).
;; - The test is at the head: CMPx v, limit and the byte branch for
;;   staying, BLEQ for a positive step, BGEQ for a negative one (signed),
;;   then JMP L^ out (section 3); the step is added at the foot, INCW for
;;   1, ADDW2 #-2, ADDL2 #3, at the variable's own width, wrapping as all
;;   integer arithmetic does (section 8). ACBx and AOBLEQ are not used,
;;   their branch being a word or a byte (section 8).
;; - The bounds take the variable's type: FOR l := n widens n (CVTWL);
;;   FOR i := s TO s + 5 widens s (CVTBW) and computes s + 5 as a
;;   SHORTINT (ADDB3), as Oberon types it, widening only its result. The
;;   two loops reuse the one slot.
;; - l := l + i widens i (CVTWL to R0) and adds in place (ADDL2); the
;;   mask stays ^M<>, R0 needing no save (section 7).
;; - Step 8 (decided 2026-10-08) adds the module's key, POC_K1_ and its
;;   .sym's key, a global symbol its importers declare .EXTERNAL, and, as
;;   it is the program's main module, the program's start, VAXFOR_MAIN,
;;   which calls the initializer, returns SS$_NORMAL and is named by
;;   .END.
; VaxFor, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	VAXFOR
	.IDENT	/396883c14f3b3cd1/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the module's variables
	.PSECT	POC_DATA
; i: INTEGER
	.ALIGN	WORD
VAXFOR_I_PLT3H91E:
	.BLKW	1
; n: INTEGER
	.ALIGN	WORD
VAXFOR_N_PLT3HAA7:
	.BLKW	1
; s: SHORTINT
VAXFOR_S_PLT3GU00:
	.BLKB	1
; l: LONGINT
	.ALIGN	LONG
VAXFOR_L_PLT3HB5D:
	.BLKL	1

; the module's initializer: once only
	.PSECT	POC_CODE
	.ENTRY	VAXFOR_INIT, ^M<>
	BLBC	L_INITIALISED, L_BODY
	RET
L_BODY:
	MOVB	#1, L_INITIALISED
	SUBL2	#4, SP
; line 11
	CLRW	VAXFOR_I_PLT3H91E
	MOVW	VAXFOR_N_PLT3HAA7, -4(FP)
L_1:
	CMPW	VAXFOR_I_PLT3H91E, -4(FP)
	BLEQ	L_3
	JMP	L^L_2
L_3:
; line 11
	CVTWL	VAXFOR_I_PLT3H91E, R0
	ADDL2	R0, VAXFOR_L_PLT3HB5D
	SUBW3	VAXFOR_I_PLT3H91E, -4(FP), R0
	CMPW	R0, #1
	BGEQU	L_4
	JMP	L^L_2
L_4:
	INCW	VAXFOR_I_PLT3H91E
	JMP	L^L_1
L_2:
; line 12
	MOVW	#10, VAXFOR_I_PLT3H91E
L_5:
	CMPW	VAXFOR_I_PLT3H91E, #1
	BGEQ	L_7
	JMP	L^L_6
L_7:
; line 12
	DECL	VAXFOR_L_PLT3HB5D
	SUBW3	#1, VAXFOR_I_PLT3H91E, R0
	CMPW	R0, #2
	BGEQU	L_8
	JMP	L^L_6
L_8:
	ADDW2	#-2, VAXFOR_I_PLT3H91E
	JMP	L^L_5
L_6:
; line 13
	CVTWL	VAXFOR_N_PLT3HAA7, VAXFOR_L_PLT3HB5D
L_9:
	CMPL	VAXFOR_L_PLT3HB5D, #100000
	BLEQ	L_11
	JMP	L^L_10
L_11:
	SUBL3	VAXFOR_L_PLT3HB5D, #100000, R0
	CMPL	R0, #3
	BGEQU	L_12
	JMP	L^L_10
L_12:
	ADDL2	#3, VAXFOR_L_PLT3HB5D
	JMP	L^L_9
L_10:
; line 14
	CVTBW	VAXFOR_S_PLT3GU00, VAXFOR_I_PLT3H91E
	ADDB3	#5, VAXFOR_S_PLT3GU00, R0
	CVTBW	R0, R0
	MOVW	R0, -4(FP)
L_13:
	CMPW	VAXFOR_I_PLT3H91E, -4(FP)
	BLEQ	L_15
	JMP	L^L_14
L_15:
; line 14
	INCW	VAXFOR_N_PLT3HAA7
	SUBW3	VAXFOR_I_PLT3H91E, -4(FP), R0
	CMPW	R0, #1
	BGEQU	L_16
	JMP	L^L_14
L_16:
	INCW	VAXFOR_I_PLT3H91E
	JMP	L^L_13
L_14:
	RET

; the module's key, which its importers refer to
POC_K1_396883C14F3B3CD1 == 0

; the program's start: the module's initializer, then SS$_NORMAL
	.ENTRY	VAXFOR_MAIN, ^M<>
	CALLS	#0, VAXFOR_INIT
	MOVL	#1, R0
	RET

	.END	VAXFOR_MAIN
