;; Written by Claude, 2026-10-14, for Phase 17 (design section 20,
;; proposals 8 and 9, approved by the user); reviewed by the user,
;; 2026-10-14. It replaces the file the user reviewed on 2026-10-13. Why
;; this is right:
;; - Card and CardHex are new (proposal 9), rtl/llvm's: Card tests x >=
;;   0 as a signed quadword (TSTL of the high longword, then the low one
;;   unsigned) and calls Int; else half is ASHQ #-1 less MIN(HUGEINT)
;;   (SUBL2/SBWC #^X80000000 in the high longword), Int of half DIV 5
;;   (POC_HDIV), last is 2 * (half MOD 5) (POC_HMOD, POC_HMUL), INC for
;;   an odd x (BICB3 #254, BLBS), and its digit is stored past Length's
;;   end with a checked index (PUSHL #2 traps). CardHex calls Hex with
;;   16 for a negative x, else with n. POC_HMUL is now used before
;;   REALDIGITS_DIGITS, so its .EXTERNAL comes first. The module's key
;;   (.IDENT, POC_K1_) is new. Every line number after them is 29 more,
;;   the traps' PUSHLs included.
;; - The FOR loop ends before a step that would pass its final value
;;   (proposal 8), as on LLVM: after the body, SUBx3 at the variable's
;;   width computes the distance left (the final value less the variable
;;   counting up, the variable less the final value counting down), CMPx
;;   compares it with the step's size, and BGEQU goes on to the step,
;;   else JMP L^ leaves the loop. It adds one label, so the labels after
;;   it are numbered one more.
;; The rest is as the user reviewed it on 2026-10-13:
;; - FormattedText is rtl/llvm's, compiled for the VAX: Length, Int,
;;   Hex, digit, Real and LongReal are the same code as any module's.
;; - RealP tells the sign and zero by TSTG of x (BGEQ, then BEQL), not
;;   from IEEE 754's bits, and has no Infinity or NaN branch;
;;   otherwise it is rtl/llvm's: the digit count from n and long, then
;;   RealDigits.Digits (REALDIGITS_DIGITS) of |x|, the exponent's
;;   digits, the letter, the trailing zeros dropped, the digits and the
;;   point, built backwards in s, then copied to text after a "-".
;; - Ten multiplies r by power (MULG2) for each odd e, halves e (DIVW3
;;   #2), and squares power only while e is still positive, so that
;;   Ten(256) to Ten(307) do not overflow (proposal 2).
;; - prepend, used only for Infinity and NaN, is gone.
;; - On the guest, vax-out-reals and vax-real-digits print what LLVM
;;   prints, but where the VAX's values differ.
; FormattedText, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	FORMATTEDTEXT
	.IDENT	/210b7cbcff3f34a3/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the symbols it uses of other modules
	.EXTERNAL	POC_HMOD
	.EXTERNAL	POC_HDIV
	.EXTERNAL	POC_HMUL
	.EXTERNAL	REALDIGITS_DIGITS_BS378LM5
	.EXTERNAL	REALDIGITS_INIT
	.EXTERNAL	POC_K1_8F1E34B9B65A7909

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/FormattedText/

; its string constants
	.PSECT	POC_CONST
L_STR_1:
	.ASCII	/-9223372036854775808/
	.BYTE	0

; the module's procedures
	.PSECT	POC_CODE
