;; Reviewed 2026-10-10 (written by Claude, from design section 15, the
;; LLVM backend's output, the guest runs and the debugger run; for the
;; user's review). Why this is right:
;; - ErrBasics imports Err, rtl/vax/Err.Mod compiled with it
;;   (expected-vax-Err.mar, and LineOutput's, expected-vax-
;;   LineOutput.mar): its initializer calls ERR_INIT first, and its calls
;;   of Err's procedures are to their global symbols, with G^.
;; - A CHAR argument is a longword (#91 is "["); Int's and Hex's are
;;   HUGEINTs, each a quadword in the frame passed by its address: -42 as
;;   ^XFFFFFFD6 and ^XFFFFFFFF, MIN(HUGEINT) as 0 and ^X80000000. A string
;;   is its address and its length with the 0X.
;; - Built with -build under -O2 and -OC and run on the VAX with
;;   SYS$ERROR a file, it writes what the LLVM backend's writes to the
;;   standard error (errors.expected), its last line, without Ln, by the
;;   exit handler.
;; - The debugger run ends with Err's line, LineOutput's second, holding
;;   that last one, and its length 0, the exit handler having written it.
; ErrBasics, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	ERRBASICS
	.IDENT	/46384e707b463900/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the symbols it uses of other modules
	.EXTERNAL	ERR_OPEN_CK0NDH86
