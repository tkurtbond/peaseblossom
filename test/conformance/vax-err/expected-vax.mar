	.EXTERNAL	ERR_CHAR_87RM3MEA
	.EXTERNAL	ERR_INT_7HFEQO07
	.EXTERNAL	ERR_HEX_7HDEIC1V
	.EXTERNAL	ERR_FLUSH_QHE7JF08
	.EXTERNAL	ERR_INIT
	.EXTERNAL	POC_K1_A9EED434BB07F592

; its string constants
	.PSECT	POC_CONST
L_STR_1:
	.ASCII	/Err writes to the error stream/
	.BYTE	0
L_STR_2:
	.ASCII	/not ended by Ln/
	.BYTE	0

; the module's initializer: once only
	.PSECT	POC_CODE
	.ENTRY	ERRBASICS_INIT, ^M<>
	BLBC	L_INITIALISED, L_BODY
	RET
L_BODY:
	MOVB	#1, L_INITIALISED
	CALLS	#0, G^ERR_INIT
	SUBL2	#28, SP
