;; Written by Claude, 2026-10-14, for Phase 17 (design section 20,
;; proposal 8, approved by the user); reviewed by the user, 2026-10-14. It
;; replaces the file the user reviewed on 2026-10-13. Why this is right:
;; - The FOR loop ends before a step that would pass its final value
;;   (proposal 8), as on LLVM: after the body, SUBx3 at the variable's
;;   width computes the distance left (the final value less the variable
;;   counting up, the variable less the final value counting down), CMPx
;;   compares it with the step's size, and BGEQU goes on to the step,
;;   else JMP L^ leaves the loop. It adds one label, so the labels after
;;   it are numbered one more.
;; The rest is as the user reviewed it on 2026-10-13:
;; - RealDigits is rtl/llvm's but ExactDigits' reading of the bits:
;;   v's quadword (MOVQ) is taken apart by POC_HMOD and POC_HDIV with
;;   65536 into four words, the first lowest. first DIV 16 MOD 2048 is
;;   the exponent field, first MOD 16 the fraction's top four bits, and
;;   each further word is appended (m * 65536 + word); then m gets 2^52
;;   added and e is the field minus 1077, so that v = m * 2^e exactly.
;; - MulAdd, ShiftLeft, MulPower5, DivSmall, RoundDigits, Digits and
;;   Fixed are rtl/llvm's: big integers of 15-bit limbs in HUGEINTs,
;;   POC_HMUL, POC_HDIV and POC_HMOD for their arithmetic, every index
;;   checked (trap 2). No floating-point arithmetic is done: Digits
;;   and Fixed only copy v (MOVG) to pass it to ExactDigits.
;; - The 800-character buffer holds the 769 exact digits a value with
;;   the smallest exponent can have.
;; - On the guest, vax-real-digits' 1083 lines match an oracle of exact
;;   fractions under -O2 and -OC, including G's and F's smallest and
;;   largest values.
; RealDigits, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	REALDIGITS
	.IDENT	/8f1e34b9b65a7909/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the symbols it uses of other modules
	.EXTERNAL	POC_HMUL
	.EXTERNAL	POC_HMOD
	.EXTERNAL	POC_HDIV

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/RealDigits/

; its type descriptors (section 14, item 4): size, extension level,
; pointer count, base types, pointer offsets
	.PSECT	POC_ADDR,  PIC,NOSHR,NOWRT,NOEXE,LONG
; RealDigits.Big
	.ALIGN	LONG
REALDIGITS_BIG_2DRUPIC3::
	.LONG	3204
	.LONG	0
	.LONG	0
	.ADDRESS	REALDIGITS_BIG_2DRUPIC3

