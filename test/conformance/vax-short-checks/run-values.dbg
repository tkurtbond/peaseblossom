! In range, no trap: ShortL(32767) is 32767 and ShortL(-32768) -32768;
! ShortI(127) 127 and ShortI(-128) -128; ShortH(2147483647) 2147483647
! and ShortH(-2147483648) -2147483648 (deposited as two longwords, the
! debugger reading -2147483648 as the negation of a value too large)
CALL VAXSHORTCHECKS\VAXSHORTCHECKS_SHORTL_M9HJ03SP(32767)
CALL VAXSHORTCHECKS\VAXSHORTCHECKS_SHORTL_M9HJ03SP(-32768)
CALL VAXSHORTCHECKS\VAXSHORTCHECKS_SHORTI_M9HJ055I(127)
CALL VAXSHORTCHECKS\VAXSHORTCHECKS_SHORTI_M9HJ055I(-128)
DEPOSIT/QUADWORD POC_SCRATCH = 2147483647
CALL VAXSHORTCHECKS\VAXSHORTCHECKS_SHORTH_M9HJ05J5(POC_SCRATCH)
DEPOSIT/LONG POC_SCRATCH = -2147483647 - 1
DEPOSIT/LONG POC_SCRATCH+4 = -1
CALL VAXSHORTCHECKS\VAXSHORTCHECKS_SHORTH_M9HJ05J5(POC_SCRATCH)
