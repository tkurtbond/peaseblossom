MODULE client;
  IMPORT Out, LongS;
  VAR a: ARRAY 700 OF CHAR; short: ARRAY 10 OF CHAR;
BEGIN
  a := LongS.text;
  Out.Int(LongS.Length(LongS.text), 0); Out.Ln;
  Out.Int(LongS.Length(a), 0); Out.Ln;
  Out.Int(LongS.Length(LongS.big), 0); Out.Ln;
  IF a = LongS.text THEN Out.String("equal") ELSE Out.String("differ") END; Out.Ln;
  IF LongS.text = "" THEN Out.String("constant equal") END; Out.Ln;
  Out.Char(a[600]); Out.Char(a[601]); Out.Char(a[602]); Out.Ln;
  COPY(LongS.text, short); Out.String(short); Out.Ln;
  COPY("", LongS.big); Out.Int(LongS.Length(LongS.big), 0); Out.Ln
END client.
