$ ! Written by poc: builds the library VAXLINK, VAXLINK.OLB and VAXLINK.EXE
$ ! (doc/developer/vax-macro32-backend.md, section 18). Run it where
$ ! the library's .MAR files are, once the setup procedure of each
$ ! library it needs has been run.
$ ON WARNING THEN EXIT $STATUS
$ IF F$TRNLNM("POC$LIB_POCRTL") .NES. "" THEN GOTO NEED_1
$ WRITE SYS$ERROR "library VAXLINK needs library POCRTL: run its POCRTL_SETUP.COM first"
$ EXIT %X1000002C
$NEED_1:
$ MACRO/OBJECT VAXLINKLIB.MAR
$ LIBRARY/CREATE/OBJECT VAXLINK.OLB
$ LIBRARY/INSERT VAXLINK.OLB VAXLINKLIB.OBJ
$ CREATE VAXLINK.OPT
VAXLINK.OLB/INCLUDE=(-
VAXLINKLIB)
POCRTL/SHAREABLE
FOREIGN.OLB/LIBRARY
PSECT_ATTR=NO_SUCH_PSECT,NOSHR ! twice
UNIVERSAL=VAXLINKLIB_QUADRUPLE_9Q6ELFM4
UNIVERSAL=VAXLINKLIB_INIT
UNIVERSAL=POC_K1_0F964F967E595FBF
$ LINK/SHAREABLE=VAXLINK.EXE VAXLINK.OPT/OPTIONS
$ EXIT $STATUS
