$ ! Written by poc: builds the library VAXLIB, VAXLIB.OLB and VAXLIB.EXE
$ ! (doc/developer/vax-macro32-backend.md, section 18). Run it where
$ ! the library's .MAR files are, once the setup procedure of each
$ ! library it needs has been run.
$ ON WARNING THEN EXIT $STATUS
$ IF F$TRNLNM("POC$LIB_POCRTL") .NES. "" THEN GOTO NEED_1
$ WRITE SYS$ERROR "library VAXLIB needs library POCRTL: run its POCRTL_SETUP.COM first"
$ EXIT %X1000002C
$NEED_1:
$ MACRO/OBJECT VAXLIBBASE.MAR
$ MACRO/OBJECT VAXLIBSHAPES.MAR
$ MACRO/OBJECT VAXLIBSUMS.MAR
$ LIBRARY/CREATE/OBJECT VAXLIB.OLB
$ LIBRARY/INSERT VAXLIB.OLB VAXLIBBASE.OBJ
$ LIBRARY/INSERT VAXLIB.OLB VAXLIBSHAPES.OBJ
$ LIBRARY/INSERT VAXLIB.OLB VAXLIBSUMS.OBJ
$ CREATE VAXLIB.OPT
VAXLIBBASE.OBJ
VAXLIBSHAPES.OBJ
VAXLIBSUMS.OBJ
POCRTL/SHAREABLE
UNIVERSAL=VAXLIBBASE_COUNT_UHJDG3QB
UNIVERSAL=VAXLIBBASE_BUMP_OP9VEP08
UNIVERSAL=VAXLIBBASE_INIT
UNIVERSAL=POC_K1_FD4B8F96F031BD45
UNIVERSAL=VAXLIBSHAPES_SHAPEDESC_1P51R6QF
UNIVERSAL=VAXLIBSHAPES_SHAPEDESC_0NAQ9PMU
UNIVERSAL=VAXLIBSHAPES_INIT
UNIVERSAL=POC_K1_43E7513DD5B53378
UNIVERSAL=VAXLIBSUMS_TOTAL_O8MO94L7
UNIVERSAL=VAXLIBSUMS_INIT
UNIVERSAL=POC_K1_905333BDEAD117C8
$ LINK/SHAREABLE=VAXLIB.EXE VAXLIB.OPT/OPTIONS
$ EXIT $STATUS
