;; Reviewed 2026-10-10 by the user (written by Claude, from design
;; section 15, the RMS Reference ($READ, $WRITE, $RENAME, the XABFHC)
;; and the guest runs). Why this is right:
;; - FileDesc is 1568 bytes under -O2: the control (768) at 0, the block
;;   (512) at 768, the name (256) at 1280, isNew, created, open, closed,
;;   dirty and byRecord at 1536 to 1541, then length, onDisk and
;;   blockStart at 1544, 1548 and 1552, the record pointer at 1556 (its
;;   descriptor's one pointer offset), recordStart and recordLength. A
;;   Rider is 16 bytes: res, eof, file at 8 (its one pointer) and
;;   position at 12.
;; - Each PocRtl.mar routine gets the control, a name, the block or the
;;   record buffer by reference, and a length or count by value as a
;;   longword (CVTWL from an INTEGER word). A position, Load's start or
;;   the File's blockStart, goes by reference: a LONGINT whose low
;;   longword POC_FILE_READ and POC_FILE_WRITE divide by 512 for the
;;   block number. A status's low bit is the result (BICB3 #254);
;;   POC_FILE_GET's length, -1 or -2 is taken as a word.
;; - Flush creates the file if need be, writes MIN(length - blockStart,
;;   512) bytes of the block (SHORT, then CVTWL) and moves onDisk up to
;;   the end written. Load flushes, then reads the block holding
;;   position when it starts before onDisk, reopening a closed file;
;;   blockStart then names it.
;; - NextRecord adds the record's length and 1, for the LF, in a
;;   longword (CVTWL, INCL), so that a 32767-byte record is counted
;;   right under -O2. RecordByte rewinds when position is before the
;;   current record, moves forward a record at a time, and gives the
;;   record's byte or, after its last, 10 (LF).
;; - Old opens the file and, for block I/O, sets length to (EBK - 1) *
;;   512 + FFB when EBK > 0 (the MULL2 and ADDL3); otherwise it
;;   allocates the 32767-byte record buffer
;;   (GarbageCollectedHeap.Allocate, tag 0), reads every record to count
;;   the bytes, and rewinds. A failed open returns NIL.
;; - New only allocates the File (Allocate with FileDesc's descriptor,
;;   blockStart -1) and marks it new. Close creates and flushes a New
;;   file, then closes it; Register then renames it, a failure going to
;;   Fail. Write refuses a file that is not new or is closed; it stores
;;   the BYTE argument's low byte in the block, marks it dirty and
;;   extends length. Read gives 0X and sets eof at the end.
;; - WriteString writes each character up to the 0X, then the 0X when
;;   there is room. ReadString and ReadLine stop at 0X, ReadLine at LF
;;   too, dropping a CR before it. Delete returns 2 for a bad name, else
;;   POC_ERASE's status's low word, 0 when it is odd.
;; - Fail copies the message and the file's name into 256-byte buffers
;;   and calls POC_FILE_FAIL, which does not return. The trap 4 calls
;;   are the NIL checks, the trap 2 calls the index checks, and the trap
;;   12 calls a function's end without RETURN, never reached.
;; - On the guest, FilesOut prints guest-run.expected under -O2 and -OC,
;;   the same as the LLVM backend's output.expected: 41, 1300 and 7
;;   bytes exact (odd counts written by $WRITE); a VAR and a VFC file
;;   read with an LF after each record; FILESOUT.TXT, registered twice,
;;   is ;1 and ;2, STMLF with CR, and TYPE shows ;1 as text; no
;;   POC_*.TMP is left.
;; - NEW calls rtl/vax's GarbageCollectedHeap.Allocate by its symbol,
;;   G^GARBAGECOLLECTEDHEAP_A_A8NV38EI, .EXTERNAL, where it called
;;   POC_NEW (Phase 16 step 4, section 15, proposal 9), with the same
;;   arguments; -build adds the collector to FilesOut's program.
; Files, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	FILES
	.IDENT	/864112f5374f12a3/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the symbols it uses of other modules
	.EXTERNAL	POC_FILE_FAIL
	.EXTERNAL	POC_FILE_CREATE
	.EXTERNAL	POC_FILE_REOPEN
	.EXTERNAL	POC_FILE_WRITE
	.EXTERNAL	POC_FILE_READ
	.EXTERNAL	POC_FILE_GET
	.EXTERNAL	POC_FILE_REWIND
	.EXTERNAL	GARBAGECOLLECTEDHEAP_A_A8NV38EI
	.EXTERNAL	POC_FILE_OPEN
	.EXTERNAL	POC_FILE_CLOSE
	.EXTERNAL	POC_FILE_RENAME
	.EXTERNAL	POC_ERASE

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/Files/

; its string constants
