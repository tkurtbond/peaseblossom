$ ! PLAN.md Phase 17 step 3: FILESEXTRA.COM, which poc -build wrote, run
$ ! after poc's runtime is assembled; then the image, with the
$ ! directories [.FXWORK] and [.FXWORK.SUB], the variable-length file
$ ! [.FXWORK]LONG-LINES. and the logical name FXLIB for [.FXWORK.SUB].
$ ! Everything made is deleted, and no POC_*.TMP file may be left
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN @FILESEXTRA
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ HERE = F$ENVIRONMENT("DEFAULT")
$ CREATE/DIRECTORY [.FXWORK.SUB]
$ CREATE [.FXWORK]LONG-LINES.
abcdefghij
xyz
$ DEFINE FXLIB 'F$EXTRACT(0, F$LENGTH(HERE) - 1, HERE)'.FXWORK.SUB]
$ RUN FILESEXTRA
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ IF F$ENVIRONMENT("DEFAULT") .EQS. HERE THEN WRITE SYS$OUTPUT "default directory as it was"
$ SET DEFAULT 'HERE'
$ DEASSIGN FXLIB
$ IF F$SEARCH("[.FXWORK...]POC_*.TMP;*") .EQS. "" THEN WRITE SYS$OUTPUT "no temporary file left"
$ IF F$SEARCH("[.FXWORK.SUB]*.*;*") .NES. "" THEN DELETE/NOLOG [.FXWORK.SUB]*.*;*
$ SET PROTECTION=O:RWED [.FXWORK]SUB.DIR
$ DELETE/NOLOG [.FXWORK]SUB.DIR;
$ IF F$SEARCH("[.FXWORK]*.*;*") .NES. "" THEN DELETE/NOLOG [.FXWORK]*.*;*
$ SET PROTECTION=O:RWED FXWORK.DIR
$ DELETE/NOLOG FXWORK.DIR;
$ CLEAN:
$ DELETE/NOLOG POCRTL.OBJ;*,OUT.OBJ;*,LINEOUTPUT.OBJ;*,FORMATTEDOUTPUT.OBJ;*,FORMATTEDTEXT.OBJ;*,REALDIGITS.OBJ;*,GARBAGECOLLECTEDHEAP.OBJ;*,PLATFORM.OBJ;*,FILES.OBJ;*
$ DELETE/NOLOG FILESEXTRA.OBJ;*,FILESEXTRA.OPT;*,FILESEXTRA.EXE;*
$ EXIT 1
