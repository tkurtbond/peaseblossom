target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-redhat-linux-gnu"

@nested.g = global i16 zeroinitializer
declare void @write(i32, ptr, i64)
declare void @exit(i32)
@.trap.indexrange = private unnamed_addr constant [19 x i8] c"index out of range\00"
@.trap.nocaselabel = private unnamed_addr constant [23 x i8] c"no matching CASE label\00"
@.str.nested.L20.C30 = private unnamed_addr constant [3 x i8] c"ok\00"
@.str.nested.L20.C56 = private unnamed_addr constant [6 x i8] c"WRONG\00"

define void @nested.Outer() {
entry:
  %t1 = alloca i16
  %t2 = sext i8 5 to i16
  store i16 %t2, ptr %t1
  ; unsupported: call of something that is not a module-level procedure (a nested one?)
  ; unsupported: call of something that is not a module-level procedure (a nested one?)
  ; unsupported: call of something that is not a module-level procedure (a nested one?)
  %t3 = load i16, ptr @nested.g
  %t4 = load i16, ptr %t1
  %t5 = add i16 %t3, %t4
  store i16 %t5, ptr @nested.g
  ret void
}

define void @nested_init() {
entry:
  %t6 = sext i8 0 to i16
  store i16 %t6, ptr @nested.g
  call void @nested.Outer()
  %t7 = load i16, ptr @nested.g
  %t8 = sext i8 17 to i16
  %t9 = icmp eq i16 %t7, %t8
  %t10 = zext i1 %t9 to i8
  %t11 = icmp ne i8 %t10, 0
  br i1 %t11, label %L2, label %L3
L2:
  %t12 = sext i8 1 to i32
  %t13 = sext i8 2 to i64
  call void @write(i32 %t12, ptr @.str.nested.L20.C30, i64 %t13)
  br label %L1
L3:
  %t14 = sext i8 1 to i32
  %t15 = sext i8 5 to i64
  call void @write(i32 %t14, ptr @.str.nested.L20.C56, i64 %t15)
  br label %L1
L1:
  ret void
}

define i32 @main() {
entry:
  call void @nested_init()
  ret i32 0
}
