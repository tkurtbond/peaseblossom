! i = 0, j = 2, p = TRUE, q = TRUE: i is 1 (i < j), 2 (p), 4 ((i = j)
! & p). (The arm i := 6 cannot be reached: ~(p OR q) needs ~q, which
! makes the first condition TRUE.)
DEPOSIT/WORD VAXIF\VAXIF_I_7U1L18FM = 0
DEPOSIT/WORD VAXIF\VAXIF_J_7U1L1823 = 2
DEPOSIT/BYTE VAXIF\VAXIF_P_7U1L15GH = 1
DEPOSIT/BYTE VAXIF\VAXIF_Q_7U1L152U = 1
DEPOSIT/BYTE VAXIF\VAXIF_C_7U1L1B18 = 0
SET BREAK VAXIF\%LINE 65
SET BREAK VAXIF\%LINE 76
SET BREAK VAXIF\%LINE 115
GO
EXAMINE/WORD VAXIF\VAXIF_I_7U1L18FM
GO
EXAMINE/WORD VAXIF\VAXIF_I_7U1L18FM
GO
EXAMINE/WORD VAXIF\VAXIF_I_7U1L18FM
GO
