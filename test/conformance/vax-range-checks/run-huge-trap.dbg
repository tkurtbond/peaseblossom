! ChrQ(4294967296) traps, code 14, at line 17, column 16: its low
! longword is 0 but its high one is not
DEPOSIT/QUADWORD POC_SCRATCH = 4294967296
CALL VAXRANGECHECKS\VAXRANGECHECKS_CHRQ_GIC6DELS(POC_SCRATCH)
EXAMINE/LONG POC_TRAP_CODE
EXAMINE/LONG POC_TRAP_LINE
EXAMINE/LONG POC_TRAP_COLUMN
EXAMINE/ASCII:14 POC_TRAP_MODULE
EXIT
