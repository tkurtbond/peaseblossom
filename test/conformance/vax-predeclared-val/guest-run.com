$ ! The predeclared VAL (doc/developer/predeclared-unsigned-types.md, step
$ ! 4): VALPLAIN.COM, VALCHECKED.COM and CONSTANTS.COM, which poc -build
$ ! wrote under the model the test gives, run after poc's runtime is
$ ! assembled; then, for each of llvm-predeclared-val's 25 cases, VALPLAIN
$ ! and VALCHECKED as foreign commands, the case's number the argument,
$ ! VALCHECKED with SYS$ERROR a file, typed after its status; then
$ ! CONSTANTS. Everything made from MACRO-32 is deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ IF .NOT. $STATUS THEN EXIT 1
$ ! Built from poc's objects (vax_build), the modules' objects were sent
$ ! and are kept
$ KIND = "MAR"
$ IF F$SEARCH("VALPLAIN.MAR") .EQS. "" THEN KIND = "OBJ"
$ @VALPLAIN
$ IF .NOT. $STATUS THEN GOTO CLEAN
$ @VALCHECKED
$ IF .NOT. $STATUS THEN GOTO CLEAN
$ @CONSTANTS
$ IF .NOT. $STATUS THEN GOTO CLEAN
$ VALPLAIN :== $SYS$LOGIN:VALPLAIN.EXE
$ VALCHECKED :== $SYS$LOGIN:VALCHECKED.EXE
$ N = 1
$ LOOP:
$ WRITE SYS$OUTPUT "== ", N
$ VALPLAIN 'N'
$ DEFINE/USER_MODE SYS$ERROR TRAPS.ERR
$ VALCHECKED 'N'
$ WRITE SYS$OUTPUT "status: ", $STATUS
$ IF F$SEARCH("TRAPS.ERR") .NES. "" THEN TYPE TRAPS.ERR
$ IF F$SEARCH("TRAPS.ERR") .NES. "" THEN DELETE/NOLOG TRAPS.ERR;*
$ N = N + 1
$ IF N .LE. 25 THEN GOTO LOOP
$ WRITE SYS$OUTPUT "== constants"
$ RUN CONSTANTS.EXE
$ DELETE/SYMBOL/GLOBAL VALPLAIN
$ DELETE/SYMBOL/GLOBAL VALCHECKED
$ CLEAN:
$ DELETE/NOLOG POCRTL.OBJ;*
$ DELETE/NOLOG VALPLAIN.OPT;*,VALPLAIN.EXE;*,VALCHECKED.OPT;*,VALCHECKED.EXE;*
$ DELETE/NOLOG CONSTANTS.OPT;*,CONSTANTS.EXE;*
$ IF KIND .NES. "MAR" THEN EXIT 1
$ DELETE/NOLOG VALPLAIN.OBJ;*,VALCHECKED.OBJ;*,CONSTANTS.OBJ;*,OUT.OBJ;*,LINEOUTPUT.OBJ;*
$ DELETE/NOLOG FORMATTEDOUTPUT.OBJ;*,FORMATTEDTEXT.OBJ;*,REALDIGITS.OBJ;*
$ DELETE/NOLOG MODULES.OBJ;*,PLATFORM.OBJ;*,GARBAGECOLLECTEDHEAP.OBJ;*,ARGS.OBJ;*
$ EXIT 1
