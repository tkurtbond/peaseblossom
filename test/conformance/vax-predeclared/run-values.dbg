! Each function called by the debugger, a HUGEINT's value or variable in
! POC_SCRATCH. ABS: -128 and -5 as SHORTINT are -128 (it wraps) and 5;
! -32768 and 7 as INTEGER -32768 and 7; -2147483647-1 and -9 as LONGINT
! themselves and 9
CALL VAXPREDECLARED\VAXPREDECLARED_ABSB_8M57D7BT(-128)
CALL VAXPREDECLARED\VAXPREDECLARED_ABSB_8M57D7BT(-5)
CALL VAXPREDECLARED\VAXPREDECLARED_ABSW_8M57DC1E(-32768)
CALL VAXPREDECLARED\VAXPREDECLARED_ABSW_8M57DC1E(7)
CALL VAXPREDECLARED\VAXPREDECLARED_ABSL_8M57D1DJ(-2147483647-1)
CALL VAXPREDECLARED\VAXPREDECLARED_ABSL_8M57D1DJ(-9)
! ABS of HUGEINTs -5 and -4294967296 (the low longword 0, so no borrow):
! 5 and 4294967296, in POC_SCRATCH+8
DEPOSIT/QUADWORD POC_SCRATCH = -5
DEPOSIT R0 = 0
CALL VAXPREDECLARED\VAXPREDECLARED_ABSQ_8M57DCSK(POC_SCRATCH, POC_SCRATCH+8)
EXAMINE/QUADWORD POC_SCRATCH+8
DEPOSIT/QUADWORD POC_SCRATCH = -4294967296
DEPOSIT R0 = 0
CALL VAXPREDECLARED\VAXPREDECLARED_ABSQ_8M57DCSK(POC_SCRATCH, POC_SCRATCH+8)
EXAMINE/QUADWORD POC_SCRATCH+8
! ODD: -3 and 4 as INTEGER 1 and 0; HUGEINTs 4294967297 and 4294967296
! (only the low longword's low bit counts) 1 and 0; words[2] = -7 and
! words[1] = 0 1 and 0
CALL VAXPREDECLARED\VAXPREDECLARED_ODDW_J3EI82C1(-3)
CALL VAXPREDECLARED\VAXPREDECLARED_ODDW_J3EI82C1(4)
DEPOSIT/QUADWORD POC_SCRATCH = 4294967297
CALL VAXPREDECLARED\VAXPREDECLARED_ODDQ_J3EI8377(POC_SCRATCH)
DEPOSIT/QUADWORD POC_SCRATCH = 4294967296
CALL VAXPREDECLARED\VAXPREDECLARED_ODDQ_J3EI8377(POC_SCRATCH)
DEPOSIT/WORD VAXPREDECLARED\VAXPREDECLARED_WORDS_9OVSHVF4+4 = -7
CALL VAXPREDECLARED\VAXPREDECLARED_ODDELEM_568IH22K(2)
CALL VAXPREDECLARED\VAXPREDECLARED_ODDELEM_568IH22K(1)
! CHR: 321 and -1 as INTEGER 65 and 255, the low byte; the HUGEINT
! 4294967362 66
CALL VAXPREDECLARED\VAXPREDECLARED_CHRW_6F9937HB(321)
CALL VAXPREDECLARED\VAXPREDECLARED_CHRW_6F9937HB(-1)
DEPOSIT/QUADWORD POC_SCRATCH = 4294967362
CALL VAXPREDECLARED\VAXPREDECLARED_CHRQ_6F993A2T(POC_SCRATCH)
! ORD: CHAR 200 is 200, zero-extended; the SET {0, 16} (65537) is 1, its
! low word; every element (-1) is -1, the low word 0FFFFH as INTEGER
CALL VAXPREDECLARED\VAXPREDECLARED_ORDC_J54SNGE3(200)
CALL VAXPREDECLARED\VAXPREDECLARED_ORDS_J54SN9KJ(65537)
CALL VAXPREDECLARED\VAXPREDECLARED_ORDS_J54SN9KJ(-1)
! CAP: "a" (97) and "z" (122) are 65 and 90; "{" (123), "`" (96), "A"
! (65) and 225 are themselves
CALL VAXPREDECLARED\VAXPREDECLARED_CAP_3T7KA4LP(97)
CALL VAXPREDECLARED\VAXPREDECLARED_CAP_3T7KA4LP(122)
CALL VAXPREDECLARED\VAXPREDECLARED_CAP_3T7KA4LP(123)
CALL VAXPREDECLARED\VAXPREDECLARED_CAP_3T7KA4LP(96)
CALL VAXPREDECLARED\VAXPREDECLARED_CAP_3T7KA4LP(65)
