! Each procedure called by the debugger, the arrays filled first so that
! what COPY leaves alone shows. Constants: name is "hello" and 0X (then
! "zz" left), short "hel" and 0X, long 0X (then "bcdefghijklmnop" left)
DEPOSIT/ASCII:8 VAXCOPY\VAXCOPY_NAME_QD3DCOK2 = "zzzzzzzz"
DEPOSIT/ASCII:4 VAXCOPY\VAXCOPY_SHORT_32DJ71K1 = "WXYZ"
DEPOSIT/ASCII:16 VAXCOPY\VAXCOPY_LONG_O9BBN247 = "abcdefghijklmnop"
DEPOSIT R0 = 0
CALL VAXCOPY\VAXCOPY_CONSTANTS_P5NG5NQ6
EXAMINE/BYTE VAXCOPY\VAXCOPY_NAME_QD3DCOK2:VAXCOPY\VAXCOPY_NAME_QD3DCOK2+7
EXAMINE/BYTE VAXCOPY\VAXCOPY_SHORT_32DJ71K1:VAXCOPY\VAXCOPY_SHORT_32DJ71K1+3
EXAMINE/BYTE VAXCOPY\VAXCOPY_LONG_O9BBN247:VAXCOPY\VAXCOPY_LONG_O9BBN247+15
! Shorten: long with no 0X, "ABCDEFGHIJKLMNOP", gives short "ABC" and 0X
DEPOSIT/ASCII:16 VAXCOPY\VAXCOPY_LONG_O9BBN247 = "ABCDEFGHIJKLMNOP"
DEPOSIT R0 = 0
CALL VAXCOPY\VAXCOPY_SHORTEN_LM0R1HM6
EXAMINE/BYTE VAXCOPY\VAXCOPY_SHORT_32DJ71K1:VAXCOPY\VAXCOPY_SHORT_32DJ71K1+3
! Into(1): names[1], "12345678", becomes "hello", 0X and "78"; OutOf(1):
! long becomes "hello", 0X and "GHIJKLMNOP"
DEPOSIT/ASCII:8 VAXCOPY\VAXCOPY_NAMES_05F4K7S3+8 = "12345678"
DEPOSIT R0 = 0
CALL VAXCOPY\VAXCOPY_INTO_KFU0CKSF(1)
EXAMINE/BYTE VAXCOPY\VAXCOPY_NAMES_05F4K7S3+8:VAXCOPY\VAXCOPY_NAMES_05F4K7S3+15
DEPOSIT R0 = 0
CALL VAXCOPY\VAXCOPY_OUTOF_2QSQFAT6(1)
EXAMINE/BYTE VAXCOPY\VAXCOPY_LONG_O9BBN247:VAXCOPY\VAXCOPY_LONG_O9BBN247+15
! Set(to, from), from "abcdefgh" (no 0X) at POC_SCRATCH, to at
! POC_SCRATCH+8: to is "abcdefg" and 0X
DEPOSIT/ASCII:8 POC_SCRATCH = "abcdefgh"
DEPOSIT/ASCII:8 POC_SCRATCH+8 = "zzzzzzzz"
DEPOSIT R0 = 0
CALL VAXCOPY\VAXCOPY_SET_8P9PUK6V(POC_SCRATCH+8, POC_SCRATCH)
EXAMINE/BYTE POC_SCRATCH+8:POC_SCRATCH+15
EXIT
