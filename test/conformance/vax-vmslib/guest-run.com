$ ! Phase 17 step 5 (doc/developer/vms-sdl-interfaces.md, part 4,
$ ! proposal 6): the libraries POCRTL, VMSDEF (the generated modules
$ ! VMSLIB's and the programs' imports, only) and VMSLIB built by their
$ ! procedures, then each program by the procedure poc -build wrote,
$ ! against their object libraries, and run, with the logical names and
$ ! symbols it expects; what each leaves is shown. The signal programs'
$ ! SYS$OUTPUT goes to one file, shown whole, and their SYS$ERROR, where
$ ! VMS's handler writes a message and the traceback, to another, of
$ ! which only the lines with "%" or "-" are kept, not the traceback's.
$ ! Everything made is deleted.
$ SET NOON
$ @POCRTL_SETUP
$ @POCRTL_BUILD
$ WRITE SYS$OUTPUT "POCRTL_BUILD: ", $STATUS
$ @VMSDEF_SETUP
$ @VMSDEF_BUILD
$ WRITE SYS$OUTPUT "VMSDEF_BUILD: ", $STATUS
$ @VMSLIB_SETUP
$ @VMSLIB_BUILD
$ WRITE SYS$OUTPUT "VMSLIB_BUILD: ", $STATUS
$ @VMSLIBCONDITIONS
$ @VMSLIBLOGICALS
$ @VMSLIBSYMBOLS
$ @VMSLIBSIGNAL
$ @VMSLIBSTOPWITH
$ @VMSLIBSTOPLIST
$ @VMSLIBLISTTOOLONG
$ WRITE SYS$OUTPUT "programs built: ", $STATUS
$ !
$ WRITE SYS$OUTPUT "== Conditions"
$ RUN VMSLIBCONDITIONS
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ !
$ WRITE SYS$OUTPUT "== LogicalNames"
$ DEFINE/PROCESS POC_VMSLIB_LIST FIRST, SECOND, THIRD
$ RUN VMSLIBLOGICALS
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ SHOW LOGICAL/PROCESS POC_VMSLIB_SUPER
$ SHOW LOGICAL/PROCESS POC_VMSLIB_SUPER2
$ SHOW LOGICAL/PROCESS POC_VMSLIB_USER
$ SHOW LOGICAL/PROCESS POC_VMSLIB_EXEC
$ DEASSIGN/PROCESS POC_VMSLIB_SUPER
$ DEASSIGN/PROCESS POC_VMSLIB_LIST
$ !
$ WRITE SYS$OUTPUT "== Symbols"
$ POC_VMSLIB_NUMBER = 42
$ POC_VMSLIB_OLD == "old value"
$ RUN VMSLIBSYMBOLS
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ SHOW SYMBOL/LOCAL POC_VMSLIB_LOCAL
$ SHOW SYMBOL/GLOBAL POC_VMSLIB_GLOBAL
$ SHOW SYMBOL/GLOBAL POC_VMSLIB_OLD
$ DELETE/SYMBOL/LOCAL POC_VMSLIB_LOCAL
$ DELETE/SYMBOL/LOCAL POC_VMSLIB_NUMBER
$ DELETE/SYMBOL/GLOBAL POC_VMSLIB_GLOBAL
$ !
$ WRITE SYS$OUTPUT "== Signal"
$ DEFINE/USER SYS$OUTPUT SIGOUT.TXT
$ DEFINE/USER SYS$ERROR SIGERR.TXT
$ RUN VMSLIBSIGNAL
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ TYPE SIGOUT.TXT
$ SEARCH SIGERR.TXT "%TRACE"/MATCH=NOR/OUTPUT=SIGERR2.TXT
$ SEARCH SIGERR2.TXT "%","-"
$ WRITE SYS$OUTPUT "== StopWith"
$ DEFINE/USER SYS$OUTPUT STOPOUT.TXT
$ DEFINE/USER SYS$ERROR STOPERR.TXT
$ RUN VMSLIBSTOPWITH
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ TYPE STOPOUT.TXT
$ SEARCH STOPERR.TXT "%TRACE"/MATCH=NOR/OUTPUT=STOPERR2.TXT
$ SEARCH STOPERR2.TXT "%","-"
$ WRITE SYS$OUTPUT "== StopList"
$ DEFINE/USER SYS$OUTPUT LISTOUT.TXT
$ DEFINE/USER SYS$ERROR LISTERR.TXT
$ RUN VMSLIBSTOPLIST
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ TYPE LISTOUT.TXT
$ SEARCH LISTERR.TXT "%TRACE"/MATCH=NOR/OUTPUT=LISTERR2.TXT
$ SEARCH LISTERR2.TXT "%","-"
$ WRITE SYS$OUTPUT "== a list too long"
$ DEFINE/USER SYS$OUTPUT LONGOUT.TXT
$ DEFINE/USER SYS$ERROR LONGERR.TXT
$ RUN VMSLIBLISTTOOLONG
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ TYPE LONGOUT.TXT
$ SEARCH LONGERR.TXT "%TRACE"/MATCH=NOR/OUTPUT=LONGERR2.TXT
$ SEARCH LONGERR2.TXT "%","-"
$ DELETE/NOLOG *.OBJ;*, *.OLB;*, *.EXE;*, *.OPT;*, SIGOUT.TXT;*, SIGERR*.TXT;*, STOPOUT.TXT;*, STOPERR*.TXT;*, LISTOUT.TXT;*, LISTERR*.TXT;*, LONGOUT.TXT;*, LONGERR*.TXT;*
$ EXIT 1
