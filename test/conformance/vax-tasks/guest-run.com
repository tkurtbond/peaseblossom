$ ! vax-tasks (doc/developer/tasks.md, Phase 9): poc's runtime and
$ ! Coroutines' switch, COROUTINESWITCH.MAR, are assembled; then
$ ! TASKBASICS.COM, TASKCHANNELS.COM and TASKSYNC.COM, which poc -build
$ ! wrote, link the three programs with the switch by their -link lines,
$ ! and each runs, its SYS$ERROR, where a trap's message goes, a file
$ ! shown after the run. Everything made is deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN MACRO/OBJECT COROUTINESWITCH.MAR
$ IF S THEN S = $STATUS
$ IF S THEN @TASKBASICS
$ IF S THEN S = $STATUS
$ IF S THEN @TASKCHANNELS
$ IF S THEN S = $STATUS
$ IF S THEN @TASKSYNC
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ P = 0
$NEXT_PROGRAM:
$ P = P + 1
$ PROGRAM = F$ELEMENT(P - 1, ",", "TASKBASICS,TASKCHANNELS,TASKSYNC")
$ IF PROGRAM .EQS. "," THEN GOTO CLEAN
$ WRITE SYS$OUTPUT "== ", PROGRAM
$ DEFINE/USER_MODE SYS$ERROR TASKS.ERR
$ RUN 'PROGRAM'
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ IF F$SEARCH("TASKS.ERR") .NES. "" THEN TYPE TASKS.ERR
$ IF F$SEARCH("TASKS.ERR") .NES. "" THEN DELETE/NOLOG TASKS.ERR;*
$ GOTO NEXT_PROGRAM
$CLEAN:
$ DELETE/NOLOG POCRTL.OBJ;*,COROUTINESWITCH.OBJ;*,TASKBASICS.OBJ;*,TASKCHANNELS.OBJ;*,TASKSYNC.OBJ;*
$ DELETE/NOLOG TASKS.OBJ;*,TASKWAITING.OBJ;*,COROUTINES.OBJ;*,GARBAGECOLLECTEDHEAP.OBJ;*,OUT.OBJ;*
$ DELETE/NOLOG LINEOUTPUT.OBJ;*,FORMATTEDOUTPUT.OBJ;*,FORMATTEDTEXT.OBJ;*,REALDIGITS.OBJ;*
$ IF F$SEARCH("TASKBASICS.OPT") .NES. "" THEN DELETE/NOLOG TASKBASICS.OPT;*
$ IF F$SEARCH("TASKBASICS.EXE") .NES. "" THEN DELETE/NOLOG TASKBASICS.EXE;*
$ IF F$SEARCH("TASKCHANNELS.OPT") .NES. "" THEN DELETE/NOLOG TASKCHANNELS.OPT;*
$ IF F$SEARCH("TASKCHANNELS.EXE") .NES. "" THEN DELETE/NOLOG TASKCHANNELS.EXE;*
$ IF F$SEARCH("TASKSYNC.OPT") .NES. "" THEN DELETE/NOLOG TASKSYNC.OPT;*
$ IF F$SEARCH("TASKSYNC.EXE") .NES. "" THEN DELETE/NOLOG TASKSYNC.EXE;*
$ EXIT 1
