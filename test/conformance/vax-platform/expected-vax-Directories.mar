;; Reviewed 2026-10-10 by the user (written by Claude, from design
;; section 15, the RMS and LIB$ manuals, the guest runs and the debugger
;; run). Why this is right:
;; - GIVEN, 256 bytes, is the name given to PocRtl.mar's POC_PARSE and
;;   POC_CREATE_DIRECTORY, as RMS takes at most 255 characters; it is
;;   not exported. pathSeparator is a constant, with no symbol.
;; - EndsDirectory is TRUE for ":" (#58), "]" (#93) or ">" (#62), the
;;   ORs short-circuited. It and Fill are not exported: each is entered
;;   by a .WORD mask and called without G^.
;; - Fill copies dir up to its 0X into GIVEN, FALSE when dir is "" or
;;   255 characters are copied and more remain; then ":" unless the last
;;   character ends a directory (FALSE if there is no room), then 0X,
;;   and the length, SHORT, to the VAR INTEGER (CVTLW, a word under
;;   -O2).
;; - MakePath copies its two value arrays, then puts dir in path up to
;;   LEN(path) - 1, ":" when dir is not "" and does not end a directory,
;;   then name, and 0X when path has room for it.
;; - IsDirectory and MakeDirectory are Fill and then, only when it is
;;   TRUE, POC_PARSE or POC_CREATE_DIRECTORY with GIVEN by reference and
;;   the length by value (CVTWL); the status's low bit is the result
;;   (BICB3 #254).
;; - The trap 2 calls are the index checks; the trap 12 calls after the
;;   last RET of a function are its end without RETURN, never reached.
;;   The initializer only marks the module initialised: it imports
;;   nothing.
;; - In the debugger run, MakePath("SYS$LOGIN", "X.MOD") gives
;;   SYS$LOGIN:X.MOD; SYS$LOGIN is a directory and [.NO-SUCH-DIRECTORY]
;;   is not. On the guest, PlatformOut's MakeDirectory makes [.MADE.SUB]
;;   and [.MADE] above it, and succeeds again when they are there.
;; - Added 2026-10-12 (Phase 17 step 1), reviewed by the user: the module
;;   imports Platform (PLATFORM_GETENV, and its key and initializer).
;;   MakeSubdirectory copies dir into a local Name; while it does not
;;   end in "]" or ">", at most ten times, it drops a last ":" and calls
;;   Platform.GetEnv, taking the translation up to its first ",", or,
;;   when there is none, puts the ":" back and stops. Then it writes the
;;   directory without its closing bracket and "." (none after a rooted
;;   "[A." ), or, for a device or untranslated name, the name, ":" if
;;   missing and "[", or "[." for "", then name and the bracket, each
;;   only while path has room, and 0X. NameStart returns 1 + the index
;;   of the last character EndsDirectory accepts, or 0.
;; - Added later on 2026-10-12, reviewed by the user: Search, a record of one
;;   longword, LIB$FIND_FILE's context, with its type descriptor (in
;;   POC_ADDR); StartSearch clears it. NextFile clears name, Fills
;;   GIVEN from the pattern, drops the ":" Fill adds when the pattern
;;   does not end a directory, and calls POC_FIND_FILE with GIVEN, the
;;   length, the context by reference, FOUND and 255; when the status is
;;   even it calls POC_FIND_FILE_END, clears the context and returns
;;   FALSE; else it copies FOUND up to its first blank or ";" (the
;;   padding and the version) into name, cut short to fit, with a 0X.
; Directories, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	DIRECTORIES
	.IDENT	/989088c6901b9744/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the module's variables
	.PSECT	POC_DATA
; given: ARRAY 256 OF CHAR
DIRECTORIES_GIVEN_KUTJQGFB:
	.BLKB	256

; the symbols it uses of other modules
	.EXTERNAL	PLATFORM_GETENV_ATVM4QJV
	.EXTERNAL	POC_FIND_FILE
	.EXTERNAL	POC_FIND_FILE_END
	.EXTERNAL	POC_PARSE
	.EXTERNAL	POC_CREATE_DIRECTORY
	.EXTERNAL	PLATFORM_INIT
	.EXTERNAL	POC_K1_587C176E2BD2ADBE

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/Directories/

; its type descriptors (section 14, item 4): size, extension level,
; pointer count, base types, pointer offsets
	.PSECT	POC_ADDR,  PIC,NOSHR,NOWRT,NOEXE,LONG
