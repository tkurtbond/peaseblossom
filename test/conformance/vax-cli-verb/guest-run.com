$ ! Phase 17 step 5 (doc/developer/vax-macro32-backend.md, section 23,
$ ! proposal 8): POCRTL, VMSDEF and VMSLIB built, then CLIVERB by the
$ ! procedure poc -build wrote; the verb POCCLI defined by SET COMMAND
$ ! from CLIVERB.CLD, its image CLIVERB.EXE here, and run several ways;
$ ! then CLIVERB run detached, with no command language interpreter, its
$ ! output shown when it is done (RUN's message, with the process's
$ ! identification, is not). Everything made is deleted.
$ SET NOON
$ @POCRTL_SETUP
$ @POCRTL_BUILD
$ WRITE SYS$OUTPUT "POCRTL_BUILD: ", $STATUS
$ @VMSDEF_SETUP
$ @VMSDEF_BUILD
$ WRITE SYS$OUTPUT "VMSDEF_BUILD: ", $STATUS
$ @VMSLIB_SETUP
$ @VMSLIB_BUILD
$ WRITE SYS$OUTPUT "VMSLIB_BUILD: ", $STATUS
$ @CLIVERB
$ WRITE SYS$OUTPUT "CLIVERB built: ", $STATUS
$ HERE = F$ENVIRONMENT("DEFAULT")
$ DEFINE/PROCESS POC_CLIVERB_IMAGE 'HERE'CLIVERB.EXE
$ SET COMMAND CLIVERB.CLD
$ WRITE SYS$OUTPUT "SET COMMAND: ", $STATUS
$ !
$ WRITE SYS$OUTPUT "== POCCLI"
$ POCCLI
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ WRITE SYS$OUTPUT "== POCCLI A.TXT/MARK,B.TXT/NOMARK+C.TXT /LOG/NOCONFIRM/OUTPUT=out.lis"
$ POCCLI A.TXT/MARK,B.TXT/NOMARK+C.TXT /LOG/NOCONFIRM/OUTPUT=out.lis
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ WRITE SYS$OUTPUT "== POCCLI/MARK ""Lower Case"" /STYLE=(BRIEF,FULL=9)"
$ POCCLI/MARK "Lower Case" /STYLE=(BRIEF,FULL=9)
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ !
$ WRITE SYS$OUTPUT "== detached"
$ DEFINE/USER SYS$OUTPUT NL:
$ RUN/DETACHED/OUTPUT='HERE'CLIDET.LOG/ERROR='HERE'CLIDET.LOG -
     /PROCESS_NAME=POC_CLIVERB 'HERE'CLIVERB.EXE
$ N = 0
$ WAIT_DETACHED:
$ WAIT 00:00:01
$ N = N + 1
$ OPEN/READ/ERROR=NOT_YET DETACHED CLIDET.LOG
$ CLOSE DETACHED
$ GOTO DETACHED_DONE
$ NOT_YET:
$ IF N .LT. 60 THEN GOTO WAIT_DETACHED
$ DETACHED_DONE:
$ TYPE CLIDET.LOG
$ DEASSIGN/PROCESS POC_CLIVERB_IMAGE
$ DELETE/NOLOG *.OBJ;*, *.OLB;*, *.EXE;*, *.OPT;*, CLIDET.LOG;*
$ EXIT 1
