! vax-cli-verb: the verb POCCLI, whose image is the logical name
! POC_CLIVERB_IMAGE, which guest-run.com defines
DEFINE TYPE STYLES
	KEYWORD BRIEF
	KEYWORD FULL, VALUE
DEFINE VERB POCCLI
	IMAGE POC_CLIVERB_IMAGE
	PARAMETER P1, LABEL=FILES, VALUE(LIST)
	QUALIFIER MARK, PLACEMENT=POSITIONAL
	QUALIFIER LOG
	QUALIFIER CONFIRM, DEFAULT
	QUALIFIER OUTPUT, VALUE
	QUALIFIER STYLE, VALUE(LIST, TYPE=STYLES)
