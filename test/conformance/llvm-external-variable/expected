== -compile, then the pair
MODULE Counters;
  IMPORT SYSTEM;
  TYPE
    Pair* = RECORD first*: SYSTEM.INT32; second*: SYSTEM.INT32 END;
  VAR
    ["C", "counter"] counter*: SYSTEM.INT32;
    ["C", "counters_table"] table*: ARRAY 4 OF SYSTEM.INT32;
    ["C", "counters_pair"] pair-: Pair;
  PROCEDURE ["C", "counters_sum"] Sum*(): SYSTEM.INT32;
END Counters.
