      f397: INTEGER;
      f398: INTEGER;
      f399: INTEGER
    END;
    Inner = RECORD a: CHAR; w: Wide; s: ARRAY 40 OF CHAR END;
    Outer = RECORD (Inner)
      list: ARRAY 5 OF Inner;
      anon: RECORD x, y: LONGINT; deep: RECORD z: REAL; i: Inner END END
    END;
    OuterP = POINTER TO Outer;
  VAR o, p: Outer; q: OuterP; grid: ARRAY 3 OF Outer;

  PROCEDURE Check(v: Outer; VAR r: Outer): LONGINT;
  BEGIN
    r := v;
    RETURN LONG(v.list[4].w.f399) + v.anon.deep.i.w.f7 + LONG(ORD(v.a))
  END Check;

  PROCEDURE Local(): LONGINT;
    TYPE L = RECORD (Outer) more: ARRAY 3 OF RECORD k: Wide END END;
    VAR l, m: L;
  BEGIN
    l.list[4].w.f399 := 11; l.more[2].k.f5 := 5;
    m := l;
    RETURN m.list[4].w.f399 + m.more[2].k.f5
  END Local;

BEGIN
  o.a := "A"; o.list[4].w.f399 := 1000; o.anon.deep.i.w.f7 := 7; o.s := "hello";
  Out.Int(Check(o, p), 0); Out.Char(" ");
  grid[2] := p;
  Out.Int(grid[2].list[4].w.f399, 0); Out.Char(" "); Out.String(grid[2].s); Out.Char(" ");
  NEW(q); q^ := grid[2];
  Out.Int(q.anon.deep.i.w.f7, 0); Out.Char(" ");
  Out.Int(Local(), 0); Out.Ln
END largerecords.
