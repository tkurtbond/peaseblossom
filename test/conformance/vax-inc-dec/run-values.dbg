! Each procedure called by the debugger, its variables in POC_SCRATCH; R0
! cleared before each, the debugger showing it. Up(b, i, l, h), b = 127,
! i = 32767, l = 2147483647 and h = 4294967295 at POC_SCRATCH, +2, +4
! and +8: -128, -32768, -2147483648 (each wraps) and 4294967296 (the
! carry); Down then gives back 127, 32767, 2147483647 and 4294967295
DEPOSIT/BYTE POC_SCRATCH = 127
DEPOSIT/WORD POC_SCRATCH+2 = 32767
DEPOSIT/LONG POC_SCRATCH+4 = 2147483647
DEPOSIT/QUADWORD POC_SCRATCH+8 = 4294967295
DEPOSIT R0 = 0
CALL VAXINCDEC\VAXINCDEC_UP_1G162PAJ(POC_SCRATCH, POC_SCRATCH+2, POC_SCRATCH+4, POC_SCRATCH+8)
EXAMINE/BYTE POC_SCRATCH
EXAMINE/WORD POC_SCRATCH+2
EXAMINE/LONG POC_SCRATCH+4
EXAMINE/QUADWORD POC_SCRATCH+8
DEPOSIT R0 = 0
CALL VAXINCDEC\VAXINCDEC_DOWN_92I6SJ56(POC_SCRATCH, POC_SCRATCH+2, POC_SCRATCH+4, POC_SCRATCH+8)
EXAMINE/BYTE POC_SCRATCH
EXAMINE/WORD POC_SCRATCH+2
EXAMINE/LONG POC_SCRATCH+4
EXAMINE/QUADWORD POC_SCRATCH+8
! AddWide(b, n): b = 1, n = 383 (17FH): b is -128, 1 + 7FH wrapping;
! AddConstant(b), b = 0: 44, 300 wrapped to a SHORTINT
DEPOSIT/BYTE POC_SCRATCH = 1
DEPOSIT R0 = 0
CALL VAXINCDEC\VAXINCDEC_ADDWIDE_VRDARJ1I(POC_SCRATCH, 383)
EXAMINE/BYTE POC_SCRATCH
DEPOSIT/BYTE POC_SCRATCH = 0
DEPOSIT R0 = 0
CALL VAXINCDEC\VAXINCDEC_ADDCONSTANT_I5EQ2RJD(POC_SCRATCH)
EXAMINE/BYTE POC_SCRATCH
! AddNarrow(h, n), h = 0, n = -1: -1, n sign-extended; h = -1, n = 1: 0
DEPOSIT/QUADWORD POC_SCRATCH = 0
DEPOSIT R0 = 0
CALL VAXINCDEC\VAXINCDEC_ADDNARROW_81EOE1UI(POC_SCRATCH, -1)
EXAMINE/QUADWORD POC_SCRATCH
DEPOSIT R0 = 0
CALL VAXINCDEC\VAXINCDEC_ADDNARROW_81EOE1UI(POC_SCRATCH, 1)
EXAMINE/QUADWORD POC_SCRATCH
! SubHuge(l, h), l = 10, h = 4294967299 (low longword 3): 7
DEPOSIT/LONG POC_SCRATCH = 10
DEPOSIT/QUADWORD POC_SCRATCH+8 = 4294967299
DEPOSIT R0 = 0
CALL VAXINCDEC\VAXINCDEC_SUBHUGE_1NVBVLB3(POC_SCRATCH, POC_SCRATCH+8)
EXAMINE/LONG POC_SCRATCH
! Element(2, -5) then Element(2, 32767): words[2] is -5, then 32762
DEPOSIT R0 = 0
CALL VAXINCDEC\VAXINCDEC_ELEMENT_1UMML5OM(2, -5)
EXAMINE/WORD VAXINCDEC\VAXINCDEC_WORDS_AOOQQ24B+4
DEPOSIT R0 = 0
CALL VAXINCDEC\VAXINCDEC_ELEMENT_1UMML5OM(2, 32767)
EXAMINE/WORD VAXINCDEC\VAXINCDEC_WORDS_AOOQQ24B+4
! Next(5) is 15 and Next(32767) -32759, n's copy changed
CALL VAXINCDEC\VAXINCDEC_NEXT_UMFECL9J(5)
CALL VAXINCDEC\VAXINCDEC_NEXT_UMFECL9J(32767)
EXIT
