$ ! vax-coroutines-collector (doc/developer/coroutines.md, Phase 4): poc's runtime and
$ ! Coroutines' switch, COROUTINESWITCH.MAR, are assembled; then
$ ! COROUTINECOLLECTOR.COM, which poc -build wrote, links the program with the
$ ! switch by its -link line, and the image runs, its SYS$ERROR, where a
$ ! trap's message goes, a file shown after the run. Everything made is
$ ! deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN MACRO/OBJECT COROUTINESWITCH.MAR
$ IF S THEN S = $STATUS
$ IF S THEN @COROUTINECOLLECTOR
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ DEFINE/USER_MODE SYS$ERROR COROUTINECOLLECTOR.ERR
$ RUN COROUTINECOLLECTOR
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ IF F$SEARCH("COROUTINECOLLECTOR.ERR") .NES. "" THEN TYPE COROUTINECOLLECTOR.ERR
$ IF F$SEARCH("COROUTINECOLLECTOR.ERR") .NES. "" THEN DELETE/NOLOG COROUTINECOLLECTOR.ERR;*
$CLEAN:
$ DELETE/NOLOG POCRTL.OBJ;*,COROUTINESWITCH.OBJ;*
$ DELETE/NOLOG COROUTINECOLLECTOR.OBJ;*,COROUTINES.OBJ;*,GARBAGECOLLECTEDHEAP.OBJ;*,OUT.OBJ;*,LINEOUTPUT.OBJ;*,FORMATTEDOUTPUT.OBJ;*,FORMATTEDTEXT.OBJ;*,REALDIGITS.OBJ;*
$ IF F$SEARCH("COROUTINECOLLECTOR.OPT") .NES. "" THEN DELETE/NOLOG COROUTINECOLLECTOR.OPT;*
$ IF F$SEARCH("COROUTINECOLLECTOR.EXE") .NES. "" THEN DELETE/NOLOG COROUTINECOLLECTOR.EXE;*
$ EXIT 1
