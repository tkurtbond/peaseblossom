$ ! PLAN.md Phase 17 step 3 (design section 19.7, proposals 2, 3 and 6):
$ ! OUTEXTRA.COM, ERRTEST.COM and OUTTEST.COM, which poc -build wrote, run
$ ! after poc's runtime is assembled; then each image: ERRTEST with
$ ! SYS$OUTPUT and SYS$ERROR in two files, typed one after the other, so
$ ! that IsConsole is FALSE for both. Everything made is deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN @OUTEXTRA
$ IF S THEN S = $STATUS
$ IF S THEN @ERRTEST
$ IF S THEN S = $STATUS
$ IF S THEN @OUTTEST
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ WRITE SYS$OUTPUT "== outextra"
$ RUN OUTEXTRA.EXE
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ WRITE SYS$OUTPUT "== errtest"
$ DEFINE/USER SYS$OUTPUT ERRTEST-OUT.TXT
$ DEFINE/USER SYS$ERROR ERRTEST-ERR.TXT
$ RUN ERRTEST.EXE
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ WRITE SYS$OUTPUT "-- SYS$OUTPUT"
$ TYPE ERRTEST-OUT.TXT
$ WRITE SYS$OUTPUT "-- SYS$ERROR"
$ TYPE ERRTEST-ERR.TXT
$ WRITE SYS$OUTPUT "== outtest"
$ RUN OUTTEST.EXE
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ CLEAN:
$ IF F$SEARCH("ERRTEST-*.TXT") .NES. "" THEN DELETE/NOLOG ERRTEST-*.TXT;*
$ DELETE/NOLOG POCRTL.OBJ;*,LINEOUTPUT.OBJ;*,FORMATTEDTEXT.OBJ;*,REALDIGITS.OBJ;*,OUT.OBJ;*,ERR.OBJ;*,CONSOLE.OBJ;*
$ DELETE/NOLOG OUTEXTRA.OBJ;*,OUTEXTRA.OPT;*,OUTEXTRA.EXE;*,ERRTEST.OBJ;*,ERRTEST.OPT;*,ERRTEST.EXE;*
$ DELETE/NOLOG OUTTEST.OBJ;*,OUTTEST.OPT;*,OUTTEST.EXE;*
$ EXIT 1
