;; Written by Claude, 2026-10-13, for Phase 17 step 3 (design section
;; 19.7, proposal 2, approved by the user); reviewed by the user, 2026-10-13. Why this
;; is right:
;; - FormattedText is rtl/llvm's, compiled for the VAX: Length, Int,
;;   Hex, digit, Real and LongReal are the same code as any module's.
;; - RealP tells the sign and zero by TSTG of x (BGEQ, then BEQL), not
;;   from IEEE 754's bits, and has no Infinity or NaN branch;
;;   otherwise it is rtl/llvm's: the digit count from n and long, then
;;   RealDigits.Digits (REALDIGITS_DIGITS) of |x|, the exponent's
;;   digits, the letter, the trailing zeros dropped, the digits and the
;;   point, built backwards in s, then copied to text after a "-".
;; - Ten multiplies r by power (MULG2) for each odd e, halves e (DIVW3
;;   #2), and squares power only while e is still positive, so that
;;   Ten(256) to Ten(307) do not overflow (proposal 2).
;; - prepend, used only for Infinity and NaN, is gone.
;; - On the guest, vax-out-reals and vax-real-digits print what LLVM
;;   prints, but where the VAX's values differ.
; FormattedText, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	FORMATTEDTEXT
	.IDENT	/f4fbdde2020bc8cf/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the symbols it uses of other modules
	.EXTERNAL	POC_HMOD
	.EXTERNAL	POC_HDIV
	.EXTERNAL	REALDIGITS_DIGITS_BS378LM5
	.EXTERNAL	POC_HMUL
	.EXTERNAL	REALDIGITS_INIT
	.EXTERNAL	POC_K1_8F1E34B9B65A7909

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/FormattedText/

; its string constants
	.PSECT	POC_CONST
L_STR_1:
	.ASCII	/-9223372036854775808/
	.BYTE	0

; the module's procedures
	.PSECT	POC_CODE
