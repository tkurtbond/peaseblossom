;; Reviewed 2026-10-10 (written by Claude, from design sections 14 and
;; 15, rtl/vax/Out.Mod, the guest runs and the debugger run; for the
;; user's review). Why this is right:
;; - Out keeps nothing of its own now: each procedure calls LineOutput's,
;;   G^ and .EXTERNAL, with stream 0, LineOutput.output, as its first
;;   argument (CLRL), so its output is what it was (expected-vax-
;;   LineOutput.mar has the code that was Out's). The initializer calls
;;   LINEOUTPUT_INIT.
;; - Char's ch is copied to the frame on entry and passed as a longword
;;   (MOVZBL); String copies its argument, as any value open array, and
;;   passes the copy's address and length; Int and Hex pass the addresses
;;   of copies of their HUGEINTs, as any HUGEINT value parameter.
;; - Open and Flush do nothing, as before.
; Out, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	OUT
	.IDENT	/721056b4be8ff51c/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the symbols it uses of other modules
	.EXTERNAL	LINEOUTPUT_CHAR_HDBHEMT8
	.EXTERNAL	LINEOUTPUT_STRING_DKRIT2LD
	.EXTERNAL	LINEOUTPUT_LN_RROULHTA
	.EXTERNAL	LINEOUTPUT_INT_QKLE32AL
	.EXTERNAL	LINEOUTPUT_HEX_QKJD2AE9
	.EXTERNAL	LINEOUTPUT_INIT
	.EXTERNAL	POC_K1_325CA5CA1A3D6BD4

; the module's procedures
	.PSECT	POC_CODE
; PROCEDURE Open
	.ENTRY	OUT_OPEN_R8H7QTNF, ^M<>
	RET
; PROCEDURE Flush
	.ENTRY	OUT_FLUSH_ITJ00AMN, ^M<>
	RET
; PROCEDURE Char
	.ENTRY	OUT_CHAR_EIQL42IB, ^M<>
	SUBL2	#16, SP
	CLRL	-4(FP)
	MOVB	4(AP), -1(FP)
; line 33
	MOVL	#2, -16(FP)
	CLRL	-12(FP)
	MOVZBL	-1(FP), -8(FP)
	CALLG	-16(FP), G^LINEOUTPUT_CHAR_HDBHEMT8
	RET
; PROCEDURE String
	.ENTRY	OUT_STRING_VTB3DE16, ^M<R2,R3,R4,R5>
	SUBL2	#20, SP
	CLRL	-4(FP)
	MOVL	8(AP), R0
	ADDL3	#3, R0, R1
	BICL2	#3, R1
	SUBL2	R1, SP
	MOVL	SP, -4(FP)
	PUSHL	R0
	MOVL	4(AP), R1
	MOVL	-4(FP), R3
L_1:
	MOVL	(SP), R0
	CMPL	R0, #65535
	BLEQU	L_2
	MOVL	#65535, R0
L_2:
	SUBL2	R0, (SP)
	MOVC3	R0, (R1), (R3)
	TSTL	(SP)
	BNEQ	L_1
	ADDL2	#4, SP
; line 40
	MOVL	#3, -20(FP)
	CLRL	-16(FP)
	MOVL	-4(FP), -12(FP)
	MOVL	8(AP), -8(FP)
	CALLG	-20(FP), G^LINEOUTPUT_STRING_DKRIT2LD
	RET
; PROCEDURE Ln
	.ENTRY	OUT_LN_1M29JSO9, ^M<>
	SUBL2	#8, SP
; line 45
	MOVL	#1, -8(FP)
	CLRL	-4(FP)
	CALLG	-8(FP), G^LINEOUTPUT_LN_RROULHTA
	RET
; PROCEDURE Int
	.ENTRY	OUT_INT_V0SG7EMC, ^M<>
	SUBL2	#48, SP
	CLRQ	-16(FP)
	CLRQ	-8(FP)
	MOVQ	@8(AP), -16(FP)
	MOVQ	@4(AP), -8(FP)
; line 53
	MOVL	#3, -32(FP)
	CLRL	-28(FP)
	MOVQ	-8(FP), -40(FP)
	MOVAQ	-40(FP), -24(FP)
	MOVQ	-16(FP), -48(FP)
	MOVAQ	-48(FP), -20(FP)
	CALLG	-32(FP), G^LINEOUTPUT_INT_QKLE32AL
	RET
; PROCEDURE Hex
	.ENTRY	OUT_HEX_V0UAM9IC, ^M<>
	SUBL2	#48, SP
	CLRQ	-16(FP)
	CLRQ	-8(FP)
	MOVQ	@8(AP), -16(FP)
	MOVQ	@4(AP), -8(FP)
; line 61
	MOVL	#3, -32(FP)
	CLRL	-28(FP)
	MOVQ	-8(FP), -40(FP)
	MOVAQ	-40(FP), -24(FP)
	MOVQ	-16(FP), -48(FP)
	MOVAQ	-48(FP), -20(FP)
	CALLG	-32(FP), G^LINEOUTPUT_HEX_QKJD2AE9
	RET

; the module's initializer: once only
	.PSECT	POC_CODE
	.ENTRY	OUT_INIT, ^M<>
	BLBC	L_INITIALISED, L_BODY
	RET
L_BODY:
	MOVB	#1, L_INITIALISED
	CALLS	#0, G^LINEOUTPUT_INIT
	RET

; the module's key, which its importers refer to
POC_K1_721056B4BE8FF51C == 0

	.END
