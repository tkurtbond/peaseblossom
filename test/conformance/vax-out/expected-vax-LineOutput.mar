;; Reviewed 2026-10-10 (written by Claude, from design sections 14 and
;; 15, rtl/vax/LineOutput.Mod, the guest runs and the debugger run; for
;; the user's review). Why this is right:
;; - LineOutput is what Out was (reviewed 2026-10-09), for two streams:
;;   LINES is two lines of 1024 bytes, Out's (0) then Err's (1), and
;;   LENGTHS their two LONGINTs. Every procedure takes the stream first,
;;   and each lines[stream] or lengths[stream] checks it against 0..1
;;   (trap 2) before using it.
;; - WriteLine calls POC_PUT_LINE for stream 0 and POC_PUT_ERROR_LINE for
;;   any other, with the line's address and its length, SHORT'ed to an
;;   INTEGER (CVTLW) and passed as a longword (CVTWL); then it clears the
;;   stream's length. POC_PUT_ERROR_LINE writes the record to SYS$ERROR
;;   with RMS, as POC_TRAP writes its message.
;; - Char writes the line first when it is full, then stores the
;;   character at lines[stream, lengths[stream]], the element's address
;;   made by MULL2 #1024 and MOVAB, the length checked (trap 2), and
;;   counts it (INCL).
;; - String, Int, Hex and Spaces are Out's, the stream passed on to each
;;   Char (CVTWL 4(AP)): Int writes MIN(HUGEINT) as a string, else its
;;   digits by POC_HMOD and POC_HDIV into the end of digits, a "-", the
;;   blanks that fill the field and the digits; Hex takes n into 1..16 and
;;   all 16 digits of x's two's complement.
;; - The initializer clears both lengths and passes the addresses of the
;;   two lines and lengths to POC_LINES_REGISTER, which declares the exit
;;   handler that writes a line left without Ln, Out's then Err's
;;   (OutUnfinished's run, and vax-err's).
;; - The debugger run ends with Out's line holding the last one, "the
;;   end", and its length 0, Ln having written it.
; LineOutput, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	LINEOUTPUT
	.IDENT	/325ca5ca1a3d6bd4/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the module's variables
	.PSECT	POC_DATA
; lines: ARRAY 2 OF ARRAY 1024 OF CHAR
LINEOUTPUT_LINES_52FJJTP7:
	.BLKB	2048
; lengths: ARRAY 2 OF LONGINT
	.ALIGN	LONG
LINEOUTPUT_LENGTHS_GMT90G79:
	.BLKB	8

; the symbols it uses of other modules
	.EXTERNAL	POC_PUT_LINE
	.EXTERNAL	POC_PUT_ERROR_LINE
	.EXTERNAL	POC_HMOD
	.EXTERNAL	POC_HDIV
	.EXTERNAL	POC_LINES_REGISTER

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/LineOutput/

; its string constants
	.PSECT	POC_CONST
L_STR_1:
	.ASCII	/-9223372036854775808/
	.BYTE	0

