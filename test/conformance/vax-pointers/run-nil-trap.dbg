! mode = 1: list := NIL, then list.value in line 50 traps, code 4 at
! column 38, the designator's
DEPOSIT/WORD VAXPOINTERS\VAXPOINTERS_MODE_OHHDV87R = 1
GO
EXAMINE/LONG POC_TRAP_CODE
EXAMINE/LONG POC_TRAP_LINE
EXAMINE/LONG POC_TRAP_COLUMN
EXAMINE/ASCII:11 POC_TRAP_MODULE
EXAMINE/WORD VAXPOINTERS\VAXPOINTERS_I_OP14PV7J
EXIT
