### -O2 LONG
  SYSTEM.INT8    -> SYSTEM.INT16
  SHORTINT       -> SYSTEM.INT16
  SYSTEM.INT16   -> SYSTEM.INT32
  INTEGER        -> SYSTEM.INT32
  SYSTEM.INT32   -> SYSTEM.INT64
  LONGINT        -> -
  SYSTEM.INT64   -> SYSTEM.INT64
  HUGEINT        -> SYSTEM.INT64
### -O2 SHORT
  SYSTEM.INT8    -> SYSTEM.INT8
  SHORTINT       -> -
  SYSTEM.INT16   -> SYSTEM.INT8
  INTEGER        -> SYSTEM.INT8
  SYSTEM.INT32   -> SYSTEM.INT16
  LONGINT        -> SYSTEM.INT16
  SYSTEM.INT64   -> SYSTEM.INT32
  HUGEINT        -> SYSTEM.INT32
### -OC LONG
  SYSTEM.INT8    -> SYSTEM.INT16
  SHORTINT       -> SYSTEM.INT32
  SYSTEM.INT16   -> SYSTEM.INT32
  INTEGER        -> SYSTEM.INT64
  SYSTEM.INT32   -> SYSTEM.INT64
  LONGINT        -> -
  SYSTEM.INT64   -> SYSTEM.INT64
  HUGEINT        -> SYSTEM.INT64
### -OC SHORT
  SYSTEM.INT8    -> SYSTEM.INT8
  SHORTINT       -> -
  SYSTEM.INT16   -> SYSTEM.INT8
  INTEGER        -> SYSTEM.INT16
  SYSTEM.INT32   -> SYSTEM.INT16
  LONGINT        -> SYSTEM.INT32
  SYSTEM.INT64   -> SYSTEM.INT32
  HUGEINT        -> SYSTEM.INT32
