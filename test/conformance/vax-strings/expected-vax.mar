; line 30
	MOVC3	#8, VAXSTRINGS_A_3DS52R9J, VAXSTRINGS_LONG_89UUQH7U
; line 31
	CVTWL	VAXSTRINGS_I_3DS52UMB, R0
	CMPL	R0, #2
	BLEQU	L_4
	PUSHL	#9
	PUSHL	#31
	PUSHAB	L_MODULE_NAME
	PUSHL	#2
	CALLS	#4, G^POC_TRAP
L_4:
	MULL2	#8, R0
	MOVAB	VAXSTRINGS_NAMES_6MKR2M7G[R0], R0
	MOVC5	#7, L_STR_5, #0, #8, (R0)
; line 32
	MOVL	#4, -20(FP)
	MOVAB	VAXSTRINGS_A_3DS52R9J, -16(FP)
	MOVL	#8, -12(FP)
	MOVAB	VAXSTRINGS_B_3DS52RN6, -8(FP)
	MOVL	#8, -4(FP)
	CALLG	-20(FP), G^POC_STRCMP
	CLRB	R1
	TSTL	R0
	BNEQ	L_5
	MOVB	#1, R1
L_5:
	MOVB	R1, VAXSTRINGS_OK_LLP88IN2
; line 33
	MOVL	#4, -20(FP)
	MOVAB	VAXSTRINGS_A_3DS52R9J, -16(FP)
	MOVL	#8, -12(FP)
	MOVAB	L_STR_4, -8(FP)
	MOVL	#6, -4(FP)
	CALLG	-20(FP), G^POC_STRCMP
	CLRB	R1
