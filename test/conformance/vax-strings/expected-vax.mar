	MOVAB	VAXSTRINGS_A_3DS52R9J, -16(FP)
	MOVL	#8, -12(FP)
	MOVAB	L_STR_3, -8(FP)
	MOVL	#2, -4(FP)
	CALLG	-20(FP), G^POC_STRCMP
	TSTL	R0
	BNEQ	L_8
	JMP	L^L_7
L_8:
; line 34
	MOVB	#1, VAXSTRINGS_OK_LLP88IN2
L_7:
; line 35
