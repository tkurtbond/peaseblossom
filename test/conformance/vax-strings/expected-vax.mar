;; Reviewed 2026-10-06 by the user (written by Claude, from the design,
;; the MACRO manual and the VAX's listing). Why this is right:
;; - A string constant is in POC_CONST: .ASCII between a delimiter not in
;;   it (MACRO 6, .ASCII: "it's /|" takes the double quote), a character
;;   that does not print .BYTE (0AX is 10), then zeros by .BYTE 0[n]. It
;;   is written once for each text and size, as L_STR_<n>.
;; - a := "hello" is MOVC5 #5, L_STR_4, #0, #8, A: the five characters,
;;   then zeros to the array's end (decided with the user 2026-10-06), so
;;   0X ends it; names[i] := ... is the same to (R0), the element's
;;   address. long := a copies the 8 bytes of a by MOVC3 and leaves the
;;   rest of long as it was (language-extensions.md, "Array assignment").
;; - A comparison of strings calls POC_STRCMP(a, LEN(a), b, LEN(b)) by
;;   CALLG, each address and length in the argument list, and compares R0
;;   with zero: a = b is TSTL R0, BNEQ over MOVB #1. A string constant's
;;   length counts its 0X ("hello" is 6), so that the routine (Phase 16)
;;   stops at 0X or the length; a one-character string compared with an
;;   array ("x") is a string. POC_STRCMP is .EXTERNAL.
;; - A string passed for Name, ARRAY 8 OF CHAR, is padded to 8 bytes
;;   (L_STR_6, "bob", L_STR_7, "x"), since Greet copies 8 bytes from the
;;   address it is given; the same one character "x" compared in Show is
;;   L_STR_3, 2 bytes.
;; - Show's n- is read-only, so not copied: its address is MOVL 4(AP).
;; - POC_STRCMP and POC_TRAP, outside the module, are named in general
;;   mode, G^ (section 7, decided with the user 2026-10-06), which the
;;   linker makes relative or absolute as each symbol is relocatable or
;;   absolute (MACRO 5.2.5), so that a routine in a shareable image is
;;   reached too ("always use general addressing mode for any external
;;   reference", Linker 4.2).
; VaxStrings, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	VAXSTRINGS
	.IDENT	/5bb2f549cfbaeafd/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the module's variables
	.PSECT	POC_DATA
; a: ARRAY 8 OF CHAR
VAXSTRINGS_A_3DS52R9J:
	.BLKB	8
; b: ARRAY 8 OF CHAR
VAXSTRINGS_B_3DS52RN6:
	.BLKB	8
; long: ARRAY 20 OF CHAR
VAXSTRINGS_LONG_89UUQH7U:
	.BLKB	20
; names: ARRAY 3 OF ARRAY 8 OF CHAR
VAXSTRINGS_NAMES_6MKR2M7G:
	.BLKB	24
; i: INTEGER
	.ALIGN	WORD
VAXSTRINGS_I_3DS52UMB:
	.BLKW	1
; ok: BOOLEAN
VAXSTRINGS_OK_LLP88IN2:
	.BLKB	1

; the procedures it calls of other modules
	.EXTERNAL	POC_STRCMP

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/VaxStrings/

; its string constants
	.PSECT	POC_CONST
L_STR_1:
	.BYTE	0
L_STR_2:
	.ASCII	/nobody/
	.BYTE	0
L_STR_3:
	.ASCII	/x/
	.BYTE	0
L_STR_4:
	.ASCII	/hello/
	.BYTE	0
L_STR_5:
	.ASCII	"it's /|"
	.BYTE	0
L_STR_6:
	.ASCII	/bob/
	.BYTE	0[5]
L_STR_7:
	.ASCII	/x/
	.BYTE	0[7]
L_STR_8:
	.BYTE	10
	.BYTE	0[7]

; the module's procedures
	.PSECT	POC_CODE
; PROCEDURE Greet
VAXSTRINGS_GREET_SMHPN5B1:
	.WORD	^M<R2,R3,R4,R5>
	SUBL2	#28, SP
	CLRQ	-8(FP)
	MOVC3	#8, @4(AP), -8(FP)
; line 18
	MOVC3	#8, -8(FP), @8(AP)
; line 19
	MOVL	#4, -28(FP)
	MOVAB	-8(FP), -24(FP)
	MOVL	#8, -20(FP)
	MOVAB	L_STR_1, -16(FP)
	MOVL	#1, -12(FP)
	CALLG	-28(FP), G^POC_STRCMP
	TSTL	R0
	BEQL	L_2
	JMP	L^L_1
L_2:
; line 19
	MOVC5	#6, L_STR_2, #0, #8, @8(AP)
L_1:
	RET
; PROCEDURE Show
VAXSTRINGS_SHOW_H74GB4LP:
	.WORD	^M<>
	SUBL2	#20, SP
; line 24
	MOVL	#4, -20(FP)
	MOVL	4(AP), -16(FP)
	MOVL	#8, -12(FP)
	MOVAB	L_STR_3, -8(FP)
	MOVL	#2, -4(FP)
	CALLG	-20(FP), G^POC_STRCMP
	CLRB	R1
	TSTL	R0
	BEQL	L_3
	MOVB	#1, R1
L_3:
	MOVZBL	R1, R0
	RET
	PUSHL	#3
	PUSHL	#25
	PUSHAB	L_MODULE_NAME
	PUSHL	#12
	CALLS	#4, G^POC_TRAP

; the module's initializer: once only
