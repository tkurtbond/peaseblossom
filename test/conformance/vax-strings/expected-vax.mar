	CMPL	R0, #2
	BLEQU	L_10
	PUSHL	#12
	PUSHL	#35
	PUSHAB	L_MODULE_NAME
	PUSHL	#2
	CALLS	#4, G^POC_TRAP
L_10:
	MULL2	#8, R0
	MOVAB	VAXSTRINGS_NAMES_6MKR2M7G[R0], R0
	MOVL	#4, -20(FP)
	MOVAB	(R0), -16(FP)
	MOVL	#8, -12(FP)
	MOVAB	VAXSTRINGS_A_3DS52R9J, -8(FP)
	MOVL	#8, -4(FP)
	CALLG	-20(FP), G^POC_STRCMP
	TSTL	R0
