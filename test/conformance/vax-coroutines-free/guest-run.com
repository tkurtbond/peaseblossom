$ ! vax-coroutines-free (doc/developer/coroutines.md, Phase 4): poc's runtime and
$ ! Coroutines' switch, COROUTINESWITCH.MAR, are assembled; then
$ ! COROUTINEFREE.COM, which poc -build wrote, links the program with the
$ ! switch by its -link line, and the image runs, its SYS$ERROR, where a
$ ! trap's message goes, a file shown after the run. Everything made is
$ ! deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN MACRO/OBJECT COROUTINESWITCH.MAR
$ IF S THEN S = $STATUS
$ IF S THEN @COROUTINEFREE
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ DEFINE/USER_MODE SYS$ERROR COROUTINEFREE.ERR
$ RUN COROUTINEFREE
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ IF F$SEARCH("COROUTINEFREE.ERR") .NES. "" THEN TYPE COROUTINEFREE.ERR
$ IF F$SEARCH("COROUTINEFREE.ERR") .NES. "" THEN DELETE/NOLOG COROUTINEFREE.ERR;*
$CLEAN:
$ DELETE/NOLOG POCRTL.OBJ;*,COROUTINESWITCH.OBJ;*
$ DELETE/NOLOG COROUTINEFREE.OBJ;*,COROUTINES.OBJ;*,GARBAGECOLLECTEDHEAP.OBJ;*,OUT.OBJ;*,LINEOUTPUT.OBJ;*,FORMATTEDOUTPUT.OBJ;*,FORMATTEDTEXT.OBJ;*,REALDIGITS.OBJ;*
$ IF F$SEARCH("COROUTINEFREE.OPT") .NES. "" THEN DELETE/NOLOG COROUTINEFREE.OPT;*
$ IF F$SEARCH("COROUTINEFREE.EXE") .NES. "" THEN DELETE/NOLOG COROUTINEFREE.EXE;*
$ EXIT 1
