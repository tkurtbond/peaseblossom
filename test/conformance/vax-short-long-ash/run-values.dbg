! Each function called by the debugger, a HUGEINT in POC_SCRATCH.
! ShortL(70000) is 4464, the low word; ShortL(-5) -5; ShortI(200) -56,
! the low byte; ShortI(-3) -3; ShortH(4294967299) 3, the low longword;
! ShortH(-2) -2
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_SHORTL_PNMIDQ34(70000)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_SHORTL_PNMIDQ34(-5)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_SHORTI_PNMIDOQB(200)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_SHORTI_PNMIDOQB(-3)
DEPOSIT/QUADWORD POC_SCRATCH = 4294967299
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_SHORTH_PNMIDOCO(POC_SCRATCH)
DEPOSIT/QUADWORD POC_SCRATCH = -2
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_SHORTH_PNMIDOCO(POC_SCRATCH)
! LongB(-5) is -5 and LongB(127) 127; LongI(-32768) -32768; LongH(-7)
! leaves -7 in r, at POC_SCRATCH+8
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_LONGB_BK9EVV46(-5)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_LONGB_BK9EVV46(127)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_LONGI_BK9F023B(-32768)
DEPOSIT/QUADWORD POC_SCRATCH = -7
DEPOSIT/QUADWORD POC_SCRATCH+8 = 0
DEPOSIT R0 = 0
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_LONGH_BK9F01LO(POC_SCRATCH, POC_SCRATCH+8)
EXAMINE/QUADWORD POC_SCRATCH+8
! Ash(x, n): (1, 31) is -2147483648; (1, 32) 0; (-8, -2) -2; (-8, -40)
! -1; (5, 2) 20; (3, 256) 0, the count limited to 64, not its low byte,
! 0; (-5, -1000) -1
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASH_4IU771IE(1, 31)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASH_4IU771IE(1, 32)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASH_4IU771IE(-8, -2)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASH_4IU771IE(-8, -40)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASH_4IU771IE(5, 2)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASH_4IU771IE(3, 256)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASH_4IU771IE(-5, -1000)
! AshB(-3, 4) is -48; AshConstant(-1) -9, -8 + -1; AshConstant(5) 40
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHB_DGS4PHJ4(-3, 4)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHCON_K9FHDLFM(-1)
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHCON_K9FHDLFM(5)
! AshH(r, x, n), r at POC_SCRATCH, x at +8: (1, 40) 1099511627776;
! (-1, 63) -9223372036854775808; (1, 64) 0; (1, 100) 0; (-1024, -3)
! -128; (-1, -100) -1
DEPOSIT/QUADWORD POC_SCRATCH+8 = 1
DEPOSIT R0 = 0
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHH_DGS4PF1I(POC_SCRATCH, POC_SCRATCH+8, 40)
EXAMINE/QUADWORD POC_SCRATCH
DEPOSIT/QUADWORD POC_SCRATCH+8 = -1
DEPOSIT R0 = 0
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHH_DGS4PF1I(POC_SCRATCH, POC_SCRATCH+8, 63)
EXAMINE/QUADWORD POC_SCRATCH
DEPOSIT/QUADWORD POC_SCRATCH+8 = 1
DEPOSIT R0 = 0
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHH_DGS4PF1I(POC_SCRATCH, POC_SCRATCH+8, 64)
EXAMINE/QUADWORD POC_SCRATCH
DEPOSIT R0 = 0
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHH_DGS4PF1I(POC_SCRATCH, POC_SCRATCH+8, 100)
EXAMINE/QUADWORD POC_SCRATCH
DEPOSIT/QUADWORD POC_SCRATCH+8 = -1024
DEPOSIT R0 = 0
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHH_DGS4PF1I(POC_SCRATCH, POC_SCRATCH+8, -3)
EXAMINE/QUADWORD POC_SCRATCH
DEPOSIT/QUADWORD POC_SCRATCH+8 = -1
DEPOSIT R0 = 0
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHH_DGS4PF1I(POC_SCRATCH, POC_SCRATCH+8, -100)
EXAMINE/QUADWORD POC_SCRATCH
! AshHN(x, n), n at POC_SCRATCH: (7, 4294967296) 0; (-7, -4294967296)
! -1; (7, 3) 56; (7, -2) 1; (7, 2147483648) 0; (-7, -2147483649) -1
DEPOSIT/QUADWORD POC_SCRATCH = 4294967296
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHHN_SEL68HLK(7, POC_SCRATCH)
DEPOSIT/QUADWORD POC_SCRATCH = -4294967296
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHHN_SEL68HLK(-7, POC_SCRATCH)
DEPOSIT/QUADWORD POC_SCRATCH = 3
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHHN_SEL68HLK(7, POC_SCRATCH)
DEPOSIT/QUADWORD POC_SCRATCH = -2
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHHN_SEL68HLK(7, POC_SCRATCH)
DEPOSIT/QUADWORD POC_SCRATCH = 2147483648
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHHN_SEL68HLK(7, POC_SCRATCH)
DEPOSIT/QUADWORD POC_SCRATCH = -2147483649
CALL VAXSHORTLONGASH\VAXSHORTLONGASH_ASHHN_SEL68HLK(-7, POC_SCRATCH)
