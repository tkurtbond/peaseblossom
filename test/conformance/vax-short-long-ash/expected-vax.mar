;; Reviewed 2026-10-08 (written by Claude, from the design, the MACRO
;; manual, the VAX's listing and the debugger runs; for the user's
;; review). Why this is right:
;; - SHORT is CVTLW or CVTWB (MACRO 9-16), the low word or byte, 70000
;;   giving 4464 and 200 -56; of a HUGEINT, MOVL of its low longword, 3 for
;;   4294967299. LONG is CVTBW or CVTWL, sign-extending; LONG of a HUGEINT
;;   is the value itself, MOVQ. The CVTWL or CVTBL after SHORT widens the
;;   result to a longword, as the calling standard returns one.
;; - ASH(x, n) is ASHL n, x, r in LONGINT, an INTEGER x first widened by
;;   CVTWL, or ASHQ for a HUGEINT x, so the result is in the wider of
;;   LONGINT and x's type. ASHL and ASHQ give 0 for a left shift of the
;;   width or more and the sign for such a right one, the rule poc
;;   promises (language-extensions.md), for any count of -128..127; but
;;   the count is a byte, so a SHORTINT n is used as it is and any wider
;;   one first limited to -64..64 in a register: CMPL with #64 and #-64 for
;;   a LONGINT, and for a HUGEINT n its high longword first (0, positive,
;;   -1 or other). ASH(3, 256) is 0, not 3, which 256's low byte would give.
;; - A constant n is limited when compiling: ASH(x, -100) is ASHL #-64.
;; - The runs cover each type, the widths 31, 32, 63 and 64, and HUGEINT
;;   counts beyond a longword both ways.
; VaxShortLongAsh, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	VAXSHORTLONGASH
	.IDENT	/54d6c889b620feeb/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/VaxShortLongAsh/

; the module's procedures
	.PSECT	POC_CODE
; PROCEDURE ShortL
VAXSHORTLONGASH_SHORTL_PNMIDQ34:
	.WORD	^M<>
; line 11
