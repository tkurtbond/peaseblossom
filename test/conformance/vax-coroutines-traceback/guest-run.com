$ ! vax-coroutines-traceback (doc/developer/coroutines.md, Phase 4): poc's
$ ! runtime and Coroutines' switch, COROUTINESWITCH.MAR, are assembled;
$ ! then COROUTINETRACE.COM, which poc -build wrote, links the program with
$ ! the switch by its -link line, and the image runs, its access
$ ! violation's message and traceback in SYS$ERROR, a file shown after the
$ ! run (vax_mask=yes masks its PCs). Everything made is deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN MACRO/OBJECT COROUTINESWITCH.MAR
$ IF S THEN S = $STATUS
$ IF S THEN @COROUTINETRACE
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ DEFINE/USER_MODE SYS$ERROR COROUTINETRACE.ERR
$ RUN COROUTINETRACE
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ IF F$SEARCH("COROUTINETRACE.ERR") .NES. "" THEN TYPE COROUTINETRACE.ERR
$ IF F$SEARCH("COROUTINETRACE.ERR") .NES. "" THEN DELETE/NOLOG COROUTINETRACE.ERR;*
$CLEAN:
$ DELETE/NOLOG POCRTL.OBJ;*,COROUTINESWITCH.OBJ;*
$ DELETE/NOLOG COROUTINETRACE.OBJ;*,COROUTINES.OBJ;*,GARBAGECOLLECTEDHEAP.OBJ;*,OUT.OBJ;*,LINEOUTPUT.OBJ;*,FORMATTEDOUTPUT.OBJ;*,FORMATTEDTEXT.OBJ;*,REALDIGITS.OBJ;*
$ IF F$SEARCH("COROUTINETRACE.OPT") .NES. "" THEN DELETE/NOLOG COROUTINETRACE.OPT;*
$ IF F$SEARCH("COROUTINETRACE.EXE") .NES. "" THEN DELETE/NOLOG COROUTINETRACE.EXE;*
$ EXIT 1
