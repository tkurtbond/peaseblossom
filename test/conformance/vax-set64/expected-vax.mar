; line 18
	MOVQ	VAXSET64_A_VFHT1MEF, R0
	BISL2	VAXSET64_B_VFHT1MS2, R0
	BISL2	VAXSET64_B_VFHT1MS2+4, R1
	CVTWL	VAXSET64_I_VFHT1PR7, R2
	MNEGL	R2, R3
	ASHQ	R3, R0, R0
	CLRB	R3
	CMPL	R2, #63
	BGTRU	L_4
	BLBC	R0, L_4
