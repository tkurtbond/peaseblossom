; line 17
	MOVQ	VAXSET64_A_VFHT1MEF, R0
	BISL2	VAXSET64_B_VFHT1MS2, R0
	BISL2	VAXSET64_B_VFHT1MS2+4, R1
	CLRB	R2
	BBC	#8, R1, L_3
