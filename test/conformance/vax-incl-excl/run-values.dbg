! Each procedure called by the debugger, its set in POC_SCRATCH; R0
! cleared before each, the debugger showing it. Include(v, x), v = 0:
! x = 5 gives 32; x = 31 then -2147483616, bit 31 too; x = 32 and x = -1
! leave v as it was
DEPOSIT/LONG POC_SCRATCH = 0
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_INCLUDE_PAL9TQEO(POC_SCRATCH, 5)
EXAMINE/LONG POC_SCRATCH
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_INCLUDE_PAL9TQEO(POC_SCRATCH, 31)
EXAMINE/LONG POC_SCRATCH
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_INCLUDE_PAL9TQEO(POC_SCRATCH, 32)
EXAMINE/LONG POC_SCRATCH
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_INCLUDE_PAL9TQEO(POC_SCRATCH, -1)
EXAMINE/LONG POC_SCRATCH
! Exclude(v, x): x = 5 gives -2147483648; x = 40 leaves it; x = 31 gives 0
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_EXCLUDE_1HT27P1E(POC_SCRATCH, 5)
EXAMINE/LONG POC_SCRATCH
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_EXCLUDE_1HT27P1E(POC_SCRATCH, 40)
EXAMINE/LONG POC_SCRATCH
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_EXCLUDE_1HT27P1E(POC_SCRATCH, 31)
EXAMINE/LONG POC_SCRATCH
! IncludeHuge(v, x), v = 0: x = 7 gives 128; x = -1 leaves it
DEPOSIT/QUADWORD POC_SCRATCH+8 = 7
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_INCLUDEHUG_UHSQHI9N(POC_SCRATCH, POC_SCRATCH+8)
EXAMINE/LONG POC_SCRATCH
DEPOSIT/QUADWORD POC_SCRATCH+8 = -1
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_INCLUDEHUG_UHSQHI9N(POC_SCRATCH, POC_SCRATCH+8)
EXAMINE/LONG POC_SCRATCH
! Constants: s is {31}, -2147483648
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_CONSTANTS_FP6K5AJP
EXAMINE/LONG VAXINCLEXCL\VAXINCLEXCL_S_1VJO9DUL
! Element(1, 3): sets[1] is 8, sets[0] and sets[2] still 0
DEPOSIT R0 = 0
CALL VAXINCLEXCL\VAXINCLEXCL_ELEMENT_PLMIV9OC(1, 3)
EXAMINE/LONG VAXINCLEXCL\VAXINCLEXCL_SETS_UNAAIM9D:VAXINCLEXCL\VAXINCLEXCL_SETS_UNAAIM9D+8
! Local(7) is {7}, 128, bit 1 included first and then excluded
CALL VAXINCLEXCL\VAXINCLEXCL_LOCAL_NTG9MRPF(7)
