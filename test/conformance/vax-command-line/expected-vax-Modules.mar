;; Written by Claude, 2026-10-13, for Phase 17 step 3 (design section
;; 19.5, proposals 1 to 8, approved by the user); reviewed by the user,
;; 2026-10-13. It replaces the file the user reviewed on 2026-10-10,
;; whose Split, GetArg, GetIntArg and ArgPos this one keeps. Why this is
;; right:
;; - It imports Platform and LineOutput, so its initializer calls
;;   PLATFORM_INIT and LINEOUTPUT_INIT, then registers its own
;;   descriptor (PUSHAL L_MODULE_DESCRIPTOR, CALLS #1, G^POC_MODULE), as
;;   every module of a program containing Modules does (proposals 2 to
;;   4), and then runs Split, FindBinaryDir and FindStackBottom. There is
;;   no MODULES_INIT entry for an Init: VMS gives the command line
;;   (proposal 1).
;; - The exported variables are global symbols ("::"): res (a word under
;;   -O2), resMsg, imported and importing (256 bytes each), MainStack-
;;   Frame, ArgCount, ArgVector and BinaryDir (1024 bytes). argv,
;;   ArgCount longwords, and modules and lastListed are its own; the
;;   root table lists modules, the one pointer the collector must see.
;; - Split ends by storing the address of each argument's first byte in
;;   argv[k] and argv's address in ArgVector (proposal 8).
;; - Update calls POC_MODULES (FirstModule) for the newest descriptor
;;   and, when it is not lastListed, counts the new ones back to
;;   lastListed by each descriptor's longword 0, then enters them oldest
;;   first: Enter reads longwords 1 to 3 (name, imports, commands) by
;;   DescriptorWord, the address plus 4 times the index; adds one to each
;;   imported module's refcnt it finds; and makes a CmdDesc of each
;;   command's name and procedure, longwords 4 + imports + 2k and the
;;   next, in declaration order. ThisMod, ThisCommand and Free are
;;   rtl/llvm's, with its res and resMsg (proposal 6).
;; - Halt writes "Terminated by Halt(", the code, "). ", voc's words for
;;   a negative code (the CASE's table, -1 to -20), and an LF to
;;   LineOutput.error, then calls PLATFORM_EXIT with the code; AssertFail
;;   writes "Assertion failure." and " ASSERT code n." when n # 0, and
;;   exits with n if positive, else -1 (proposal 7; section 14, item 10
;;   makes these statuses).
;; - FindBinaryDir copies argument 0 up to its last "]" or ">", or else
;;   its last ":" before any bracket, with a 0X; FindStackBottom stores
;;   its local's address, MOVAB -4(FP), in MainStackFrame (proposal 8).
;; - On the guest, vax-modules-commands' five programs print what
;;   llvm-modules-commands' do, but ModuleTable is not found and the
;;   statuses are VMS's (%X1000001A for Halt(3), %X100007F2 for
;;   Halt(-2), %X1000003A for AssertFail(7), %X100007FA for
;;   AssertFail(0)); vax-modules-extra's ArgVector matches GetArg for
;;   each argument, BinaryDir is argument 0 up to its "]", and
;;   MainStackFrame is in P1 space; under -O2 and -OC.
; Modules, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	MODULES
	.IDENT	/c77d093894fb628f/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the module's variables
	.PSECT	POC_DATA
; res: INTEGER, exported
	.ALIGN	WORD
MODULES_RES_QKMKB3JQ::
