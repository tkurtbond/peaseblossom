$ ! PLAN.md Phase 17 step 3 (design section 19.11, proposals 1, 2 and 5):
$ ! INTEST.COM (llvm-in's intest.mod) and PROMPT.COM, which poc -build
$ ! wrote, run after poc's runtime is assembled; then each image, with
$ ! SYS$INPUT its input file. Everything made is deleted
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN @INTEST
$ IF S THEN S = $STATUS
$ IF S THEN @PROMPT
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ WRITE SYS$OUTPUT "== intest"
$ DEFINE/USER SYS$INPUT INPUT.TXT
$ RUN INTEST.EXE
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ WRITE SYS$OUTPUT "== prompt"
$ DEFINE/USER SYS$INPUT PROMPT.TXT
$ RUN PROMPT.EXE
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ CLEAN:
$ DELETE/NOLOG POCRTL.OBJ;*,LINEOUTPUT.OBJ;*,FORMATTEDOUTPUT.OBJ;*,FORMATTEDTEXT.OBJ;*,REALDIGITS.OBJ;*,OUT.OBJ;*
$ DELETE/NOLOG IN.OBJ;*,FORMATTEDINPUT.OBJ;*,DECIMALTOREAL.OBJ;*,PLATFORM.OBJ;*
$ DELETE/NOLOG INTEST.OBJ;*,INTEST.OPT;*,INTEST.EXE;*,PROMPT.OBJ;*,PROMPT.OPT;*,PROMPT.EXE;*
$ DELETE/NOLOG INPUT.TXT;*,PROMPT.TXT;*
$ EXIT 1
