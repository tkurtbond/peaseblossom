;; Written by Claude, 2026-10-13, for Phase 17 step 3 (design section
;; 19.5, proposals 1 to 8, approved by the user); not yet reviewed. Why
;; this is right:
;; - commands (llvm-modules-commands' program) imports Modules, Greeter,
;;   Out and Platform; its descriptor names the four, in that order, and
;;   has no commands, as it exports nothing. Its initializer calls the
;;   four initializers, then registers the descriptor, then runs the
;;   body, so it is the last module listed.
;; - The body is any module's code: it calls MODULES_THISMOD_...,
;;   MODULES_THISCOMMAND_... and MODULES_FREE_..., reads MODULES_RES_...
;;   (a word under -O2) and MODULES_RESMSG_..., calls a command through
;;   the procedure variable, checked for NIL (trap 4), and compares
;;   MODULES_BINARYDIR_... with PLATFORM_CWD_... by POC_STRCMP.
;; - On the guest, it prints llvm-modules-commands' lines but
;;   ModuleTable's, not found, since VMS has no ModuleTable module
;;   (proposal 5), and BinaryDir is the current directory
;;   (guest-run.expected).
; commands, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	COMMANDS
	.IDENT	/507c1bfbe6014157/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the module's variables
	.PSECT	POC_DATA
; m: POINTER TO Modules.ModuleDesc
	.ALIGN	LONG
COMMANDS_M_H7UH4KRU:
	.BLKL	1
; c: POINTER TO Modules.CmdDesc
	.ALIGN	LONG
COMMANDS_C_H7UH4IAC:
	.BLKL	1
; command: PROCEDURE
	.ALIGN	LONG
COMMANDS_COMMAND_UPKDAKPK:
	.BLKL	1

; its root table, for the collector: the next table, the count,
; and the address of each pointer its variables hold
	.PSECT	POC_DATA
	.ALIGN	LONG
L_ROOTS:
	.LONG	0
	.LONG	2
	.ADDRESS	COMMANDS_M_H7UH4KRU, COMMANDS_C_H7UH4IAC

; the symbols it uses of other modules
	.EXTERNAL	POC_ROOTS
	.EXTERNAL	POC_MODULE
	.EXTERNAL	MODULES_THISMOD_SL4L5STS
