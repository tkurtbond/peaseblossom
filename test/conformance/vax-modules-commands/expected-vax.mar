L_MD_NAME:
	.ASCIZ	/commands/
L_MD_IMPORT_1:
	.ASCIZ	/Modules/
L_MD_IMPORT_2:
	.ASCIZ	/Greeter/
L_MD_IMPORT_3:
	.ASCIZ	/Out/
L_MD_IMPORT_4:
	.ASCIZ	/Platform/
	.PSECT	POC_DATA
	.ALIGN	LONG
L_MODULE_DESCRIPTOR:
	.LONG	0
	.ADDRESS	L_MD_NAME
	.LONG	4
	.LONG	0
	.ADDRESS	L_MD_IMPORT_1
	.ADDRESS	L_MD_IMPORT_2
	.ADDRESS	L_MD_IMPORT_3
	.ADDRESS	L_MD_IMPORT_4

