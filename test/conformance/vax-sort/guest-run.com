$ ! Phase 17 step 5 (doc/developer/vms-sdl-interfaces.md, part 8): POCRTL,
$ ! VMSDEF and VMSLIB built, then SORTFILES by the procedure poc -build
$ ! wrote; HAND-SORTSYMBOLS linked with a map, SORTSYMS.MAP, which SORTFILES
$ ! reads; and SORTFILES run, then the record formats of its files
$ ! shown. Everything made is deleted.
$ SET NOON
$ @POCRTL_SETUP
$ @POCRTL_BUILD
$ WRITE SYS$OUTPUT "POCRTL_BUILD: ", $STATUS
$ @VMSDEF_SETUP
$ @VMSDEF_BUILD
$ WRITE SYS$OUTPUT "VMSDEF_BUILD: ", $STATUS
$ @VMSLIB_SETUP
$ @VMSLIB_BUILD
$ WRITE SYS$OUTPUT "VMSLIB_BUILD: ", $STATUS
$ @SORTFILES
$ WRITE SYS$OUTPUT "SORTFILES built: ", $STATUS
$ MACRO HAND-SORTSYMBOLS
$ LINK/MAP=SORTSYMS.MAP/FULL/EXECUTABLE=SORTSYMS.EXE HAND-SORTSYMBOLS
$ WRITE SYS$OUTPUT "SORTSYMBOLS linked: ", $STATUS
$ RUN SORTFILES
$ WRITE SYS$OUTPUT "run: ", $STATUS
$ ! the record formats of the input and of SORT's and MERGE's output
$ WRITE SYS$OUTPUT "STAFF.DAT: ", F$FILE_ATTRIBUTES("STAFF.DAT", "RFM")
$ WRITE SYS$OUTPUT "STAFF.SRT: ", F$FILE_ATTRIBUTES("STAFF.SRT", "RFM")
$ WRITE SYS$OUTPUT "DEPTS.SRT: ", F$FILE_ATTRIBUTES("DEPTS.SRT", "RFM")
$ WRITE SYS$OUTPUT "NAMES.MRG: ", F$FILE_ATTRIBUTES("NAMES.MRG", "RFM")
$ DELETE/NOLOG *.OBJ;*, *.OLB;*, *.EXE;*, *.OPT;*, SORTSYMS.MAP;*
$ DELETE/NOLOG STAFF.DAT;*, STAFF.SRT;*, DEPTS.SRT;*, NAMES1.DAT;*, NAMES2.DAT;*, NAMES.MRG;*
$ EXIT 1
