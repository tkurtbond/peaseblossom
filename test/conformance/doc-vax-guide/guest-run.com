$ ! doc-vax-guide: the VAX/VMS Guide's example programs built by the
$ ! procedures poc -build wrote, against POCRTL.OBJ, and each run as the
$ ! guide's session of its name runs it, under "== <name>". A build's
$ ! log is shown only if it fails. Everything made is deleted.
$ SET NOON
$ MACRO/OBJECT POCRTL.MAR
$ PROGRAMS = "HELLO,VERSIONS,WHERELOGIN,WHERELOGIN2,DATES,FACTORIAL,WORDS,SYSTEMINFO,GREET,SHELL,WARNINGS,PROBE,GOODBYE,TICKS,MAILBOX,SPAWN,FAIL,FAULT,PARTS,PANEL"
$ I = 0
$NEXT_BUILD:
$ P = F$ELEMENT(I, ",", PROGRAMS)
$ IF P .EQS. "," THEN GOTO BUILT
$ @'P'/OUTPUT=BUILD.LOG
$ IF .NOT. $STATUS THEN WRITE SYS$OUTPUT "build ", P, " failed: ", $STATUS
$ IF .NOT. $STATUS THEN TYPE BUILD.LOG
$ DELETE/NOLOG BUILD.LOG;*
$ I = I + 1
$ GOTO NEXT_BUILD
$BUILT:
$ WRITE SYS$OUTPUT "== hello"
$ RUN HELLO
$ WRITE SYS$OUTPUT "== versions"
$ RUN VERSIONS
$ WRITE SYS$OUTPUT "== wherelogin"
$ RUN WHERELOGIN
$ WRITE SYS$OUTPUT "== dates"
$ RUN DATES
$ WRITE SYS$OUTPUT "== factorial"
$ RUN FACTORIAL
$ WRITE SYS$OUTPUT "== words"
$ RUN WORDS
$ WRITE SYS$OUTPUT "== systeminfo"
$ RUN SYSTEMINFO
$ WRITE SYS$OUTPUT "== greet"
$ HERE = F$ENVIRONMENT("DEFAULT")
$ DEFINE/PROCESS GREET_IMAGE 'HERE'GREET.EXE
$ SET COMMAND GREET.CLD
$ GREET world
$ GREET/TIMES=2/NOEXCLAIM world,"Dear Reader"
$ GREET/TIMES=many world
$ GREET/LOUD world
$ DEASSIGN/PROCESS GREET_IMAGE
$ WRITE SYS$OUTPUT "== shell"
$ RUN SHELL
greet world
greet/noexclaim "Dear Reader"
count
exit
$ WRITE SYS$OUTPUT "== parts"
$ RUN PARTS
$ WRITE SYS$OUTPUT "== panel"
$ PANEL := $'F$ENVIRONMENT("DEFAULT")'PANEL
$ PANEL PANEL.LIS
$ SEARCH PANEL.LIS "|","+"
$ DELETE/NOLOG PANEL.LIS;*
$ DELETE/SYMBOL PANEL
$ WRITE SYS$OUTPUT "== warnings"
$ RUN WARNINGS
$ WRITE SYS$OUTPUT "== probe"
$ RUN PROBE
$ WRITE SYS$OUTPUT "== goodbye"
$ RUN GOODBYE
$ WRITE SYS$OUTPUT "== ticks"
$ RUN TICKS
$ WRITE SYS$OUTPUT "== mailbox"
$ RUN MAILBOX
$ WRITE SYS$OUTPUT "== spawn"
$ RUN SPAWN
$ WRITE SYS$OUTPUT "== fail"
$ RUN FAIL
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== fault"
$ RUN FAULT
$ WRITE SYS$OUTPUT "== faultdebug"
$ MACRO/DEBUG/OBJECT FAULT.MAR
$ LINK/EXECUTABLE=FAULT.EXE FAULT.OPT/OPTIONS, POCRTL.OBJ
$ RUN FAULT
$ IF F$SEARCH("NOTES.TXT") .NES. "" THEN DELETE/NOLOG NOTES.TXT;*
$ DELETE/NOLOG *.OBJ;*, *.EXE;*, *.OPT;*
$ EXIT 1
