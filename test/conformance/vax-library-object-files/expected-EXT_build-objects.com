$ ! Written by poc: builds the library EXT, EXT.OLB and EXT.EXE
$ ! (doc/developer/vax-macro32-backend.md, section 18). Run it where
$ ! the library's .OBJ and .MAR files are, once the setup procedure of each
$ ! library it needs has been run.
$ ! An object sent in binary from Linux or a BSD, fixed-length records,
$ ! is converted first, by OBJCONVERT, which poc's SETUP.COM defines.
$ ON WARNING THEN EXIT $STATUS
$ IF F$TRNLNM("POC$LIB_POCRTL") .NES. "" THEN GOTO NEED_1
$ WRITE SYS$ERROR "library EXT needs library POCRTL: run its POCRTL_SETUP.COM first"
$ EXIT %X1000002C
$NEED_1:
$ IF F$FILE_ATTRIBUTES("EXTLIB.OBJ", "RFM") .NES. "FIX" THEN GOTO CONVERTED_1
$ OBJCONVERT EXTLIB.OBJ EXTLIB.OBJ
$ DELETE/NOLOG EXTLIB.OBJ;-1
$CONVERTED_1:
$ IF F$FILE_ATTRIBUTES("HELPER.OBJ", "RFM") .NES. "FIX" THEN GOTO CONVERTED_2
$ OBJCONVERT HELPER.OBJ HELPER.OBJ
$ DELETE/NOLOG HELPER.OBJ;-1
$CONVERTED_2:
$ IF F$FILE_ATTRIBUTES("EVERY.OBJ", "RFM") .NES. "FIX" THEN GOTO CONVERTED_3
$ OBJCONVERT EVERY.OBJ EVERY.OBJ
$ DELETE/NOLOG EVERY.OBJ;-1
$CONVERTED_3:
$ MACRO/OBJECT THRICE.MAR
$ LIBRARY/CREATE/OBJECT EXT.OLB
$ LIBRARY/INSERT EXT.OLB EXTLIB.OBJ
$ LIBRARY/INSERT EXT.OLB THRICE.OBJ
$ LIBRARY/INSERT EXT.OLB HELPER.OBJ
$ LIBRARY/INSERT EXT.OLB EVERY.OBJ
$ CREATE EXT.OPT
EXT.OLB/INCLUDE=(-
EXTLIB)
THRICE.OBJ
HELPER.OBJ
EVERY.OBJ
POCRTL/SHAREABLE
UNIVERSAL=EXTLIB_QUADRUPLE_F2UMV32O
UNIVERSAL=EXTLIB_INIT
UNIVERSAL=POC_K1_BBB0CB6667F8EBBD
UNIVERSAL=THRICE
UNIVERSAL=HELPER_INIT
UNIVERSAL=HELPER_MAIN
UNIVERSAL=ENTRY_A
UNIVERSAL=PROC_B
UNIVERSAL=ENTRY_C
UNIVERSAL=PROC_D
$ LINK/SHAREABLE=EXT.EXE EXT.OPT/OPTIONS
$ EXIT $STATUS
