$ ! PLAN.md Phase 17 step 3 (design section 19.19, proposal 4):
$ ! TEXTSUSE.COM (llvm-texts' program, renamed) and FILEBYTES.COM, which
$ ! poc -build wrote, run after poc's runtime is assembled; then TEXTSUSE,
$ ! whether PLAIN.TEXT, closed twice, is two versions and no more, and
$ ! FILEBYTES on the files TEXTSUSE wrote. Everything made is deleted
$ SET NOON
$ IF F$SEARCH("ELEMENTS.TEXT") .NES. "" THEN DELETE/NOLOG ELEMENTS.TEXT;*
$ IF F$SEARCH("PLAIN.TEXT") .NES. "" THEN DELETE/NOLOG PLAIN.TEXT;*
$ IF F$SEARCH("LINES.TXT") .NES. "" THEN DELETE/NOLOG LINES.TXT;*
$ MACRO/OBJECT POCRTL.MAR
$ S = $STATUS
$ IF S THEN @TEXTSUSE
$ IF S THEN S = $STATUS
$ IF S THEN @FILEBYTES
$ IF S THEN S = $STATUS
$ WRITE SYS$OUTPUT "build status: ", S
$ IF .NOT. S THEN GOTO CLEAN
$ RUN TEXTSUSE.EXE
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ OLDER = "no older version"
$ IF F$SEARCH("PLAIN.TEXT;-1") .NES. "" THEN OLDER = "an older version"
$ IF F$SEARCH("PLAIN.TEXT;-2") .NES. "" THEN OLDER = "more than two versions"
$ WRITE SYS$OUTPUT "plain.Text: ", OLDER
$ FILEBYTES :== $SYS$LOGIN:FILEBYTES.EXE
$ FILEBYTES "elements.Text" "plain.Text" "lines.txt"
$ WRITE SYS$OUTPUT "run status: ", $STATUS
$ DELETE/SYMBOL/GLOBAL FILEBYTES
$ CLEAN:
$ IF F$SEARCH("ELEMENTS.TEXT") .NES. "" THEN DELETE/NOLOG ELEMENTS.TEXT;*
$ IF F$SEARCH("PLAIN.TEXT") .NES. "" THEN DELETE/NOLOG PLAIN.TEXT;*
$ IF F$SEARCH("LINES.TXT") .NES. "" THEN DELETE/NOLOG LINES.TXT;*
$ DELETE/NOLOG POCRTL.OBJ;*,GARBAGECOLLECTEDHEAP.OBJ;*,LINEOUTPUT.OBJ;*,PLATFORM.OBJ;*,FILES.OBJ;*
$ DELETE/NOLOG MODULES.OBJ;*,ARGS.OBJ;*,DECIMALTOREAL.OBJ;*,REALS.OBJ;*,REALDIGITS.OBJ;*
$ DELETE/NOLOG TEXTS.OBJ;*,FORMATTEDTEXT.OBJ;*,FORMATTEDOUTPUT.OBJ;*,OUT.OBJ;*
$ DELETE/NOLOG TEXTSUSE.OBJ;*,TEXTSUSE.OPT;*,TEXTSUSE.EXE;*
$ DELETE/NOLOG FILEBYTES.OBJ;*,FILEBYTES.OPT;*,FILEBYTES.EXE;*
$ EXIT 1
