;; Reviewed 2026-10-09 (written by Claude; for the user's review). Why
;; this is right: constants need no code or data - a constant is folded
;; where it is used - and a type only its descriptor, below, so the
;; module is otherwise exactly vax-empty-module's layout under its own
;; name: .TITLE VAXDECLARATIONSONLY (19 characters), .IDENT with the key
;; of its own .sym, which differs from VaxEmpty's, and
;; VAXDECLARATIONSONLY_INIT, 24 characters, within the 31 (section 5).
;; See vax-empty-module's expected-vax.mar for the rest.
;; - Step 8 (decided 2026-10-08) adds the module's key, POC_K1_ and its
;;   .sym's key, a global symbol its importers declare .EXTERNAL, and, as
;;   it is the program's main module, the program's start,
;;   VAXDECLARATIONSONLY_MAIN, which calls the initializer, returns
;;   SS$_NORMAL and is named by .END.
;; - Phase 16 step 3 (section 14, item 4) adds Point's type descriptor,
;;   as every record type declared at the module's level gets, in
;;   POC_CONST: its size, 4, extension level 0, no pointers, and its own
;;   address as its base type at level 0. Its symbol is global, label::,
;;   for an importer's NEW, and named as a variable would be (section 5):
;;   VAXDECLARATIONSONLY_POINT and the hash are more than 31 characters,
;;   so the name is cut to VAXDECLARATIONSONLY_PO_UEV18DS3. Line, an
;;   array type, gets none: an array's descriptor is made where NEW
;;   needs one.
; VaxDeclarationsOnly, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	VAXDECLARATIONSONLY
	.IDENT	/2cb9a82338548e80/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; its type descriptors (section 14, item 4): size, extension level,
; pointer count, base types, pointer offsets
	.PSECT	POC_CONST
; VaxDeclarationsOnly.Point
	.ALIGN	LONG
VAXDECLARATIONSONLY_PO_UEV18DS3::
	.LONG	4
	.LONG	0
	.LONG	0
	.ADDRESS	VAXDECLARATIONSONLY_PO_UEV18DS3

; the module's initializer: once only
	.PSECT	POC_CODE
	.ENTRY	VAXDECLARATIONSONLY_INIT, ^M<>
	BLBS	L_INITIALISED, L_DONE
	MOVB	#1, L_INITIALISED
L_DONE:
	RET

; the module's key, which its importers refer to
POC_K1_2CB9A82338548E80 == 0

; the program's start: the module's initializer, then SS$_NORMAL
	.ENTRY	VAXDECLARATIONSONLY_MAIN, ^M<>
	CALLS	#0, VAXDECLARATIONSONLY_INIT
	MOVL	#1, R0
	RET

	.END	VAXDECLARATIONSONLY_MAIN
