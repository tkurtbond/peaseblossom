! Each procedure called by the debugger, POC_SCRATCH holding a VAR
! parameter's variable or a HUGEINT (in MACRO a symbol's value is its
! address); R0 cleared before a proper procedure, the debugger showing it.
! Scale(-3, 7) is -21; Scale(127, -32768) -32768 (the product wraps at
! INTEGER); Scale(-128, -1) 128
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_SCALE_92OHOEOC(-3, 7, POC_SCRATCH)
EXAMINE/LONG POC_SCRATCH
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_SCALE_92OHOEOC(127, -32768, POC_SCRATCH)
EXAMINE/LONG POC_SCRATCH
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_SCALE_92OHOEOC(-128, -1, POC_SCRATCH)
EXAMINE/LONG POC_SCRATCH
! Down: 7, 1, 0, 0, 15 halvings of 100, 1, 0, -5 and 32767
CALL VAXPARAMETERS\VAXPARAMETERS_DOWN_UIJ2BLVM(100)
CALL VAXPARAMETERS\VAXPARAMETERS_DOWN_UIJ2BLVM(1)
CALL VAXPARAMETERS\VAXPARAMETERS_DOWN_UIJ2BLVM(0)
CALL VAXPARAMETERS\VAXPARAMETERS_DOWN_UIJ2BLVM(-5)
CALL VAXPARAMETERS\VAXPARAMETERS_DOWN_UIJ2BLVM(32767)
! Upto: sum 0 + 7 + .. + 10 = 34; 5 (11 > 10); 0 + -2 + .. + 10 = 52
DEPOSIT/LONG POC_SCRATCH = 0
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_UPTO_GBN0F39E(7, POC_SCRATCH)
EXAMINE/LONG POC_SCRATCH
DEPOSIT/LONG POC_SCRATCH = 5
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_UPTO_GBN0F39E(11, POC_SCRATCH)
EXAMINE/LONG POC_SCRATCH
DEPOSIT/LONG POC_SCRATCH = 0
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_UPTO_GBN0F39E(-2, POC_SCRATCH)
EXAMINE/LONG POC_SCRATCH
! Swap(a, b), a = 5 and b = 9 at POC_SCRATCH + 8 and + 10: 9 and 5;
! Pass(1, b): b is 1 (n's copy swapped, not the caller's)
DEPOSIT/WORD POC_SCRATCH+8 = 5
DEPOSIT/WORD POC_SCRATCH+10 = 9
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_SWAP_IIOIM9M9(POC_SCRATCH+8, POC_SCRATCH+10)
EXAMINE/WORD POC_SCRATCH+8:POC_SCRATCH+11
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_PASS_JEJGG1VV(1, POC_SCRATCH+10)
EXAMINE/WORD POC_SCRATCH+8:POC_SCRATCH+11
! Double(x, y), x at + 16, y at + 24: 6000000000; -2; 2^62 doubled wraps
! to MIN(HUGEINT)
DEPOSIT/QUADWORD POC_SCRATCH+16 = 3000000000
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_DOUBLE_RQMJ5T9J(POC_SCRATCH+16, POC_SCRATCH+24)
EXAMINE/QUADWORD POC_SCRATCH+24
DEPOSIT/QUADWORD POC_SCRATCH+16 = -1
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_DOUBLE_RQMJ5T9J(POC_SCRATCH+16, POC_SCRATCH+24)
EXAMINE/QUADWORD POC_SCRATCH+24
DEPOSIT/QUADWORD POC_SCRATCH+16 = 4611686018427387904
DEPOSIT R0 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_DOUBLE_RQMJ5T9J(POC_SCRATCH+16, POC_SCRATCH+24)
EXAMINE/QUADWORD POC_SCRATCH+24
! High(x, flags), x at + 16: 1 (x = 1, {3}); 0 (x = 1, {0 .. 2}); 0
! (x = 0); 0 (x = -1); 1 (x = 2^32: high 1, low 0); 1 (x = 2^31: high 0,
! low 80000000H, unsigned)
DEPOSIT/QUADWORD POC_SCRATCH+16 = 1
CALL VAXPARAMETERS\VAXPARAMETERS_HIGH_QON8QAOE(POC_SCRATCH+16, 8)
CALL VAXPARAMETERS\VAXPARAMETERS_HIGH_QON8QAOE(POC_SCRATCH+16, 7)
DEPOSIT/QUADWORD POC_SCRATCH+16 = 0
CALL VAXPARAMETERS\VAXPARAMETERS_HIGH_QON8QAOE(POC_SCRATCH+16, 8)
DEPOSIT/QUADWORD POC_SCRATCH+16 = -1
CALL VAXPARAMETERS\VAXPARAMETERS_HIGH_QON8QAOE(POC_SCRATCH+16, 8)
DEPOSIT/QUADWORD POC_SCRATCH+16 = 4294967296
CALL VAXPARAMETERS\VAXPARAMETERS_HIGH_QON8QAOE(POC_SCRATCH+16, 8)
DEPOSIT/QUADWORD POC_SCRATCH+16 = 2147483648
CALL VAXPARAMETERS\VAXPARAMETERS_HIGH_QON8QAOE(POC_SCRATCH+16, 8)
EXIT
