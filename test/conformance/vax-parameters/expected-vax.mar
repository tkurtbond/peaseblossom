;; Reviewed 2026-10-06 (written by Claude, from the design, the MACRO
;; manual and the VAX's listing; for the user's review). Why this is right:
;; - The n-th parameter is the n-th longword of the argument list, 4n(AP)
;;   (CallStd 2.3). A value parameter of a longword or less is its value,
;;   read at its own width (the list holds it extended to a longword):
;;   Scale's b is CVTBW 4(AP), w MULW2 8(AP); High's flags is tested in
;;   place, BBC #3, 8(AP).
;; - A VAR parameter is its variable's address: @12(AP), deferred, so
;;   CVTWL R0, @12(AP) writes Scale's result, ADDL2 adds to Upto's sum,
;;   and Swap moves @4(AP) and @8(AP) through its local t.
;; - The list is read-only to the callee (CallStd 2.3), so a value
;;   parameter the body changes is copied to the frame on entry (decided
;;   2026-10-06): Down's n, assigned; Upto's limit, a FOR variable;
;;   Pass's n, passed as a VAR argument - MOVAB -2(FP) gives Swap the
;;   copy's address. Pass's m, already an address, is passed on with MOVL
;;   8(AP).
;; - A HUGEINT value parameter is the address of a copy (section 7):
;;   Double copies it again, MOVQ @4(AP), -8(FP). Its VAR y is reached
;;   through R2, MOVL 8(AP), R2, since @8(AP) cannot name the second
;;   longword: (R2) and 4(R2), ADDL2 then ADWC. High's x is read-only,
;;   x-, so not copied: the same through R2. R2 is in both masks.
;; - High's x > 0 compares the high longword signed, then the low one
;;   unsigned, as in step 3; & is the step-3 short circuit.
; VaxParameters, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	VAXPARAMETERS
	.IDENT	/d38be97da73d4737/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/VaxParameters/

; the module's procedures
	.PSECT	POC_CODE
; PROCEDURE Scale
VAXPARAMETERS_SCALE_92OHOEOC:
	.WORD	^M<>
; line 15
	CVTBW	4(AP), R0
	MULW2	8(AP), R0
	CVTWL	R0, @12(AP)
	RET
; PROCEDURE Down
VAXPARAMETERS_DOWN_UIJ2BLVM:
	.WORD	^M<>
	SUBL2	#4, SP
	CLRL	-4(FP)
	MOVW	4(AP), -2(FP)
; line 21
L_1:
	TSTW	-2(FP)
	BGTR	L_3
	JMP	L^L_2
L_3:
; line 21
	DIVW3	#2, -2(FP), R0
	MULW3	R0, #2, R1
	SUBW3	R1, -2(FP), R1
	BEQL	L_4
	XORW2	#2, R1
	BGEQ	L_4
	DECW	R0
L_4:
	MOVW	R0, -2(FP)
; line 21
	INCW	-4(FP)
	JMP	L^L_1
L_2:
; line 22
	CVTWL	-4(FP), R0
	RET
	PUSHL	#3
	PUSHL	#23
	PUSHAB	L_MODULE_NAME
	PUSHL	#12
	CALLS	#4, POC_TRAP
; PROCEDURE Upto
VAXPARAMETERS_UPTO_GBN0F39E:
	.WORD	^M<>
	SUBL2	#4, SP
	CLRL	-4(FP)
	MOVW	4(AP), -2(FP)
; line 27
L_5:
	CMPW	-2(FP), #10
	BLEQ	L_7
	JMP	L^L_6
L_7:
; line 27
	CVTWL	-2(FP), R0
	ADDL2	R0, @8(AP)
	INCW	-2(FP)
	JMP	L^L_5
L_6:
	RET
; PROCEDURE Swap
VAXPARAMETERS_SWAP_IIOIM9M9:
	.WORD	^M<>
	SUBL2	#4, SP
	CLRL	-4(FP)
; line 33
	MOVW	@4(AP), -2(FP)
; line 33
	MOVW	@8(AP), @4(AP)
; line 33
	MOVW	-2(FP), @8(AP)
	RET
; PROCEDURE Pass
VAXPARAMETERS_PASS_JEJGG1VV:
	.WORD	^M<>
	SUBL2	#16, SP
	CLRL	-4(FP)
	MOVW	4(AP), -2(FP)
; line 38
	MOVL	#2, -16(FP)
	MOVAB	-2(FP), -12(FP)
	MOVL	8(AP), -8(FP)
	CALLG	-16(FP), VAXPARAMETERS_SWAP_IIOIM9M9
	RET
; PROCEDURE Double
VAXPARAMETERS_DOUBLE_RQMJ5T9J:
	.WORD	^M<R2>
	SUBL2	#8, SP
	CLRQ	-8(FP)
	MOVQ	@4(AP), -8(FP)
; line 43
	MOVL	8(AP), R2
	MOVQ	-8(FP), (R2)
	ADDL2	-8(FP), (R2)
	ADWC	-4(FP), 4(R2)
	RET
; PROCEDURE High
VAXPARAMETERS_HIGH_QON8QAOE:
	.WORD	^M<R2>
; line 48
	MOVL	4(AP), R2
	CLRB	R0
	TSTL	4(R2)
	BGTR	L_8
	BLSS	L_9
	TSTL	(R2)
	BLEQU	L_9
L_8:
	MOVB	#1, R0
L_9:
	BLBS	R0, L_10
	JMP	L^L_11
L_10:
	CLRB	R1
	BBC	#3, 8(AP), L_12
	MOVB	#1, R1
L_12:
	MOVB	R1, R0
L_11:
	MOVZBL	R0, R0
	RET
	PUSHL	#3
	PUSHL	#49
	PUSHAB	L_MODULE_NAME
	PUSHL	#12
	CALLS	#4, POC_TRAP

; the module's initializer: once only
	.PSECT	POC_CODE
	.ENTRY	VAXPARAMETERS_INIT, ^M<>
	BLBS	L_INITIALISED, L_DONE
	MOVB	#1, L_INITIALISED
L_DONE:
	RET

	.END
