;; Reviewed 2026-10-11 by the user (written by Claude, from the design,
;; the MACRO manual and the guest runs). Why this is right:
;; - Phase 16 step 6 (section 17): POC.EXE on the guest failed with an
;;   access violation at its first .sym, in ModuleInterface.HashStart:
;;   hash[0] := 25H, hash a VAR ARRAY 8 OF LONGINT, a quadword under -OC,
;;   was MOVL #^X25, @4(AP) and CLRL @8(AP). Element 0 kept the
;;   parameter's deferred operand, @4(AP), and the high longword added 4
;;   to its displacement, which names the next argument's target. No
;;   operand names 4 bytes past the target of @4(AP).
;; - Now a deferred parameter is rebased for a wide element or field (a
;;   quadword or a G_floating) at offset 0 too, as it already was for one
;;   at any other offset: MOVL 4(AP), R0, then (R0) and 4(R0). So
;;   StartFirst's two quadword immediates are two MOVLs each through R0
;;   (a, then p at 8(AP), its type tag at 12(AP) unused), and IncFirst
;;   is ADDL2 to (R0) and ADWC to 4(R0).
;; - A whole quadword or G_floating moved (MOVQ, MOVG) was right before
;;   and is the same form now, through R0: First, PairFirst, RealFirst,
;;   SetPair's p.h and SetReal's r.r; a value parameter still comes in
;;   by MOVQ @n(AP) into the frame.
;; - WideOut, run on the guest under -O2 and -OC, prints what the LLVM
;;   build prints (output.expected).
; VaxDeferredWide, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	VAXDEFERREDWIDE
	.IDENT	/b5297e0df44bc04a/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/VaxDeferredWide/

; its type descriptors (section 14, item 4): size, extension level,
; pointer count, base types, pointer offsets
	.PSECT	POC_CONST
