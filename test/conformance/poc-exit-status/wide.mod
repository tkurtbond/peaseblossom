MODULE wide;
  VAR g: INTEGER;
  PROCEDURE ["C", "write"] SysWrite(fd: LONGINT; s: ARRAY OF CHAR; n: HUGEINT);
  PROCEDURE Deep(VAR a: ARRAY OF ARRAY OF ARRAY OF ARRAY OF ARRAY OF ARRAY OF ARRAY OF ARRAY OF ARRAY OF INTEGER);
  BEGIN g := 1
  END Deep;
BEGIN
  g := 0;
  IF g = 0 THEN SysWrite(1, "ok", 2) ELSE SysWrite(1, "WRONG", 5) END
END wide.
