! and [69001] still "Z" (90), the 0X found in LOCC's second piece and the
! characters moved in two MOVC3s
DEPOSIT R0 = 0
CALL VAXCOPYLONG\VAXCOPYLONG_FILL_0LCBF4AM(69000)
