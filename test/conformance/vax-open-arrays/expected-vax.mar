;; Reviewed 2026-10-09 (written by Claude, from design section 14, the
;; MACRO manual, the guest runs and the debugger runs; for the user's
;; review). Why this is right:
;; - An open array parameter is its address, then a longword for each open
;;   dimension's length, so that Length's s is 4(AP) and its length 8(AP),
;;   Sum's x 4(AP) with lengths 8(AP) and 12(AP). A caller passes a fixed
;;   array's length as an immediate, and an open array's own (PassOn
;;   passes the copy's address, -4(FP), and 8(AP)).
;; - Only the operations on characters know 0X: a string literal's length
;;   counts it ("hello", 6), COPY stops at it, and = compares as strings.
;;   Everything else goes by the lengths times the element size, whatever
;;   the element type: LEN, indexing, the copy at entry and assignment.
;; - A value open array is copied at entry: its lengths times its element
;;   size (MULL2 #2 for Total's INTEGERs), rounded up to a longword, are
;;   taken from SP at run time, the copy's address kept in the frame, and
;;   the bytes moved by MOVC3 in pieces of at most 65535; since MOVC3
;;   changes R0-R5, the mask saves R2-R5. RET gives the space back.
;;   Change's a[0] := "Z" and Total's a[3] := 0 change the copies, not s
;;   or n (bits 64 and 512; Total sums all four of n's elements).
;; - An element is checked against its length, unsigned (CMPL, BLSSU), so
;;   that a negative index fails too (At's CVTWL sign-extends it), then
;;   addressed through the copy's address or the parameter's,
;;   @-4(FP)[R0] or @4(AP)[R0], which index mode scales by the element's
;;   size; a two-dimensional one's first index is scaled by the second
;;   length and the element size. The index-trap run traps with code 2 at
;;   line 72, column 14.
;; - COPY into or out of an open array takes the most of LEN(dst) - 1 and
;;   the source's length (folded to #7 for t), looks for 0X with LOCC
;;   within it, moves that many and ends with 0X; = calls POC_STRCMP with
;;   both lengths.
;; - Assigning an open array to a fixed one traps with code 9 at line 67,
;;   column 10, before anything is moved, when LEN(a) > 8 (the assign-trap
;;   run, t still empty); else it moves LEN(a) times the element size
;;   bytes, so that AssignInts moves all 8 bytes of n into u (bit 1024).
;; - The values run exits with bits = 2047, %X00007FF1: all 11 checks
;;   hold, as they do in the -O2 and -OC builds run on the VAX.
; VaxOpenArrays, written by poc (doc/developer/vax-macro32-backend.md)
	.TITLE	VAXOPENARRAYS
	.IDENT	/7e95d3d1df8db31f/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD

; set once the module has been initialised
	.PSECT	POC_DATA
L_INITIALISED:
	.BLKB	1

; the module's variables
	.PSECT	POC_DATA
; s: ARRAY 16 OF CHAR
VAXOPENARRAYS_S_OOKJRF1L:
	.BLKB	16
; t: ARRAY 8 OF CHAR
VAXOPENARRAYS_T_OOKJRC2G:
	.BLKB	8
; m: ARRAY 3 OF ARRAY 4 OF INTEGER
	.ALIGN	WORD
VAXOPENARRAYS_M_OOKJR93B:
	.BLKB	24
; bits: LONGINT
	.ALIGN	LONG
VAXOPENARRAYS_BITS_C1541UDK:
	.BLKL	1
; mode: INTEGER
	.ALIGN	WORD
VAXOPENARRAYS_MODE_EV21NUI7:
	.BLKW	1
; c: CHAR
VAXOPENARRAYS_C_OOKJR885:
	.BLKB	1
; n: ARRAY 4 OF INTEGER
	.ALIGN	WORD
VAXOPENARRAYS_N_OOKJR9GU:
	.BLKB	8
; u: ARRAY 4 OF INTEGER
	.ALIGN	WORD
VAXOPENARRAYS_U_OOKJRCG3:
	.BLKB	8

; the symbols it uses of other modules
	.EXTERNAL	POC_STRCMP
	.EXTERNAL	SYS$EXIT

; for traps: poc's runtime routine (Phase 16), and the module's name
	.EXTERNAL	POC_TRAP
	.PSECT	POC_CONST
L_MODULE_NAME:
	.ASCIC	/VaxOpenArrays/

; its string constants
	.PSECT	POC_CONST
L_STR_1:
	.ASCII	/abc/
	.BYTE	0
L_STR_2:
	.ASCII	/123456789/
	.BYTE	0
L_STR_3:
	.ASCII	/hello/
	.BYTE	0
L_STR_4:
	.ASCII	/abd/
	.BYTE	0
L_STR_5:
	.ASCII	/longer than eight/
	.BYTE	0
L_STR_6:
	.ASCII	/longer /
	.BYTE	0
L_STR_7:
	.ASCII	/12345/
	.BYTE	0
L_STR_8:
	.ASCII	/abcdefghij/
	.BYTE	0
L_STR_9:
	.ASCII	/abcdefg/
	.BYTE	0

