;; Reviewed 2026-10-10 by the user (written by Claude, from design
;; section 16, the VAX architecture's floating point and the guest
;; runs). Why this is right:
;; - The integer lines are the host's: wrapping is the same on the VAX.
;; - The VAX has no infinity and no NaN. Reals() divides 1.0 by 0.0
;;   first, which on the VAX is a floating divide by zero fault, not an
;;   infinity, so the program stops there: none of the real lines is
;;   printed (expected-vax-overflow-*.err and .status say how it stops).
SHORTINT -128 127 -2 -128
INTEGER  -32768 32767 -2 -32768
LONGINT  -2147483648 2147483647 -2 -2147483648
HUGEINT  -9223372036854775808 9223372036854775807 -2 -9223372036854775808
ABS(MIN) -128 -32768 -2147483648 -9223372036854775808
INC(MAX) -128 -32768 -2147483648 -9223372036854775808
DEC(MIN) 127 32767 2147483647 9223372036854775807
DIV/MOD  -4 -1 -4 1
