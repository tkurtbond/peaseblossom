; Coroutines' switch and its new stacks' first frames, the part of
; rtl/vax/Coroutines.Mod that cannot be Oberon (doc/developer/coroutines.md,
; Phase 4; concurrency-survey.md, option B, whose prototype this was).
; A coroutine is left in POC_COROUTINE_SWITCH's frame, which holds R2-R11
; and the caller's AP, FP and PC, and its FP is all Coroutines keeps of
; it. A new stack starts with a frame that looks like one of these, made
; by POC_COROUTINE_FRAME, whose RET goes to POC_COROUTINE_START.
	.TITLE	COROUTINESWITCH
	.IDENT	/COROUTINES-4/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG

	.PSECT	POC_CODE
; POC_COROUTINE_SWITCH(VAR from: ADDRESS; to: ADDRESS): the running
; coroutine's FP stored in from, its registers saved by the entry mask,
; and the coroutine whose FP is to resumed by the RET from its own frame
; (a switch's, or a new stack's first). from may be the variable to was
; passed from: to is passed by value.
	.ENTRY	POC_COROUTINE_SWITCH, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVL	FP, @4(AP)
	MOVL	8(AP), FP
	RET

; POC_COROUTINE_FRAME(start, high, chain): R0 the FP of a frame made at
; high - 64, the top of a new stack, as CALLS would have made it: no
; handler; the mask and PSW word with the CALLS bit and R2-R11 saved; AP
; at the argument count of 0 above the registers, which RET pops; the
; saved FP chain, the main program's frame, so that a traceback or SHOW
; CALLS lists the coroutine's routines down to POC_COROUTINE_START and
; stops there (survey 8.7.2: with no chain there is no traceback at all);
; the saved PC POC_COROUTINE_START's first instruction; and start as R2,
; the others 0. R2-R5 saved for MOVC5
	.ENTRY	POC_COROUTINE_FRAME, ^M<R2,R3,R4,R5>
	SUBL3	#64, 8(AP), R0
	MOVC5	#0, (R0), #0, #64, (R0)
	SUBL3	#64, 8(AP), R0
	MOVL	#^X2FFC0000, 4(R0)
	ADDL3	#60, R0, 8(R0)
	MOVL	12(AP), 12(R0)
	MOVAB	POC_COROUTINE_START+2, 16(R0)
	MOVL	4(AP), 20(R0)
	RET

; POC_COROUTINE_START: where a new stack's first frame returns to, with
; R2 the routine to call, Coroutines' Start, which never returns. A
; routine of its own, so that the traceback names it on its last line;
; the $EXIT is only for a start that did return: trap 16's status
	.ENTRY	POC_COROUTINE_START, ^M<>
	CALLS	#0, (R2)
	$EXIT_S	CODE=#^X10000082
	RET

	.END
