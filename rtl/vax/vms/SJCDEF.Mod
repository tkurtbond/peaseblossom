    SJC$V_ACCT_CCVENAB* = 13; (* Charge code validation *)
    SJC$V_ACCT_UNUSED* = 14;
    SJC$S_ACCT_UNUSED* = 18;
    (* Subfields of DIAGNOSTIC_FLAGS item code. *)
    SJC$M_DIAG_COPY_QF* = 01H;
    SJC$M_DIAG_CREATE_MF* = 02H;
    SJC$M_DIAG_CLOSE_MF* = 04H;
    SJC$M_DIAG_OPEN_MF* = 08H;
    SJC$M_DIAG_CLEAR_FLAGS* = 010H;
    SJC$M_DIAG_LOG_ALL_TRANS* = 020H;
    SJC$M_DIAG_JOURNAL_PUTS* = 040H;
    SJC$M_DIAG_DUMP_DIAG_BUFFER* = 080H;
    SJC$M_DIAG_INIT_DIAG_BUFFER* = 0100H;
    SJC$V_DIAG_COPY_QF* = 0; (* Make copy of the queue file *)
    SJC$V_DIAG_CREATE_MF* = 1; (* Create new monitor log file and begin monitoring *)
    SJC$V_DIAG_CLOSE_MF* = 2; (* Stop monitoring and close monitor log file *)
    SJC$V_DIAG_OPEN_MF* = 3; (* Open existing monitor log file and resume monitoring *)
    SJC$V_DIAG_CLEAR_FLAGS* = 4; (* Clear monitoring flags in queue file header record *)
    SJC$V_DIAG_LOG_ALL_TRANS* = 5; (* Log read-only transactions in addition to basic monitoring *)
    SJC$V_DIAG_JOURNAL_PUTS* = 6; (* Journal queue file $PUT operations in addition to basic monitoring *)
    SJC$V_DIAG_DUMP_DIAG_BUFFER* = 7; (* Return contents of diagnostic buffer to caller *)
    SJC$V_DIAG_INIT_DIAG_BUFFER* = 8; (* Initialize diagnostic buffer and zero cumulative counters *)
    SJC$V_DIAG_UNUSED* = 9;
    SJC$S_DIAG_UNUSED* = 23;

END SJCDEF.
