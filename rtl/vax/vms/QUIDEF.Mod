    QUI$V_PEND_NO_ACCESS* = 4; (* User does not have access to queue *)
    QUI$V_PEND_QUEUE_BUSY* = 5; (* Job is ready to execute but must wait until other jobs ahead of it in the queue *)
    QUI$V_PEND_QUEUE_STATE* = 6; (* Queue state prevents job from executing (see QUI$_QUEUE_STATUS for more info) *)
    QUI$V_PEND_STOCK_MISMATCH* = 7; (* Stock type of mounted form on output execution queue does not match *)
    (* Subfields of QUEUE_FLAGS item code. *)
    QUI$M_QUEUE_BATCH* = 01H;
    QUI$M_QUEUE_CPU_DEFAULT* = 02H;
    QUI$M_QUEUE_CPU_LIMIT* = 04H;
    QUI$M_QUEUE_FILE_BURST* = 08H;
    QUI$M_QUEUE_FILE_BURST_ONE* = 010H;
    QUI$M_QUEUE_FILE_FLAG* = 020H;
    QUI$M_QUEUE_FILE_FLAG_ONE* = 040H;
    QUI$M_QUEUE_FILE_TRAILER* = 080H;
    QUI$M_QUEUE_FILE_TRAILER_ONE* = 0100H;
    QUI$M_QUEUE_GENERIC* = 0200H;
    QUI$M_QUEUE_GENERIC_SELECTION* = 0400H;
    QUI$M_QUEUE_JOB_BURST* = 0800H;
    QUI$M_QUEUE_JOB_FLAG* = 01000H;
    QUI$M_QUEUE_JOB_SIZE_SCHED* = 02000H;
    QUI$M_QUEUE_JOB_TRAILER* = 04000H;
    QUI$M_QUEUE_RETAIN_ALL* = 08000H;
    QUI$M_QUEUE_RETAIN_ERROR* = 010000H;
    QUI$M_QUEUE_SWAP* = 020000H;
    QUI$M_QUEUE_TERMINAL* = 040000H;
    QUI$M_QUEUE_WSDEFAULT* = 080000H;
    QUI$M_QUEUE_WSEXTENT* = 0100000H;
    QUI$M_QUEUE_WSQUOTA* = 0200000H;
    QUI$M_QUEUE_FILE_PAGINATE* = 0400000H;
    QUI$M_QUEUE_RECORD_BLOCKING* = 0800000H;
    QUI$M_QUEUE_PRINTER* = 01000000H;
    QUI$M_QUEUE_ACL_SPECIFIED* = 02000000H;
    QUI$M_QUEUE_NOTIFY_ON_INTERRUPT* = 04000000H;
    QUI$M_QUEUE_CHECKPOINT_FREQ* = 08000000H;
    QUI$M_QUEUE_AUTOSTART* = 010000000H;
    QUI$V_QUEUE_BATCH* = 0; (* /BATCH *)
    QUI$V_QUEUE_CPU_DEFAULT* = 1; (* /CPUDEFAULT specified *)
    QUI$V_QUEUE_CPU_LIMIT* = 2; (* /CPUMAXIMUM specified *)
    QUI$V_QUEUE_FILE_BURST* = 3; (* /DEFAULT=BURST=ALL *)
    QUI$V_QUEUE_FILE_BURST_ONE* = 4; (* /DEFAULT=BURST=ONE *)
    QUI$V_QUEUE_FILE_FLAG* = 5; (* /DEFAULT=FLAG=ALL *)
    QUI$V_QUEUE_FILE_FLAG_ONE* = 6; (* /DEFAULT=FLAG=ONE *)
    QUI$V_QUEUE_FILE_TRAILER* = 7; (* /DEFAULT=TRAILER=ALL *)
    QUI$V_QUEUE_FILE_TRAILER_ONE* = 8; (* /DEFAULT=TRAILER=ONE *)
    QUI$V_QUEUE_GENERIC* = 9; (* /GENERIC *)
    QUI$V_QUEUE_GENERIC_SELECTION* = 10; (* /ENABLE_GENERIC *)
    QUI$V_QUEUE_JOB_BURST* = 11; (* /SEPARATE=BURST *)
    QUI$V_QUEUE_JOB_FLAG* = 12; (* /SEPARATE=FLAG *)
    QUI$V_QUEUE_JOB_SIZE_SCHED* = 13; (* /SCHEDULE=SIZE *)
    QUI$V_QUEUE_JOB_TRAILER* = 14; (* /SEPARATE=TRAILER *)
    QUI$V_QUEUE_RETAIN_ALL* = 15; (* /RETAIN=ALL *)
    QUI$V_QUEUE_RETAIN_ERROR* = 16; (* /RETAIN=ERROR *)
    QUI$V_QUEUE_SWAP* = 17; (* /NODISABLE_SWAPPING *)
    QUI$V_QUEUE_TERMINAL* = 18; (* /DEVICE=TERMINAL or terminal device type reported by symbiont *)
    QUI$V_QUEUE_WSDEFAULT* = 19; (* /WSDEFAULT specified *)
    QUI$V_QUEUE_WSEXTENT* = 20; (* /WSEXTENT specified *)
    QUI$V_QUEUE_WSQUOTA* = 21; (* /WSQUOTA specified *)
    QUI$V_QUEUE_FILE_PAGINATE* = 22; (* /DEFAULT=FEED *)
    QUI$V_QUEUE_RECORD_BLOCKING* = 23; (* /RECORD_BLOCKING *)
    QUI$V_QUEUE_PRINTER* = 24; (* /DEVICE=PRINTER or printer device type reported by symbiont *)
    QUI$V_QUEUE_ACL_SPECIFIED* = 25; (* ACL has been specified for queue *)
    QUI$V_QUEUE_NOTIFY_ON_INTERRUPT* = 26; (* /NOTIFY=INTERRUPTION *)
    QUI$V_QUEUE_CHECKPOINT_FREQ* = 27; (* /CHECKPOINT_FREQUENCY specified *)
    QUI$V_QUEUE_AUTOSTART* = 28; (* /AUTOSTART_ON specified *)
    (* Subfields of QUEUE_STATUS item code. *)
    QUI$M_QUEUE_ALIGNING* = 01H;
    QUI$M_QUEUE_IDLE* = 02H;
    QUI$M_QUEUE_LOWERCASE* = 04H;
    QUI$M_QUEUE_OPERATOR_REQUEST* = 08H;
    QUI$M_QUEUE_PAUSED* = 010H;
    QUI$M_QUEUE_PAUSING* = 020H;
    QUI$M_QUEUE_REMOTE* = 040H;
    QUI$M_QUEUE_RESETTING* = 080H;
    QUI$M_QUEUE_RESUMING* = 0100H;
    QUI$M_QUEUE_SERVER* = 0200H;
    QUI$M_QUEUE_STALLED* = 0400H;
    QUI$M_QUEUE_STARTING* = 0800H;
    QUI$M_QUEUE_STOPPED* = 01000H;
    QUI$M_QUEUE_STOPPING* = 02000H;
    QUI$M_QUEUE_UNAVAILABLE* = 04000H;
    QUI$M_QUEUE_CLOSED* = 08000H;
    QUI$M_QUEUE_BUSY* = 010000H;
    QUI$M_QUEUE_UNDEFINED* = 020000H;
    QUI$M_QUEUE_AVAILABLE* = 040000H;
    QUI$M_QUEUE_DISABLED* = 080000H;
    QUI$M_QUEUE_AUTOSTART_INACTIVE* = 0100000H;
    QUI$M_QUEUE_STOP_PENDING* = 0200000H;
    QUI$V_QUEUE_ALIGNING* = 0; (* Queue is aligning *)
    QUI$V_QUEUE_IDLE* = 1; (* Queue is idle:  no jobs executing and none available for execution *)
    QUI$V_QUEUE_LOWERCASE* = 2; (* Lowercase device *)
    QUI$V_QUEUE_OPERATOR_REQUEST* = 3; (* Queue is doing /OPERATOR (intentionally not documented) *)
    QUI$V_QUEUE_PAUSED* = 4; (* Queue is paused *)
    QUI$V_QUEUE_PAUSING* = 5; (* Queue is pausing *)
    QUI$V_QUEUE_REMOTE* = 6; (* Remote device *)
    QUI$V_QUEUE_RESETTING* = 7; (* Incomplete remote request to reset  (OBSOLETE) *)
    QUI$V_QUEUE_RESUMING* = 8; (* Queue is resuming from paused state *)
    QUI$V_QUEUE_SERVER* = 9; (* /DEVICE=SERVER or reported to be a served queue by the symbiont *)
    QUI$V_QUEUE_STALLED* = 10; (* Device is stalled *)
    QUI$V_QUEUE_STARTING* = 11; (* Queue is starting *)
    QUI$V_QUEUE_STOPPED* = 12; (* Queue is stopped *)
    QUI$V_QUEUE_STOPPING* = 13; (* Queue is stopping *)
    QUI$V_QUEUE_UNAVAILABLE* = 14; (* Device is unavailable *)
    QUI$V_QUEUE_CLOSED* = 15; (* Queue is closed *)
    QUI$V_QUEUE_BUSY* = 16; (* Queue is executing as many jobs as it is capable of executing *)
    QUI$V_QUEUE_UNDEFINED* = 17; (* Queue does not yet exist in db or is being removed from db *)
    QUI$V_QUEUE_AVAILABLE* = 18; (* At least one job is executing, but the queue is capable of executing more *)
    QUI$V_QUEUE_DISABLED* = 19; (* Queue is not able to accept or process jobs; its QSIs are inactive *)
    QUI$V_QUEUE_AUTOSTART_INACTIVE* = 20; (* AUTOSTART queue explicitly stopped *)
    QUI$V_QUEUE_STOP_PENDING* = 21; (* Queue will be stopped when work currently in progress has completed *)
    (* Subfields of SEARCH_FLAGS item code. *)
    QUI$M_SEARCH_ALL_JOBS* = 01H;
    QUI$M_SEARCH_WILDCARD* = 02H;
    QUI$M_SEARCH_BATCH* = 04H;
    QUI$M_SEARCH_SYMBIONT* = 08H;
    QUI$M_SEARCH_THIS_JOB* = 010H;
    QUI$M_SEARCH_PRINTER* = 020H;
    QUI$M_SEARCH_SERVER* = 040H;
    QUI$M_SEARCH_TERMINAL* = 080H;
    QUI$M_SEARCH_GENERIC* = 0100H;
    QUI$M_SEARCH_GENERIC_TARGET* = 0200H;
    QUI$M_SEARCH_PENDING_JOBS* = 0400H;
    QUI$M_SEARCH_EXECUTING_JOBS* = 0800H;
    QUI$M_SEARCH_TIMED_RELEASE_JOBS* = 01000H;
    QUI$M_SEARCH_HOLDING_JOBS* = 02000H;
    QUI$M_SEARCH_RETAINED_JOBS* = 04000H;
    QUI$M_SEARCH_FREEZE_CONTEXT* = 08000H;
    QUI$V_SEARCH_ALL_JOBS* = 0; (* Select all jobs (else only those with same username as caller) *)
    QUI$V_SEARCH_WILDCARD* = 1; (* Force a wildcard operation *)
    QUI$V_SEARCH_BATCH* = 2; (* Select batch queues *)
    QUI$V_SEARCH_SYMBIONT* = 3; (* Select symbiont (output) queues (note that QUI$V_SEARCH_SYMBIONT is equivalent *)
    QUI$V_SEARCH_THIS_JOB* = 4; (* Select only caller's batch job (forcing new context) *)
    QUI$V_SEARCH_PRINTER* = 5; (* Select printer queues *)
    QUI$V_SEARCH_SERVER* = 6; (* Select server queues *)
    QUI$V_SEARCH_TERMINAL* = 7; (* Select terminal queues *)
    QUI$V_SEARCH_GENERIC* = 8; (* Select generic queues *)
    QUI$V_SEARCH_GENERIC_TARGET* = 9; (* Select generic target queues after selecting generic queue (for internal use) *)
    QUI$V_SEARCH_PENDING_JOBS* = 10; (* Select only pending jobs *)
    QUI$V_SEARCH_EXECUTING_JOBS* = 11; (* Select only executing jobs *)
    QUI$V_SEARCH_TIMED_RELEASE_JOBS* = 12; (* Select only timed release jobs *)
    QUI$V_SEARCH_HOLDING_JOBS* = 13; (* Select only holding jobs *)
    QUI$V_SEARCH_RETAINED_JOBS* = 14; (* Select only retained jobs *)
    QUI$V_SEARCH_FREEZE_CONTEXT* = 15; (* Do not advance wildcard context to next object in list at end of operation *)
    (* Subfields of SYMBIONT_FLAGS item code.

       Note: this item code is intentionally not documented and reserved for Digital use. *)
    QUI$M_SYM_NOTIFIES* = 01H;
    QUI$M_SYM_REQUESTS_OPER* = 02H;
    QUI$M_SYM_COPIES_FILE* = 04H;
    QUI$M_SYM_COPIES_JOB* = 08H;
    QUI$M_SYM_ACCEPTS_ALL_FORMS* = 010H;
    QUI$M_SYM_NO_JOB_CHECKPOINT* = 020H;
    QUI$V_SYM_NOTIFIES* = 0; (* Symbiont notifies for job completions *)
    QUI$V_SYM_REQUESTS_OPER* = 1; (* Symbiont generates operator messages *)
    QUI$V_SYM_COPIES_FILE* = 2; (* Symbiont generates multiple file copies *)
    QUI$V_SYM_COPIES_JOB* = 3; (* Symbiont generates multiple job copies *)
    QUI$V_SYM_ACCEPTS_ALL_FORMS* = 4; (* Symbiont processes all form types *)
    QUI$V_SYM_NO_JOB_CHECKPOINT* = 5; (* Always reprocess full job on a restart *)

END QUIDEF.
