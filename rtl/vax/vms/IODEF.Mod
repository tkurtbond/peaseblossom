    IO$V_LOCKBUF* = 8; (* Direct I/O request *)
    IO$V_NOBLOCK* = 9; (* Segment message w/o blocking *)
    IO$V_ABORT* = 8; (* Disconnect abort/connect reject *)
    IO$V_SYNCH* = 9; (* Synchronous disconnect *)
    IO$V_RESPONSE* = 6; (* Transmit this packet as a response *)
    IO$V_STARTUP* = 6; (* Start protocol *)
    IO$V_SHUTDOWN* = 7; (* Stop protocol *)
    IO$V_ATTNAST* = 8; (* Attention AST *)
    IO$V_CTRL* = 9; (* Controller (ie. not station) function *)
    IO$V_SET_MAC* = 11; (* Set MAC parameters *)
    IO$V_RD_MEM* = 6; (* Read device memory *)
    IO$V_RD_MODEM* = 7; (* Read modem status *)
    IO$V_RD_COUNT* = 8; (* Read counters *)
    IO$V_CLR_COUNT* = 10; (* Clear counters *)
    IO$V_SENSE_MAC* = 11; (* Sense MAC parameters *)
    IO$V_MORE* = 6; (* More data follows (M-bit) *)
    IO$V_QUALIFIED* = 7; (* Use qualified sub-channel (Q-bit) *)
    IO$V_REDIRECT* = 6; (* Redirect virtual call *)
    IO$V_ACCEPT* = 7; (* Accept virtual call *)
    IO$V_SETEVF* = 6; (* Set event flag *)
    IO$V_WORD* = 6; (* Word (interrupt)/block (DMA) mode specifier *)
    IO$V_SETFNCT* = 9; (* Set "FNCT" bits in device CSR *)
    IO$V_DATAPATH* = 10; (* Change UBA datapath (direct/buffered) *)
    IO$V_CYCLE* = 12; (* Set "cycle" bit in device CSR *)
    IO$V_RESET* = 13; (* Device reset specifier *)
    IO$V_SETCUADR* = 8; (* Set a new CU address *)
    IO$V_SETBSIZE* = 9; (* Set a new maximum buffer size *)
    IO$V_SETPOOLSZ* = 10; (* Set a new pool size *)
    IO$V_SETENQCNT* = 11; (* Set a new ENQ threshold *)
    IO$V_CLEAR* = 12; (* Zero status counters *)
    IO$V_LPBEXT* = 13; (* Loopback is external loopback *)
    IO$V_LPBINT* = 14; (* Loopback is internal loopback (DUP11) *)
    IO$V_READCSR* = 15; (* Read CSRs on DUP11 *)
    IO$V_NOCTSWAIT* = 6; (* Diagnostic function *)
    IO$V_SLAVLOOP* = 7; (* Diagnostic function *)
    IO$V_NODSRWAIT* = 8; (* Do not wait for DSR (diag) *)
    IO$V_MAINTLOOP* = 9; (* Internal maint loop *)
    IO$V_LASTBLOCK* = 10; (* Last block of message *)
    IO$V_INTCLOCK* = 12; (* Internal clock *)
    IO$V_LT_CONNECT* = 6; (* Solicit connection to remote LAT device *)
    IO$V_LT_DISCON* = 7; (* Disconnect LAT session *)
    IO$V_LT_READPORT* = 8; (* Read LAT device info *)
    IO$V_LT_MAP_PORT* = 9; (* Map application port *)
    IO$V_LT_RATING* = 10; (* Set service rating *)
    IO$V_LT_SOL_INFO* = 11; (* Request solicit info *)
    IO$V_LT_RCV_INFO* = 12; (* Setup to recive reply *)
    IO$V_LT_SETMODE* = 13; (* SETMODE on LTA device *)
    IO$V_LT_SENSEMODE* = 14; (* SENSEMODE on LTA device *)
    IO$V_LT_MAP_FILLER* = 0; (* Item 0 not used *)
    IO$V_LT_MAP_NODNAM* = 1; (* Server node name *)
    IO$V_LT_MAP_PORNAM* = 2; (* Server port name *)
    IO$V_LT_MAP_SRVNAM* = 3; (* Server service name *)
    IO$V_LT_MAP_LNKNAM* = 4; (* Link name *)
    IO$V_LT_MAP_NETADR* = 5; (* Server Ethernet Add. *)

END IODEF.
