    NSA$C_PKT_UAF_MODIFY* = 53; (* UAF record modified *)
    NSA$C_PKT_UAF_COPY* = 54; (* UAF record copied *)
    NSA$C_PKT_UAF_FIELDS* = 55; (* UAF fields modified *)
    NSA$C_PKT_USERNAME* = 56; (* Requestor username *)
    NSA$C_PKT_UAF_SOURCE* = 57; (* UAF source username *)
    NSA$C_PKT_UAF_RENAME* = 58; (* UAF record renamed *)
    NSA$C_PKT_VOLUME_NAME* = 59; (* Mount/dismount volume name *)
    NSA$C_PKT_VOLUME_SET_NAME* = 60; (* Volume set name *)
    (* Define client/server packets. *)
    NSA$C_PKT_SERVER_ACCOUNT* = 61; (* Server account *)
    NSA$C_PKT_SERVER_SYSTEM_ID* = 62; (* Server system id *)
    NSA$C_PKT_SERVER_SYSTEM_NAME* = 63; (* Server system name *)
    NSA$C_PKT_SERVER_FINAL_STATUS* = 64; (* Server status *)
    NSA$C_PKT_SERVER_IMAGE_NAME* = 65; (* Server image name *)
    NSA$C_PKT_SERVER_PARENT_ID* = 66; (* Server parent id *)
    NSA$C_PKT_SERVER_PARENT_OWNER* = 67; (* Server parent owner *)
    NSA$C_PKT_SERVER_PARENT_NAME* = 68; (* Server parent process name *)
    NSA$C_PKT_SERVER_PROCESS_ID* = 69; (* Server process id *)
    NSA$C_PKT_SERVER_PROCESS_NAME* = 70; (* Server process name *)
    NSA$C_PKT_SERVER_SUBJECT_CLASS* = 71; (* Server classification *)
    NSA$C_PKT_SERVER_SUBJECT_OWNER* = 72; (* Server owner ('UIC') *)
    NSA$C_PKT_SERVER_TERMINAL* = 73; (* Server terminal *)
    NSA$C_PKT_SERVER_TIME_STAMP* = 74; (* Server timestamp *)
    NSA$C_PKT_SERVER_USERNAME* = 75; (* Server username *)
    (* Additional packets. *)
    NSA$C_PKT_AUDIT_DISABLE* = 76; (* Audit event disable mask *)
    NSA$C_PKT_AUDIT_ENABLE* = 77; (* Audit event enable mask *)
    NSA$C_PKT_ALARM_DISABLE* = 78; (* Alarm event disable mask *)
    NSA$C_PKT_ALARM_ENABLE* = 79; (* Alarm event enable mask *)
    NSA$C_PKT_PERFORMANCE_NOP* = 80; (* No-op (delete) packet for performance *)
    NSA$C_PKT_REPLY_MAILBOX* = 81; (* Message acknowledge mailbox *)
    NSA$C_PKT_DEFAULT_USERNAME* = 82; (* NETUAF default proxy account *)
    NSA$C_PKT_LOCAL_USERNAME* = 83; (* NETUAF local proxy account *)
    NSA$C_PKT_FIELD_NAME* = 84; (* Name of (NEW_DATA/ORIGINAL_DATA) field *)
    NSA$C_PKT_LISTENER_DEVICE* = 85; (* Listener device name *)
    NSA$C_PKT_FIELD_TITLE_STR* = 86; (* Field title string (formerly PKT_RESERVED_1_1) *)
    NSA$C_PKT_FIELD_DATA_STR* = 87; (* Field data string (formerly PKT_RESERVED_1_2) *)
    NSA$C_PKT_MESSAGE_TYPE_STR* = 88; (* Event message type string (formerly PKT_RESERVED_1_3) *)
    NSA$C_PKT_RESERVED_1_4* = 89; (* Reserved packet codes, block 1 *)
    NSA$C_PKT_RESERVED_1_5* = 90;
    NSA$C_PKT_RESERVED_1_6* = 91;
    NSA$C_PKT_RESERVED_1_7* = 92;
    NSA$C_PKT_RESERVED_1_8* = 93;
    NSA$C_PKT_CUSTOMER_1* = 94; (* Customer packet codes, block 1 *)
    NSA$C_PKT_CUSTOMER_2* = 95;
    NSA$C_PKT_CUSTOMER_3* = 96;
    NSA$C_PKT_CUSTOMER_4* = 97;
    NSA$C_PKT_CUSTOMER_5* = 98;
    NSA$C_PKT_CUSTOMER_6* = 99;
    NSA$C_PKT_CUSTOMER_7* = 100;
    NSA$C_PKT_CUSTOMER_8* = 101;
    NSA$C_PKT_CSS_1* = 102; (* CSS packet codes, block 1 *)
    NSA$C_PKT_CSS_2* = 103;
    NSA$C_PKT_CSS_3* = 104;
    NSA$C_PKT_CSS_4* = 105;
    NSA$C_PKT_CSS_5* = 106;
    NSA$C_PKT_CSS_6* = 107;
    NSA$C_PKT_CSS_7* = 108;
    NSA$C_PKT_CSS_8* = 109;
    NSA$C_PKT_LP_1* = 110; (* Layered product packet codes, block 1 *)
    NSA$C_PKT_LP_2* = 111;
    NSA$C_PKT_LP_3* = 112;
    NSA$C_PKT_LP_4* = 113;
    NSA$C_PKT_LP_5* = 114;
    NSA$C_PKT_LP_6* = 115;
    NSA$C_PKT_LP_7* = 116;
    NSA$C_PKT_LP_8* = 117;
    NSA$C_PKT_ALARM_FAILURE* = 118; (* Alarm failure mode *)
    NSA$C_PKT_AUDIT_FAILURE* = 119; (* Audit failure mode *)
    NSA$C_PKT_MAX_CODE* = 120; (* Must be last *)
    NSA$C_PKT_HDR_LENGTH* = 4;
    NSA$K_PKT_HDR_LENGTH* = 4;
    NSA$_ACCESS_DESIRED* = 1; (* Access requested *)
    NSA$_ACCOUNT* = 2; (* Account name *)
    NSA$_ALARM_NAME* = 3; (* Alarm journal name *)
    NSA$_APPL_DATA* = 4; (* Application supplied data *)
    NSA$_AUDIT_FLAGS* = 5; (* Audit flags *)
    NSA$_AUDIT_NAME* = 6; (* Audit journal name *)
    NSA$_SYSTEM_NAME* = 7; (* SCS system node name *)
    NSA$_SYSTEM_ID* = 8; (* SCS system node identification *)
    NSA$_DEVICE_NAME* = 9; (* Primary device name on which the volume resides *)
    NSA$_DISMOUNT_FLAGS* = 10; (* Volume dismount flags *)
    NSA$_HOLDER_NAME* = 11; (* Holder name *)
    NSA$_HOLDER_OWNER* = 12; (* Holder owner ID *)
    NSA$_ID_ATTRIBUTES* = 13; (* Identifier attributes *)
    NSA$_ID_NAME* = 14; (* Identifier name *)
    NSA$_ID_NEW_NAME* = 15; (* Identifer new name *)
    NSA$_ID_VALUE* = 16; (* Identifier value *)
    NSA$_ID_NEW_VALUE* = 17; (* Identifier new value *)
    NSA$_IDENTIFIERS_USED* = 18; (* Identifiers used to gain access *)
    NSA$_IMAGE_NAME* = 19; (* Name of the image being executed *)
    NSA$_INSTALL_FILE* = 20; (* Installed file *)
    NSA$_INSTALL_FLAGS* = 21; (* INSTALL flags *)
    NSA$_INSTALL_PRIVS* = 22; (* INSTALL privileges *)
    NSA$_LOGICAL_NAME* = 23; (* Logical name associated with the device. *)
    NSA$_MOUNT_FLAGS* = 24; (* Volume mount flags *)
    NSA$_NEW_DATA* = 25; (* Data after modification *)
    NSA$_OBJECT_ID* = 26; (* Unique object identification code *)
    NSA$_OBJECT_MIN_CLASS* = 27; (* Minimum object access classification *)
    NSA$_OBJECT_MAX_CLASS* = 28; (* Maximum object access classification *)
    NSA$_OBJECT_NAME* = 29; (* The object's name *)
    NSA$_OBJECT_NAME_2* = 30; (* Secondary (path) object name *)
    NSA$_OBJECT_OWNER* = 31; (* Owner identifier (UIC) of the process *)
    NSA$_OBJECT_PROTECTION* = 32; (* UIC based protection of the object *)
    NSA$_OBJECT_TYPE* = 33; (* Object's type code *)
    NSA$_ORIGINAL_DATA* = 34; (* Data before modification *)
    NSA$_PARENT_ID* = 35; (* PID of the parent process *)
    NSA$_PARENT_NAME* = 36; (* Parent process' name *)
    NSA$_PARENT_OWNER* = 37; (* Parent process' current 'UIC' *)
    NSA$_PARENT_USERNAME* = 38; (* Parent process' username *)
    NSA$_PASSWORD* = 39; (* Breakin password *)
    NSA$_PRIVS_USED* = 40; (* Privileges used to gain access *)
    NSA$_PROCESS_ID* = 41; (* Current process PID *)
    NSA$_PROCESS_NAME* = 42; (* Current process name *)
    NSA$_REMOTE_NODE_ID* = 43; (* Node ID of network source *)
    NSA$_REMOTE_NODENAME* = 44; (* Remote nodename *)
    NSA$_REMOTE_USERNAME* = 45; (* Remote username *)
    NSA$_SUBJECT_CLASS* = 46; (* Process' current access class *)
    NSA$_SUBJECT_OWNER* = 47; (* Process' current 'UIC' *)
    NSA$_FINAL_STATUS* = 48; (* Completion status *)
    NSA$_TERMINAL* = 49; (* Process' terminal name *)
    NSA$_TIME_STAMP* = 50; (* When the event took place *)
    NSA$_UAF_ADD* = 51; (* UAF record added *)
    NSA$_UAF_DELETE* = 52; (* UAF record removed *)
    NSA$_UAF_MODIFY* = 53; (* UAF record modified *)
    NSA$_UAF_COPY* = 54; (* UAF record copied *)
    NSA$_UAF_FIELDS* = 55; (* UAF fields modified *)
    NSA$_USERNAME* = 56; (* Requestor username *)
    NSA$_UAF_SOURCE* = 57; (* Secondary username *)
    NSA$_UAF_RENAME* = 58; (* UAF record renamed *)
    NSA$_VOLUME_NAME* = 59; (* Mount/dismount volume name *)
    NSA$_VOLUME_SET_NAME* = 60; (* Volume set name *)
    NSA$_SERVER_ACCOUNT* = 61; (* Server account *)
    NSA$_SERVER_SYSTEM_ID* = 62; (* Server system id *)
    NSA$_SERVER_SYSTEM_NAME* = 63; (* Server system name *)
    NSA$_SERVER_FINAL_STATUS* = 64; (* Server status *)
    NSA$_SERVER_IMAGE_NAME* = 65; (* Server image name *)
    NSA$_SERVER_PARENT_ID* = 66; (* Server parent id *)
    NSA$_SERVER_PARENT_OWNER* = 67; (* Server parent owner *)
    NSA$_SERVER_PARENT_NAME* = 68; (* Server parent process name *)
    NSA$_SERVER_PROCESS_ID* = 69; (* Server process id *)
    NSA$_SERVER_PROCESS_NAME* = 70; (* Server process name *)
    NSA$_SERVER_SUBJECT_CLASS* = 71; (* Server classification *)
    NSA$_SERVER_SUBJECT_OWNER* = 72; (* Server owner ('UIC') *)
    NSA$_SERVER_TERMINAL* = 73; (* Server terminal *)
    NSA$_SERVER_TIME_STAMP* = 74; (* Server timestamp *)
    NSA$_SERVER_USERNAME* = 75; (* Server username *)
    NSA$_AUDIT_DISABLE* = 76; (* Audit event disable mask *)
    NSA$_AUDIT_ENABLE* = 77; (* Audit event enable mask *)
    NSA$_ALARM_DISABLE* = 78; (* Alarm event disable mask *)
    NSA$_ALARM_ENABLE* = 79; (* Alarm event enable mask *)
    NSA$_PERFORMANCE_NOP* = 80; (* No-op (delete) packet for performance *)
    NSA$_REPLY_MAILBOX* = 81; (* Message acknowledge mailbox *)
    NSA$_DEFAULT_USERNAME* = 82; (* NETUAF proxy default account *)
    NSA$_LOCAL_USERNAME* = 83; (* NETUAF proxy local account *)
    NSA$_FIELD_NAME* = 84; (* Name of (NEW_DATA/ORIGINAL_DATA) field *)
    NSA$_LISTENER_DEVICE* = 85; (* Listener device name *)
    NSA$_FIELD_TITLE_STR* = 86; (* Field title string (formerly RESERVED_1_1) *)
    NSA$_FIELD_DATA_STR* = 87; (* Field data string (formerly RESERVED_1_2) *)
    NSA$_MESSAGE_TYPE_STR* = 88; (* Event message type string (formerly RESERVED_1_3) *)
    NSA$_RESERVED_1_4* = 89; (* Reserved packet codes, block 1 *)
    NSA$_RESERVED_1_5* = 90;
    NSA$_RESERVED_1_6* = 91;
    NSA$_RESERVED_1_7* = 92;
    NSA$_RESERVED_1_8* = 93;
    NSA$_CUSTOMER_1* = 94; (* Customer packet codes, block 1 *)
    NSA$_CUSTOMER_2* = 95;
    NSA$_CUSTOMER_3* = 96;
    NSA$_CUSTOMER_4* = 97;
    NSA$_CUSTOMER_5* = 98;
    NSA$_CUSTOMER_6* = 99;
    NSA$_CUSTOMER_7* = 100;
    NSA$_CUSTOMER_8* = 101;
    NSA$_CSS_1* = 102; (* CSS packet codes, block 1 *)
    NSA$_CSS_2* = 103;
    NSA$_CSS_3* = 104;
    NSA$_CSS_4* = 105;
    NSA$_CSS_5* = 106;
    NSA$_CSS_6* = 107;
    NSA$_CSS_7* = 108;
    NSA$_CSS_8* = 109;
    NSA$_LP_1* = 110; (* Layered product packet codes, block 1 *)
    NSA$_LP_2* = 111;
    NSA$_LP_3* = 112;
    NSA$_LP_4* = 113;
    NSA$_LP_5* = 114;
    NSA$_LP_6* = 115;
    NSA$_LP_7* = 116;
    NSA$_LP_8* = 117;
    NSA$_MAX_ITM_CODE* = 118; (* Must be last *)
    NSA$_CLIENT_ACCOUNT* = 2;
    NSA$_CLIENT_SYSTEM_ID* = 8;
    NSA$_CLIENT_SYSTEM_NAME* = 7;
    NSA$_CLIENT_FINAL_STATUS* = 48;
    NSA$_CLIENT_IMAGE_NAME* = 19;
    NSA$_CLIENT_PARENT_ID* = 35;
    NSA$_CLIENT_PARENT_OWNER* = 37;
    NSA$_CLIENT_PARENT_NAME* = 36;
    NSA$_CLIENT_PROCESS_ID* = 41;
    NSA$_CLIENT_PROCESS_NAME* = 42;
    NSA$_CLIENT_SUBJECT_CLASS* = 46;
    NSA$_CLIENT_SUBJECT_OWNER* = 47;
    NSA$_CLIENT_TERMINAL* = 49;
    NSA$_CLIENT_TIME_STAMP* = 50;
    NSA$_CLIENT_USERNAME* = 56;
    NSA$S_NSADATADEF* = 5;
    NSA$W_PACKET_SIZE* = 0; (* Data packet size *)
    NSA$W_PACKET_TYPE* = 2; (* Data packet type *)
    NSA$R_PACKET_DATA* = 4; (* Start of packet data *)

  TYPE
    NSADATADEF* = RECORD (* 5 bytes, which poc pads to 6 *)
      NSA$W_PACKET_SIZE*: SYSTEM.CARD16;
      NSA$W_PACKET_TYPE*: SYSTEM.CARD16;
      NSA$R_PACKET_DATA*: SYSTEM.CARD8
    END;

  CONST
    (* Define flag masks for NSA$EVENT_AUDIT supplied parameter.
       Each bit set tells NSA$EVENT_AUDIT *not* to default that
       corresponding packet from the current process. *)
    NSA$M_ACCOUNT_NAME* = 01H;
    NSA$M_SYSTEM_ID* = 02H;
    NSA$M_SYSTEM_NAME* = 04H;
    NSA$M_FINAL_STATUS* = 08H;
    NSA$M_IMAGE_NAME* = 010H;
    NSA$M_PARENT_ID* = 020H;
    NSA$M_PARENT_OWNER* = 040H;
    NSA$M_PARENT_NAME* = 080H;
    NSA$M_PROCESS_ID* = 0100H;
    NSA$M_PROCESS_NAME* = 0200H;
    NSA$M_SUBJECT_CLASS* = 0400H;
    NSA$M_SUBJECT_OWNER* = 0800H;
    NSA$M_TERMINAL* = 01000H;
    NSA$M_TIME_STAMP* = 02000H;
    NSA$M_USERNAME* = 04000H;
    NSA$M_PARENT_USERNAME* = 08000H;
    NSA$V_ACCOUNT_NAME* = 0; (* account *)
    NSA$V_SYSTEM_ID* = 1; (* system id *)
    NSA$V_SYSTEM_NAME* = 2; (* system name *)
    NSA$V_FINAL_STATUS* = 3; (* status *)
    NSA$V_IMAGE_NAME* = 4; (* image name *)
    NSA$V_PARENT_ID* = 5; (* parent id *)
    NSA$V_PARENT_OWNER* = 6; (* parent owner *)
    NSA$V_PARENT_NAME* = 7; (* parent process name *)
    NSA$V_PROCESS_ID* = 8; (* process id *)
    NSA$V_PROCESS_NAME* = 9; (* process name *)
    NSA$V_SUBJECT_CLASS* = 10; (* classification *)
    NSA$V_SUBJECT_OWNER* = 11; (* owner ('UIC') *)
    NSA$V_TERMINAL* = 12; (* terminal *)
    NSA$V_TIME_STAMP* = 13; (* timestamp *)
    NSA$V_USERNAME* = 14; (* username *)
    NSA$V_PARENT_USERNAME* = 15; (* parent username *)
    (* Define the format of an audit server reply message.  This defines the
       format of the message written to any supplied reply mailbox. *)
    NSA$C_REPLY_LENGTH* = 4;
    NSA$K_REPLY_LENGTH* = 4;
    NSA$S_NSAREPLYDEF* = 4;
    NSA$L_REPLY_STATUS* = 0; (* condition status value *)

  TYPE
    NSAREPLYDEF* = RECORD (* 4 bytes *)
      NSA$L_REPLY_STATUS*: SYSTEM.CARD32
    END;

  CONST
    (* Define the structure of a message formating table entry.  These entries define
       the order in which the data packets are displayed, and the manner in which they
       are formatted. *)
    NSA$C_FMTINF_NONE* = 0; (* No value to format *)
    NSA$C_FMTINF_LONG_VALUE* = 1; (* Value is supplied as a longword *)
    NSA$C_FMTINF_IDENTIFIER* = 2; (* Value supplied is an identifier *)
    NSA$C_FMTINF_DATE* = 3; (* Value supplied is address of quadword date *)
    NSA$C_FMTINF_STRING* = 4; (* String size (count) and address supplied to FAO *)
    NSA$C_FMTINF_CLASSIFICATION* = 5; (* Vector represents a classification *)
    NSA$C_FMTINF_SPECIAL* = 6; (* Special processing required *)
    NSA$M_FMTINF_CHECK_PREVIOUS* = 01H;
    NSA$M_FMTINF_NTH_NEW_LINE* = 02H;
    NSA$M_FMTINF_NOFORMAT* = 04H;
    NSA$M_FMTINF_SENSITIVE* = 08H;
    NSA$K_FMTINF_LENGTH* = 28;
    NSA$C_FMTINF_LENGTH* = 28;
    (* Define the format style codes. *)
    NSA$C_FORMAT_STYLE_BRIEF* = 1; (* Single line briefly formatted message *)
    NSA$C_FORMAT_STYLE_FULL* = 2; (* Fully formatted message *)
    NSA$C_FORMAT_STYLE_PACKET_TYPE* = 3; (* Packet type format *)
    NSA$S_FMTTBLDEF* = 28;
    NSA$L_FMTINF_PACKET_NAME* = 0; (* Address of the packet name descriptor *)
    NSA$W_FMTINF_PACKET_TYPE* = 4; (* Define the type of packet represented by this entry (NSA$C_PKT_xxx) *)
    NSA$W_FMTINF_OUTPUT_ORDER* = 6; (* Define the order in the output buffer *)
    NSA$L_FMTINF_FAO_CTRSTR* = 8; (* Normal FAO control string *)
    NSA$L_FMTINF_CLIENT_FAO_CTRSTR* = 12; (* FAO control string for client/server combination *)
    NSA$L_FMTINF_NTH_FAO_CTRSTR* = 16; (* FAO control string for the Nth packet of the same type *)
    NSA$B_FMTINF_DATA_TYPE* = 20; (* Type of data to format *)
    NSA$B_FMTINF_FMT_FLAGS* = 21;
    NSA$V_FMTINF_CHECK_PREVIOUS* = 0; (* Check adjacency with previous output item *)
    NSA$V_FMTINF_NTH_NEW_LINE* = 1; (* Force duplicate packets to a new line *)
    NSA$V_FMTINF_NOFORMAT* = 2; (* Don't format the packet(s) *)
    NSA$V_FMTINF_SENSITIVE* = 3; (* Packet contains sensitive information *)
    NSA$W_FMTINF_SERVER_PKT* = 22; (* Associated (server) packet *)
    NSA$W_FMTINF_INDENT* = 24; (* Indent for multi-line packets *)

  TYPE
    FMTTBLDEF* = RECORD (* 28 bytes *)
      NSA$L_FMTINF_PACKET_NAME*: SYSTEM.CARD32;
      NSA$W_FMTINF_PACKET_TYPE*: SYSTEM.CARD16;
      NSA$W_FMTINF_OUTPUT_ORDER*: SYSTEM.CARD16;
      NSA$L_FMTINF_FAO_CTRSTR*: SYSTEM.CARD32;
      NSA$L_FMTINF_CLIENT_FAO_CTRSTR*: SYSTEM.CARD32;
      NSA$L_FMTINF_NTH_FAO_CTRSTR*: SYSTEM.CARD32;
      NSA$B_FMTINF_DATA_TYPE*: SYSTEM.CARD8;
      NSA$B_FMTINF_FMT_FLAGS*: SYSTEM.CARD8;
      NSA$W_FMTINF_SERVER_PKT*: SYSTEM.CARD16;
      NSA$W_FMTINF_INDENT*: SYSTEM.CARD16;
      fill1: SYSTEM.CARD16
    END;

  CONST
    (* Define the structure of the format image callout block.  This block is used to determine
       which routines should be used to format event messages and event message data packets that
       are unknown to the base VMS operating system. *)
    NSA$K_IMGXFR_LENGTH* = 25;
    NSA$C_IMGXFR_LENGTH* = 25;
    NSA$S_FMTCALLDEF* = 25;
    NSA$L_IMGXFR_FLINK* = 0; (* Address of next entry (must be first) *)
    NSA$L_IMGXFR_BLINK* = 4; (* Address of previous entry (must be secomd) *)
    NSA$W_IMGXFR_SIZE* = 8; (* Size of entry block *)
    NSA$W_IMGXFR_FACILITY* = 10; (* Facility code for image *)
    NSA$L_IMGXFR_BASE_ADDR* = 12; (* Base address of merged image *)
    NSA$L_IMGXFR_END_ADDR* = 16; (* End address of merged image *)
    NSA$L_IMGXFR_BASE_ORDER_OFFSET* = 20; (* Base output order offset *)
    NSA$T_IMGXFR_IMAGE_NAME* = 24; (* Start of image name *)
    NSA$S_IMGXFR_IMAGE_NAME* = 1;

  TYPE
    FMTCALLDEF* = RECORD (* 25 bytes, which poc pads to 28 *)
      NSA$L_IMGXFR_FLINK*: SYSTEM.CARD32;
      NSA$L_IMGXFR_BLINK*: SYSTEM.CARD32;
      NSA$W_IMGXFR_SIZE*: SYSTEM.CARD16;
      NSA$W_IMGXFR_FACILITY*: SYSTEM.CARD16;
      NSA$L_IMGXFR_BASE_ADDR*: SYSTEM.CARD32;
      NSA$L_IMGXFR_END_ADDR*: SYSTEM.CARD32;
      NSA$L_IMGXFR_BASE_ORDER_OFFSET*: SYSTEM.CARD32;
      NSA$T_IMGXFR_IMAGE_NAME*: ARRAY 1 OF CHAR
    END;

  CONST
    (* The following structure defines the common argument block passed to all the
       various formatting routines (which actually format information). *)
    NSA$M_FMTARG_SENSITIVE* = 01H;
    NSA$M_FMTARG_DISPLAY_TITLE* = 02H;
    NSA$M_FMTARG_CHECK_PREVIOUS* = 01H;
    NSA$M_FMTARG_NTH_NEW_LINE* = 02H;
    NSA$M_FMTARG_NOFORMAT* = 04H;
    NSA$K_FMTARG_LENGTH* = 32;
    NSA$C_FMTARG_LENGTH* = 32;
    NSA$S_FMTARGDEF* = 32;
    NSA$Q_FMTARG_BUFFER* = 0;
    NSA$S_FMTARG_BUFFER* = 8;
    NSA$W_FMTARG_BUFFER_SIZE* = 0; (* Output buffer size *)
    NSA$A_FMTARG_BUFFER_POINTER* = 4; (* Output buffer address *)
    NSA$W_FMTARG_BUFFER_OFFSET* = 8; (* Current position in output buffer *)
    NSA$W_FMTARG_BOL_OFFSET* = 10; (* Offset to beginning of current line *)
    NSA$Q_FMTARG_TERMINATOR* = 12;
    NSA$S_FMTARG_TERMINATOR* = 8;
    NSA$W_FMTARG_TERM_SIZE* = 12; (* Size of line terminator *)
    NSA$A_FMTARG_TERM_TEXT* = 16; (* Address of terminator text *)
    NSA$W_FMTARG_LINE_WIDTH* = 20; (* Output display width *)
    NSA$W_FMTARG_LINE_INDENT* = 22; (* Positions to indent (when needed) *)
    NSA$A_FMTARG_OUTPUT_ROUTINE* = 24; (* Address of an output routine *)
    NSA$L_FMTARG_FLAGS* = 28;
    NSA$W_FMTARG_FLAGS_LOW* = 28;
    NSA$V_FMTARG_SENSITIVE* = 0; (* Packet contains sensitive information *)
    NSA$V_FMTARG_DISPLAY_TITLE* = 1; (* Display title *)
    NSA$W_FMTARG_FLAGS_HIGH* = 30;
    NSA$V_FMTARG_CHECK_PREVIOUS* = 0; (* Check adjacency with previous output item *)
    NSA$V_FMTARG_NTH_NEW_LINE* = 1; (* Force duplicate packets to a new line *)
    NSA$V_FMTARG_NOFORMAT* = 2; (* Don't format the packet(s) *)

  TYPE
    FMTARGDEF* = RECORD (* 32 bytes *)
      NSA$Q_FMTARG_BUFFER*: SYSTEM.INT64;
      NSA$W_FMTARG_BUFFER_OFFSET*: SYSTEM.CARD16;
      NSA$W_FMTARG_BOL_OFFSET*: SYSTEM.CARD16;
      NSA$Q_FMTARG_TERMINATOR*: SYSTEM.INT64;
      NSA$W_FMTARG_LINE_WIDTH*: SYSTEM.CARD16;
      NSA$W_FMTARG_LINE_INDENT*: SYSTEM.CARD16;
      NSA$A_FMTARG_OUTPUT_ROUTINE*: SYSTEM.CARD32;
      NSA$L_FMTARG_FLAGS*: SYSTEM.CARD32
    END;

  CONST
    (* The following structure defines the transfer vector area for the format image. *)
    NSA$C_IMGXFR_MESSAGE_INFO* = 0; (* Message information routine *)
    NSA$C_IMGXFR_VALIDATE_PACKET* = 1; (* Packet validation routine *)
    NSA$C_IMGXFR_DISPLAY_INFO* = 2; (* Packet display information routine *)
    NSA$C_IMGXFR_LINE_BREAK* = 3; (* Line break processing routine *)
    NSA$C_IMGXFR_FORMAT_SPECIAL* = 4; (* Special packet formatting routine *)
    NSA$C_IMGXFR_FORMAT_INFO* = 5; (* Normal packet formatting routine *)
    NSA$C_IMGXFR_FORMAT_BRIEF* = 6; (* Brief format routine *)
    NSA$C_IMGXFR_FORMAT_PACKET_TYPE* = 7; (* Packet type format routine *)
    NSA$C_IMGXFR_FORMAT_EVENT_TYPE* = 8; (* Message type/subtype format routine *)
    NSA$S_FMTXFERDEF* = 72;
    NSA$R_IMGXFR_MESSAGE_INFO* = 0; (* Message information routine *)
    NSA$S_IMGXFR_MESSAGE_INFO* = 8;
    NSA$R_IMGXFR_VALIDATE_PACKET* = 8; (* Packet validation routine *)
    NSA$S_IMGXFR_VALIDATE_PACKET* = 8;
    NSA$R_IMGXFR_DISPLAY_INFO* = 16; (* Packet display information routine *)
    NSA$S_IMGXFR_DISPLAY_INFO* = 8;
    NSA$R_IMGXFR_LINE_BREAK* = 24; (* Line break processing routine *)
    NSA$S_IMGXFR_LINE_BREAK* = 8;
    NSA$R_IMGXFR_FORMAT_SPECIAL* = 32; (* Special packet formatting routine *)
    NSA$S_IMGXFR_FORMAT_SPECIAL* = 8;
    NSA$R_IMGXFR_FORMAT_INFO* = 40; (* Normal packet formatting routine *)
    NSA$S_IMGXFR_FORMAT_INFO* = 8;
    NSA$R_IMGXFR_FORMAT_BRIEF* = 48; (* Brief format routine *)
    NSA$S_IMGXFR_FORMAT_BRIEF* = 8;
    NSA$R_IMGXFR_FORMAT_PACKET_TYPE* = 56; (* Packet type format routine *)
    NSA$S_IMGXFR_FORMAT_PACKET_TYPE* = 8;
    NSA$R_IMGXFR_FORMAT_EVENT_TYPE* = 64; (* Message type/subtype format routine *)
    NSA$S_IMGXFR_FORMAT_EVENT_TYPE* = 8;

  TYPE
    FMTXFERDEF* = RECORD (* 72 bytes *)
      NSA$R_IMGXFR_MESSAGE_INFO*: SYSTEM.CARD64;
      NSA$R_IMGXFR_VALIDATE_PACKET*: SYSTEM.CARD64;
      NSA$R_IMGXFR_DISPLAY_INFO*: SYSTEM.CARD64;
      NSA$R_IMGXFR_LINE_BREAK*: SYSTEM.CARD64;
      NSA$R_IMGXFR_FORMAT_SPECIAL*: SYSTEM.CARD64;
      NSA$R_IMGXFR_FORMAT_INFO*: SYSTEM.CARD64;
      NSA$R_IMGXFR_FORMAT_BRIEF*: SYSTEM.CARD64;
      NSA$R_IMGXFR_FORMAT_PACKET_TYPE*: SYSTEM.CARD64;
      NSA$R_IMGXFR_FORMAT_EVENT_TYPE*: SYSTEM.CARD64
    END;

  CONST
    (* Define the format of the message information block.  This block defines some general
       characteristics of messages for a particular facility. *)
    NSA$K_MSGINF_LENGTH* = 8;
    NSA$C_MSGINF_LENGTH* = 8;
    NSA$S_MSGINFODEF* = 8;
    NSA$L_MSGINF_MAX_ORDER_OFFSET* = 0; (* Maximum (output) line index *)
    NSA$A_MSGINF_BRIEF_TITLE* = 4; (* Address of brief format titleline *)

  TYPE
    MSGINFODEF* = RECORD (* 8 bytes *)
      NSA$L_MSGINF_MAX_ORDER_OFFSET*: SYSTEM.CARD32;
      NSA$A_MSGINF_BRIEF_TITLE*: SYSTEM.CARD32
    END;

  CONST
    (* Define the structure of a formatting table subtype entry.  This entry consists of
       a description of the subtype as well as the name of the subtype. *)
    NSA$K_SUBTBL_LENGTH* = 8;
    NSA$C_SUBTBL_LENGTH* = 8;
    NSA$S_SUBFMTTBLDEF* = 8;
    NSA$L_SUBTBL_DESCRIPTION* = 0; (* Address of the description string *)
    NSA$L_SUBTBL_TABLE_SIZE* = 0; (* Number of entries in the subtable *)
    NSA$L_SUBTBL_MNEMONIC* = 4; (* Mnemonic name for the entry *)

  TYPE
    SUBFMTTBLDEF* = RECORD (* 8 bytes *)
      NSA$L_SUBTBL_DESCRIPTION*: SYSTEM.CARD32;
      NSA$L_SUBTBL_MNEMONIC*: SYSTEM.CARD32
    END;

  CONST
    (* Define all obsolete symbol definitions here. *)
    NSA$C_MSG_PRIV_AUDIT* = 16;
    NSA$C_PKT_PRIV_MASK* = 22;
    NSA$C_PKT_RESERVED_1_1* = 86;
    NSA$C_PKT_RESERVED_1_2* = 87;
    NSA$C_PKT_RESERVED_1_3* = 88;
    NSA$C_PRIV_AUDIT* = 1;
    NSA$_RESERVED_1_1* = 86;
    NSA$_RESERVED_1_2* = 87;
    NSA$_RESERVED_1_3* = 88;

END NSADEF.
