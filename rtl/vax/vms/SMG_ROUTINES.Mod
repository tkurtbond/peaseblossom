  (* SMG$SAVE_VIRTUAL_DISPLAY

     Save the Virtual Display to a File

     The Save the Virtual Display to a File routine saves the contents of a
     virtual display and stores it in a file. *)
  PROCEDURE ["VMS", "SMG$SAVE_VIRTUAL_DISPLAY"] SMG$SAVE_VIRTUAL_DISPLAY*(
      display_id-: SYSTEM.CARD32; (* identifier *)
      filespec-: ARRAY OF CHAR (* char_string, optional: NIL omits it *)
    ): SYSTEM.INT32; (* cond_value *)

  (* SMG$SAVE_PHYSICAL_SCREEN

     Save Physical Screen

     The Save Physical Screen routine saves the contents of the pasteboard so
     that a later call to SMG$RESTORE_PHYSICAL_SCREEN can restore it. *)
  PROCEDURE ["VMS", "SMG$SAVE_PHYSICAL_SCREEN"] SMG$SAVE_PHYSICAL_SCREEN*(
      pasteboard_id-: SYSTEM.CARD32; (* identifier *)
      VAR display_id: SYSTEM.CARD32; (* identifier *)
      desired_start_row-: SYSTEM.INT32; (* longword_signed, optional: NIL omits it *)
      desired_end_row-: SYSTEM.INT32 (* longword_signed, optional: NIL omits it *)
    ): SYSTEM.INT32; (* cond_value *)

  (* SMG$UNPASTE_VIRTUAL_DISPLAY

     Remove Virtual Display

     The Remove Virtual Display routine removes a virtual display from a pasteboard. *)
  PROCEDURE ["VMS", "SMG$UNPASTE_VIRTUAL_DISPLAY"] SMG$UNPASTE_VIRTUAL_DISPLAY*(
      display_id-: SYSTEM.CARD32; (* identifier *)
      pasteboard_id-: SYSTEM.CARD32 (* identifier *)
    ): SYSTEM.INT32; (* cond_value *)

END SMG_ROUTINES.
