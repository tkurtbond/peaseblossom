  PROCEDURE ["VMS", "SMG$FLUSH_BUFFER"] SMG$FLUSH_BUFFER*(
      pasteboard_id-: SYSTEM.CARD32 (* identifier *)
    ): SYSTEM.INT32; (* cond_value *)

