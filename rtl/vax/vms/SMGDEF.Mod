    SMG$m_spare9* = 0FFFFFFFFFFFFFFFCH;
    SMG$S_CREATE_PBD_FLAGS* = 4;
    SMG$V_KEEP_CONTENTS* = 0; (* Don't erase the pasteboard *)
    SMG$V_WORKSTATION* = 1; (* Pasteboard is DECwindows terminal *)
    SMG$v_spare9* = 2; (* extra bits *)
    SMG$s_spare9* = 30;
    (* The following defines bits used with the FLAGS parameter for
       SMG$READ_xxxx. *)
    SMG$M_FUNC_KEYS* = 01H;
    SMG$M_NOKEEP* = 02H;
    SMG$M_NORECALL* = 04H;
    SMG$m_spare8* = 0FFFFFFFFFFFFFFF8H;
    SMG$S_READ_FLAGS* = 4;
    SMG$V_FUNC_KEYS* = 0; (* Disable line-editting. *)
    SMG$V_NOKEEP* = 1; (* Don't save input in recall buffer *)
    SMG$V_NORECALL* = 2; (* Disable input recall for this call *)
    SMG$v_spare8* = 3; (* extra bits *)
    SMG$s_spare8* = 29;
    (* The following defines bits used with the FLAGS parameter for
       SMG$SET_CURSOR_MODE. *)
    SMG$M_CURSOR_OFF* = 01H;
    SMG$M_CURSOR_ON* = 02H;
    SMG$M_SCROLL_JUMP* = 04H;
    SMG$M_SCROLL_SMOOTH* = 08H;
    SMG$m_spare16* = 0FFFFFFFFFFFFFFF0H;
    SMG$S_SET_CURSOR_FLAGS* = 4;
    SMG$V_CURSOR_OFF* = 0; (* Turn the physical cursor off *)
    SMG$V_CURSOR_ON* = 1; (* Turn the physical cursor on *)
    SMG$V_SCROLL_JUMP* = 2; (* Set jump scroll *)
    SMG$V_SCROLL_SMOOTH* = 3; (* Set smooth scroll *)
    SMG$v_spare16* = 4; (* extra bits *)
    SMG$s_spare16* = 28;
    (* The following defines bits used with the FLAGS parameter for
       SMG$GET_DISPLAY_ATTR. *)
    SMG$M_VIEWPORT* = 01H;
    SMG$M_SUBPROCESS* = 02H;
    SMG$M_MENU* = 04H;
    SMG$m_spare7* = 0FFFFFFFFFFFFFFF8H;
    SMG$S_GET_DISPLAY_FLAGS* = 4;
    SMG$V_VIEWPORT* = 0; (* Display contains a viewport *)
    SMG$V_SUBPROCESS* = 1; (* Display contains a subprocess *)
    SMG$V_MENU* = 2; (* Display contains a menu *)
    SMG$v_spare7* = 3; (* extra bits *)
    SMG$s_spare7* = 29;
    (* The following defines bits used with the FLAGS parameter for
       SMG$PUT_CHARS. *)
    SMG$M_ERASE_LINE* = 01H;
    SMG$M_ERASE_TO_EOL* = 02H;
    SMG$m_spare6* = 0FFFFFFFFFFFFFFFCH;
    SMG$S_PUT_CHARS_FLAGS* = 4;
    SMG$V_ERASE_LINE* = 0; (* Erase the entire line *)
    SMG$V_ERASE_TO_EOL* = 1; (* Erase from cursor to end of line *)
    SMG$v_spare6* = 2; (* extra bits *)
    SMG$s_spare6* = 30;
    (* The following defines bits used with the FLAGS parameter for
       SMG$MOVE_TEXT. *)
    SMG$M_TEXT_SAVE* = 01H;
    SMG$M_TEXT_ONLY* = 02H;
    SMG$m_spare17* = 0FFFFFFFFFFFFFFFCH;
    SMG$S_MOVE_TEXT_FLAGS* = 4;
    SMG$V_TEXT_SAVE* = 0; (* Don't erase text after moving it *)
    SMG$V_TEXT_ONLY* = 1; (* Don't move attributes *)
    SMG$v_spare17* = 2; (* extra bits *)
    SMG$s_spare17* = 30;
    (* The following defines bits used with the FLAGS parameter for
       SMG$PUT_PASTEBOARD and SMG$SNAPSHOT. *)
    SMG$M_FORM_FEED* = 01H;
    SMG$m_spare5* = 0FFFFFFFFFFFFFFFEH;
    SMG$S_SNAPSHOT_FLAGS* = 4;
    SMG$V_FORM_FEED* = 0; (* Output form feed before first row *)
    SMG$v_spare5* = 1; (* extra bits *)
    SMG$s_spare5* = 31;
    (* The following defines bits used with the FLAGS parameter for
       SMG$PUT_xxxx. *)
    SMG$M_WRAP_CHAR* = 01H;
    SMG$M_WRAP_WORD* = 02H;
    SMG$m_spare4* = 0FFFFFFFFFFFFFFFCH;
    SMG$S_PUT_LINE_FLAGS* = 4;
    SMG$V_WRAP_CHAR* = 0; (* Do character wrapping at end of line *)
    SMG$V_WRAP_WORD* = 1; (* Do word wrapping at end of line *)
    SMG$v_spare4* = 2; (* extra bits *)
    SMG$s_spare4* = 30;
    (* The following defines bits used with the FLAGS parameter for
       SMG$SET_KEYPAD_MODE. *)
    SMG$M_KEYPAD_APPLICATION* = 01H;
    SMG$M_KEYPAD_NUMERIC* = 02H;
    SMG$m_spare3* = 0FFFFFFFFFFFFFFFCH;
    SMG$S_KEYPAD_MODES* = 4;
    SMG$V_KEYPAD_APPLICATION* = 0; (* Application keypad *)
    SMG$V_KEYPAD_NUMERIC* = 1; (* Numeric keypad *)
    SMG$v_spare3* = 2; (* extra bits *)
    SMG$s_spare3* = 30;
    (* The following defines bits used with the FLAGS parameter for
       SMG$GET_PASTING_INFO. *)
    SMG$M_DISPLAY_PASTED* = 01H;
    SMG$m_spare19* = 0FFFFFFFFFFFFFFFEH;
    SMG$S_PASTING_INFO_FLAGS* = 4;
    SMG$V_DISPLAY_PASTED* = 0; (* Display is pasted *)
    SMG$v_spare19* = 1; (* extra bits *)
    SMG$s_spare19* = 31;
    (* The following defines bits used with menu manipulation. *)
    SMG$M_REMOVE_ITEM* = 01H;
    SMG$M_FIXED_FORMAT* = 02H;
    SMG$M_DOUBLE_SPACE* = 04H;
    SMG$M_RETURN_IMMED* = 08H;
    SMG$M_ERASE_MENU* = 010H;
    SMG$M_WIDE_MENU* = 020H;
    SMG$M_WRAP_MENU* = 040H;
    SMG$M_FULL_FIELD* = 080H;
    SMG$m_spare2* = 0FFFFFFFFFFFFFF00H;
    SMG$S_MENU_FLAGS* = 4;
    SMG$V_REMOVE_ITEM* = 0; (* Only select item once *)
    SMG$V_FIXED_FORMAT* = 1; (* Use fixed size cols *)
    SMG$V_DOUBLE_SPACE* = 2; (* Double space menu rows *)
    SMG$V_RETURN_IMMED* = 3; (* Ret on non-arrow key *)
    SMG$V_ERASE_MENU* = 4; (* Erase menu when deleting *)
    SMG$V_WIDE_MENU* = 5; (* Wide menu items *)
    SMG$V_WRAP_MENU* = 6; (* Wrap menu items top to bottom *)
    SMG$V_FULL_FIELD* = 7; (* Highlight entire field *)
    SMG$v_spare2* = 8; (* extra bits *)
    SMG$s_spare2* = 24;
    (* The following are used with SMG$PUT_LINE_xxxx,
       SMG$SCROLL_DISPLAY_AREA, and SMG$DRAW_CHAR. *)
    SMG$M_UP* = 01H;
    SMG$M_DOWN* = 02H;
    SMG$M_RIGHT* = 04H;
    SMG$M_LEFT* = 08H;
    SMG$m_spare1* = 0FFFFFFFFFFFFFFF0H;
    SMG$S_SCROLL_DIRS* = 4;
    SMG$V_UP* = 0; (* Up *)
    SMG$V_DOWN* = 1; (* Down *)
    SMG$V_RIGHT* = 2; (* Right *)
    SMG$V_LEFT* = 3; (* Left *)
    SMG$v_spare1* = 4; (* extra bits *)
    SMG$s_spare1* = 28;
    (* Define data structures *)
    SMG$C_BAND_INFORMATION_TABLE* = 12; (* Length of table in bytes *)
    SMG$C_PASTEBOARD_INFO_BLOCK* = 32; (* Length of table in bytes *)
    SMG$C_KEYBOARD_INFO_BLOCK* = 20; (* Length of table in bytes *)
    SMG$S_SMGDEF* = 32;
    SMG$R_BAND_INFORMATION_TABLE* = 0;
    SMG$L_PASTEBOARD_ID* = 0; (* Pasteboard ID *)
    SMG$L_ARG* = 4; (* User's AST argument *)
    SMG$R_CHARACTER_OVERLAY* = 8;
    SMG$B_CHARACTER* = 8; (* The character typed *)
    SMG$L_CHARACTER* = 8; (* The character and 3 spaces *)
    SMG$R_PASTEBOARD_INFO_BLOCK* = 0;
    SMG$L_DEVCHAR* = 0; (* Device characteristics *)
    SMG$L_DEVDEPEND* = 4; (* Specific characteristics (1) *)
    SMG$L_DEVDEPEND2* = 8; (* Specific characteristics (2) *)
    SMG$B_DEVCLASS* = 12; (* Device class (e.g. DC$_TERM) *)
    SMG$B_SMG_DEVTYPE* = 13; (* Internal SMG device type *)
    SMG$B_PHY_DEVTYPE* = 14; (* Physical device type (e.g. DT$_VT100) *)
    SMG$B_ROWS* = 15; (* Number of rows on device *)
    SMG$W_WIDTH* = 16; (* Terminal width *)
    SMG$B_COLOR* = 18; (* PBD background color *)
    SMG$B_PARITY* = 19; (* Parity attributes (+) *)
    SMG$W_SPEED* = 20; (* Terminal Speed (+) *)
    SMG$W_FILL* = 22; (* Fill characteristics (+) *)
    SMG$W_CURSOR_ROW* = 24; (* Row where physical cursor is *)
    SMG$W_CURSOR_COL* = 26; (* Col where physical cursor is *)
    SMG$L_CURSOR_DID* = 28; (* Display id of topmost *)
    SMG$R_KEYBOARD_INFO_BLOCK* = 0;
    SMG$B_RECALL_SIZE* = 13; (* Size of recall buffer (+) *)
    SMG$B_TYPEAHEAD_CHAR* = 15; (* First char in typeahead buffer (+) *)
    SMG$W_TYPEAHEAD_COUNT* = 18; (* Number of chars in typeahead buffer (+) *)
    (* Define the out-of-band information table used when an out-of-band
       AST routine is called as it's own record. *)
    SMG$S_OUT_OF_BAND_TABLE* = 12;
    SMG$L_PBD_ID* = 0; (* Pasteboard ID *)
    SMG$L_USER_ARG* = 4; (* User's AST argument *)
    SMG$R_CHAR_OVERLAY* = 8;
    SMG$B_CHAR* = 8; (* The character typed *)
    SMG$L_CHAR* = 8; (* The character and 3 spaces *)

  TYPE
    SMG$R_OUT_OF_BAND_TABLE* = RECORD (* 12 bytes *)
      SMG$L_PBD_ID*: SYSTEM.CARD32;
      SMG$L_USER_ARG*: SYSTEM.CARD32;
      SMG$L_CHAR*: SYSTEM.CARD32
    END;

  CONST
    SMG$C_OUT_OF_BAND_TABLE* = 12; (* Length of table in bytes *)
    (* Define the subprocess information table used when a subprocess
       AST routine is called as it's own record. *)
    SMG$S_SUBPROCESS_INFO_TABLE* = 12;
    SMG$L_DISP_ID* = 0; (* Display ID *)
    SMG$L_USR_ARG* = 4; (* User's AST argument *)
    SMG$L_STATUS* = 8; (* Status of executed command *)

  TYPE
    SMG$R_SUBPROCESS_INFO_TABLE* = RECORD (* 12 bytes *)
      SMG$L_DISP_ID*: SYSTEM.CARD32;
      SMG$L_USR_ARG*: SYSTEM.CARD32;
      SMG$L_STATUS*: SYSTEM.CARD32
    END;

  CONST
    SMG$C_SUBPROCESS_INFO_TABLE* = 12; (* Length of table in bytes *)
    (* Define an information table that can be used by both
       SMG$GET_PASTEBOARD_ATTRIBUTES and SMG$GET_KEYBOARD_ATTRIBUTES
       as it's own record. *)
    SMG$S_ATTRIBUTE_INFO_BLOCK* = 32;
    SMG$L_DEV_CHAR* = 0; (* Device characteristics *)
    SMG$L_DEV_DEPEND* = 4; (* Specific characteristics (1) *)
    SMG$L_DEV_DEPEND2* = 8; (* Specific characteristics (2) *)
    SMG$B_DEV_CLASS* = 12; (* Device class (e.g. DC$_TERM) *)
    SMG$R_DEV_OVERLAY* = 13;
    SMG$B_PBD_TYPE* = 13; (* Internal SMG device type *)
    SMG$B_RECALL_NUM* = 13; (* Size of recall buffer (+) *)
    SMG$B_DEV_TYPE* = 14; (* Physical device type (e.g. DT$_VT100) *)
    SMG$R_ROW_OVERLAY* = 15;
    SMG$B_NUM_ROWS* = 15; (* Number of rows on device *)
    SMG$B_TYPEAHD_CHAR* = 15; (* First char in typeahead buffer (+) *)
    SMG$W_NUM_COLUMNS* = 16; (* Terminal width *)
    SMG$R_COUNT_OVERLAY* = 18;
    SMG$W_TYPEAHD_CNT* = 18; (* Number of chars in typeahead buffer (+) *)
    SMG$R_COUNT_STRUCT* = 18;
    SMG$B_PBD_COLOR* = 18; (* PBD background color *)
    SMG$B_DEV_PARITY* = 19; (* Parity attributes (+) *)
    SMG$W_DEV_SPEED* = 20; (* Terminal Speed (+) *)
    SMG$W_DEV_FILL* = 22; (* Fill characteristics (+) *)
    SMG$W_PHYS_CURSOR_ROW* = 24; (* Row where physical cursor is *)
    SMG$W_PHYS_CURSOR_COL* = 26; (* Col where physical cursor is *)
    SMG$L_DISPLAY_ID* = 28; (* Display containing phy cursor *)

  TYPE
    SMG$R_ATTRIBUTE_INFO_BLOCK* = RECORD (* 32 bytes *)
      SMG$L_DEV_CHAR*: SYSTEM.CARD32;
      SMG$L_DEV_DEPEND*: SYSTEM.CARD32;
      SMG$L_DEV_DEPEND2*: SYSTEM.CARD32;
      SMG$B_DEV_CLASS*: SYSTEM.CARD8;
      SMG$B_PBD_TYPE*: SYSTEM.CARD8;
      SMG$B_DEV_TYPE*: SYSTEM.CARD8;
      SMG$B_NUM_ROWS*: SYSTEM.CARD8;
      SMG$W_NUM_COLUMNS*: SYSTEM.CARD16;
      SMG$W_TYPEAHD_CNT*: SYSTEM.CARD16;
      SMG$W_DEV_SPEED*: SYSTEM.CARD16;
      SMG$W_DEV_FILL*: SYSTEM.CARD16;
      SMG$W_PHYS_CURSOR_ROW*: SYSTEM.CARD16;
      SMG$W_PHYS_CURSOR_COL*: SYSTEM.CARD16;
      SMG$L_DISPLAY_ID*: SYSTEM.CARD32
    END;

  CONST
    SMG$C_ATTRIBUTE_INFO_BLOCK* = 32; (* Length of table in bytes *)

END SMGDEF.
