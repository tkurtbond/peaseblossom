  (* MTH$JMIN1 left out: F_FLOATING is a list *)

  (* MTH$AMOD

     Remainder of Two F_floating Parameters Routine *)
  PROCEDURE ["VMS", "MTH$AMOD"] MTH$AMOD*(
      dividend-: REAL; (* F_FLOATING *)
      divisor-: REAL (* F_FLOATING *)
    ): REAL; (* F_FLOATING *)

  (* MTH$DMOD

     Remainder of Two D_floating Parameters Routine *)
  (* MTH$DMOD left out: its result is SDL type 6 *)

  (* MTH$GMOD

     Remainder of Two G_floating Parameters Routine *)
  PROCEDURE ["VMS", "MTH$GMOD"] MTH$GMOD*(
      dividend-: LONGREAL; (* G_FLOATING *)
      divisor-: LONGREAL (* G_FLOATING *)
    ): LONGREAL; (* G_FLOATING *)

  (* MTH$HMOD

     Remainder of Two H_floating Parameters Routine *)
  PROCEDURE ["VMS", "MTH$HMOD"] MTH$HMOD*(
      VAR h_mod: ARRAY OF SYSTEM.BYTE; (* H_FLOATING *)
      dividend-: ARRAY OF SYSTEM.BYTE; (* H_FLOATING *)
      divisor-: ARRAY OF SYSTEM.BYTE (* H_FLOATING *)
    );

  (* MTH$IMOD

     Remainder of Two Word Parameters Routine *)
  PROCEDURE ["VMS", "MTH$IMOD"] MTH$IMOD*(
      dividend-: SYSTEM.INT16; (* word_signed *)
      divisor-: SYSTEM.INT16 (* word_signed *)
    ): SYSTEM.INT16; (* word_signed *)

  (* MTH$JMOD

     Remainder of Two Longword Parameters Routine *)
  PROCEDURE ["VMS", "MTH$JMOD"] MTH$JMOD*(
      dividend-: SYSTEM.INT32; (* longword_signed *)
      divisor-: SYSTEM.INT32 (* longword_signed *)
    ): SYSTEM.INT32; (* longword_signed *)

  (* MTH$ANINT

     Convert F_floating to Nearest F_floating Integer Routine *)
  PROCEDURE ["VMS", "MTH$ANINT"] MTH$ANINT*(
      F_FLOATING-: REAL (* F_FLOATING *)
    ): REAL; (* F_FLOATING *)

  (* MTH$DNINT

     Convert D_floating to Nearest D_floating Integer Routine *)
  (* MTH$DNINT left out: its result is SDL type 6 *)

  (* MTH$IIDNNT

     Convert D_floating to Word Integer Routine *)
  PROCEDURE ["VMS", "MTH$IIDNNT"] MTH$IIDNNT*(
      D_FLOATING-: ARRAY OF SYSTEM.BYTE (* D_FLOATING *)
    ): SYSTEM.INT16; (* word_signed *)

  (* MTH$JIDNNT

     Convert D_floating to Nearest Longword Integer Routine *)
  PROCEDURE ["VMS", "MTH$JIDNNT"] MTH$JIDNNT*(
      D_FLOATING-: ARRAY OF SYSTEM.BYTE (* D_FLOATING *)
    ): SYSTEM.INT32; (* longword_signed *)

  (* MTH$GNINT

     Convert G_floating to Nearest G_floating Integer Routine *)
  PROCEDURE ["VMS", "MTH$GNINT"] MTH$GNINT*(
      G_FLOATING-: LONGREAL (* G_FLOATING *)
    ): LONGREAL; (* G_FLOATING *)

  (* MTH$IIGNNT

     Convert T_floating to Nearest G_floating Integer Routine *)
  PROCEDURE ["VMS", "MTH$IIGNNT"] MTH$IIGNNT*(
      G_FLOATING-: LONGREAL (* G_FLOATING *)
    ): SYSTEM.INT16; (* word_signed *)

  (* MTH$JIGNNT

     Convert G_floating to Nearest Longword Integer Routine *)
  PROCEDURE ["VMS", "MTH$JIGNNT"] MTH$JIGNNT*(
      G_FLOATING-: LONGREAL (* G_FLOATING *)
    ): SYSTEM.INT32; (* longword_signed *)

  (* MTH$HNINT

     Convert H_floating to Nearest H_floating Integer Routine *)
  PROCEDURE ["VMS", "MTH$HNINT"] MTH$HNINT*(
      VAR nearst_h_flt: ARRAY OF SYSTEM.BYTE; (* H_FLOATING *)
      H_FLOATING-: ARRAY OF SYSTEM.BYTE (* H_FLOATING *)
    );

  (* MTH$IIHNNT

     Convert H_floating to Nearest Word Integer Routine *)
  PROCEDURE ["VMS", "MTH$IIHNNT"] MTH$IIHNNT*(
      H_FLOATING-: ARRAY OF SYSTEM.BYTE (* H_FLOATING *)
    ): SYSTEM.INT16; (* word_signed *)

  (* MTH$JIHNNT

     Convert H_floating to Nearest Longword Integer Routine *)
  PROCEDURE ["VMS", "MTH$JIHNNT"] MTH$JIHNNT*(
      H_FLOATING-: ARRAY OF SYSTEM.BYTE (* H_FLOATING *)
    ): SYSTEM.INT32; (* longword_signed *)

  (* MTH$ININT

     Convert F_floating to Nearest Word Integer Routine *)
  PROCEDURE ["VMS", "MTH$ININT"] MTH$ININT*(
      F_FLOATING-: REAL (* F_FLOATING *)
    ): SYSTEM.INT16; (* word_signed *)

  (* MTH$JNINT

     Convert F_floating to Nearest Longword Integer Routine *)
  PROCEDURE ["VMS", "MTH$JNINT"] MTH$JNINT*(
      F_FLOATING-: REAL (* F_FLOATING *)
    ): SYSTEM.INT32; (* longword_signed *)

  (* MTH$INOT

     Bitwise Complement of Word Parameter Routine *)
  PROCEDURE ["VMS", "MTH$INOT"] MTH$INOT*(
      WORD-: SYSTEM.CARD16 (* word_unsigned *)
    ): SYSTEM.CARD16; (* word_unsigned *)

  (* MTH$JNOT

     Bitwise Complement of Longword Parameter Routine *)
  PROCEDURE ["VMS", "MTH$JNOT"] MTH$JNOT*(
      LONGWORD-: SYSTEM.CARD32 (* longword_unsigned *)
    ): SYSTEM.CARD32; (* longword_unsigned *)

  (* MTH$DPROD

     D_floating Product of Two F_floating Parameters Routine *)
  (* MTH$DPROD left out: its result is SDL type 6 *)

  (* MTH$GPROD

     G_floating Product of Two F_floating Parameters Routine *)
  PROCEDURE ["VMS", "MTH$GPROD"] MTH$GPROD*(
      f_floating1-: REAL; (* F_FLOATING *)
      f_floating2-: REAL (* F_FLOATING *)
    ): LONGREAL; (* G_FLOATING *)

  (* MTH$SGN

     F_floating Sign Function *)
  PROCEDURE ["VMS", "MTH$SGN"] MTH$SGN*(
      f_or_d_floating-: ARRAY OF SYSTEM.BYTE (* ANY *)
    ): SYSTEM.INT32; (* longword_signed *)

  (* MTH$IISHFT

     Bitwise Shift of Word Routine *)
  PROCEDURE ["VMS", "MTH$IISHFT"] MTH$IISHFT*(
      WORD-: SYSTEM.CARD16; (* word_unsigned *)
      shift_cnt-: SYSTEM.INT16 (* word_signed *)
    ): SYSTEM.CARD16; (* word_unsigned *)

  (* MTH$JISHFT

     Bitwise Shift of Longword Routine *)
  PROCEDURE ["VMS", "MTH$JISHFT"] MTH$JISHFT*(
      LONGWORD-: SYSTEM.CARD32; (* longword_unsigned *)
      shift_cnt-: SYSTEM.INT32 (* longword_signed *)
    ): SYSTEM.CARD32; (* longword_unsigned *)

  (* MTH$SIGN

     F_floating Transfer of Sign of Y to Sign of X Routine *)
  PROCEDURE ["VMS", "MTH$SIGN"] MTH$SIGN*(
      f_float_x-: REAL; (* F_FLOATING *)
      f_float_y-: REAL (* F_FLOATING *)
    ): REAL; (* F_FLOATING *)

  (* MTH$DSIGN

     D_floating Transfer of Sign of Y to Sign of X Routine *)
  (* MTH$DSIGN left out: its result is SDL type 6 *)

  (* MTH$GSIGN

     G_floating Transfer of Sign of X to Sign of X Routine *)
  PROCEDURE ["VMS", "MTH$GSIGN"] MTH$GSIGN*(
      g_float_x-: LONGREAL; (* G_FLOATING *)
      g_float_y-: LONGREAL (* G_FLOATING *)
    ): LONGREAL; (* G_FLOATING *)

  (* MTH$HSIGN

     H_floating Transfer of Sign of Y to Sign of X Routine *)
  PROCEDURE ["VMS", "MTH$HSIGN"] MTH$HSIGN*(
      VAR h_result: ARRAY OF SYSTEM.BYTE; (* H_FLOATING *)
      h_float_x-: ARRAY OF SYSTEM.BYTE; (* H_FLOATING *)
      h_float_y-: ARRAY OF SYSTEM.BYTE (* H_FLOATING *)
    );

  (* MTH$IISIGN

     Word Transfer of Sign of Y to Sign of X Routine *)
  PROCEDURE ["VMS", "MTH$IISIGN"] MTH$IISIGN*(
      word_x-: SYSTEM.INT16; (* word_signed *)
      word_y-: SYSTEM.INT16 (* word_signed *)
    ): SYSTEM.INT16; (* word_signed *)

  (* MTH$JISIGN

     Longword Transfer of Sign of Y to Sign of X Routine *)
  PROCEDURE ["VMS", "MTH$JISIGN"] MTH$JISIGN*(
      longwrd_x-: SYSTEM.INT32; (* longword_signed *)
      longwrd_y-: SYSTEM.INT32 (* longword_signed *)
    ): SYSTEM.INT32; (* longword_signed *)

  (* MTH$SNGL

     Convert D_floating to F_floating (Rounded) Routine *)
  PROCEDURE ["VMS", "MTH$SNGL"] MTH$SNGL*(
      D_FLOATING-: ARRAY OF SYSTEM.BYTE (* D_FLOATING *)
    ): REAL; (* F_FLOATING *)

  (* MTH$SNGLG

     Convert G_floating to F_floating (Rounded) Routine *)
  PROCEDURE ["VMS", "MTH$SNGLG"] MTH$SNGLG*(
      G_FLOATING-: LONGREAL (* G_FLOATING *)
    ): REAL; (* F_FLOATING *)

END MTH_ROUTINES.
