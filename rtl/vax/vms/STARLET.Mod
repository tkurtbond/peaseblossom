  PROCEDURE ["VMS", "SYS$RESTORE_VP_EXCEPTION"] SYS$RESTORE_VP_EXCEPTION*(
      EXCID-: SYSTEM.INT32 (* CONTEXT, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $RESTORE_VP_EXC_INT

     Restore Vector Processor Exception State

     $RESTORE_VP_EXC_INT excid

