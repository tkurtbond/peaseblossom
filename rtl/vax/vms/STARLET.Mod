      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      VAR BUFFER_HANDLE: ARRAY OF SYSTEM.BYTE (* QUADWORD_UNSIGNED, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $CREATE_RDB

     Create The Rights Database

     $CREATE_RDB [sysid]

     sysid = address of the quadword system identifier
     to store in the maintenance record *)
  PROCEDURE ["VMS", "SYS$CREATE_RDB"] SYS$CREATE_RDB*(
      SYSID-: ARRAY OF SYSTEM.BYTE (* SYSTEM_ACCESS_ID, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $CRELNM

     Create Logical Name

     $CRELNM  [attr], tabnam, lognam, [acmode], [itemlist]

     attr = address of logical name attributes

     Attribute Meaning
     LNM$M_CONFINE   Logical name not to be copied into sub-process
     LNM$M_NO_ALIAS  Logical name can not be aliased
     LNM$M_CRELOG Logical name created using $CRELOG

     tabnam = address of logical name table string descriptor

     lognam = address of logical name string descriptor

     acmode = address of access mode for logical name

     itmlst = address of a list of item descriptors *)
  PROCEDURE ["VMS", "SYS$CRELNM"] SYS$CRELNM*(
      ATTR-: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
      TABNAM-: ARRAY OF CHAR; (* LOGICAL_NAME *)
      LOGNAM-: ARRAY OF CHAR; (* LOGICAL_NAME *)
      ACMODE-: SYSTEM.INT8; (* ACCESS_MODE, unsigned, optional: NIL omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE (* ITEM_LIST, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $CRELNT

     Create Logical Name Table

     $CRELNT  [attr], [resnam], [reslen], [quota],
     [promsk], [tabnam], [acmode], [partab]

     attr = address of logical name table attributes

     resnam = address of descriptor of a buffer to receive the
     created table's name

     reslen = address of word to recieve length of created table's
     name

     quota = address of quota associated with logical name table

     promsk = address of protection mask

     tabnam = address of descriptor of logical name table name to be created

     partab = address of name of table parent string descriptor

     acmode = address of access mode for logical name *)
  PROCEDURE ["VMS", "SYS$CRELNT"] SYS$CRELNT*(
      ATTR-: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
      VAR RESNAM: ARRAY OF CHAR; (* LOGICAL_NAME, optional: NIL omits it *)
      VAR RESLEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      QUOTA-: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: NIL omits it *)
      PROMSK-: SYSTEM.INT16; (* FILE_PROTECTION, unsigned, optional: NIL omits it *)
      TABNAM-: ARRAY OF CHAR; (* LOGICAL_NAME, optional: NIL omits it *)
      PARTAB-: ARRAY OF CHAR; (* CHAR_STRING *)
      ACMODE-: SYSTEM.INT8 (* ACCESS_MODE, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $CRELOG

     Create Logical Name

     $CRELOG  [tblflg] ,lognam ,eqlnam ,[acmode]

     tblflg = logical name table number
     0 -> system (default)   1 -> group    2 -> process

     lognam = address of logical name string descriptor

     eqlnam = address of equivalence name string descriptor

     acmode = access mode for logical name (process table only) *)
  PROCEDURE ["VMS", "SYS$CRELOG"] SYS$CRELOG*(
      TBLFLG: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      LOGNAM-: ARRAY OF CHAR; (* LOGICAL_NAME *)
      EQLNAM-: ARRAY OF CHAR; (* LOGICAL_NAME *)
      ACMODE: SYSTEM.INT32 (* ACCESS_MODE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $CREMBX

     Create Mailbox and Assign Channel

     $CREMBX  [prmflg] ,chan ,[maxmsg] ,[bufquo] ,[promsk] ,[acmode] ,[lognam], [flags]

     prmflg = permanent flag
     0 -> temporary (default)   1 -> permanent

     chan   = address of word to receive channel

     maxmsg = maximum message size that may be received

     bufquo = number of bytes that can be used to buffer messages

     promsk = protection mask

     acmode = access mode of created mailbox

     lognam = address of logical name string descriptor for mailbox

     flags = flags for mailbox creation and channel assignment *)
  PROCEDURE ["VMS", "SYS$CREMBX"] SYS$CREMBX*(
      PRMFLG: SYSTEM.INT8; (* BOOLEAN, boolean, optional: 0 omits it *)
      VAR CHAN: SYSTEM.INT16; (* CHANNEL, unsigned *)
      MAXMSG: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      BUFQUO: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      PROMSK: SYSTEM.INT32; (* FILE_PROTECTION, unsigned, optional: 0 omits it *)
      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      LOGNAM-: ARRAY OF CHAR; (* LOGICAL_NAME, optional: NIL omits it *)
      FLAGS: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $CREPRC

     Create Process

     $CREPRC  [pidadr] ,[image] ,[input] ,[output] ,[error] ,[prvadr]
     ,[quota] ,[prcnam] ,[baspri] ,[uic] ,[mbxunt] ,[stsflg] ,[itmlst]

     pidadr = address of longword to return id of created process

     image  = address of string descriptor for image name

     input  = address of string descriptor for SYS$INPUT

     output = address of string descriptor for SYS$OUTPUT

     error  = address of string descriptor for SYS$ERROR

     prvadr = address of quadword privilege list

     quota  = address of quota list

     prcnam = address of string descriptor for process name

     baspri = base priority (0-31)

     uic    = user identification code.  If 0, create a subprocess

     mbxunt = mailbox unit for termination message

     stsflg = status and mode flag bits

     Bit  Meaning

     0   disable resource wait mode
     1   enable system service failure exception mode
     2   inhibit process swapping
     3   disable accounting messages
     4   batch process
     5   cause created process to hibernate
     6   allow login without authorization file check
     7   process is a network connect object

     itmlst = address of a list of item descriptors *)
  PROCEDURE ["VMS", "SYS$CREPRC"] SYS$CREPRC*(
      VAR PIDADR: SYSTEM.INT32; (* PROCESS_ID, unsigned, optional: NIL omits it *)
      IMAGE-: ARRAY OF CHAR; (* LOGICAL_NAME, optional: NIL omits it *)
      INPUT-: ARRAY OF CHAR; (* LOGICAL_NAME, optional: NIL omits it *)
      OUTPUT-: ARRAY OF CHAR; (* LOGICAL_NAME, optional: NIL omits it *)
      ERROR-: ARRAY OF CHAR; (* LOGICAL_NAME, optional: NIL omits it *)
      PRVADR-: ARRAY OF SYSTEM.BYTE; (* MASK_PRIVILEGES, unsigned, optional: NIL omits it *)
      QUOTA-: ARRAY OF SYSTEM.BYTE; (* ITEM_QUOTA_LIST, optional: NIL omits it *)
      PRCNAM-: ARRAY OF CHAR; (* PROCESS_NAME, optional: NIL omits it *)
      BASPRI: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      UIC: SYSTEM.INT32; (* UIC, unsigned, optional: 0 omits it *)
      MBXUNT: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: 0 omits it *)
      STSFLG: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE (* ITEM_LIST, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $CRETVA

     Create Virtual Address Space

     $CRETVA  inadr ,[retadr] ,[acmode]

     inadr  = address of 2-longword array containing  starting  and
     ending virtual address of pages to be created

     retadr = address of a 2-longword array to receive starting and
     ending virtual address of pages actually created

     acmode = access  mode  for  the  new  pages   (protection   is
     read/write for acmode and more privileged modes) *)
  PROCEDURE ["VMS", "SYS$CRETVA"] SYS$CRETVA*(
      INADR-: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned *)
      VAR RETADR: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32 (* ACCESS_MODE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $CRMPSC

     Create and Map Section

     $CRMPSC  [inadr] ,[retadr] ,[acmode] ,[flags] ,[gsdnam] ,[ident]
     ,[relpag] ,[chan] ,[pagcnt] ,[vbn] ,[prot] ,[pfc]

     inadr  = address of 2-longword array containing  starting  and
     ending virtual addresses of space to map section

     retadr = address of  2-longword  array  to  receive  addresses
     actually mapped

     acmode = access mode of owner of pages

     flags  = section characteristics

     Flag         Meaning

     SEC$M_GBL    Global section
     SEC$M_CRF    Copy-on-reference pages
     SEC$M_DZRO   Demand zero pages
     SEC$M_EXPREG Find first available space
     SEC$M_PERM   Permanent section
     SEC$M_PFNMAP Physical page frame section
     SEC$M_SYSGBL System global section
     SEC$M_WRT    Read/write section

     gsdnam = address of global section name string descriptor

     ident  = address of quadword containing version id and match control

     relpag = relative page number within section

     chan   = number of channel on which file is accessed

     pagcnt = number of pages in section

     vbn    = virtual block  number  of  beginning  of  section  or
     physical page frame number of beginning of section

     prot   = protection mask

     pfc    = page fault cluster size *)
  PROCEDURE ["VMS", "SYS$CRMPSC"] SYS$CRMPSC*(
      INADR-: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      VAR RETADR: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      GSDNAM-: ARRAY OF CHAR; (* SECTION_NAME, optional: NIL omits it *)
      IDENT-: ARRAY OF SYSTEM.BYTE; (* SECTION_ID, unsigned, optional: NIL omits it *)
      RELPAG: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      CHAN: SYSTEM.INT16; (* CHANNEL, unsigned, optional: 0 omits it *)
      PAGCNT: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      VBN: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      PROT: SYSTEM.INT32; (* FILE_PROTECTION, unsigned, optional: 0 omits it *)
      PFC: SYSTEM.INT32 (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DACEFC

     Disassociate Common Event Flag Cluster

     $DACEFC  efn

     efn    = number of any event flag in the cluster *)
  PROCEDURE ["VMS", "SYS$DACEFC"] SYS$DACEFC*(
      EFN: SYSTEM.INT32 (* EF_NUMBER, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DALLOC

     Deallocate Device

     $DALLOC  [devnam] ,[acmode]

     devnam = address of device name descriptor.  If 0, deallocate all

     acmode = access mode associated with device *)
  PROCEDURE ["VMS", "SYS$DALLOC"] SYS$DALLOC*(
      DEVNAM-: ARRAY OF CHAR; (* DEVICE_NAME, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32 (* ACCESS_MODE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DASSGN

     Deassign I/O Channel

     $DASSGN  chan

     chan   = number of channel to be deassigned *)
  PROCEDURE ["VMS", "SYS$DASSGN"] SYS$DASSGN*(
      CHAN: SYSTEM.INT16 (* CHANNEL, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DCLAST

     Declare AST

     $DCLAST  astadr ,[astprm] ,[acmode]

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine

     acmode = access mode for which the AST is to be declared *)
  PROCEDURE ["VMS", "SYS$DCLAST"] SYS$DCLAST*(
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      ACMODE: SYSTEM.INT32 (* ACCESS_MODE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DCLCMH

     Declare Change Mode or Compatibility Mode Handler

     $DCLCMH  addres ,[prvhnd] ,[type]

     addres = address of handler

     prvhnd = address of longword to receive previous handler address

     type   = handler type indicator
     0 -> change mode (current mode)   1 -> compatibility mode *)
  PROCEDURE ["VMS", "SYS$DCLCMH"] SYS$DCLCMH*(
      ADDRES: SYSTEM.ADDRESS; (* PROCEDURE, a routine's address *)
      VAR PRVHND: SYSTEM.INT32; (* ADDRESS, unsigned, optional: NIL omits it *)
      TYPE_: SYSTEM.INT8 (* LONGWORD_UNSIGNED, boolean, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DCLEVT

     Declare an Event

     $DCLEVT evtnam, [rcvacl], [evtfac], [acmode], [flags]
     ,[evtdata], [nullarg], [nullarg], [nullarg], [nullarg]

     evtnam  = address of descriptor of event name

     rcvacl  = address of descriptor of ACL

     evtfac  = address of event facility code

     acmode  = access mode of event declaration

     flags   = optional flags

     evtdata = address of descriptor of optional event data *)
  PROCEDURE ["VMS", "SYS$DCLEVT"] SYS$DCLEVT*(
      EVTNAM-: ARRAY OF CHAR; (* CHAR_STRING *)
      RCVACL-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      EVTFAC-: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      EVTDATA-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      NULLARG1: SYSTEM.INT32; (* NULL_ARG, unsigned, optional: 0 omits it *)
      NULLARG2: SYSTEM.INT32; (* NULL_ARG, unsigned, optional: 0 omits it *)
      NULLARG3: SYSTEM.INT32; (* NULL_ARG, unsigned, optional: 0 omits it *)
      NULLARG4: SYSTEM.INT32 (* NULL_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DCLEXH

     Declare Exit Handler

     $DCLEXH  desblk

     desblk = address of exit control block containing:

     +-------------------------------+
     |         forward link          |
     +-------------------------------+
     |     exit handler address      |
     +-------------------------------+
     |        argument count         |
     +-------------------------------+
     |   address to store reason     |
     +-------------------------------+
     |     additional arguments      |
     +--      for exit handler,    --+
     |            if any             |
     +-------------------------------+ *)
  PROCEDURE ["VMS", "SYS$DCLEXH"] SYS$DCLEXH*(
      DESBLK-: ARRAY OF SYSTEM.BYTE (* EXIT_HANDLER_BLOCK *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DELETE

     Delete Record

     $DELETE rab, [err], [suc]

     rab = address of rab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$DELETE"] SYS$DELETE*(
      VAR RAB: ARRAY OF SYSTEM.BYTE; (* RAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DELLNM

     Delete Logical Name and/or Table

     $DELLNM  [tabnam], [lognam], [acmode]

     tabnam = address of descriptor of logical name table name string

     lognam = address of descriptor of logical name string

     acmode = address of access mode for logical name *)
  PROCEDURE ["VMS", "SYS$DELLNM"] SYS$DELLNM*(
      TABNAM-: ARRAY OF CHAR; (* LOGICAL_NAME *)
      LOGNAM-: ARRAY OF CHAR; (* LOGICAL_NAME, optional: NIL omits it *)
      ACMODE-: SYSTEM.INT8 (* ACCESS_MODE, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DELLOG

     Delete Logical Name

     $DELLOG  [tblflg] ,[lognam] ,[acmode]

     tblflg = logical name table number
     0 -> system   1 -> group   2 -> process

     lognam = address of logical name string descriptor.  If 0,
     delete all names

     acmode = access mode of logical name (process table only) *)
  PROCEDURE ["VMS", "SYS$DELLOG"] SYS$DELLOG*(
      TBLFLG: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      LOGNAM-: ARRAY OF CHAR; (* LOGICAL_NAME, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32 (* ACCESS_MODE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DELMBX

     Delete Mailbox

     $DELMBX  chan

     chan   = channel number assigned to the mailbox *)
  PROCEDURE ["VMS", "SYS$DELMBX"] SYS$DELMBX*(
      CHAN: SYSTEM.INT16 (* CHANNEL, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DELPRC

     Delete Process

     $DELPRC  [pidadr] ,[prcnam]

     pidadr = address of longword containing id of process to be deleted

     prcnam = address of string descriptor for process name to be deleted *)
  PROCEDURE ["VMS", "SYS$DELPRC"] SYS$DELPRC*(
      VAR PIDADR: SYSTEM.INT32; (* PROCESS_ID, unsigned, optional: NIL omits it *)
      PRCNAM-: ARRAY OF CHAR (* PROCESS_NAME, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DELTVA

     Delete Virtual Address Space

     $DELTVA  inadr ,[retadr] ,[acmode]

     inadr  = address of 2-longword array containing  starting  and
     ending virtual addresses of pages to delete

     retadr = address of 2-longword array to receive  starting  and
     ending addresses of pages actually deleted

     acmode = access mode for which service is performed *)
  PROCEDURE ["VMS", "SYS$DELTVA"] SYS$DELTVA*(
      INADR-: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned *)
      VAR RETADR: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32 (* ACCESS_MODE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DELETE_BUFOBJ

     Delete I/O Buffer Object

     $DELETE_BUFOBJ  buffer_handle

     buffer_handle = address of a quadword that contains the buffer handle
     identifying the buffer object to be deleted *)
  PROCEDURE ["VMS", "SYS$DELETE_BUFOBJ"] SYS$DELETE_BUFOBJ*(
      BUFFER_HANDLE-: ARRAY OF SYSTEM.BYTE (* QUADWORD_UNSIGNED, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DEQ

     Dequeue Lock

     $DEQ  [lkid] ,[valblk] ,[acmode] ,[flags]

     lkid   = lock ID of the lock to be dequeued

     valblk = address of the lock value block

     acmode = access mode of the locks to be dequeued

     flags  = optional flags.

     LCK$M_DEQALL *)
  PROCEDURE ["VMS", "SYS$DEQ"] SYS$DEQ*(
      LKID: SYSTEM.INT32; (* LOCK_ID, unsigned, optional: 0 omits it *)
      VAR VALBLK: ARRAY OF SYSTEM.BYTE; (* LOCK_VALUE_BLOCK, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      FLAGS: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DEVICE_SCAN

     Wildcard device scan

     $DEVICE_SCAN  return_devnam, retlen, [search_devnam], [itmlst], [contxt]

     return_devnam = address of descriptor of returned device name buffer

     retlen        = address to store length of device name returned

     search_devnam = address of descriptor of search device name

     itmlst        = address of a list of item descriptors

     contxt        = address of quadword context structures *)
  PROCEDURE ["VMS", "SYS$DEVICE_SCAN"] SYS$DEVICE_SCAN*(
      VAR RETURN_DEVNAM: ARRAY OF CHAR; (* DEVICE_NAME *)
      VAR RETLEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned *)
      SEARCH_DEVNAM-: ARRAY OF CHAR; (* DEVICE_NAME, optional: NIL omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST, optional: NIL omits it *)
      VAR CONTXT: ARRAY OF SYSTEM.BYTE (* USER_ARG, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DGBLSC

     Delete Global Section

     $DGBLSC  [flags] ,gsdnam ,[ident]

     flags  = type of section
     0 -> group section   SEC$M_SYSGBL -> system section

     gsdnam = address of global section name string descriptor

     ident  = address of quadword containing version id and match control *)
  PROCEDURE ["VMS", "SYS$DGBLSC"] SYS$DGBLSC*(
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      GSDNAM-: ARRAY OF CHAR; (* SECTION_NAME *)
      IDENT-: ARRAY OF SYSTEM.BYTE (* SECTION_ID, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DIAGNOSE
     System Service for Diagnostics Programmers

     $DIAGNOSE function, P2, [cpu_id, [flags]]

     function = DIAG$SETAFF or DIAG$_ACTVCPUS

     P2 = enable flag if function is DIAG$SETAFF, or
     address to return actvcpus in if function
     is DIAG$_ACTVCPUS

     cpu_id = CPU number to set affinity to

     flags = masks governing the checking to do, whether
     affinity is set for image or process duration,
     whether to set affinity to primary cpu. *)
  PROCEDURE ["VMS", "SYS$DIAGNOSE"] SYS$DIAGNOSE*(
      FUNCTION: SYSTEM.INT32; (* FUNCTION_CODE, unsigned, optional: 0 omits it *)
      P2: SYSTEM.INT32; (* VARYING_ARG, unsigned, optional: 0 omits it *)
      CPU_ID: SYSTEM.INT32; (* LONGWORD_SIGNED, unsigned, optional: 0 omits it *)
      FLAGS: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DISABLE_VP_USE

     Disable Use of the Vector Processor

     $DISABLE_VP_USE flags ,[curflg] ,[prvflg]

     flags  = mask of facility(ies) that disabled vector use

     curflg = address of longword to receive current flags

     prvflg = address of longword to receive previous flags *)
  PROCEDURE ["VMS", "SYS$DISABLE_VP_USE"] SYS$DISABLE_VP_USE*(
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      VAR CURFLG: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
      VAR PRVFLG: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DISABLE_VP_USE_INT

     Disable Use of the Vector Processor, internal form

     $DISABLE_VP_USE_INT flags ,[curflg] ,[prvflg]

     flags  = mask of facility(ies) that disabled vector use

     curflg = address of longword to receive current flags

     prvflg = address of longword to receive previous flags *)
  PROCEDURE ["VMS", "SYS$DISABLE_VP_USE_INT"] SYS$DISABLE_VP_USE_INT*(
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      VAR CURFLG: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
      VAR PRVFLG: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DISCONNECT

     Disconnect Record Stream

     $DISCONNECT rab, [err], [suc]

     rab = address of rab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$DISCONNECT"] SYS$DISCONNECT*(
      VAR RAB: ARRAY OF SYSTEM.BYTE; (* RAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DISMOU

     Dismount Volume

     $DISMOU devnam ,[flags]

     devnam = address of device name string descriptor

     flags  = 32-bit status mask  selecting options for  the  dismount
     The  symbols  for  the flags are  defined by the $DMTDEF
     macro.

     Flag      Meaning

     DMT$M_NOUNLOAD   Do not unload the volume.

     DMT$M_UNIT       Dismount the specified device, rather
     than the entire volume set. *)
  PROCEDURE ["VMS", "SYS$DISMOU"] SYS$DISMOU*(
      DEVNAM-: ARRAY OF CHAR; (* DEVICE_NAME *)
      FLAGS: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DISPLAY

     Display File

     $DISPLAY fab, [err], [suc]

     fab = address of fab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$DISPLAY"] SYS$DISPLAY*(
      VAR FAB: ARRAY OF SYSTEM.BYTE; (* FAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DLCEFC

     Delete Common Event Flag Cluster

     $DLCEFC  name

     name   = address of cluster name string descriptor *)
  PROCEDURE ["VMS", "SYS$DLCEFC"] SYS$DLCEFC*(
      NAME-: ARRAY OF CHAR (* EF_CLUSTER_NAME *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DNS

     DNS Clerk system service

     $DNS     [efn], func , itmlst, [dnsb] ,[astadr] ,[astprm]
     ($DNSW)

     efn    = number of event flag to set on completion

     func   = function code specifying action to be performed

     itmlst = address of a list of item descriptors

     dnsb   = address of quadword I/O status block to receive final
     completion status

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine as argument *)
  PROCEDURE ["VMS", "SYS$DNS"] SYS$DNS*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      FUNC: SYSTEM.INT32; (* FUNCTION_CODE, unsigned *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST_3 *)
      VAR DNSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$DNSW"] SYS$DNSW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      FUNC: SYSTEM.INT32; (* FUNCTION_CODE, unsigned *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST_3 *)
      VAR DNSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $EMAA

     Call Entity Management Assist Agent

     $EMAA *)
  PROCEDURE ["VMS", "SYS$EMAA"] SYS$EMAA*(
      ARGLIST-: ARRAY OF CHAR; (* CHAR_STRING *)
      INVOKEID-: SYSTEM.INT32 (* USER_ARG, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $ENABLE_VP_USE

     Enable Use of the Vector Processor

     $ENABLE_VP_USE flags ,[curflg] ,[prvflg]

     flags  = mask of facility(ies) that disabled vector use

     curflg = address of longword to receive current flags

     prvflg = address of longword to receive previous flags *)
  PROCEDURE ["VMS", "SYS$ENABLE_VP_USE"] SYS$ENABLE_VP_USE*(
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      VAR CURFLG: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
      VAR PRVFLG: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $ENABLE_VP_USE_INT

     Enable Use of the Vector Processor, internal form

     $ENABLE_VP_USE_INT flags ,[curflg] ,[prvflg]

     flags  = mask of facility(ies) that disabled vector use

     curflg = address of longword to receive current flags

     prvflg = address of longword to receive previous flags *)
  PROCEDURE ["VMS", "SYS$ENABLE_VP_USE_INT"] SYS$ENABLE_VP_USE_INT*(
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      VAR CURFLG: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
      VAR PRVFLG: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $ENQ

     Enqueue Lock Request

     $ENQ     [efn] ,lkmode ,lksb ,[flags] ,[resnam] ,[parid]
     ($ENQW)  ,[astadr] ,[astprm] ,[blkast] ,[acmode], [prot]

     efn    = event flag to be set at completion

     lkmode = type of lock mode requested.  Modes are:

     LCK$K_NLMODE null lock
     LCK$K_CRMODE concurrent read
     LCK$K_CWMODE concurrent write
     LCK$K_PRMODE protected read
     LCK$K_PWMODE protected write
     LCK$K_EXMODE exclusive lock

     lksb  = address of the lock status block

     flags = flags defining the characteristics of the lock.  These are:

     LCK$M_NOQUEUE
     LCK$M_SYNCSTS
     LCK$M_SYSTEM
     LCK$M_VALBLK
     LCK$M_CONVERT

     resnam = address of string descriptor of the resource name

     parid  = lock ID of the parent lock

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine

     blkast = address of entry mask of blocking AST routine

     acmode = Access mode to be associated with the lock

     prot  = optional additional arg for extension

     range  = optional range to be locked within resource

     priority = optional priority of request *)
  PROCEDURE ["VMS", "SYS$ENQ"] SYS$ENQ*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      LKMODE: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned *)
      VAR LKSB: ARRAY OF SYSTEM.BYTE; (* LOCK_STATUS_BLOCK *)
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      RESNAM-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      PARID: SYSTEM.INT32; (* LOCK_ID, unsigned, optional: 0 omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      BLKAST: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      PROT: SYSTEM.INT32; (* NULL_ARG, unsigned, optional: 0 omits it *)
      RANGE: SYSTEM.ADDRESS; (* RANGE, a routine's address, optional: 0 omits it *)
      PRIORITY: SYSTEM.INT32 (* PRIORITY, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$ENQW"] SYS$ENQW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      LKMODE: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned *)
      VAR LKSB: ARRAY OF SYSTEM.BYTE; (* LOCK_STATUS_BLOCK *)
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      RESNAM-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      PARID: SYSTEM.INT32; (* LOCK_ID, unsigned, optional: 0 omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      BLKAST: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      PROT: SYSTEM.INT32; (* NULL_ARG, unsigned, optional: 0 omits it *)
      RANGE: SYSTEM.ADDRESS; (* RANGE, a routine's address, optional: 0 omits it *)
      PRIORITY: SYSTEM.INT32 (* PRIORITY, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $ENTER

     Enter File

     $ENTER fab, [err], [suc]

     fab = address of fab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$ENTER"] SYS$ENTER*(
      VAR FAB: ARRAY OF SYSTEM.BYTE; (* FAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $ERAPAT

     Generate a security erase pattern.

     $ERAPAT type, [count], patadr

     type = type of security erase

     count = iteration count (seed for erase pattern)

     patadr = address of longword to receive erase pattern *)
  PROCEDURE ["VMS", "SYS$ERAPAT"] SYS$ERAPAT*(
      TYPE_: SYSTEM.INT32; (* LONGWORD_UNSIGNED, optional: 0 omits it *)
      COUNT: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      VAR PATADR: SYSTEM.INT32 (* LONGWORD_UNSIGNED, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $ERASE

     Erase File

     $ERASE fab, [err], [suc]

     fab = address of fab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$ERASE"] SYS$ERASE*(
      VAR FAB: ARRAY OF SYSTEM.BYTE; (* FAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $EVDPOSTEVENT

     Post Event to EVD

     $EVDPOSTEVENT  EVENT *)
  PROCEDURE ["VMS", "SYS$EVDPOSTEVENT"] SYS$EVDPOSTEVENT*(
      EVENT-: ARRAY OF CHAR (* CHAR_STRING *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $EXIT

     Exit image

     $EXIT    [code]

     code   = longword completion status *)
  PROCEDURE ["VMS", "SYS$EXIT"] SYS$EXIT*(
      CODE: SYSTEM.INT32 (* COND_VALUE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $EXPREG

     Expand Program/Control Region

     $EXPREG  pagcnt ,[retadr] ,[acmode] ,[region]

     pagcnt = number of pages to add to end of specified region

     retadr = address  of  2-longword  array  to  receive   virtual
     addresses of starting and ending pages

     acmode = access mode of the new pages

     region = region indicator
     0 -> program (P0) region   1 -> control (P1) region *)
  PROCEDURE ["VMS", "SYS$EXPREG"] SYS$EXPREG*(
      PAGCNT: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned *)
      VAR RETADR: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      REGION: SYSTEM.INT8 (* LONGWORD_UNSIGNED, boolean, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $EXTEND

     Extend File

     $EXTEND fab, [err], [suc]

     fab = address of fab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$EXTEND"] SYS$EXTEND*(
      VAR FAB: ARRAY OF SYSTEM.BYTE; (* FAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FAO

     Formatted ASCII Output

     $FAO     ctrstr ,[outlen] ,outbuf ,[p1] ,[p2]...[pn]

     ctrstr = address of string descriptor for control string

     outlen = address of word in which to store output length

     outbuf = address of output buffer string descriptor

     p1...  = variable number of arguments to FAO *)
  (* SYS$FAO left out: a variable argument list *)

  (* $FAOL

     Formatted ASCII Output With List Parameter

     $FAOL    ctrstr ,[outlen] ,outbuf ,prmlst

     ctrstr = address of string descriptor for control string

     outlen = address of word to receive output string length

     outbuf = address of output buffer string descriptor

     prmlst = address of a list of longword parameters *)
  PROCEDURE ["VMS", "SYS$FAOL"] SYS$FAOL*(
      CTRSTR-: ARRAY OF CHAR; (* CHAR_STRING *)
      VAR OUTLEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR OUTBUF: ARRAY OF CHAR; (* CHAR_STRING *)
      PRMLST-: ARRAY OF SYSTEM.BYTE (* VECTOR_LONGWORD_UNSIGNED *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FILESCAN

     Scan a string and identify a file specification

     $FILESCAN    srcstr, [valuelst], [fldflags]

     srcstr = address of string descriptor for source string

     valuelst = address of a list of item descriptors

     fldflags = address of a longword to receive flags *)
  PROCEDURE ["VMS", "SYS$FILESCAN"] SYS$FILESCAN*(
      SRCSTR-: ARRAY OF CHAR; (* CHAR_STRING *)
      VAR VALUELST: ARRAY OF SYSTEM.BYTE; (* LIST_ITEM, optional: NIL omits it *)
      VAR FLDFLAGS: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FIND

     Find Record in File

     $FIND rab, [err], [suc]

     rab = address of rab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$FIND"] SYS$FIND*(
      VAR RAB: ARRAY OF SYSTEM.BYTE; (* RAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FIND_HELD

     Find Identifiers Held By Holder

     $FIND_HELD holder, [id], [attrib], [contxt]

     holder = address of a quadword which specifies the holder
     id of the records to find
     id = address to return the identifier longword
     attrib = address to return the holder attributes longword
     contxt = address of a longword containing the record stream
     context. initially should be zero, value output
     on first call, value input on subsequent calls. *)
  PROCEDURE ["VMS", "SYS$FIND_HELD"] SYS$FIND_HELD*(
      HOLDER-: ARRAY OF SYSTEM.BYTE; (* RIGHTS_HOLDER, unsigned *)
      VAR ID: SYSTEM.INT32; (* RIGHTS_ID, unsigned, optional: NIL omits it *)
      VAR ATTRIB: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
      VAR CONTXT: SYSTEM.INT32 (* CONTEXT, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FIND_HOLDER

     Find Holder Of Identifier

     $FIND_HOLDER id, [holder], [attrib], [contxt]

     id = identifier longword whose holder records
     are to be found
     holder = address to return the holder id quadword
     attrib = address to return the attributes longword
     contxt = address of a longword containing the record stream
     context. initially should be zero, value output
     on first call, value input on subsequent calls. *)
  PROCEDURE ["VMS", "SYS$FIND_HOLDER"] SYS$FIND_HOLDER*(
      ID: SYSTEM.INT32; (* RIGHTS_ID, unsigned *)
      VAR HOLDER: ARRAY OF SYSTEM.BYTE; (* RIGHTS_HOLDER, unsigned, optional: NIL omits it *)
      VAR ATTRIB: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
      VAR CONTXT: SYSTEM.INT32 (* CONTEXT, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FINISH_RDB

     Clean up RMS Stream

     $FINISH_RDB contxt

     contxt = address of a longword containing the record stream
     context. *)
  PROCEDURE ["VMS", "SYS$FINISH_RDB"] SYS$FINISH_RDB*(
      VAR CONTXT: SYSTEM.INT32 (* CONTEXT, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FORCEX

     Force Exit

     $FORCEX  [pidadr] ,[prcnam] ,[code]

     pidadr = address of process id of process to be forced to exit

     prcnam = address of process name descriptor for forced process

     code   = longword completion status for exit service *)
  PROCEDURE ["VMS", "SYS$FORCEX"] SYS$FORCEX*(
      VAR PIDADR: SYSTEM.INT32; (* PROCESS_ID, unsigned, optional: NIL omits it *)
      PRCNAM-: ARRAY OF CHAR; (* PROCESS_NAME, optional: NIL omits it *)
      CODE: SYSTEM.INT32 (* COND_VALUE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FORMAT_ACL

     Format an Access Control list Entry

     $FORMAT_ACL acl-entry, [acl-length], acl-string,
     [line-width], [term-desc], [line-indent],
     [bit-names], [routin]

     acl-entry = address of a descriptor of a buffer which
     contains the ACE

     acl-length = address of a word to receive the length of
     the output string

     acl-string = address of a descriptor of a buffer into
     which the output string is to be stored

     line-width = address of the maximum line width
     (0 = infinite)

     term_desc = address of a character descriptor containing
     a character string to be inserted whenever
     the line segment length exceeds the line-width

     line-indent = address of the number of columns to indent
     the output line segment

     bit-names = address of a access bit name table (32 entries)

     routin  = address of routine to be executed in kernel mode *)
  PROCEDURE ["VMS", "SYS$FORMAT_ACL"] SYS$FORMAT_ACL*(
      ACLENT-: ARRAY OF CHAR; (* CHAR_STRING *)
      VAR ACLLEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR ACLSTR: ARRAY OF CHAR; (* CHAR_STRING *)
      WIDTH-: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      TRMDSC-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      INDENT-: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      ACCNAM-: ARRAY OF SYSTEM.BYTE; (* ACCESS_BIT_NAMES, optional: NIL omits it *)
      ROUTIN: SYSTEM.ADDRESS (* PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FORMAT_AUDIT fmttyp, audmsg, [outlen], outbuf,
     [width], [trmdsc], [routin], [fmtflg]

     Format security auditing event message

     fmttyp  = format type

     audmsg  = address of the message to format

     outlen  = address of a word to receive length of output string

     outbuf  = Address of a descriptor of a buffer to receive
     the formatted event message

     width  = address of a word containing the display width

     trmdsc  = address of a descriptor containing the line
     terminator character(s)

     routin  = address of an output routine

     fmtflg  = format control flags *)
  PROCEDURE ["VMS", "SYS$FORMAT_AUDIT"] SYS$FORMAT_AUDIT*(
      FMTTYP: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned *)
      AUDMSG-: ARRAY OF CHAR; (* CHAR_STRING *)
      VAR OUTLEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR OUTBUF: ARRAY OF CHAR; (* CHAR_STRING *)
      WIDTH-: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      TRMDSC-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      ROUTIN: SYSTEM.ADDRESS; (* PROCEDURE, a routine's address, optional: 0 omits it *)
      FMTFLG: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FORMAT_CLASS itmlst, [routin]

     Format access class strings

     itmlst = address of a list of item descriptors

     routin = address of routine to be executed in kernel mode *)
  PROCEDURE ["VMS", "SYS$FORMAT_CLASS"] SYS$FORMAT_CLASS*(
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      ROUTIN: SYSTEM.ADDRESS (* PROCEDURE, a routine's address, optional: 0 omits it *)
