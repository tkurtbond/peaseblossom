     $ACK_EVENT     [flags], report_id, report_reply, [, [reason],
     [beftime], [afttime], [part_name], [rm_context],
     [timout]]

     flags  = operation flags
     report_id = participant id value
     report_reply = value of completion status
     reason  = extended abort reason code (for veto vote)
