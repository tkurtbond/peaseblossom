      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GET

     Get Record from File

     $GET rab, [err], [suc]

     rab = address of rab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$GET"] SYS$GET*(
      VAR RAB: ARRAY OF SYSTEM.BYTE; (* RAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETCHN

     Get I/O Channel Information

     $GETCHN  chan ,[prilen] ,[pribuf] ,[scdlen] ,[scdbuf]

     chan   = number of a channel assigned to the device

     prilen = address of word to receive length of primary buffer

     pribuf = address of primary buffer descriptor

     scdlen = address of word to receive length of secondary buffer

     scdbuf = address of secondary buffer descriptor *)
  PROCEDURE ["VMS", "SYS$GETCHN"] SYS$GETCHN*(
      CHAN: SYSTEM.INT16; (* CHANNEL, unsigned *)
      VAR PRILEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR PRIBUF: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      VAR SCDLEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR SCDBUF: ARRAY OF CHAR (* CHAR_STRING, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETDEV

     Get I/O Device Information

     $GETDEV  devnam  ,[prilen] ,[pribuf] ,[scdlen] ,[scdbuf]

     devnam = address of device name or logical name descriptor

     prilen = address of word to receive length of primary buffer

     pribuf = address of primary buffer descriptor

     scdlen = address of word to receive length of secondary buffer

     scdbuf = address of secondary buffer descriptor *)
  PROCEDURE ["VMS", "SYS$GETDEV"] SYS$GETDEV*(
      DEVNAM-: ARRAY OF CHAR; (* DEVICE_NAME *)
      VAR PRILEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR PRIBUF: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      VAR SCDLEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR SCDBUF: ARRAY OF CHAR (* CHAR_STRING, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETDTI

     Get Distributed Transaction Information

     $GETDTI [efn], [flags], iosb, [astadr], [astprm], [log_id], context,
     ($GETDTIW)  search, itmlst

     efn = event flag to set at completion
     flags = operation flags
     iosb = address of a quadword I/O status block
     astadr = address of the entry mask of an AST routine
     astprm = value to be passed to AST routine
     log_id = address of log id for TM log
     context = address of longword search context
     search = address of a list of search criteria items
     itmlst = address of a list of item descriptors *)
  PROCEDURE ["VMS", "SYS$GETDTI"] SYS$GETDTI*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      LOG_ID-: ARRAY OF SYSTEM.BYTE; (* OCTAWORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR CONTXT: SYSTEM.INT32; (* CONTEXT, unsigned *)
      SEARCH-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      ITMLST-: ARRAY OF SYSTEM.BYTE (* ITEM_LIST *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$GETDTIW"] SYS$GETDTIW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      LOG_ID-: ARRAY OF SYSTEM.BYTE; (* OCTAWORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR CONTXT: SYSTEM.INT32; (* CONTEXT, unsigned *)
      SEARCH-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      ITMLST-: ARRAY OF SYSTEM.BYTE (* ITEM_LIST *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETDVI

     Get Device/Volume Information

     $GETDVI  [efn] ,[chan] ,[devnam] ,itmlst ,[iosb] ,[astadr]
     ($GETDVIW)          ,[astprm] ,[nullarg]

     efn    = event flag to be set at completion

     chan   = number of a channel assigned to the device or
     0 if device is specified by the devnam parameter

     devnam = address of device name or logical name descriptor

     itmlst = address of a list of item descriptors

     iosb   = address of a quadword I/O status block

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine

     nullarg = reserved argument *)
  PROCEDURE ["VMS", "SYS$GETDVI"] SYS$GETDVI*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      CHAN: SYSTEM.INT16; (* CHANNEL, unsigned, optional: 0 omits it *)
      DEVNAM-: ARRAY OF CHAR; (* DEVICE_NAME, optional: NIL omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      NULLARG-: ARRAY OF SYSTEM.BYTE (* NULL_ARG, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$GETDVIW"] SYS$GETDVIW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      CHAN: SYSTEM.INT16; (* CHANNEL, unsigned, optional: 0 omits it *)
      DEVNAM-: ARRAY OF CHAR; (* DEVICE_NAME, optional: NIL omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      NULLARG-: ARRAY OF SYSTEM.BYTE (* NULL_ARG, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETEVI

     Get Event Information

     $GETEVI  itmlst ,[nullarg]

     itmlst = address of a list of item descriptors *)
  PROCEDURE ["VMS", "SYS$GETEVI"] SYS$GETEVI*(
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      NULLARG: SYSTEM.INT32 (* NULL_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETJPI

     Get Job/Process Information

     $GETJPI  [efn] ,[pidadr] ,[prcnam] ,itmlst ,[iosb], [astadr],
     ($GETJPIW)   [astprm]

     efn    = event flag to be set at completion

     pidadr = address of process identification

     prcnam = address of process name string descriptor

     itmlst = address of a list of item descriptors

     iosb   = address of a quadword I/O status block

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine as an argument *)
  PROCEDURE ["VMS", "SYS$GETJPI"] SYS$GETJPI*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      VAR PIDADR: SYSTEM.INT32; (* PROCESS_ID, unsigned, optional: NIL omits it *)
      PRCNAM-: ARRAY OF CHAR; (* PROCESS_NAME, optional: NIL omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$GETJPIW"] SYS$GETJPIW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      VAR PIDADR: SYSTEM.INT32; (* PROCESS_ID, unsigned, optional: NIL omits it *)
      PRCNAM-: ARRAY OF CHAR; (* PROCESS_NAME, optional: NIL omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETLKI

     Get Lock Information

     $GETLKI  [efn] ,lkidadr ,itmlst ,[iosb], [astadr], [astprm],
     ($GETLKIW)   [reserved]

     efn    = event flag to be set at completion

     lkidadr = address of lock identification

     itmlst = address of a list of item descriptors

     iosb   = address of a quadword I/O status block

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine as an argument

     reserved = reserved parameter *)
  PROCEDURE ["VMS", "SYS$GETLKI"] SYS$GETLKI*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      VAR LKIDADR: SYSTEM.INT32; (* LOCK_ID, unsigned *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      RESERVED: SYSTEM.INT32 (* NULL_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$GETLKIW"] SYS$GETLKIW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      VAR LKIDADR: SYSTEM.INT32; (* LOCK_ID, unsigned *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      RESERVED: SYSTEM.INT32 (* NULL_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETMSG

     Get Message

     $GETMSG  msgid ,msglen ,bufadr ,[flags] ,[outadr]

     msgid  = identification of message to be retrieved

     msglen = address  of  a  word  to  receive  length  of  string
     returned

     bufadr = address of buffer descriptor  of  buffer  to  receive
     string

     flags  = flag bits for message content (macro default = 15)

     Bit  Value/Meaning

     0  1 Include text
     0 Do not include text
     1  1 Include identifier
     0 Do not include identifier
     2  1 Include severity
     0 Do not include severity
     3  1 Include component
     0 Do not include component

     outadr = address of 4-byte array to receive the following values:

     Byte       Contents

     0  Reserved
     1  Count of FAO arguments
     2  User value
     3  Reserved *)
  PROCEDURE ["VMS", "SYS$GETMSG"] SYS$GETMSG*(
      MSGID: SYSTEM.INT32; (* COND_VALUE, unsigned *)
      VAR MSGLEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned *)
      VAR BUFADR: ARRAY OF CHAR; (* CHAR_STRING *)
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      VAR OUTADR: ARRAY OF SYSTEM.INT8 (* VECTOR_BYTE_UNSIGNED, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETPTI

     Get Page Table Information

     $GETPTI  [inadr],[retadr],[acmode],[mask],[pagcnt]

     inadr = address of two longwords containing starting
     and ending virtual address to operate on

     retadr = address of two longwords into which starting
     and ending address of pages operated on is returned

     acmode   = access mode against which ownership is checked

     mask = mask of page table information control bits

     pagcnt = minimum page count *)
  PROCEDURE ["VMS", "SYS$GETPTI"] SYS$GETPTI*(
      INADR-: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned *)
      VAR RETADR: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      MASK: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      PAGCNT: SYSTEM.INT32 (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETQUI

     Get Queue Information

     $GETQUI   [efn], func, [nullarg], [itmlst],
     ($GETQUIW) [iosb], [astadr], [astprm]

     efn     = event flag to be set when request completes
     func    = code specifying function to be performed
     nullarg = reserved argument for similarity with $getxxx services
     itmlst  = address of a list of item descriptors for the operation
     iosb    = address of a quadword status block to receive the final status
     astadr  = address of an ast routine to be called when request completes
     astprm  = 32-bit ast parameter *)
  PROCEDURE ["VMS", "SYS$GETQUI"] SYS$GETQUI*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      FUNC: SYSTEM.INT16; (* FUNCTION_CODE, unsigned *)
      NULLARG: SYSTEM.INT32; (* NULL_ARG, unsigned, optional: 0 omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST, optional: NIL omits it *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$GETQUIW"] SYS$GETQUIW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      FUNC: SYSTEM.INT16; (* FUNCTION_CODE, unsigned *)
      NULLARG: SYSTEM.INT32; (* NULL_ARG, unsigned, optional: 0 omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST, optional: NIL omits it *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETSYI

     Get System-Wide Information

     $GETSYI  [efn] ,[csidadr],[nodename],itmlst ,[iosb] ,[astadr],
     ($GETSYIW)  [astprm]

     efn    = event flag to be set at completion

     csidadr = address of cluster system identification

     nodename = address of node name string descriptor

     itmlst = address of a list of item descriptors

     iosb   = address of a quadword I/O status block

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine


     The second and third arguments in the $GETSYI argument list are
     not used; they are reserved for future use. *)
  PROCEDURE ["VMS", "SYS$GETSYI"] SYS$GETSYI*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      VAR CSIDADR: SYSTEM.INT32; (* PROCESS_ID, unsigned, optional: NIL omits it *)
      NODENAME-: ARRAY OF CHAR; (* PROCESS_NAME, optional: NIL omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$GETSYIW"] SYS$GETSYIW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      VAR CSIDADR: SYSTEM.INT32; (* PROCESS_ID, unsigned, optional: NIL omits it *)
      NODENAME-: ARRAY OF CHAR; (* PROCESS_NAME, optional: NIL omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETTIM

     Get Time

     $GETTIM  timadr

     timadr = address of a quadword to receive 64-bit current time value *)
  PROCEDURE ["VMS", "SYS$GETTIM"] SYS$GETTIM*(
      VAR TIMADR: ARRAY OF SYSTEM.BYTE (* DATE_TIME, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETUTC

     Get UTC Time

     $GETUTC  timadr

     timadr = address of a quadword to receive 128-bit current UTC time
     value *)
  PROCEDURE ["VMS", "SYS$GETUTC"] SYS$GETUTC*(
      VAR TIMADR: ARRAY OF SYSTEM.BYTE (* DATE_TIME, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GETUAI

     Get User Authorization Information

     $GETUAI  [efn] ,[contxt] ,usrnam ,itmlst ,[iosb] ,[astadr]
     ,[astprm]

     efn    = event flag to be set at completion

     contxt = address of a context longword (UAF IFI & ISI)

     usrnam = address of user name descriptor

     itmlst = address of a list of item descriptors

     iosb   = address of a quadword I/O status block

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine *)
  PROCEDURE ["VMS", "SYS$GETUAI"] SYS$GETUAI*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      CONTXT-: SYSTEM.INT32; (* CONTEXT, unsigned, optional: NIL omits it *)
      USRNAM-: ARRAY OF CHAR; (* CHAR_STRING *)
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GRANTID

     Grant Identifier to Process

     $GRANTID [pidadr], [prcnam], [id], [name], [prvatr]

     pidadr  = address of PID of affected process
     prcnam  = address of string descriptor of process name
     id      = address of quadword identifier and attributes
     name    = address of string descriptor of identifier name
     prvatr  = address to store attributes of superseded id *)
  PROCEDURE ["VMS", "SYS$GRANTID"] SYS$GRANTID*(
      VAR PIDADR: SYSTEM.INT32; (* PROCESS_ID, unsigned, optional: NIL omits it *)
      PRCNAM-: ARRAY OF CHAR; (* PROCESS_NAME, optional: NIL omits it *)
      VAR ID: ARRAY OF SYSTEM.BYTE; (* RIGHTS_HOLDER, unsigned, optional: NIL omits it *)
      NAME-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      VAR PRVATR: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $GRANT_LICENSE

     Grant authorization to execute licensed software product.

     $GRANT_LICENSE  prdnam ,prducer [,contxt] [,itmlst]

     prdnam = address of descriptor for software product name
     prducer = address of descriptor for software producer name
     contxt  = address of context buffer (4 longwords)
     itmlst = address of a list of item descriptors *)
  PROCEDURE ["VMS", "SYS$GRANT_LICENSE"] SYS$GRANT_LICENSE*(
      PRDNAM-: ARRAY OF CHAR; (* CHAR_STRING *)
      PRDUCER-: ARRAY OF CHAR; (* CHAR_STRING *)
      CONTXT-: ARRAY OF SYSTEM.INT32; (* CONTEXT, unsigned, optional: NIL omits it *)
      ITMLST-: ARRAY OF SYSTEM.BYTE (* ITEM_LIST_3, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $HASH_PASSWORD

     Encrypt a user password to produce a quadword hash value.

     $HASH_PASSWORD pwd, alg, [salt], usrnam, hash

     pwd = address of descriptor for plaintext password
     alg = algorithm to use for hash
     salt = salt value for use by hash algorithm
     usrnam = address of descriptor of username
     hash = address of output quadword hash buffer *)
  PROCEDURE ["VMS", "SYS$HASH_PASSWORD"] SYS$HASH_PASSWORD*(
      PWD-: ARRAY OF CHAR; (* CHAR_STRING *)
      ALG: SYSTEM.INT8; (* BYTE_UNSIGNED, unsigned *)
      SALT: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: 0 omits it *)
      USRNAM-: ARRAY OF CHAR; (* CHAR_STRING *)
      VAR HASH: ARRAY OF SYSTEM.BYTE (* QUADWORD_UNSIGNED, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $HIBER

     Hibernate

     $HIBER_S *)
  PROCEDURE ["VMS", "SYS$HIBER"] SYS$HIBER*(): SYSTEM.INT32; (* COND_VALUE *)

  (* $IDTOASC

     Identifier To Ascii Conversion

     $IDTOASC id, [namlen], [nambuf], [resid], [attrib], [contxt]

     id = identifier longword to convert, or zero to
     find all identifiers (wildcarding)
     namlen = address of a word to store the length of the
     identifier name
     nambuf = address of a character string descriptor that
     describes the buffer to return the identifier name
     resid = address of a longword to return the id found
     while wildcarding
     attrib = address to return the attributes longword
     contxt = address of a longword containing the record stream
     context. initially should be zero, value output
     on first call, value input on subsequent calls. *)
  PROCEDURE ["VMS", "SYS$IDTOASC"] SYS$IDTOASC*(
      ID: SYSTEM.INT32; (* RIGHTS_ID, unsigned *)
      VAR NAMLEN: SYSTEM.INT16; (* WORD_UNSIGNED, unsigned, optional: NIL omits it *)
      VAR NAMBUF: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      VAR RESID: SYSTEM.INT32; (* RIGHTS_ID, unsigned, optional: NIL omits it *)
      VAR ATTRIB: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: NIL omits it *)
      VAR CONTXT: SYSTEM.INT32 (* CONTEXT, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $IMGACT

     Image Activation

     $IMGACT name,[dflnam],hdrbuf,[imgctl],[inadr],
     [retadr], [ident], [acmode]


     name = address of descriptor for file name string

     dflnam = descriptor for file name string

     hdrbuf = address of 512 byte buffer to write in

     imgctl = image activation control flags

     inadr = address of quadword specifying virtual address
     range to be mapped

     retadr = address of quadword specifying virtual address
     range actually mapped

     ident = address of quadword holding image section match
     control and identifier

     acmode = access mode to be the owner of the created pages *)
  PROCEDURE ["VMS", "SYS$IMGACT"] SYS$IMGACT*(
      NAME-: ARRAY OF CHAR; (* CHAR_STRING *)
      DFLNAM-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      VAR HDRBUF: SYSTEM.ADDRESS; (* CNTRLBLK *)
      IMGCTL: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      INADR-: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      VAR RETADR: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      IDENT-: ARRAY OF SYSTEM.BYTE; (* SECTION_ID, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32 (* ACCESS_MODE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $IMGFIX

     Image Address Fixup Service

     $IMGFIX *)
  PROCEDURE ["VMS", "SYS$IMGFIX"] SYS$IMGFIX*(): SYSTEM.INT32; (* COND_VALUE *)

  (* $INIT_VOL

     Initialize Volume

     $INIT_VOL devnam, volnam, [itmlst]

     devnam = device name containing volume to initialize

     volnam = name to initialize the volume with

     itmlst = address of item code list for initialization options *)
  PROCEDURE ["VMS", "SYS$INIT_VOL"] SYS$INIT_VOL*(
      DEVNAM-: ARRAY OF CHAR; (* DEVICE_NAME *)
      VOLNAM-: ARRAY OF CHAR; (* CHAR_STRING *)
      ITMLST-: ARRAY OF SYSTEM.BYTE (* ITEM_LIST, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $IPC

     Interprocess Communication Request

     $IPC     [efn] ,func ,ipcb ,[astadr] ,[astprm]
     ($IPCW)

     efn    = number of event flag to set on completion

     func   = function code specifying action to be performed

     ipcb   = address of Interprocess Communication Block

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine as argument *)
  PROCEDURE ["VMS", "SYS$IPC"] SYS$IPC*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      FUNC: SYSTEM.INT16; (* FUNCTION_CODE, unsigned *)
      IPCB-: SYSTEM.INT32; (* ADDRESS, unsigned *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$IPCW"] SYS$IPCW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      FUNC: SYSTEM.INT16; (* FUNCTION_CODE, unsigned *)
      IPCB-: SYSTEM.INT32; (* ADDRESS, unsigned *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $LCKPAG

     Lock Pages in Memory

     $LCKPAG  inadr ,[retadr] ,[acmode]

     inadr  = address of 2-longword array containing starting and
     ending addresses of pages to be locked

     retadr = address of 2-longword array to receive addresses of
     pages actually locked

     acmode = access mode to check against the owner of the pages *)
  PROCEDURE ["VMS", "SYS$LCKPAG"] SYS$LCKPAG*(
      INADR-: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned *)
      VAR RETADR: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32 (* ACCESS_MODE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $LKWSET

     Lock Pages in Working Set

     $LKWSET  inadr ,[retadr] ,[acmode]

     inadr  = address of 2-longword array containing starting and
     ending virtual addresses of pages to be locked

     retadr = address of a 2-longword array to receive starting and
     ending virtual addresses of pages actually locked

     acmode = access mode to be checked against the page owner *)
  PROCEDURE ["VMS", "SYS$LKWSET"] SYS$LKWSET*(
      INADR-: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned *)
      VAR RETADR: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32 (* ACCESS_MODE, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $MGBLSC

     Map Global Section

     $MGBLSC  inadr ,[retadr] ,[acmode] ,[flags] ,gsdnam ,[ident] ,[relpag]

     inadr  = address of 2-longword array containing starting and
     ending addresses of pages to be mapped

     retadr = address of 2-longword array to receive virtual
     addresses of pages mapped

     acmode = access mode of owner of mapped pages

     flags  = flags overriding default section characteristics

     Flag        Meaning

     SEC$M_WRT      Read/write section
     SEC$M_SYSGBL   System global section
     SEC$M_EXPREG   Find first available space

     gsdnam = address of global section name descriptor

     ident  = address of quadword containing version id and match control

     relpag = relative page number within global section *)
  PROCEDURE ["VMS", "SYS$MGBLSC"] SYS$MGBLSC*(
      INADR-: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned *)
      VAR RETADR: ARRAY OF SYSTEM.INT32; (* ADDRESS_RANGE, unsigned, optional: NIL omits it *)
      ACMODE: SYSTEM.INT32; (* ACCESS_MODE, unsigned, optional: 0 omits it *)
      FLAGS: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      GSDNAM-: ARRAY OF CHAR; (* SECTION_NAME *)
      IDENT-: ARRAY OF SYSTEM.BYTE; (* SECTION_ID, unsigned, optional: NIL omits it *)
      RELPAG: SYSTEM.INT32 (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $MODIFY

     Modify File

     $MODIFY fab, [err], [suc]

     fab = address of fab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$MODIFY"] SYS$MODIFY*(
      VAR FAB: ARRAY OF SYSTEM.BYTE; (* FAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $MOD_HOLDER

     Modify Holder Record In Rights Database

     $MOD_HOLDER id, holder, [set_attrib], [clr_attrib]

     id    = identifier longword
     holder    = address of the holder identifier quadword
     set_attrib = longword containing the attributes to set
     into the holder record
     clr_attrib = longword containing the attributes to clear
     in the holder record *)
  PROCEDURE ["VMS", "SYS$MOD_HOLDER"] SYS$MOD_HOLDER*(
      ID: SYSTEM.INT32; (* RIGHTS_ID, unsigned *)
      HOLDER-: ARRAY OF SYSTEM.BYTE; (* RIGHTS_HOLDER, unsigned *)
      SET_ATTRIB: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      CLR_ATTRIB: SYSTEM.INT32 (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $MOD_IDENT

     Modify Identifier Record In Rights Database

     $MOD_IDENT id, [set_attrib], [clr_attrib], [new_name], [new_value]

     id    = identifier longword
     set_attrib = longword containing the attributes
     to set into the identifier record
     clr_attrib = longword containing the attributes
     to clear in the identifier record
     new_name   = address of the new identifier name character
     string descriptor
     new_value  = new identifier value longword *)
  PROCEDURE ["VMS", "SYS$MOD_IDENT"] SYS$MOD_IDENT*(
      ID: SYSTEM.INT32; (* RIGHTS_ID, unsigned *)
      SET_ATTRIB: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      CLR_ATTRIB: SYSTEM.INT32; (* MASK_LONGWORD, unsigned, optional: 0 omits it *)
      NEW_NAME-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      NEW_VALUE: SYSTEM.INT32 (* RIGHTS_ID, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $MOUNT

     Mount Volume

     $MOUNT  itmlst

     itmlst = Address of a list of item identifiers *)
  PROCEDURE ["VMS", "SYS$MOUNT"] SYS$MOUNT*(
      ITMLST-: ARRAY OF SYSTEM.BYTE (* ITEM_LIST *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $MTACCESS

     Installation specific accessibility routine

     $MTACCESS lblnam, [uic], [std_version], [access_char],
     [access_spec],type

     lblnam =    On input this field is the address of the
     VOL1 or HDR1 label read off the magnetic tape. On
     output of labels this field is zero. The type
     of label is determined by the TYPE field.
     uic   =    This field contains the longword volme UIC passed
     by value.
     std_version =  This field contains a byte value of the
     decimal equivalent of the version number
     gotten from the VOL1 label, passed by value.
     access_char =  This field contins the byte value of the
     accessibility character specified by the user,
     passed by value. For output of labels only.
     access_spec =  This field determines if the character passed
     in ACCESS_CHAR  was specified by user, passed
     by value.  It must contain one of the following
     values:
     MTA$K_CHARVALID = YES
     MTA$K_NOCHAR = NO
     For output of labels only.
     type = This field contains the type of accessibility to process,
     passed by value. It must contain one of the following
     values:
     MTA$K_INVOL1 = Input a VOL1 label
     MTA$K_INHDR1 = Input a HDR1 label
     MTA$K_OUTVOL1 = Output a VOL1 label
     MTA$K_OUTHDR1 = Output a HDR1 label *)
  PROCEDURE ["VMS", "SYS$MTACCESS"] SYS$MTACCESS*(
      LBLNAM-: SYSTEM.INT32; (* VECTOR_LONGWORD_UNSIGNED, unsigned *)
      UIC: SYSTEM.INT32; (* RIGHTS_ID, unsigned, optional: 0 omits it *)
      STD_VERSION: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      ACCESS_CHAR: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      ACCESS_SPEC: SYSTEM.INT32; (* LONGWORD_UNSIGNED, unsigned, optional: 0 omits it *)
      TYPE_: SYSTEM.INT32 (* LONGWORD_UNSIGNED, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $NUMTIM

     Convert Binary Time to Numeric Time

     $NUMTIM  timbuf ,[timadr]

     timbuf = address of a 7-word buffer to receive numeric time
     information

     timadr = address of a quadword containing the 64-bit time.  If
     0, use current time *)
  PROCEDURE ["VMS", "SYS$NUMTIM"] SYS$NUMTIM*(
      VAR TIMBUF: ARRAY OF SYSTEM.INT16; (* VECTOR_WORD_UNSIGNED, unsigned *)
      TIMADR-: ARRAY OF SYSTEM.BYTE (* DATE_TIME, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $NUMUTC

     Convert UTC Binary Time to Numeric Time

     $NUMUTC  timbuf ,[timadr]

     timbuf = address of a 11-word buffer to receive numeric time
     information

     31     0
     +---------------+---------------+
     | month of year | year since 0  |    7 word Date (ala NUMTIM)
     +---------------+---------------+
     | hour of day   | day of month  |
     +---------------+---------------+
     | sec. of min.  | min. of hour  |
     +---------------+---------------+
     |  iDays    |  hund of Sec  |
     +---------------+---------------+
     |  imins        |   ihours      |     5 word Inaccuracy
     +---------------+---------------+
     |  ihund of sec |   isecs       |
     +---------------+---------------+
     |  TDF in Secs  |
     +---------------+

     timadr = address of a quadword containing the 64-bit time.  If
     0, use current time *)
  PROCEDURE ["VMS", "SYS$NUMUTC"] SYS$NUMUTC*(
      VAR TIMBUF: ARRAY OF SYSTEM.INT16; (* VECTOR_WORD_UNSIGNED, unsigned *)
      TIMADR-: ARRAY OF SYSTEM.BYTE (* DATE_TIME, unsigned, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $NXTVOL

     Go to Next Volume

     $NXTVOL rab, [err], [suc]

     rab = address of rab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$NXTVOL"] SYS$NXTVOL*(
      VAR RAB: ARRAY OF SYSTEM.BYTE; (* RAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $OPEN

     Open File

     $OPEN fab, [err], [suc]

     fab = address of fab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$OPEN"] SYS$OPEN*(
      VAR FAB: ARRAY OF SYSTEM.BYTE; (* FAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $PARSE

     Parse File Name

     $PARSE fab, [err], [suc]

     fab = address of fab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$PARSE"] SYS$PARSE*(
      VAR FAB: ARRAY OF SYSTEM.BYTE; (* FAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $PARSE_ACL

     Parse an Access Control list Entry

     $PARSE_ACL acl-string ,acl-entry ,[error-position],
     [bit-names], [routin]

     acl-string = address of a descriptor of a buffer which
     contains the text to be parsed

     acl-entry = address of a descriptor of a buffer into
     which the converted ACE is to be written

     error-position = address of a word to receive the number of
     characters actually processed by the service.
     If the service fails, this count points to
     the failing point in the input string.

     bit-names = address of a access bit name table (32 entries)

     routin  = address of routine to be executed in kernel mode *)
  PROCEDURE ["VMS", "SYS$PARSE_ACL"] SYS$PARSE_ACL*(
      ACLSTR-: ARRAY OF CHAR; (* CHAR_STRING *)
      VAR ACLENT: ARRAY OF CHAR; (* CHAR_STRING *)
      VAR ERRPOS: SYSTEM.INT16; (* LONGWORD_UNSIGNED, unsigned, optional: NIL omits it *)
      ACCNAM-: ARRAY OF SYSTEM.BYTE; (* ACCESS_BIT_NAMES, optional: NIL omits it *)
      ROUTIN: SYSTEM.ADDRESS (* PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $PARSE_CLASS itmlst, [routin]

     Parse access class strings

     itmlst = address of a list of item descriptors

     routin = address of routine to be executed in kernel mode *)
  PROCEDURE ["VMS", "SYS$PARSE_CLASS"] SYS$PARSE_CLASS*(
      ITMLST-: ARRAY OF SYSTEM.BYTE; (* ITEM_LIST *)
      ROUTIN: SYSTEM.ADDRESS (* PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $PROCESS_SCAN

     Initialize Process_scan context

     $Process_scan  pidctx , [itmlst ]

     pidctx = address of process ctx id

     itmlst = address of a list of item descriptors *)
  PROCEDURE ["VMS", "SYS$PROCESS_SCAN"] SYS$PROCESS_SCAN*(
      VAR PIDCTX: SYSTEM.INT32; (* PROCESS_ID, unsigned *)
      ITMLST-: ARRAY OF SYSTEM.BYTE (* ITEM_LIST, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $PURGWS

     Purge Working Set

     $PURGWS  inadr

     inadr  = address of 2-longword array containing starting and
     ending addresses of pages to be removed *)
  PROCEDURE ["VMS", "SYS$PURGWS"] SYS$PURGWS*(
      INADR-: ARRAY OF SYSTEM.INT32 (* ADDRESS_RANGE, unsigned *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $PUT

     Put Record to File

     $PUT rab, [err], [suc]

     rab = address of rab

     err = address of user error completion routine

     suc = address of user success completion routine *)
  PROCEDURE ["VMS", "SYS$PUT"] SYS$PUT*(
      VAR RAB: ARRAY OF SYSTEM.BYTE; (* RAB *)
      ERR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $PUTMSG

     Put Message

     $PUTMSG  msgvec ,[actrtn] ,[facnam], [actprm]

     msgvec = address of message argument vector

     actrtn = address of entry mask of action routine

     facnam = address of facility name string descriptor

     actprm = parameter to pass to action routine *)
  PROCEDURE ["VMS", "SYS$PUTMSG"] SYS$PUTMSG*(
      MSGVEC-: ARRAY OF SYSTEM.BYTE; (* CNTRLBLK *)
      ACTRTN: SYSTEM.ADDRESS; (* PROCEDURE, a routine's address, optional: 0 omits it *)
      FACNAM-: ARRAY OF CHAR; (* CHAR_STRING, optional: NIL omits it *)
      ACTPRM: SYSTEM.INT32 (* USER_ARG, unsigned, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $QIO

     Queue I/O Request

     $QIO     [efn] ,chan ,func ,[iosb] ,[astadr] ,[astprm]
     ($QIOW)  ,[p1] ,[p2] ,[p3] ,[p4] ,[p5] ,[p6]

     efn    = number of event flag to set on completion

     chan   = number of channel on which I/O is directed

     func   = function code specifying action to be performed

     iosb   = address of quadword I/O status block to receive final
     completion status

     astadr = address of entry mask of AST routine

     astprm = value to be passed to AST routine as argument

     p1...  = optional device- and function-specific parameters *)
  PROCEDURE ["VMS", "SYS$QIO"] SYS$QIO*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      CHAN: SYSTEM.INT16; (* CHANNEL, unsigned *)
      FUNC: SYSTEM.INT16; (* FUNCTION_CODE, unsigned *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      P1-: ARRAY OF SYSTEM.BYTE; (* VARYING_ARG, optional: NIL omits it *)
      P2: SYSTEM.INT32; (* VARYING_ARG, optional: 0 omits it *)
      P3: SYSTEM.INT32; (* VARYING_ARG, optional: 0 omits it *)
      P4: SYSTEM.INT32; (* VARYING_ARG, optional: 0 omits it *)
      P5: SYSTEM.INT32; (* VARYING_ARG, optional: 0 omits it *)
      P6: SYSTEM.INT32 (* VARYING_ARG, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  PROCEDURE ["VMS", "SYS$QIOW"] SYS$QIOW*(
      EFN: SYSTEM.INT32; (* EF_NUMBER, unsigned, optional: 0 omits it *)
      CHAN: SYSTEM.INT16; (* CHANNEL, unsigned *)
      FUNC: SYSTEM.INT16; (* FUNCTION_CODE, unsigned *)
      VAR IOSB: ARRAY OF SYSTEM.BYTE; (* IO_STATUS_BLOCK, unsigned, optional: NIL omits it *)
      ASTADR: SYSTEM.ADDRESS; (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
      ASTPRM: SYSTEM.INT32; (* USER_ARG, unsigned, optional: 0 omits it *)
      P1-: ARRAY OF SYSTEM.BYTE; (* VARYING_ARG, optional: NIL omits it *)
      P2: SYSTEM.INT32; (* VARYING_ARG, optional: 0 omits it *)
      P3: SYSTEM.INT32; (* VARYING_ARG, optional: 0 omits it *)
      P4: SYSTEM.INT32; (* VARYING_ARG, optional: 0 omits it *)
      P5: SYSTEM.INT32; (* VARYING_ARG, optional: 0 omits it *)
      P6: SYSTEM.INT32 (* VARYING_ARG, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

