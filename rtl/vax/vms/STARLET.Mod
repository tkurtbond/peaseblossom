      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $FLUSH

     Flush Record

     $FLUSH rab, [err], [suc]

     rab = address of rab

     err = address of user error completion routine

