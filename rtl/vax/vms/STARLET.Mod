      SUC: SYSTEM.ADDRESS (* AST_PROCEDURE, a routine's address, optional: 0 omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $DCLRNH

     Declare Restart Handler

     $DCLRNH  desblk

     desblk = address of handler control block containing:

     +-------------------------------+
     |         forward link          |
     +-------------------------------+
     |   restart handler address     |
     +-------------------------------+
     |        argument count         |
     +-------------------------------+
     |     reserved, must be zero    |
     +-------------------------------+
     |  address to store event code  |
     +-------------------------------+
     |     additional arguments      |
     +--   for restart handler,    --+
     |            if any             |
     +-------------------------------+ *)
  PROCEDURE ["VMS", "SYS$DCLRNH"] SYS$DCLRNH*(
      DESBLK-: ARRAY OF SYSTEM.BYTE (* VECTOR_LONGWORD_UNSIGNED *)
    ): SYSTEM.INT32; (* COND_VALUE *)

  (* $CANRNH

     Cancel Restart Handler

     $CANRNH  [desblk]

     desblk = address of handler control block describing
     handler to be deleted.  If 0, delete all *)
  PROCEDURE ["VMS", "SYS$CANRNH"] SYS$CANRNH*(
      DESBLK-: ARRAY OF SYSTEM.BYTE (* VECTOR_LONGWORD_UNSIGNED, optional: NIL omits it *)
    ): SYSTEM.INT32; (* COND_VALUE *)

