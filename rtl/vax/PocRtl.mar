; poc's VAX/VMS runtime routines (PLAN.md Phase 16), which a program poc
; builds for vax-dec-vms links as POCRTL.OBJ (VaxToolchainDriver's build
; procedure; doc/developer/vax-macro32-backend.md, sections 8, 9 and 13).
; Step 2's first cut: POC_STRCMP, POC_HMUL, POC_HDIV and POC_HMOD compute
; what they will in the end, as tools/vax-runtime-stub.mar's do. Step 3's:
; POC_TRAP and POC_HALT, which end the program as section 14, item 10
; says; POC_QTOG and POC_ENTIERQ, the conversions between a quadword
; and a G_floating.
; Step 4's (section 15): Out's and Err's lines, written to SYS$OUTPUT and
; SYS$ERROR, the services rtl/vax's Platform and Modules call, RMS file
; access for its Files, and what its GarbageCollectedHeap needs: the
; modules' root tables, memory, the registers saved, an exit handler and
; the page-file quota.
	.TITLE	POCRTL
	.IDENT	/PHASE16-4/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD
	$DSCDEF
	$FABDEF
	$JPIDEF
	$LNMDEF
	$NAMDEF
	$RABDEF
	$RMSDEF
	$XABDEF
	$XABFHCDEF

; a fixed-length string descriptor of the length bytes at text, made on
; the stack, its address in R1
	.MACRO	POC_DESCRIBE	TEXT, LENGTH
	SUBL2	#8, SP
	MOVW	LENGTH, DSC$W_LENGTH(SP)
	MOVB	#DSC$K_DTYPE_T, DSC$B_DTYPE(SP)
	MOVB	#DSC$K_CLASS_S, DSC$B_CLASS(SP)
	MOVL	TEXT, DSC$A_POINTER(SP)
	MOVL	SP, R1
	.ENDM	POC_DESCRIBE

; Traps and HALT (design section 14, item 10). A trap's message is the
; LLVM backend's, a counted string here for each code, 2 to 14 (section
; 9; LLVMCodeGenerator's trap messages), and CHR's for 14 when the code's
; high word is 1, SHORT's being the other
	.PSECT	POC_CONST
POC_TRAP_TEXTS:
	.ADDRESS	POC_TX_0, POC_TX_0, POC_TX_2, POC_TX_3, POC_TX_4
	.ADDRESS	POC_TX_5, POC_TX_6, POC_TX_7, POC_TX_8, POC_TX_9
	.ADDRESS	POC_TX_10, POC_TX_11, POC_TX_12, POC_TX_13, POC_TX_14
	.ADDRESS	POC_TX_CHR
POC_TX_0:	.ASCIC	/trap/
POC_TX_2:	.ASCIC	/index out of range/
POC_TX_3:	.ASCIC	/no matching CASE label/
POC_TX_4:	.ASCIC	/NIL pointer dereference/
POC_TX_5:	.ASCIC	/type guard failed/
POC_TX_6:	.ASCIC	/no matching WITH guard/
POC_TX_7:	.ASCIC	/Too many, or negative number of, elements in dynamic array/
POC_TX_8:	.ASCIC	/ENTIER argument out of range for LONGINT/
POC_TX_9:	.ASCIC	/open array assigned to an array too short for it/
POC_TX_10:	.ASCIC	/assertion failed/
POC_TX_11:	.ASCIC	/heap exhausted: NEW cannot allocate the block/
POC_TX_12:	.ASCIC	/function procedure reached its END without RETURN/
POC_TX_13:	.ASCIC	/record assigned to a variable whose dynamic type extends its static type/
POC_TX_14:	.ASCIC	/SHORT argument out of range/
POC_TX_CHR:	.ASCIC	/CHR argument out of range/
; -trap-location's form: file:line:column: message (in procedure)
POC_TRAP_WHERE:
	.ASCID	"!AC:!UL:!UL: !AC (in !AC)"
; ASSERT(x, n)'s message
POC_ASSERT_N:
	.ASCID	"assertion failed (!UL)"

	.PSECT	POC_DATA
; SYS$ERROR, written one record at a time (RMS 4.1: a variable-length
; record, carriage return carriage control); POC_ERR_IS_OPEN is 1 once
; POC_ERR_OPEN has opened it
POC_ERR_IS_OPEN:
	.BLKL	1
POC_ERR_FAB:
	$FAB	FNM=<SYS$ERROR>, FAC=<PUT>, RFM=VAR, RAT=<CR>
POC_ERR_RAB:
	$RAB	FAB=POC_ERR_FAB
; $FAO's output, and a descriptor of it
POC_TRAP_LENGTH:
	.BLKW	1
POC_TRAP_BUFFER:
	.BLKB	600
POC_TRAP_OUT:
	.WORD	600
	.BYTE	DSC$K_DTYPE_T, DSC$K_CLASS_S
	.ADDRESS	POC_TRAP_BUFFER
; ASSERT(x, n)'s message, made by $FAO after a count byte, and a
; descriptor of the text
POC_ASSERT_LENGTH:
	.BLKW	1
POC_ASSERT_TEXT:
	.BLKB	40
POC_ASSERT_OUT:
	.WORD	39
	.BYTE	DSC$K_DTYPE_T, DSC$K_CLASS_S
	.ADDRESS	POC_ASSERT_TEXT+1

	.PSECT	POC_CODE
; POC_TRAP(code, module, line, column[, file, procedure]), module, file
; and procedure counted strings, the code in the low word of its
; longword and which of its messages in the high word (1 for 14, CHR's;
; n + 1 for 10, ASSERT(x, n)'s "assertion failed (n)"): the message
; written to SYS$ERROR, as the LLVM backend writes it to the standard
; error, then the program ends with %X10000000 + 8 * code + 2, severity
; error, message number code, with STS$M_INHIB_MSG set so that DCL adds
; nothing. Under -trap-location the call has six arguments, and the
; message is prefixed with file:line:column: and ended with (in
; procedure), as on LLVM. A record that cannot be written is let go: the
; status still says what happened
	.ENTRY	POC_TRAP, ^M<R2,R3,R4,R5>
	MOVZWL	4(AP), R2
	MOVL	R2, R3
	CMPL	R3, #14
	BLSSU	10$
	BGTRU	5$
	TSTW	6(AP)
	BEQL	10$
	MOVL	#15, R3
	BRB	10$
5$:	CLRL	R3
10$:	MOVL	POC_TRAP_TEXTS[R3], R3
	CMPL	R2, #10
	BNEQ	15$
	MOVZWL	6(AP), R0
	BEQL	15$
	DECL	R0
	$FAO_S	CTRSTR=POC_ASSERT_N, OUTLEN=POC_ASSERT_LENGTH, -
		OUTBUF=POC_ASSERT_OUT, P1=R0
	MOVB	POC_ASSERT_LENGTH, POC_ASSERT_TEXT
	MOVAB	POC_ASSERT_TEXT, R3
15$:	CMPB	(AP), #6
	BLSSU	20$
	$FAO_S	CTRSTR=POC_TRAP_WHERE, OUTLEN=POC_TRAP_LENGTH, -
		OUTBUF=POC_TRAP_OUT, P1=20(AP), P2=12(AP), P3=16(AP), -
		P4=R3, P5=24(AP)
	MOVZWL	POC_TRAP_LENGTH, R4
	MOVAB	POC_TRAP_BUFFER, R5
	BRB	30$
20$:	MOVZBL	(R3)+, R4
	MOVL	R3, R5
30$:	CALLS	#0, POC_ERR_OPEN
	BLBC	R0, 40$
	MOVW	R4, POC_ERR_RAB+RAB$W_RSZ
	MOVL	R5, POC_ERR_RAB+RAB$L_RBF
	$PUT	RAB=POC_ERR_RAB
40$:	ASHL	#3, R2, R2
	BISL3	#^X10000002, R2, R0
	$EXIT_S	CODE=R0
	RET

; POC_ERR_OPEN: SYS$ERROR opened, the first time, for POC_TRAP and for
; Err's lines; R0 the status. It stays open, and RMS closes it when the
; image exits, as it does every file the image has open ($RMSRUNDWN,
; System Services Reference SYS-639)
	.ENTRY	POC_ERR_OPEN, ^M<>
	MOVL	#1, R0
	TSTL	POC_ERR_IS_OPEN
	BNEQ	10$
	$CREATE	FAB=POC_ERR_FAB
	BLBC	R0, 10$
	$CONNECT	RAB=POC_ERR_RAB
	BLBS	R0, 5$
	PUSHL	R0
	$CLOSE	FAB=POC_ERR_FAB
	POPL	R0
	RET
5$:	MOVL	#1, POC_ERR_IS_OPEN
10$:	RET

; POC_HALT(code), code 0 to 255: the program ends with SS$_NORMAL for 0,
; else with %X10000000 + 8 * code + 2, as a trap with that code does
	.ENTRY	POC_HALT, ^M<>
	MOVL	4(AP), R0
	BNEQ	10$
	MOVL	#1, R0
	BRB	20$
10$:	ASHL	#3, R0, R0
	BISL2	#^X10000002, R0
20$:	$EXIT_S	CODE=R0
	RET

; POC_STRCMP(a, alen, b, blen): the strings at a and b, alen and blen
; bytes, compared up to the first 0X or the end of either, a byte past
; the end being 0X; R0 is the difference of the first two bytes that
; differ, unsigned, so less than, equal to or greater than zero as a is
; less than, equal to or greater than b
	.ENTRY	POC_STRCMP, ^M<R2,R3,R4,R5>
	MOVL	4(AP), R1
	MOVL	8(AP), R3
	MOVL	12(AP), R2
	MOVL	16(AP), R4
10$:	CLRL	R0
	TSTL	R3
	BEQL	20$
	MOVZBL	(R1)+, R0
	DECL	R3
20$:	CLRL	R5
	TSTL	R4
	BEQL	30$
	MOVZBL	(R2)+, R5
	DECL	R4
30$:	SUBL2	R5, R0
	BNEQ	40$
	TSTL	R5
	BNEQ	10$
40$:	RET

; POC_HMUL(a, b), a and b the addresses of HUGEINTs: R0 and R1 the
; product's low 64 bits. EMUL multiplies the low longwords as signed; a
; negative one's other operand, added to the high longword, makes that
; unsigned; the cross products go into the high longword too
	.ENTRY	POC_HMUL, ^M<R2,R3,R4>
	MOVL	4(AP), R3
	MOVL	8(AP), R4
	EMUL	(R3), (R4), #0, R0
	TSTL	(R3)
	BGEQ	10$
	ADDL2	(R4), R1
10$:	TSTL	(R4)
	BGEQ	20$
	ADDL2	(R3), R1
20$:	MULL3	(R3), 4(R4), R2
	ADDL2	R2, R1
	MULL3	4(R3), (R4), R2
	ADDL2	R2, R1
	RET

; POC_HDIV(a, b) and POC_HMOD(a, b), a and b the addresses of HUGEINTs:
; R0 and R1 the floored quotient or the remainder (with b's sign); a zero
; b gets the VAX's integer divide-by-zero trap
	.ENTRY	POC_HDIV, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	JSB	HDIVMOD
	RET

	.ENTRY	POC_HMOD, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	JSB	HDIVMOD
	MOVQ	R2, R0
	RET

; a, b as above: R0 and R1 the quotient, R2 and R3 the remainder. The
; magnitudes are divided bit by bit, the quotient's bits shifted in where
; the dividend's leave (R2 and R3), the remainder in R8 and R9; then the
; signs (R10: 1 a negative, 2 b negative) and the floor
HDIVMOD:
	MOVL	4(AP), R0
	MOVQ	(R0), R2
	MOVL	8(AP), R0
	MOVQ	(R0), R4
	BISL3	R4, R5, R0
	BNEQ	5$
	DIVL2	R0, R1
5$:	CLRL	R10
	MOVQ	R4, R6
	TSTL	R3
	BGEQ	10$
	MNEGL	R3, R3
	MNEGL	R2, R2
	SBWC	#0, R3
	BISL2	#1, R10
10$:	TSTL	R7
	BGEQ	20$
	MNEGL	R7, R7
	MNEGL	R6, R6
	SBWC	#0, R7
	BISL2	#2, R10
20$:	CLRQ	R8
	MOVL	#64, R11
30$:	ADDL2	R2, R2
	ADWC	R3, R3
	ADWC	R8, R8
	ADWC	R9, R9
	CMPL	R9, R7
	BGTRU	40$
	BLSSU	50$
	CMPL	R8, R6
	BLSSU	50$
40$:	SUBL2	R6, R8
	SBWC	R7, R9
	BISL2	#1, R2
50$:	SOBGTR	R11, 30$
	BLBC	R10, 60$
	MNEGL	R9, R9
	MNEGL	R8, R8
	SBWC	#0, R9
60$:	CMPL	R10, #1
	BEQL	70$
	CMPL	R10, #2
	BNEQ	90$
70$:	MNEGL	R3, R3
	MNEGL	R2, R2
	SBWC	#0, R3
	BISL3	R8, R9, R0
	BEQL	90$
	SUBL2	#1, R2
	SBWC	#0, R3
	ADDL2	R4, R8
	ADWC	R5, R9
90$:	MOVQ	R2, R0
	MOVQ	R8, R2
	RSB

; POC_QTOG(q), q the address of a quadword: R0 and R1 its value as a
; G_floating (design section 14, item 9), which no VAX instruction
; converts a quadword to. The high longword, signed, times 2^32, and the
; low one, unsigned, are each exact; their sum is rounded once, as the
; VAX rounds
	.ENTRY	POC_QTOG, ^M<R2,R3,R4>
	MOVL	4(AP), R4
	CVTLG	4(R4), R0
	MULG2	#4294967296.0, R0
	CVTLG	(R4), R2
	BGEQ	10$
	ADDG2	#4294967296.0, R2
10$:	ADDG2	R2, R0
	RET

; POC_ENTIERQ(x), x the address of a G_floating in [-2^63, 2^63), which
; the caller has checked: R0 and R1 ENTIER(x), the largest quadword not
; greater than x (design section 14, item 9). An x within a longword's
; range is floored by CVTGL, which truncates, then 1 less when converting
; that back gives more than x, then sign-extended. A larger x has no bit
; below 2^-21, so that hi = floor(x / 2^32), floored as above, and
; f = x - hi * 2^32, in [0, 2^32), are exact; the low longword is f's
; floor, its truncation: CVTGL of f - 2^31 (exact, f being at least
; 2^31) with bit 31 set, or of f
	.ENTRY	POC_ENTIERQ, ^M<R2,R3,R4,R5>
	MOVG	@4(AP), R2
	CMPG	R2, #-2147483648.0
	BLSS	20$
	CMPG	R2, #2147483648.0
	BGEQ	20$
	CVTGL	R2, R0
	CVTLG	R0, R4
	CMPG	R4, R2
	BLEQ	10$
	DECL	R0
10$:	ASHL	#-31, R0, R1
	RET
20$:	DIVG2	#4294967296.0, R2
	CVTGL	R2, R1
	CVTLG	R1, R4
	CMPG	R4, R2
	BLEQ	30$
	DECL	R1
30$:	CVTLG	R1, R2
	MULG2	#4294967296.0, R2
	SUBG3	R2, @4(AP), R2
	CMPG	R2, #2147483648.0
	BLSS	40$
	SUBG2	#2147483648.0, R2
	CVTGL	R2, R0
	BISL2	#^X80000000, R0
	RET
40$:	CVTGL	R2, R0
	RET

; The collector's (rtl/vax/GarbageCollectedHeap.Mod; design section 15,
; proposal 9), which NEW allocates from.

	.PSECT	POC_DATA
; the root tables registered, the most recent first, 0 if none: each a
; module's, its next table, count and the addresses of its pointers
; (VaxCodeGenerator.WriteRoots)
POC_ROOT_HEAD:
	.BLKL	1
; the collector's exit handler's control block: forward link, handler,
; one argument, the address of the exit status
POC_HEAP_EXIT_BLOCK:
	.LONG	0
	.BLKL	1
	.LONG	1
	.ADDRESS	POC_HEAP_EXIT_STATUS
POC_HEAP_EXIT_STATUS:
	.BLKL	1
; $GETJPI's item list for the paging file quota left, in pages
POC_JPI_PAGES:
	.BLKL	1
POC_JPI_PAGES_ITEMS:
	.WORD	4, JPI$_PAGFILCNT
	.ADDRESS	POC_JPI_PAGES
	.LONG	0
	.LONG	0

	.PSECT	POC_CODE
; POC_ROOTS(table): table, a module's root table, put first on the list,
; its first longword linking it to the one before. Called by a module's
; initializer, before its imports' and its body, in every program, with
; the collector or without it
	.ENTRY	POC_ROOTS, ^M<>
	MOVL	4(AP), R0
	MOVL	POC_ROOT_HEAD, (R0)
	MOVL	R0, POC_ROOT_HEAD
	RET

; POC_ROOT_TABLES(): R0 the first root table, 0 if none
	.ENTRY	POC_ROOT_TABLES, ^M<>
	MOVL	POC_ROOT_HEAD, R0
	RET

; POC_GET_MEMORY(bytes): R0 the address of bytes bytes from LIB$GET_VM,
; cleared, since LIB$GET_VM does not clear them (MOVC5 in pieces of at
; most 65535), or 0 when there is no memory
	.ENTRY	POC_GET_MEMORY, ^M<R2,R3,R4,R5,R6,R7>
	SUBL2	#8, SP
	MOVL	4(AP), -8(FP)
	PUSHAL	-4(FP)
	PUSHAL	-8(FP)
	CALLS	#2, G^LIB$GET_VM
	BLBS	R0, 10$
	CLRL	R0
	RET
10$:	MOVL	4(AP), R6
	MOVL	-4(FP), R3
20$:	TSTL	R6
	BEQL	30$
	MOVL	R6, R7
	CMPL	R7, #65535
	BLEQU	25$
	MOVL	#65535, R7
25$:	SUBL2	R7, R6
	MOVC5	#0, (R3), #0, R7, (R3)
	BRB	20$
30$:	MOVL	-4(FP), R0
	RET

; POC_FREE_MEMORY(address, bytes): the bytes bytes at address, which
; POC_GET_MEMORY gave, given back by LIB$FREE_VM; R0 its status
	.ENTRY	POC_FREE_MEMORY, ^M<>
	PUSHAL	8(AP)
	PUSHAL	4(AP)
	CALLS	#2, G^LIB$FREE_VM
	RET

; POC_SAVE_REGISTERS(procedure): procedure, which has no parameters,
; called from a frame that holds R2-R11, which this entry mask saves,
; so that a pointer a caller keeps only in a register is on the stack
; the collector scans from procedure's frame
	.ENTRY	POC_SAVE_REGISTERS, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CALLS	#0, @4(AP)
	RET

; POC_AT_EXIT(procedure): procedure, which has no parameters, declared
; the collector's exit handler ($DCLEXH), so that it runs when the
; image exits, as the C library's atexit runs one on LLVM; R0 the status
	.ENTRY	POC_AT_EXIT, ^M<>
	MOVL	4(AP), POC_HEAP_EXIT_BLOCK+4
	$DCLEXH_S	DESBLK=POC_HEAP_EXIT_BLOCK
	RET

; POC_PAGE_FILE_LEFT(): R0 the process's paging file quota left, in
; bytes ($GETJPI, JPI$_PAGFILCNT, in pages of 512), 0 if $GETJPI fails
	.ENTRY	POC_PAGE_FILE_LEFT, ^M<>
	CLRL	POC_JPI_PAGES
	$GETJPIW_S	ITMLST=POC_JPI_PAGES_ITEMS
	BLBC	R0, 10$
	ASHL	#9, POC_JPI_PAGES, R0
	RET
10$:	CLRL	R0
	RET

; Out's and Err's lines (rtl/vax/LineOutput.Mod; design section 14, item
; 2, and section 15, proposal 8). Each is kept until Ln, since a record
; is written whole.

	.PSECT	POC_DATA
; the two lines and their lengths, Out's then Err's, for the exit handler
POC_LINES:
	.BLKL	4
; the exit handler's control block: forward link, handler, one argument,
; the address of the exit status
POC_LINES_EXIT_BLOCK:
	.LONG	0
	.ADDRESS	POC_LINES_EXIT
	.LONG	1
	.ADDRESS	POC_LINES_EXIT_STATUS
POC_LINES_EXIT_STATUS:
	.BLKL	1

	.PSECT	POC_CODE
; POC_PUT_LINE(text, length): the length bytes at text written to
; SYS$OUTPUT as one record by LIB$PUT_OUTPUT, through a fixed-length string
; descriptor made on the stack; R0 LIB$PUT_OUTPUT's status
	.ENTRY	POC_PUT_LINE, ^M<>
	SUBL2	#8, SP
	MOVW	8(AP), (SP)
	MOVB	#DSC$K_DTYPE_T, DSC$B_DTYPE(SP)
	MOVB	#DSC$K_CLASS_S, DSC$B_CLASS(SP)
	MOVL	4(AP), DSC$A_POINTER(SP)
	MOVL	SP, R0
	PUSHL	R0
	CALLS	#1, G^LIB$PUT_OUTPUT
	RET

; POC_PUT_ERROR_LINE(text, length): the same written to SYS$ERROR, by
; RMS as POC_TRAP writes; R0 the status
	.ENTRY	POC_PUT_ERROR_LINE, ^M<>
	CALLS	#0, POC_ERR_OPEN
	BLBC	R0, 10$
	MOVW	8(AP), POC_ERR_RAB+RAB$W_RSZ
	MOVL	4(AP), POC_ERR_RAB+RAB$L_RBF
	$PUT	RAB=POC_ERR_RAB
10$:	RET

; POC_LINES_REGISTER(outText, outLength, errText, errLength): Out's and
; Err's lines and their lengths, LONGINTs whose low longwords are the
; counts, under -O2 or -OC; kept for POC_LINES_EXIT, which is declared an
; exit handler, so that a line the program has not ended with Ln when it
; ends is written still, as a record of its own: Out's, then Err's
	.ENTRY	POC_LINES_REGISTER, ^M<>
	MOVQ	4(AP), POC_LINES
	MOVQ	12(AP), POC_LINES+8
	$DCLEXH_S	DESBLK=POC_LINES_EXIT_BLOCK
	RET

	.ENTRY	POC_LINES_EXIT, ^M<R2>
	MOVL	POC_LINES+4, R2
	TSTL	(R2)
	BEQL	10$
	PUSHL	(R2)
	PUSHL	POC_LINES
	CALLS	#2, POC_PUT_LINE
	CLRL	(R2)
10$:	MOVL	POC_LINES+12, R2
	TSTL	(R2)
	BEQL	20$
	PUSHL	(R2)
	PUSHL	POC_LINES+8
	CALLS	#2, POC_PUT_ERROR_LINE
	CLRL	(R2)
20$:	RET

; Platform's and Modules' services (rtl/vax/Platform.Mod and Modules.Mod;
; design section 15, proposals 3 to 8). A name is passed as its address
; and its length, a buffer to fill as its address and its size; a routine
; that fills one returns the length it wrote in R0.

	.PSECT	POC_CONST
; the tables a file name's logical names are looked up in: the process's,
; the job's, the group's and the system's
POC_FILE_DEV:
	.ASCID	/LNM$FILE_DEV/
POC_CASE_BLIND:
	.LONG	LNM$M_CASE_BLIND

	.PSECT	POC_DATA
; $TRNLNM's item list: the index of the equivalence string wanted, the
; string and its length, and the largest index there is
POC_LNM_INDEX:
	.BLKL	1
POC_LNM_LENGTH:
	.BLKW	1
POC_LNM_MAX:
	.BLKL	1
POC_LNM_ITEMS:
	.WORD	4, LNM$_INDEX
	.ADDRESS	POC_LNM_INDEX
	.LONG	0
POC_LNM_STRING:
	.WORD	0, LNM$_STRING
	.LONG	0
	.ADDRESS	POC_LNM_LENGTH
	.WORD	4, LNM$_MAX_INDEX
	.ADDRESS	POC_LNM_MAX
	.LONG	0
	.LONG	0
; $GETJPI's item lists: the process's identification, and the image's
; file specification and its length
POC_JPI_PID:
	.BLKL	1
POC_JPI_PID_ITEMS:
	.WORD	4, JPI$_PID
	.ADDRESS	POC_JPI_PID
	.LONG	0
	.LONG	0
POC_JPI_LENGTH:
	.BLKW	1
POC_JPI_IMAGE_ITEMS:
	.WORD	0, JPI$_IMAGNAME
	.LONG	0
	.ADDRESS	POC_JPI_LENGTH
	.LONG	0
; the file a name is erased, or parsed, as: one FAB and NAM serve every
; $PARSE, so that each releases what the last one kept (RMS, $PARSE)
POC_NAME_FAB:
	$FAB	NAM=POC_NAME_NAM
POC_NAME_NAM:
	$NAM	ESA=POC_NAME_EXPANDED, ESS=NAM$C_MAXRSS
POC_NAME_EXPANDED:
	.BLKB	NAM$C_MAXRSS

	.PSECT	POC_CODE
; POC_TRNLNM(name, length, index, value, size): the equivalence string
; at index of the logical name in LNM$FILE_DEV, ignoring case, in value;
; R0 its length, or -1 when there is no such name or no string at index
	.ENTRY	POC_TRNLNM, ^M<>
	MOVL	12(AP), POC_LNM_INDEX
	MOVW	20(AP), POC_LNM_STRING
	MOVL	16(AP), POC_LNM_STRING+4
	CLRW	POC_LNM_LENGTH
	MNEGL	#1, POC_LNM_MAX
	POC_DESCRIBE	4(AP), 8(AP)
	PUSHAL	POC_LNM_ITEMS
	CLRL	-(SP)
	PUSHL	R1
	PUSHAQ	POC_FILE_DEV
	PUSHAL	POC_CASE_BLIND
	CALLS	#5, G^SYS$TRNLNM
	BLBC	R0, 10$
	CMPL	12(AP), POC_LNM_MAX
	BGTR	10$
	MOVZWL	POC_LNM_LENGTH, R0
	RET
10$:	MNEGL	#1, R0
	RET

; POC_ERASE(name, length): the file deleted, the highest version when
; the name gives none; R0 RMS's status
	.ENTRY	POC_ERASE, ^M<>
	MOVL	4(AP), POC_NAME_FAB+FAB$L_FNA
	MOVB	8(AP), POC_NAME_FAB+FAB$B_FNS
	$ERASE	FAB=POC_NAME_FAB
	RET

; POC_PARSE(name, length): the name parsed, which looks its directory up;
; R0 RMS's status, RMS$_DNF if there is no such directory
	.ENTRY	POC_PARSE, ^M<>
	MOVL	4(AP), POC_NAME_FAB+FAB$L_FNA
	MOVB	8(AP), POC_NAME_FAB+FAB$B_FNS
	$PARSE	FAB=POC_NAME_FAB
	RET

; POC_CREATE_DIRECTORY(name, length): the directory made, and those it is
; in that are missing, by LIB$CREATE_DIR; R0 its status, SS$_CREATED or
; SS$_NORMAL (all of them there already) when it succeeds
	.ENTRY	POC_CREATE_DIRECTORY, ^M<>
	POC_DESCRIBE	4(AP), 8(AP)
	PUSHL	R1
	CALLS	#1, G^LIB$CREATE_DIR
	RET

; POC_DEFAULT_DIRECTORY(value, size): the process's default directory, as
; $SETDDIR reads it, in value; R0 its length, 0 if it cannot be read
	.ENTRY	POC_DEFAULT_DIRECTORY, ^M<>
	CLRL	-(SP)
	POC_DESCRIBE	4(AP), 8(AP)
	PUSHL	R1
	PUSHAW	-4(FP)
	CLRL	-(SP)
	CALLS	#3, G^SYS$SETDDIR
	BLBC	R0, 10$
	MOVZWL	-4(FP), R0
	RET
10$:	CLRL	R0
	RET

; POC_PROCESS_ID(): R0 the process's identification, 0 if $GETJPI fails
	.ENTRY	POC_PROCESS_ID, ^M<>
	CLRL	POC_JPI_PID
	$GETJPIW_S	ITMLST=POC_JPI_PID_ITEMS
	MOVL	POC_JPI_PID, R0
	RET

; POC_IMAGE_NAME(value, size): the file specification of the image
; running in value; R0 its length, 0 if $GETJPI fails
	.ENTRY	POC_IMAGE_NAME, ^M<>
	MOVW	8(AP), POC_JPI_IMAGE_ITEMS
	MOVL	4(AP), POC_JPI_IMAGE_ITEMS+4
	CLRW	POC_JPI_LENGTH
	$GETJPIW_S	ITMLST=POC_JPI_IMAGE_ITEMS
	BLBC	R0, 10$
	MOVZWL	POC_JPI_LENGTH, R0
	RET
10$:	CLRL	R0
	RET

; POC_FOREIGN(value, size): the command line after a foreign command, as
; LIB$GET_FOREIGN gives it, without prompting, in value; R0 its length,
; 0 when there is none
	.ENTRY	POC_FOREIGN, ^M<>
	CLRL	-(SP)
	POC_DESCRIBE	4(AP), 8(AP)
	PUSHAW	-4(FP)
	CLRL	-(SP)
	PUSHL	R1
	CALLS	#3, G^LIB$GET_FOREIGN
	BLBC	R0, 10$
	MOVZWL	-4(FP), R0
	RET
10$:	CLRL	R0
	RET

; Files' services (rtl/vax/Files.Mod; design section 15, proposal 2). A
; file's FAB, RAB, NAM block and XABFHC, and the resultant name, are in
; the control the File keeps (Files.Control, its address the first
; argument), laid out as below. A position is passed as the address of a
; LONGINT, whose low longword is the count under -O2 or -OC.

POC_F_FAB = 0
POC_F_RAB = POC_F_FAB + FAB$C_BLN
POC_F_NAM = POC_F_RAB + RAB$C_BLN
POC_F_FHC = POC_F_NAM + NAM$C_BLN
POC_F_RSA = POC_F_FHC + XAB$C_FHCLEN
POC_F_SIZE = POC_F_RSA + NAM$C_MAXRSS
	.IF	GREATER, POC_F_SIZE - 768
	.ERROR	; a file's RMS blocks do not fit Files.Control (768 bytes)
	.ENDC

	.PSECT	POC_CONST
; the blocks each control's are copied from
	.ALIGN	LONG
POC_FILE_FAB_TEMPLATE:
	$FAB	ORG=SEQ
POC_FILE_RAB_TEMPLATE:
	$RAB
POC_FILE_NAM_TEMPLATE:
	$NAM
POC_FILE_FHC_TEMPLATE:
	$XABFHC
; a New file's name until Register: the process and a count, in the
; directory of the name it is to be registered as
POC_FILE_TEMP_CONTROL:
	.ASCID	/POC_!XL_!UL.TMP/

	.PSECT	POC_DATA
POC_FILE_TEMP_COUNT:
	.BLKL	1
POC_FILE_TEMP_LENGTH:
	.BLKW	1
POC_FILE_TEMP_NAME:
	.BLKB	40
POC_FILE_TEMP_OUT:
	.WORD	40
	.BYTE	DSC$K_DTYPE_T, DSC$K_CLASS_S
	.ADDRESS	POC_FILE_TEMP_NAME
; $RENAME's FABs and NAM blocks, the old name's and the new one's, each
; NAM block with the expanded string $RENAME requires, and the new name's
; resultant string
	.ALIGN	LONG
POC_RENAME_OLD_FAB:
	$FAB	NAM=POC_RENAME_OLD_NAM
POC_RENAME_OLD_NAM:
	$NAM	ESA=POC_RENAME_OLD_ESA, ESS=NAM$C_MAXRSS
POC_RENAME_OLD_ESA:
	.BLKB	NAM$C_MAXRSS
	.ALIGN	LONG
POC_RENAME_NEW_FAB:
	$FAB	NAM=POC_RENAME_NEW_NAM
POC_RENAME_NEW_NAM:
	$NAM	ESA=POC_RENAME_NEW_ESA, ESS=NAM$C_MAXRSS, -
		RSA=POC_RENAME_NEW_RSA, RSS=NAM$C_MAXRSS
POC_RENAME_NEW_ESA:
	.BLKB	NAM$C_MAXRSS
POC_RENAME_NEW_RSA:
	.BLKB	NAM$C_MAXRSS
; POC_FILE_FAIL's message
POC_FILE_MESSAGE:
	.BLKB	600

	.PSECT	POC_CODE
; JSB, R6 the control: its blocks copied from the templates and linked,
; the NAM block's resultant string in the control
POC_FILE_INIT:
	MOVC3	#FAB$C_BLN, POC_FILE_FAB_TEMPLATE, POC_F_FAB(R6)
	MOVC3	#RAB$C_BLN, POC_FILE_RAB_TEMPLATE, POC_F_RAB(R6)
	MOVC3	#NAM$C_BLN, POC_FILE_NAM_TEMPLATE, POC_F_NAM(R6)
	MOVC3	#XAB$C_FHCLEN, POC_FILE_FHC_TEMPLATE, POC_F_FHC(R6)
	MOVAB	POC_F_NAM(R6), POC_F_FAB+FAB$L_NAM(R6)
	MOVAB	POC_F_FHC(R6), POC_F_FAB+FAB$L_XAB(R6)
	MOVAB	POC_F_FAB(R6), POC_F_RAB+RAB$L_FAB(R6)
	MOVAB	POC_F_RSA(R6), POC_F_NAM+NAM$L_RSA(R6)
	MOVB	#NAM$C_MAXRSS, POC_F_NAM+NAM$B_RSS(R6)
	RSB

; JSB, R6 the control, R0 $OPEN's or $CREATE's status: the RAB connected,
; for block I/O when R1's low bit is set; R0 the status, the file closed
; again when $CONNECT fails
POC_FILE_CONNECT:
	BLBC	R0, 20$
	BLBC	R1, 10$
	BISL2	#RAB$M_BIO, POC_F_RAB+RAB$L_ROP(R6)
10$:	CLRQ	-(SP)
	PUSHAB	POC_F_RAB(R6)
	CALLS	#3, G^SYS$CONNECT
	BLBS	R0, 20$
	PUSHL	R0
	CLRQ	-(SP)
	PUSHAB	POC_F_FAB(R6)
	CALLS	#3, G^SYS$CLOSE
	POPL	R0
20$:	RSB

; JSB, R6 the control with its name in the FAB, R7 the address of three
; longwords: the file opened to be read, by block I/O when it is
; Stream_LF, fixed-length or undefined (the first longword then 1, else
; 0, to be read a record at a time), the end-of-file block and the first
; free byte in it; R0 the status
POC_FILE_OPEN_FAB:
	MOVB	#<FAB$M_GET!FAB$M_BRO>, POC_F_FAB+FAB$B_FAC(R6)
	MOVB	#<FAB$M_SHRGET!FAB$M_UPI>, POC_F_FAB+FAB$B_SHR(R6)
	CLRQ	-(SP)
	PUSHAB	POC_F_FAB(R6)
	CALLS	#3, G^SYS$OPEN
	BLBC	R0, 30$
	MOVL	#1, R1
	CMPB	POC_F_FAB+FAB$B_RFM(R6), #FAB$C_STMLF
	BEQL	20$
	CMPB	POC_F_FAB+FAB$B_RFM(R6), #FAB$C_FIX
	BEQL	20$
	CMPB	POC_F_FAB+FAB$B_RFM(R6), #FAB$C_UDF
	BEQL	20$
	CLRL	R1
20$:	MOVL	R1, (R7)
	MOVL	POC_F_FHC+XAB$L_EBK(R6), 4(R7)
	MOVZWL	POC_F_FHC+XAB$W_FFB(R6), 8(R7)
	JSB	POC_FILE_CONNECT
30$:	RSB

; POC_FILE_OPEN(control, name, length, info): the file name opened to be
; read, info the three longwords POC_FILE_OPEN_FAB gives; R0 the status
	.ENTRY	POC_FILE_OPEN, ^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP), R6
	JSB	POC_FILE_INIT
	MOVL	8(AP), POC_F_FAB+FAB$L_FNA(R6)
	MOVB	12(AP), POC_F_FAB+FAB$B_FNS(R6)
	MOVL	16(AP), R7
	JSB	POC_FILE_OPEN_FAB
	RET

; POC_FILE_REOPEN(control, info): the file the control was last open on,
; by its resultant name, opened again as POC_FILE_OPEN opens one; R0 the
; status
	.ENTRY	POC_FILE_REOPEN, ^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP), R6
	MOVZBL	POC_F_NAM+NAM$B_RSL(R6), -(SP)
	JSB	POC_FILE_INIT
	MOVAB	POC_F_RSA(R6), POC_F_FAB+FAB$L_FNA(R6)
	MOVL	(SP)+, R0
	MOVB	R0, POC_F_FAB+FAB$B_FNS(R6)
	MOVL	8(AP), R7
	JSB	POC_FILE_OPEN_FAB
	RET

; POC_FILE_CREATE(control, name, length): a new Stream_LF file, with
; carriage return carriage control, made under a name of its own in the
; directory name is in (name the default name), to be written by block
; I/O and read back; R0 the status
	.ENTRY	POC_FILE_CREATE, ^M<R2,R3,R4,R5,R6>
	MOVL	4(AP), R6
	JSB	POC_FILE_INIT
	INCL	POC_FILE_TEMP_COUNT
	CALLS	#0, POC_PROCESS_ID
	$FAO_S	CTRSTR=POC_FILE_TEMP_CONTROL, OUTLEN=POC_FILE_TEMP_LENGTH, -
		OUTBUF=POC_FILE_TEMP_OUT, P1=R0, P2=POC_FILE_TEMP_COUNT
	BLBC	R0, 10$
	MOVAB	POC_FILE_TEMP_NAME, POC_F_FAB+FAB$L_FNA(R6)
	MOVB	POC_FILE_TEMP_LENGTH, POC_F_FAB+FAB$B_FNS(R6)
	MOVL	8(AP), POC_F_FAB+FAB$L_DNA(R6)
	MOVB	12(AP), POC_F_FAB+FAB$B_DNS(R6)
	MOVB	#<FAB$M_GET!FAB$M_PUT!FAB$M_BIO>, POC_F_FAB+FAB$B_FAC(R6)
	MOVB	#FAB$M_NIL, POC_F_FAB+FAB$B_SHR(R6)
	MOVB	#FAB$C_STMLF, POC_F_FAB+FAB$B_RFM(R6)
	MOVB	#FAB$M_CR, POC_F_FAB+FAB$B_RAT(R6)
	CLRQ	-(SP)
	PUSHAB	POC_F_FAB(R6)
	CALLS	#3, G^SYS$CREATE
	MOVL	#1, R1
	JSB	POC_FILE_CONNECT
10$:	RET

; POC_FILE_READ(control, position, block): the 512-byte block of the
; file holding the byte at position read into block; R0 the status
	.ENTRY	POC_FILE_READ, ^M<R6>
	MOVL	4(AP), R6
	DIVL3	#512, @8(AP), R0
	ADDL3	#1, R0, POC_F_RAB+RAB$L_BKT(R6)
	MOVL	12(AP), POC_F_RAB+RAB$L_UBF(R6)
	MOVW	#512, POC_F_RAB+RAB$W_USZ(R6)
	CLRQ	-(SP)
	PUSHAB	POC_F_RAB(R6)
	CALLS	#3, G^SYS$READ
	RET

; POC_FILE_WRITE(control, position, block, count): the first count bytes
; of block written to the block of the file starting at position, a
; multiple of 512; RMS keeps the file's end at the highest byte written
; (RMS Reference, $WRITE); R0 the status
	.ENTRY	POC_FILE_WRITE, ^M<R6>
	MOVL	4(AP), R6
	DIVL3	#512, @8(AP), R0
	ADDL3	#1, R0, POC_F_RAB+RAB$L_BKT(R6)
	MOVL	12(AP), POC_F_RAB+RAB$L_RBF(R6)
	MOVW	16(AP), POC_F_RAB+RAB$W_RSZ(R6)
	CLRQ	-(SP)
	PUSHAB	POC_F_RAB(R6)
	CALLS	#3, G^SYS$WRITE
	RET

; POC_FILE_GET(control, record, size): the next record into record, of
; size bytes; R0 its length, -1 at the end of the file, -2 if it cannot
; be read
	.ENTRY	POC_FILE_GET, ^M<R6>
	MOVL	4(AP), R6
	MOVL	8(AP), POC_F_RAB+RAB$L_UBF(R6)
	MOVW	12(AP), POC_F_RAB+RAB$W_USZ(R6)
	CLRQ	-(SP)
	PUSHAB	POC_F_RAB(R6)
	CALLS	#3, G^SYS$GET
	BLBC	R0, 10$
	MOVZWL	POC_F_RAB+RAB$W_RSZ(R6), R0
	RET
10$:	CMPL	R0, #RMS$_EOF
	BNEQ	20$
	MNEGL	#1, R0
	RET
20$:	MNEGL	#2, R0
	RET

; POC_FILE_REWIND(control): the file's records to be read from the
; first again; R0 the status
	.ENTRY	POC_FILE_REWIND, ^M<R6>
	MOVL	4(AP), R6
	CLRQ	-(SP)
	PUSHAB	POC_F_RAB(R6)
	CALLS	#3, G^SYS$REWIND
	RET

; POC_FILE_CLOSE(control): the file closed; R0 the status
	.ENTRY	POC_FILE_CLOSE, ^M<R6>
	MOVL	4(AP), R6
	CLRQ	-(SP)
	PUSHAB	POC_F_FAB(R6)
	CALLS	#3, G^SYS$CLOSE
	RET

; POC_FILE_RENAME(control, name, length): the file the control was last
; open on, now closed, renamed name, whose resultant name the control
; then keeps; R0 the status
	.ENTRY	POC_FILE_RENAME, ^M<R2,R3,R4,R5,R6>
	MOVL	4(AP), R6
	MOVAB	POC_F_RSA(R6), POC_RENAME_OLD_FAB+FAB$L_FNA
	MOVB	POC_F_NAM+NAM$B_RSL(R6), POC_RENAME_OLD_FAB+FAB$B_FNS
	MOVL	8(AP), POC_RENAME_NEW_FAB+FAB$L_FNA
	MOVB	12(AP), POC_RENAME_NEW_FAB+FAB$B_FNS
	PUSHAB	POC_RENAME_NEW_FAB
	CLRQ	-(SP)
	PUSHAB	POC_RENAME_OLD_FAB
	CALLS	#4, G^SYS$RENAME
	BLBC	R0, 10$
	PUSHL	R0
	MOVB	POC_RENAME_NEW_NAM+NAM$B_RSL, POC_F_NAM+NAM$B_RSL(R6)
	MOVZBL	POC_RENAME_NEW_NAM+NAM$B_RSL, R0
	MOVC3	R0, POC_RENAME_NEW_RSA, POC_F_RSA(R6)
	POPL	R0
10$:	RET

; POC_FILE_FAIL(message, mlength, name, nlength): Files' error that
; nothing can be told about written to SYS$ERROR, after an empty record
; as rtl/llvm's writes its message on a line of its own, "-- message" and
; ": name" when there is one; then the program ends as HALT(99) ends it
	.ENTRY	POC_FILE_FAIL, ^M<R2,R3,R4,R5>
	CLRL	-(SP)
	PUSHAB	POC_FILE_MESSAGE
	CALLS	#2, POC_PUT_ERROR_LINE
	MOVAB	POC_FILE_MESSAGE, R3
	MOVW	#^A/--/, (R3)+
	MOVB	#^A/ /, (R3)+
	MOVC3	8(AP), @4(AP), (R3)
	TSTL	16(AP)
	BEQL	10$
	MOVW	#^A/: /, (R3)+
	MOVC3	16(AP), @12(AP), (R3)
10$:	MOVAB	POC_FILE_MESSAGE, R1
	SUBL3	R1, R3, -(SP)
	PUSHAB	POC_FILE_MESSAGE
	CALLS	#2, POC_PUT_ERROR_LINE
	PUSHL	#99
	CALLS	#1, POC_HALT
	RET

	.END
