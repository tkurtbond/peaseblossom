; poc's VAX/VMS runtime routines (PLAN.md Phase 16), which a program poc
; builds for vax-dec-vms links as POCRTL.OBJ (VaxToolchainDriver's build
; procedure; doc/developer/vax-macro32-backend.md, sections 8, 9 and 13).
; Step 2's first cut: POC_STRCMP, POC_HMUL, POC_HDIV and POC_HMOD compute
; what they will in the end, as tools/vax-runtime-stub.mar's do. Step 3's:
; POC_TRAP and POC_HALT, which end the program as section 14, item 10
; says; POC_NEW, NEW's, from LIB$GET_VM until the collector is ported;
; POC_PUT_LINE and POC_OUT_REGISTER, Out's output; POC_QTOG and
; POC_ENTIERQ, the conversions between a quadword and a G_floating.
; The rest of the runtime is step 4's.
	.TITLE	POCRTL
	.IDENT	/PHASE16-3/
	.PSECT	POC_CODE,  PIC,SHR,NOWRT,EXE,LONG
	.PSECT	POC_CONST, PIC,SHR,NOWRT,NOEXE,QUAD
	.PSECT	POC_DATA,  NOPIC,NOSHR,WRT,NOEXE,QUAD
	$DSCDEF

; Traps and HALT (design section 14, item 10). A trap's message is the
; LLVM backend's, a counted string here for each code, 2 to 14 (section
; 9; LLVMCodeGenerator's trap messages), and CHR's for 14 when the code's
; high word is 1, SHORT's being the other
	.PSECT	POC_CONST
POC_TRAP_TEXTS:
	.ADDRESS	POC_TX_0, POC_TX_0, POC_TX_2, POC_TX_3, POC_TX_4
	.ADDRESS	POC_TX_5, POC_TX_6, POC_TX_7, POC_TX_8, POC_TX_9
	.ADDRESS	POC_TX_10, POC_TX_11, POC_TX_12, POC_TX_13, POC_TX_14
	.ADDRESS	POC_TX_CHR
POC_TX_0:	.ASCIC	/trap/
POC_TX_2:	.ASCIC	/index out of range/
POC_TX_3:	.ASCIC	/no matching CASE label/
POC_TX_4:	.ASCIC	/NIL pointer dereference/
POC_TX_5:	.ASCIC	/type guard failed/
POC_TX_6:	.ASCIC	/no matching WITH guard/
POC_TX_7:	.ASCIC	/Too many, or negative number of, elements in dynamic array/
POC_TX_8:	.ASCIC	/ENTIER argument out of range for LONGINT/
POC_TX_9:	.ASCIC	/open array assigned to an array too short for it/
POC_TX_10:	.ASCIC	/assertion failed/
POC_TX_11:	.ASCIC	/heap exhausted: NEW cannot allocate the block/
POC_TX_12:	.ASCIC	/function procedure reached its END without RETURN/
POC_TX_13:	.ASCIC	/record assigned to a variable whose dynamic type extends its static type/
POC_TX_14:	.ASCIC	/SHORT argument out of range/
POC_TX_CHR:	.ASCIC	/CHR argument out of range/
; -trap-location's form: file:line:column: message (in procedure)
POC_TRAP_WHERE:
	.ASCID	"!AC:!UL:!UL: !AC (in !AC)"
; ASSERT(x, n)'s message
POC_ASSERT_N:
	.ASCID	"assertion failed (!UL)"

	.PSECT	POC_DATA
; SYS$ERROR, written one record at a time (RMS 4.1: a variable-length
; record, carriage return carriage control)
POC_ERR_FAB:
	$FAB	FNM=<SYS$ERROR>, FAC=<PUT>, RFM=VAR, RAT=<CR>
POC_ERR_RAB:
	$RAB	FAB=POC_ERR_FAB
; $FAO's output, and a descriptor of it
POC_TRAP_LENGTH:
	.BLKW	1
POC_TRAP_BUFFER:
	.BLKB	600
POC_TRAP_OUT:
	.WORD	600
	.BYTE	DSC$K_DTYPE_T, DSC$K_CLASS_S
	.ADDRESS	POC_TRAP_BUFFER
; ASSERT(x, n)'s message, made by $FAO after a count byte, and a
; descriptor of the text
POC_ASSERT_LENGTH:
	.BLKW	1
POC_ASSERT_TEXT:
	.BLKB	40
POC_ASSERT_OUT:
	.WORD	39
	.BYTE	DSC$K_DTYPE_T, DSC$K_CLASS_S
	.ADDRESS	POC_ASSERT_TEXT+1

	.PSECT	POC_CODE
; POC_TRAP(code, module, line, column[, file, procedure]), module, file
; and procedure counted strings, the code in the low word of its
; longword and which of its messages in the high word (1 for 14, CHR's;
; n + 1 for 10, ASSERT(x, n)'s "assertion failed (n)"): the message
; written to SYS$ERROR, as the LLVM backend writes it to the standard
; error, then the program ends with %X10000000 + 8 * code + 2, severity
; error, message number code, with STS$M_INHIB_MSG set so that DCL adds
; nothing. Under -trap-location the call has six arguments, and the
; message is prefixed with file:line:column: and ended with (in
; procedure), as on LLVM. A record that cannot be written is let go: the
; status still says what happened
	.ENTRY	POC_TRAP, ^M<R2,R3,R4,R5>
	MOVZWL	4(AP), R2
	MOVL	R2, R3
	CMPL	R3, #14
	BLSSU	10$
	BGTRU	5$
	TSTW	6(AP)
	BEQL	10$
	MOVL	#15, R3
	BRB	10$
5$:	CLRL	R3
10$:	MOVL	POC_TRAP_TEXTS[R3], R3
	CMPL	R2, #10
	BNEQ	15$
	MOVZWL	6(AP), R0
	BEQL	15$
	DECL	R0
	$FAO_S	CTRSTR=POC_ASSERT_N, OUTLEN=POC_ASSERT_LENGTH, -
		OUTBUF=POC_ASSERT_OUT, P1=R0
	MOVB	POC_ASSERT_LENGTH, POC_ASSERT_TEXT
	MOVAB	POC_ASSERT_TEXT, R3
15$:	CMPB	(AP), #6
	BLSSU	20$
	$FAO_S	CTRSTR=POC_TRAP_WHERE, OUTLEN=POC_TRAP_LENGTH, -
		OUTBUF=POC_TRAP_OUT, P1=20(AP), P2=12(AP), P3=16(AP), -
		P4=R3, P5=24(AP)
	MOVZWL	POC_TRAP_LENGTH, R4
	MOVAB	POC_TRAP_BUFFER, R5
	BRB	30$
20$:	MOVZBL	(R3)+, R4
	MOVL	R3, R5
30$:	$CREATE	FAB=POC_ERR_FAB
	BLBC	R0, 40$
	$CONNECT	RAB=POC_ERR_RAB
	BLBC	R0, 40$
	MOVW	R4, POC_ERR_RAB+RAB$W_RSZ
	MOVL	R5, POC_ERR_RAB+RAB$L_RBF
	$PUT	RAB=POC_ERR_RAB
	$CLOSE	FAB=POC_ERR_FAB
40$:	ASHL	#3, R2, R2
	BISL3	#^X10000002, R2, R0
	$EXIT_S	CODE=R0
	RET

; POC_HALT(code), code 0 to 255: the program ends with SS$_NORMAL for 0,
; else with %X10000000 + 8 * code + 2, as a trap with that code does
	.ENTRY	POC_HALT, ^M<>
	MOVL	4(AP), R0
	BNEQ	10$
	MOVL	#1, R0
	BRB	20$
10$:	ASHL	#3, R0, R0
	BISL2	#^X10000002, R0
20$:	$EXIT_S	CODE=R0
	RET

; POC_STRCMP(a, alen, b, blen): the strings at a and b, alen and blen
; bytes, compared up to the first 0X or the end of either, a byte past
; the end being 0X; R0 is the difference of the first two bytes that
; differ, unsigned, so less than, equal to or greater than zero as a is
; less than, equal to or greater than b
	.ENTRY	POC_STRCMP, ^M<R2,R3,R4,R5>
	MOVL	4(AP), R1
	MOVL	8(AP), R3
	MOVL	12(AP), R2
	MOVL	16(AP), R4
10$:	CLRL	R0
	TSTL	R3
	BEQL	20$
	MOVZBL	(R1)+, R0
	DECL	R3
20$:	CLRL	R5
	TSTL	R4
	BEQL	30$
	MOVZBL	(R2)+, R5
	DECL	R4
30$:	SUBL2	R5, R0
	BNEQ	40$
	TSTL	R5
	BNEQ	10$
40$:	RET

; POC_HMUL(a, b), a and b the addresses of HUGEINTs: R0 and R1 the
; product's low 64 bits. EMUL multiplies the low longwords as signed; a
; negative one's other operand, added to the high longword, makes that
; unsigned; the cross products go into the high longword too
	.ENTRY	POC_HMUL, ^M<R2,R3,R4>
	MOVL	4(AP), R3
	MOVL	8(AP), R4
	EMUL	(R3), (R4), #0, R0
	TSTL	(R3)
	BGEQ	10$
	ADDL2	(R4), R1
10$:	TSTL	(R4)
	BGEQ	20$
	ADDL2	(R3), R1
20$:	MULL3	(R3), 4(R4), R2
	ADDL2	R2, R1
	MULL3	4(R3), (R4), R2
	ADDL2	R2, R1
	RET

; POC_HDIV(a, b) and POC_HMOD(a, b), a and b the addresses of HUGEINTs:
; R0 and R1 the floored quotient or the remainder (with b's sign); a zero
; b gets the VAX's integer divide-by-zero trap
	.ENTRY	POC_HDIV, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	JSB	HDIVMOD
	RET

	.ENTRY	POC_HMOD, ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	JSB	HDIVMOD
	MOVQ	R2, R0
	RET

; a, b as above: R0 and R1 the quotient, R2 and R3 the remainder. The
; magnitudes are divided bit by bit, the quotient's bits shifted in where
; the dividend's leave (R2 and R3), the remainder in R8 and R9; then the
; signs (R10: 1 a negative, 2 b negative) and the floor
HDIVMOD:
	MOVL	4(AP), R0
	MOVQ	(R0), R2
	MOVL	8(AP), R0
	MOVQ	(R0), R4
	BISL3	R4, R5, R0
	BNEQ	5$
	DIVL2	R0, R1
5$:	CLRL	R10
	MOVQ	R4, R6
	TSTL	R3
	BGEQ	10$
	MNEGL	R3, R3
	MNEGL	R2, R2
	SBWC	#0, R3
	BISL2	#1, R10
10$:	TSTL	R7
	BGEQ	20$
	MNEGL	R7, R7
	MNEGL	R6, R6
	SBWC	#0, R7
	BISL2	#2, R10
20$:	CLRQ	R8
	MOVL	#64, R11
30$:	ADDL2	R2, R2
	ADWC	R3, R3
	ADWC	R8, R8
	ADWC	R9, R9
	CMPL	R9, R7
	BGTRU	40$
	BLSSU	50$
	CMPL	R8, R6
	BLSSU	50$
40$:	SUBL2	R6, R8
	SBWC	R7, R9
	BISL2	#1, R2
50$:	SOBGTR	R11, 30$
	BLBC	R10, 60$
	MNEGL	R9, R9
	MNEGL	R8, R8
	SBWC	#0, R9
60$:	CMPL	R10, #1
	BEQL	70$
	CMPL	R10, #2
	BNEQ	90$
70$:	MNEGL	R3, R3
	MNEGL	R2, R2
	SBWC	#0, R3
	BISL3	R8, R9, R0
	BEQL	90$
	SUBL2	#1, R2
	SBWC	#0, R3
	ADDL2	R4, R8
	ADWC	R5, R9
90$:	MOVQ	R2, R0
	MOVQ	R8, R2
	RSB

; POC_QTOG(q), q the address of a quadword: R0 and R1 its value as a
; G_floating (design section 14, item 9), which no VAX instruction
; converts a quadword to. The high longword, signed, times 2^32, and the
; low one, unsigned, are each exact; their sum is rounded once, as the
; VAX rounds
	.ENTRY	POC_QTOG, ^M<R2,R3,R4>
	MOVL	4(AP), R4
	CVTLG	4(R4), R0
	MULG2	#4294967296.0, R0
	CVTLG	(R4), R2
	BGEQ	10$
	ADDG2	#4294967296.0, R2
10$:	ADDG2	R2, R0
	RET

; POC_ENTIERQ(x), x the address of a G_floating in [-2^63, 2^63), which
; the caller has checked: R0 and R1 ENTIER(x), the largest quadword not
; greater than x (design section 14, item 9). An x within a longword's
; range is floored by CVTGL, which truncates, then 1 less when converting
; that back gives more than x, then sign-extended. A larger x has no bit
; below 2^-21, so that hi = floor(x / 2^32), floored as above, and
; f = x - hi * 2^32, in [0, 2^32), are exact; the low longword is f's
; floor, its truncation: CVTGL of f - 2^31 (exact, f being at least
; 2^31) with bit 31 set, or of f
	.ENTRY	POC_ENTIERQ, ^M<R2,R3,R4,R5>
	MOVG	@4(AP), R2
	CMPG	R2, #-2147483648.0
	BLSS	20$
	CMPG	R2, #2147483648.0
	BGEQ	20$
	CVTGL	R2, R0
	CVTLG	R0, R4
	CMPG	R4, R2
	BLEQ	10$
	DECL	R0
10$:	ASHL	#-31, R0, R1
	RET
20$:	DIVG2	#4294967296.0, R2
	CVTGL	R2, R1
	CVTLG	R1, R4
	CMPG	R4, R2
	BLEQ	30$
	DECL	R1
30$:	CVTLG	R1, R2
	MULG2	#4294967296.0, R2
	SUBG3	R2, @4(AP), R2
	CMPG	R2, #2147483648.0
	BLSS	40$
	SUBG2	#2147483648.0, R2
	CVTGL	R2, R0
	BISL2	#^X80000000, R0
	RET
40$:	CVTGL	R2, R0
	RET

; POC_NEW(size, tag), for NEW (design section 14, item 3): a block of a
; tag longword and size bytes from LIB$GET_VM, tag stored and the bytes
; cleared, since LIB$GET_VM does not clear them and every variable starts
; at zero (MOVC5 in pieces of at most 65535); R0 the address past the
; tag, or 0, NIL, when there is no memory. Nothing is freed until the
; collector is ported (step 4).
	.ENTRY	POC_NEW, ^M<R2,R3,R4,R5,R6,R7>
	SUBL2	#8, SP
	ADDL3	#4, 4(AP), -8(FP)
	PUSHAL	-4(FP)
	PUSHAL	-8(FP)
	CALLS	#2, G^LIB$GET_VM
	BLBS	R0, 10$
	CLRL	R0
	RET
10$:	MOVL	-4(FP), R1
	MOVL	8(AP), (R1)
	MOVL	4(AP), R6
	ADDL3	#4, R1, R3
20$:	TSTL	R6
	BEQL	30$
	MOVL	R6, R7
	CMPL	R7, #65535
	BLEQU	25$
	MOVL	#65535, R7
25$:	SUBL2	R7, R6
	MOVC5	#0, (R3), #0, R7, (R3)
	BRB	20$
30$:	ADDL3	#4, -4(FP), R0
	RET

; Out's output (rtl/vax/Out.Mod; design section 14, item 2). Out keeps a
; line until Ln, since LIB$PUT_OUTPUT writes whole records.

	.PSECT	POC_DATA
; where Out keeps its line and its length, for the exit handler
POC_OUT_TEXT:
	.BLKL	1
POC_OUT_LENGTH:
	.BLKL	1
; the exit handler's control block: forward link, handler, one argument,
; the address of the exit status
POC_OUT_EXIT_BLOCK:
	.LONG	0
	.ADDRESS	POC_OUT_EXIT
	.LONG	1
	.ADDRESS	POC_OUT_EXIT_STATUS
POC_OUT_EXIT_STATUS:
	.BLKL	1

	.PSECT	POC_CODE
; POC_PUT_LINE(text, length): the length bytes at text written to
; SYS$OUTPUT as one record by LIB$PUT_OUTPUT, through a fixed-length string
; descriptor made on the stack; R0 LIB$PUT_OUTPUT's status
	.ENTRY	POC_PUT_LINE, ^M<>
	SUBL2	#8, SP
	MOVW	8(AP), (SP)
	MOVB	#DSC$K_DTYPE_T, DSC$B_DTYPE(SP)
	MOVB	#DSC$K_CLASS_S, DSC$B_CLASS(SP)
	MOVL	4(AP), DSC$A_POINTER(SP)
	MOVL	SP, R0
	PUSHL	R0
	CALLS	#1, G^LIB$PUT_OUTPUT
	RET

; POC_OUT_REGISTER(text, length): Out's line and its length, a LONGINT
; whose low longword is the count, under -O2 or -OC; kept for POC_OUT_EXIT,
; which is declared an exit handler, so that a line the program has not
; ended with Ln when it ends is written still, as a record of its own
	.ENTRY	POC_OUT_REGISTER, ^M<>
	MOVL	4(AP), POC_OUT_TEXT
	MOVL	8(AP), POC_OUT_LENGTH
	$DCLEXH_S	DESBLK=POC_OUT_EXIT_BLOCK
	RET

	.ENTRY	POC_OUT_EXIT, ^M<>
	MOVL	POC_OUT_LENGTH, R0
	TSTL	(R0)
	BEQL	10$
	PUSHL	(R0)
	PUSHL	POC_OUT_TEXT
	CALLS	#2, POC_PUT_LINE
	CLRL	@POC_OUT_LENGTH
10$:	RET

	.END
